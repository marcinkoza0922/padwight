# Select switches to the Alt mode and back; Start enters a mode that swallows unbound buttons.
setup tests/scenarios/packs/layers.padpack Base
tap south 30
tap select 30
tap south 30
tap east 30
tap select 30
tap south 30
tap start 30
tap south 30
tap east 30
tap start 30
tap east 30
---
key KEY_A down             @0
key KEY_A up               @30
shifts mode Alt layers -   @30
key KEY_M down             @60
key KEY_M up               @90
key KEY_N down             @90
key KEY_N up               @120
shifts mode - layers -     @120
key KEY_A down             @150
key KEY_A up               @180
shifts mode Other layers - @180
key KEY_O down             @210
key KEY_O up               @240
shifts mode - layers -     @270
key KEY_B down             @300
key KEY_B up               @330
