# FEEL-4 / known finding: the right stick is pushed before the radial menu opens, and still
# pushed when the menu closes. What the virtual pad sees of the stick is the transcript's point.
setup tests/scenarios/packs/menus.padpack Menus
stick right 1 0
advance 100
press rb
advance 100
release rb
advance 100
stick right 0 0
advance 100
---
pad-axis RightX 1.00                   @0
pad-axis RightX 0.00                   @100
overlay menu "Radial" selected "Right" @100
sound menu Open pop                    @100
sound menu Pick pop                    @200
overlay none                           @200
sound menu Close pop                   @200
key KEY_R down                         @200
key KEY_R up                           @200
