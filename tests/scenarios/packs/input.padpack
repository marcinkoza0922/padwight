[[profiles]]
name = "Stick keys"

[profiles.buttons]
South = {keys = ["KEY_SPACE"]}
East = {gamepad = "East"}
North = {gamepad = "North"}
West = {gamepad = "West"}
LeftBumper = {gamepad = "LeftBumper"}
RightBumper = {gamepad = "RightBumper"}
LeftStick = {gamepad = "LeftStick"}
RightStick = {gamepad = "RightStick"}
Select = {gamepad = "Select"}
Start = {gamepad = "Start"}
DpadUp = {gamepad = "DpadUp"}
DpadDown = {gamepad = "DpadDown"}
DpadLeft = {gamepad = "DpadLeft"}
DpadRight = {gamepad = "DpadRight"}

[profiles.left_stick]
deadzone = 0.1
curve = 1.0
key_threshold = 0.3

[profiles.left_stick.action.ring]
sectors = 4
start_angle = 0.0
inner_radius = 0.25
hysteresis = 0.1

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_W"]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_D"]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_S"]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_A"]

[[profiles.left_stick.zones]]
min = 0.9
max = 1.0
action = {keys = ["KEY_LEFTSHIFT"]}

[profiles.right_stick]
deadzone = 0.1
curve = 1.0
key_threshold = 0.5

[profiles.right_stick.action]
gamepad = {stick = "Right", invert_y = false}

[profiles.left_trigger]
action = {gamepad = "Left"}

[profiles.right_trigger]
action = {gamepad = "Right"}

[profiles.gyro]
enabled = false
horizontal = "yaw"
invert_x = false
invert_y = false
noise_threshold = 1.0

[[profiles]]
name = "Triggers"

[profiles.buttons]
South = {gamepad = "South"}
