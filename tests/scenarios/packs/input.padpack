[profiles.right_trigger]
action = {gamepad = "Right"}

[profiles.gyro]
enabled = false
horizontal = "yaw"
invert_x = false
invert_y = false
noise_threshold = 1.0

[[profiles]]
name = "Toggle and turbo"

[profiles.buttons]
South = {toggle = {keys = ["KEY_A"]}}
East = {turbo = {action = {keys = ["KEY_B"]}, rate = 10.0}}
North = {toggle = {turbo = {action = {keys = ["KEY_C"]}, rate = 10.0}}}
