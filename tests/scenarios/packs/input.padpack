[profiles.right_stick]
deadzone = 0.05
curve = 1.0
key_threshold = 0.3

[profiles.right_stick.action]
gamepad = {stick = "Right", invert_y = false}

[profiles.left_trigger.action.button]
action = {mouse = "Right"}
threshold = 0.5

[profiles.right_trigger]
action = {gamepad = "Right"}

[[profiles.right_trigger.zones]]
min = 0.2
max = 0.7
action = {keys = ["KEY_Z"]}

[[profiles.right_trigger.zones]]
min = 0.7
max = 1.0
action = {keys = ["KEY_X"]}

