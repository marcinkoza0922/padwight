format = 20
macros = []
overlay_font = "Cinzel"

[pack]
id = "b54da73c-2a3c-4f10-bc31-79c2f11db6cd"
name = "Baldur's Gate 3"
version = "1.0"
author = "Padwight"
description = "Baldur's Gate 3 on an Xbox-style pad. The game has its own controller support, so the controller passes through untouched and the game's Controller options set the buttons. Padwight adds the Guide overlay on top, with the on-screen keyboard for naming a character and the media controls, in the game's colors."
made_with = "Xbox controller"

[[rules]]
kind = "executable"
value = "bg3.exe"
profile = "Baldur's Gate 3"

[[rules]]
kind = "executable"
value = "bg3_dx11.exe"
profile = "Baldur's Gate 3"

[[rules]]
kind = "steam_app_id"
value = "1086940"
profile = "Baldur's Gate 3"

[controllers]
dualshock = true
dualsense = true

[[profiles]]
name = "Baldur's Gate 3"
combos = []
combo_window_ms = 120
tap_window_ms = 250
long_press_ms = 500

[profiles.buttons]
South = {gamepad = "South"}
East = {gamepad = "East"}
North = {gamepad = "North"}
West = {gamepad = "West"}
LeftBumper = {gamepad = "LeftBumper"}
RightBumper = {gamepad = "RightBumper"}
LeftStick = {gamepad = "LeftStick"}
RightStick = {gamepad = "RightStick"}
Select = {gamepad = "Select"}
Start = {gamepad = "Start"}
DpadUp = {gamepad = "DpadUp"}
DpadDown = {gamepad = "DpadDown"}
DpadLeft = {gamepad = "DpadLeft"}
DpadRight = {gamepad = "DpadRight"}
Guide = {mode = "Guide"}

[profiles.left_stick]
deadzone = 0.05
curve = 1.0
key_threshold = 0.3

[profiles.left_stick.action]
gamepad = {stick = "Left", invert_y = false}

[profiles.right_stick]
deadzone = 0.05
curve = 1.0
key_threshold = 0.3

[profiles.right_stick.action]
gamepad = {stick = "Right", invert_y = false}

[profiles.left_trigger]
action = {gamepad = "Left"}

[profiles.right_trigger]
action = {gamepad = "Right"}

[profiles.gyro]
enabled = false
horizontal = "yaw"
invert_x = false
invert_y = false
noise_threshold = 1.0

[profiles.guide]
notes = '''Baldur's Gate 3 has its own controller support, so the controller goes to the game as it is. Set the buttons in the game's options, on the Controller tab.
{guide} still works over the game: {guide} + {west} opens the on-screen keyboard for naming a character or a save, and {guide} + {lb} the media controls.
If the game keeps showing Xbox glyphs for a DualSense, or doesn't answer the pad, check that Steam Input or another remapper isn't also running for it.'''

[keyboard_style]
corners = 0.2
position = "bottom_center"
scale = 1.0

[keyboard_style.background]
color = "#0e0b0b"
opacity = 0.92

[keyboard_style.items]
color = "#271c1c"
opacity = 0.95

[keyboard_style.selected]
color = "#c9a24a"
opacity = 1.0

[keyboard_style.border]
width = 1
color = "#a2802f"
opacity = 0.8

[keyboard_style.gradient]
color = "#171010"
opacity = 1.0
angle = 180

[keyboard_style.item_border]
width = 1
color = "#4d3a2a"

[numpad_style]
corners = 0.2
position = "center"
scale = 1.0

[numpad_style.background]
color = "#0e0b0b"
opacity = 0.92

[numpad_style.items]
color = "#271c1c"
opacity = 0.95

[numpad_style.selected]
color = "#c9a24a"
opacity = 1.0

[numpad_style.border]
width = 1
color = "#a2802f"
opacity = 0.8

[numpad_style.gradient]
color = "#171010"
opacity = 1.0
angle = 180

[numpad_style.item_border]
width = 1
color = "#4d3a2a"

[media_style]
corners = 0.2
position = "top_right"
scale = 0.9

[media_style.background]
color = "#0e0b0b"
opacity = 0.92

[media_style.items]
color = "#271c1c"
opacity = 0.95

[media_style.selected]
color = "#c9a24a"
opacity = 1.0

[media_style.border]
width = 1
color = "#a2802f"
opacity = 0.8

[media_style.gradient]
color = "#171010"
opacity = 1.0
angle = 180

[media_style.item_border]
width = 1
color = "#4d3a2a"

[media_style.type]
letter_spacing = 1

[menu_style]
corners = 0.2
position = "center"
scale = 1.0

[menu_style.background]
color = "#0e0b0b"
opacity = 0.92

[menu_style.items]
color = "#271c1c"
opacity = 0.95

[menu_style.selected]
color = "#c9a24a"
opacity = 1.0

[menu_style.border]
width = 1
color = "#a2802f"
opacity = 0.8

[menu_style.gradient]
color = "#171010"
opacity = 1.0
angle = 180
drift = true

[menu_style.item_border]
width = 1
color = "#4d3a2a"

[menu_style.glow]
color = "#e6c26b"
opacity = 0.6
blur = 18

[menu_style.type]
letter_spacing = 1

[menu_style.ornament]
vignette = {color = "#000000", opacity = 0.45, reach = 25}

[motion]
keyboard = "dreamy"
numpad = "dreamy"
menu = "dreamy"
media = "dreamy"
offer = "dreamy"
info = "dreamy"
log = "dreamy"

[sounds.keyboard]
step = {kind = "drop", volume = 0.06, pitch = 1.3}
pick = {kind = "keys", volume = 0.2}

[sounds.numpad]
step = {kind = "drop", volume = 0.06, pitch = 1.3}
pick = {kind = "glass", volume = 0.1}

[sounds.media]
pick = {kind = "glass", volume = 0.1, pitch = 1.2}

[rumble.keyboard]
step = {strength = 0.06, length_ms = 14}
pick = {strength = 0.25, length_ms = 22}

[rumble.numpad]
step = {strength = 0.06, length_ms = 14}
pick = {strength = 0.25, length_ms = 22}

[rumble.media]
pick = {strength = 0.25, length_ms = 25}

[rumble.guide]
mode = {strength = 0.25, length_ms = 60}
