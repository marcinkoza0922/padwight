format = 19
macros = []
overlay_font = "Source Code Pro"

[pack]
id = "a3e96f08-81c7-4d2b-b5f3-6c0d47e9128a"
name = "Max Payne 2"
version = "1.2"
author = "Padwight"
description = "Max Payne 2: The Fall of Max Payne (2003) on an Xbox-style pad, for the game's default keys. RT shoots, LT is bullet time and RB shootdodges (with a direction). A uses, B jumps, X reloads and Y takes a painkiller. LB opens a radial menu of weapon groups (aim with the right stick), R3 is the secondary attack, up on the d-pad the sniper zoom, L3 toggles crouch. Start is the menu: double tap it to quick save, hold it to quick load. Gyro and flick stick profiles are included to try."
made_with = "Xbox controller"

[[rules]]
kind = "executable"
value = "maxpayne2.exe"
profile = "Max Payne 2"

[[rules]]
kind = "steam_app_id"
value = "12150"
profile = "Max Payne 2"

[[profiles]]
name = "Max Payne 2"
combos = []
combo_window_ms = 120
tap_window_ms = 250
long_press_ms = 500

[profiles.buttons]

[profiles.buttons.Guide]
mode = "Guide"

[profiles.buttons.South]
keys = ["KEY_E"]

[profiles.buttons.East]
keys = ["KEY_SPACE"]

[profiles.buttons.West]
keys = ["KEY_R"]

[profiles.buttons.North]
keys = ["KEY_TAB"]

[profiles.buttons.LeftBumper]
open_menu = "Weapons"

[profiles.buttons.RightBumper]
keys = ["KEY_LEFTSHIFT"]

[profiles.buttons.Select]
keys = ["KEY_P"]

[profiles.buttons.Start]
keys = ["KEY_ESC"]

[profiles.buttons.LeftStick.toggle]
keys = ["KEY_C"]

[profiles.buttons.RightStick]
keys = ["KEY_F"]

[profiles.buttons.DpadLeft]
wheel = "Up"

[profiles.buttons.DpadRight]
wheel = "Down"

[profiles.buttons.DpadUp]
keys = ["KEY_Q"]
[profiles.left_stick]
deadzone = 0.12
curve = 1.0
key_threshold = 0.25

[profiles.left_stick.action.keys]
up = "KEY_W"
down = "KEY_S"
left = "KEY_A"
right = "KEY_D"

[profiles.right_stick]
deadzone = 0.1
curve = 1.8
key_threshold = 0.5

[profiles.right_stick.action.mouse]
speed = 1300.0
accel = 0.2

[profiles.left_trigger.action.button]
threshold = 0.4
action = {mouse = "Right"}

[profiles.right_trigger.action.button]
threshold = 0.3

[profiles.right_trigger.action.button.action]
mouse = "Left"

[profiles.gestures.Start.double_tap]
keys = ["KEY_F5"]

[profiles.gestures.Start.long_press]
keys = ["KEY_F9"]

[profiles.gyro]
mode = "off"
horizontal = "yaw"
invert_x = false
invert_y = false
activation = "always"
noise_threshold = 1.0
[profiles.guide]
notes = '''Hold {lt} for bullet time. Hold {rb} with a direction on the left stick {ls} to shootdodge, and let go to stand back up.
{north} takes a painkiller. {south} uses doors, switches and phones, and {east} jumps.
Hold {lb} for the weapon groups, aiming with the right stick {rs}. The {dpad} left and right step through the weapons.
Click {r3} for the secondary attack: a melee strike, or a grenade or Molotov without switching weapons. {up} is the sniper zoom.
Crouch is a toggle: click {l3} to crouch and again to stand.
{start} is the menu. Double tap it to quick save and hold it to quick load. {select} pauses without the menu.'''

[profiles.guide.edits]
"stick:Left" = {text = "Move"}
"stick:Right" = {text = "Aim"}
"trigger:Right" = {text = "Shoot"}
"trigger:Left" = {text = "{icon:hourglass} Bullet time"}
"button:RightBumper" = {text = "Shootdodge (with a direction)"}
"button:South" = {text = "Use"}
"button:East" = {text = "Jump"}
"button:West" = {text = "Reload"}
"button:North" = {text = "{icon:pill} {color:green}Painkillers{/color}"}
"button:LeftBumper" = {text = "Hold: weapon groups"}
"button:LeftStick" = {text = "Crouch (toggle)"}
"button:RightStick" = {text = "Secondary attack (melee, throw)"}
"button:Select" = {text = "Pause"}
"button:Start" = {text = "Menu"}
"gesture:button:Start:double_tap" = {text = "{icon:save} Quick save"}
"gesture:button:Start:long_press" = {text = "{icon:load} Quick load"}
"button:DpadUp" = {text = "{icon:scope} Sniper zoom"}

[[profiles.guide.merged]]
inputs = ["button:DpadLeft", "button:DpadRight"]
text = "Previous / next weapon"




