format = 20
macros = []
overlay_font = "Titillium Web"

[pack]
id = "6decf402-895c-497d-9f58-63a3f1223bf1"
name = "Oxygen Not Included"
version = "1.0"
author = "Padwight"
description = "Oxygen Not Included on an Xbox-style pad, for the game's default keys. The left stick pans the asteroid and the right stick moves the pointer; RT and A click, LT right-clicks. Hold LB for the build categories, RB for the overlays and X for the tools (tap X to dig). Y rotates, L3 pauses, the D-pad zooms and sets the speed, and Select lists the screens."
made_with = "Xbox controller"

[[rules]]
kind = "steam_app_id"
value = "457140"
profile = "Oxygen Not Included"

[[rules]]
kind = "executable"
value = "OxygenNotIncluded.exe"
profile = "Oxygen Not Included"

[[rules]]
kind = "executable"
value = "OxygenNotIncluded"
profile = "Oxygen Not Included"

[[profiles]]
name = "Oxygen Not Included"
combos = []
combo_window_ms = 120
tap_window_ms = 250
long_press_ms = 500

[profiles.buttons]
Guide = {mode = "Guide"}
South = {mouse = "Left"}
East = {keys = ["KEY_ESC"]}
West = {keys = ["KEY_G"]}
North = {keys = ["KEY_O"]}
LeftBumper = {open_menu = "Build"}
RightBumper = {open_menu = "Overlays"}
Select = {open_menu = "Screens"}
Start = {keys = ["KEY_ESC"]}
LeftStick = {keys = ["KEY_SPACE"]}
RightStick = {keys = ["KEY_H"]}
DpadUp = {wheel = "Up"}
DpadDown = {wheel = "Down"}
DpadLeft = {keys = ["KEY_KPMINUS"]}
DpadRight = {keys = ["KEY_KPPLUS"]}

[profiles.gestures.West.long_press]
open_menu = "Tools"

[profiles.gestures.North.long_press]
keys = ["KEY_B"]

[profiles.left_stick]
deadzone = 0.15
curve = 1.0
key_threshold = 0.35

[profiles.left_stick.action.ring]
sectors = 8
start_angle = 0.0
inner_radius = 0.35
hysteresis = 0.1

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_W"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_W"] },
    { keys = ["KEY_D"] },
]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_D"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_S"] },
    { keys = ["KEY_D"] },
]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_S"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_S"] },
    { keys = ["KEY_A"] },
]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_A"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_W"] },
    { keys = ["KEY_A"] },
]

[profiles.right_stick]
deadzone = 0.12
curve = 1.8
key_threshold = 0.5

[profiles.right_stick.action.mouse]
speed = 1500.0
accel = 0.3

[profiles.left_trigger.action.button]
threshold = 0.4
action = {mouse = "Right"}

[profiles.right_trigger.action.button]
threshold = 0.3
action = {mouse = "Left"}

[profiles.gyro]
enabled = false
horizontal = "yaw"
invert_x = false
invert_y = false
noise_threshold = 1.0

[profiles.guide]
notes = '''The right stick {rs} moves the pointer and the left stick {ls} pans the asteroid. {rt} or {south} clicks and drags; {lt} right-clicks to put the tool down.
Hold {lb} for the build categories and {rb} for the overlays, aiming with the right stick {rs}. {west} picks the dig tool; hold it for every tool (cancel, deconstruct, prioritize, sweep, mop and more), aiming with the left stick {ls}.
{north} rotates the building in hand; hold it to copy the one under the pointer. Click {l3} to pause, {left} and {right} slow down and speed up. {up} and {down} zoom, {r3} returns the camera to the Printing Pod.
{select} lists the screens: vitals, consumables, schedule, priorities, skills, research, reports, database and starmap. {east} closes them.
Keys are the game's defaults, read from memory rather than an install: if one is off, check Options → Controls. Naming a duplicant: {guide} + {west} opens the on-screen keyboard.'''

[profiles.guide.edits]
"stick:Left" = {text = "Pan"}
"stick:Right" = {text = "Pointer"}
"trigger:Right" = {text = "Click / drag"}
"trigger:Left" = {text = "Right-click (drop tool)"}
"button:South" = {text = "Click"}
"button:East" = {text = "Close"}
"button:West" = {text = "{icon:pick} Dig"}
"gesture:button:West:long_press" = {text = "Hold: tools"}
"button:North" = {text = "{icon:rotate} Rotate"}
"gesture:button:North:long_press" = {text = "Copy building"}
"button:LeftBumper" = {text = "Hold: {icon:hammer} build"}
"button:RightBumper" = {text = "Hold: {icon:layers} overlays"}
"button:Select" = {text = "Screens"}
"button:Start" = {text = "Menu"}
"button:LeftStick" = {text = "{icon:pause} Pause"}
"button:RightStick" = {text = "{icon:home} Printing Pod"}
"button:DpadLeft" = {text = "{icon:speed1} Slower"}
"button:DpadRight" = {text = "{icon:speed3} Faster"}

[[profiles.guide.merged]]
inputs = ["button:DpadUp", "button:DpadDown"]
text = "Zoom in / out"


