format = 20
macros = []
overlay_font = "Kreon"

[pack]
id = "94f6a8e2-9b6f-4e69-837d-d02ecfa430a2"
name = "Breath of Fire IV"
version = "1.0"
author = "Padwight"
description = "Breath of Fire IV (GOG, 2025 re-release of the 2000 game) on an Xbox-style pad, laid out like the PlayStation original for the game's default keys. A checks and talks, B acts and cancels, X runs, Y opens the sub screen. The triggers turn the camera and flip between characters, LB backs out, RB changes rank, and Select lists the camp and menu keys."
made_with = "Xbox controller"

[[rules]]
kind = "executable"
value = "BOF4.exe"
profile = "Breath of Fire IV"

[[profiles]]
name = "Breath of Fire IV"
combos = []
combo_window_ms = 120
tap_window_ms = 250
long_press_ms = 500

[profiles.buttons]
Guide = {mode = "Guide"}
South = {keys = ["KEY_C"]}
East = {keys = ["KEY_V"]}
West = {keys = ["KEY_X"]}
North = {keys = ["KEY_Z"]}
LeftBumper = {keys = ["KEY_ESC"]}
RightBumper = {keys = ["KEY_TAB"]}
Select = {open_menu = "Keys"}
Start = {keys = ["KEY_ENTER"]}
DpadUp = {keys = ["KEY_UP"]}
DpadDown = {keys = ["KEY_DOWN"]}
DpadLeft = {keys = ["KEY_LEFT"]}
DpadRight = {keys = ["KEY_RIGHT"]}
RightStickLeft = {keys = ["KEY_A"]}
RightStickRight = {keys = ["KEY_D"]}

[profiles.left_stick]
deadzone = 0.2
curve = 1.0
key_threshold = 0.4

[profiles.left_stick.action.ring]
sectors = 8
start_angle = 0.0
inner_radius = 0.4
hysteresis = 0.1

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_UP"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_UP"] },
    { keys = ["KEY_RIGHT"] },
]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_RIGHT"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_DOWN"] },
    { keys = ["KEY_RIGHT"] },
]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_DOWN"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_DOWN"] },
    { keys = ["KEY_LEFT"] },
]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_LEFT"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_UP"] },
    { keys = ["KEY_LEFT"] },
]

[profiles.right_stick]
deadzone = 0.3
curve = 1.0
key_threshold = 0.5


action = "disabled"

[profiles.left_trigger.action.button]
threshold = 0.3
action = {keys = ["KEY_A"]}

[profiles.right_trigger.action.button]
threshold = 0.3
action = {keys = ["KEY_D"]}

[profiles.gyro]
mode = "off"
horizontal = "yaw"
invert_x = false
invert_y = false
activation = "always"
noise_threshold = 1.0

[profiles.guide]
notes = '''The layout follows the PlayStation original: {south} checks and talks, {east} is the action and cancel key, {west} runs (hold it) and {north} opens the Sub Screen, where items, magic, equipment and saving live. In a fight {north} shows the enemy's details.
{lt} and {rt} turn the camera, the right stick {rs} does too, and in the Sub Screen and in battle they flip between characters. Hold {rt} in battle for the extra commands (Guard, Charge, Escape). {rb} changes rank, which puts characters on the front line or the rest bench.
{lb} is Escape and backs out of menus; {start} is Enter, which pauses and opens the options. Press {select} for the camp (on the world map), Enter, Escape and rank in one list. The game saves at inns, in the camp and from the Sub Screen on the world map.'''

[profiles.guide.edits]
"stick:Left" = {text = "Move"}
"stick:Right" = {text = "Turn camera"}
"trigger:Left" = {text = "{icon:rotate-left} Camera left / previous character"}
"trigger:Right" = {text = "{icon:rotate} Camera right / next character (hold: more commands)"}
"button:South" = {text = "{icon:search} {b}Check / talk{/b}"}
"button:East" = {text = "Action / cancel"}
"button:West" = {text = "{icon:fast} Run (hold)"}
"button:North" = {text = "{icon:bag} {b}Sub Screen{/b} / enemy info"}
"button:LeftBumper" = {text = "Escape: back out"}
"button:RightBumper" = {text = "{icon:flip} Change rank"}
"button:Select" = {text = "{icon:map} Camp and menu keys"}
"button:Start" = {text = "Enter: pause, options"}

[[info_overlays]]
name = "Controls"
title = "{b}Breath of Fire IV{/b}"
rows = [
    ["{south}", "Check / talk", "{east}", "Action / cancel"],
    ["{west}", "Run (hold)", "{north}", "Sub Screen / enemy info"],
    ["{lt} {rt}", "Camera, characters", "{rb}", "Change rank"],
    ["{lb}", "Escape", "{start}", "Enter / pause"],
    ["{select}", "Camp, Enter, Escape, rank", "{ls}", "Move"],
]

[[menus]]
name = "Keys"

kind = "list"

[[menus.items]]
label = "{icon:cottage} {b}Camp{/b}"
action = { keys = ["KEY_G"] }

[[menus.items]]
label = "{icon:flip} Change rank"
action = { keys = ["KEY_TAB"] }

[[menus.items]]
label = "{icon:save} Enter (pause, options)"
action = { keys = ["KEY_ENTER"] }

[[menus.items]]
label = "{icon:cancel} Escape"
action = { keys = ["KEY_ESC"] }

