[[profiles]]
name = "Civilization IV"
combos = []
combo_window_ms = 120
tap_window_ms = 250
long_press_ms = 500

[profiles.buttons]
Guide = { mode = "Guide" }
South = { mouse = "Left" }
East = { keys = ["KEY_ESC"] }
West = { keys = ["KEY_SPACE"] }
North = { keys = ["KEY_F"] }
LeftBumper = { open_menu = "Orders" }
RightBumper = { keys = ["KEY_ENTER"] }
Select = { open_menu = "Screens" }
Start = { keys = ["KEY_ESC"] }
LeftStick = { keys = ["KEY_C"] }
RightStick = { keys = ["KEY_F11"] }
DpadUp = { wheel = "Up" }
DpadDown = { wheel = "Down" }
DpadLeft = { keys = ["KEY_COMMA"] }
DpadRight = { keys = ["KEY_DOT"] }

[profiles.gestures.RightBumper.long_press]
keys = ["KEY_LEFTSHIFT", "KEY_ENTER"]

[profiles.gestures.DpadLeft.long_press]
keys = ["KEY_END"]

[profiles.gestures.DpadRight.long_press]
keys = ["KEY_HOME"]

[profiles.gestures.Start.double_tap]
keys = ["KEY_LEFTSHIFT", "KEY_F5"]

[profiles.gestures.Start.long_press]
keys = ["KEY_LEFTSHIFT", "KEY_F8"]

[profiles.left_stick]
deadzone = 0.15
curve = 1.0
key_threshold = 0.35

[profiles.left_stick.action.keys]
up = "KEY_UP"
down = "KEY_DOWN"
left = "KEY_LEFT"
right = "KEY_RIGHT"

[profiles.right_stick]
deadzone = 0.12
curve = 1.8
key_threshold = 0.5

[profiles.right_stick.action.mouse]
speed = 1500.0
accel = 0.3

[profiles.left_trigger.action.button]
threshold = 0.4
action = { mouse = "Right" }

[profiles.right_trigger.action.button]
threshold = 0.3
action = { mouse = "Left" }

[profiles.guide]
notes = '''The right stick moves the mouse pointer; {rt} or {south} is a left click and {lt} a right click. Hold {guide} and press {west} for the on-screen keyboard when the game asks for a name.
{lt} gives a right click, which moves the selected unit to the tile under the pointer.
{east} closes the open screen. {start} opens the game menu.
Hold {lb} for the unit orders, picking with the right stick {rs}.
{rb} goes to the next unit that needs orders, and ends the turn when none do.
Double tap {start} to quick save and hold it to quick load. {r3} switches to the globe view.'''

[profiles.guide.edits]
