format = 20
macros = []
overlay_font = "Cinzel"

[pack]
id = "92586738-ac63-4a9c-b4aa-d143b64d5975"
name = "Civilization IV"
version = "1.3"
author = "Padwight"
description = "Civilization IV: Beyond the Sword (Steam) on an Xbox-style pad. The right stick moves the pointer, the left stick pans the map, RT or A left-clicks, LT right-clicks to move units. X skips a unit, Y fortifies, RB goes to the next unit or ends the turn. Hold LB for unit orders. The d-pad zooms and cycles units (hold: cities). Select lists the advisors and screens. Start is the game menu; double tap it to quick save, hold it to quick load."
made_with = "Xbox controller"

[[rules]]
kind = "executable"
value = "Civ4BeyondSword.exe"
profile = "Civilization IV"

[[rules]]
kind = "executable"
value = "Civ4Warlords.exe"
profile = "Civilization IV"

[[rules]]
kind = "executable"
value = "Civilization4.exe"
profile = "Civilization IV"

[[rules]]
kind = "steam_app_id"
value = "8800"
profile = "Civilization IV"

[[rules]]
kind = "steam_app_id"
value = "3900"
profile = "Civilization IV"

[[profiles]]
name = "Civilization IV"
combos = []
combo_window_ms = 120
tap_window_ms = 250
long_press_ms = 500

[profiles.buttons]
Guide = { mode = "Guide" }
South = { mouse = "Left" }
East = { keys = ["KEY_ESC"] }
West = { keys = ["KEY_SPACE"] }
North = { keys = ["KEY_F"] }
LeftBumper = { open_menu = "Orders" }
RightBumper = { keys = ["KEY_ENTER"] }
Select = { open_menu = "Screens" }
Start = { keys = ["KEY_ESC"] }
LeftStick = { keys = ["KEY_C"] }
RightStick = { keys = ["KEY_F11"] }
DpadUp = { wheel = "Up" }
DpadDown = { wheel = "Down" }
DpadLeft = { keys = ["KEY_COMMA"] }
DpadRight = { keys = ["KEY_DOT"] }

[profiles.gestures.RightBumper.long_press]
keys = ["KEY_LEFTSHIFT", "KEY_ENTER"]

[profiles.gestures.DpadLeft.long_press]
keys = ["KEY_END"]

[profiles.gestures.DpadRight.long_press]
keys = ["KEY_HOME"]

[profiles.gestures.Start.double_tap]
keys = ["KEY_LEFTSHIFT", "KEY_F5"]

[profiles.gestures.Start.long_press]
keys = ["KEY_LEFTSHIFT", "KEY_F8"]

[profiles.left_stick]
deadzone = 0.15
curve = 1.0
key_threshold = 0.35

[profiles.left_stick.action.ring]
sectors = 8
start_angle = 0.0
inner_radius = 0.35
hysteresis = 0.1

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_UP"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_UP"] },
    { keys = ["KEY_RIGHT"] },
]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_RIGHT"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_DOWN"] },
    { keys = ["KEY_RIGHT"] },
]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_DOWN"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_DOWN"] },
    { keys = ["KEY_LEFT"] },
]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_LEFT"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_UP"] },
    { keys = ["KEY_LEFT"] },
]

[profiles.right_stick]
deadzone = 0.12
curve = 1.8
key_threshold = 0.5

[profiles.right_stick.action.mouse]
speed = 1500.0
accel = 0.3

[profiles.left_trigger.action.button]
threshold = 0.4
action = { mouse = "Right" }

[profiles.right_trigger.action.button]
threshold = 0.3
action = { mouse = "Left" }

[profiles.guide]
notes = '''The right stick moves the mouse pointer; {rt} or {south} is a left click and {lt} a right click. Hold {guide} and press {west} for the on-screen keyboard when the game asks for a name.
{lt} gives a right click, which moves the selected unit to the tile under the pointer.
{east} closes the open screen. {start} opens the game menu.
Hold {lb} for the unit orders, picking with the right stick {rs}.
{rb} goes to the next unit that needs orders, and ends the turn when none do.
Double tap {start} to quick save and hold it to quick load. {r3} switches to the globe view.'''

[profiles.guide.edits]
"stick:Right" = { text = "Pointer" }
"trigger:Right" = { text = "Left click (select)" }
"trigger:Left" = { text = "Right click (move to)" }
"button:South" = { text = "Left click" }
"button:East" = { text = "Close screen" }
"button:LeftBumper" = { text = "Hold: unit orders" }
"button:Select" = { text = "Advisors, screens" }
"button:Start" = { text = "Game menu" }
"stick:Left" = { text = "Pan the map" }
"button:West" = { text = "Skip the unit's turn" }
"button:North" = { text = "{icon:fortify} Fortify / sleep" }
"button:RightBumper" = { text = "Next action / end turn" }
"button:LeftStick" = { text = "Center on the unit" }
"button:RightStick" = { text = "Globe view" }
"gesture:button:DpadLeft:long_press" = { text = "Previous city" }
"gesture:button:DpadRight:long_press" = { text = "Next city" }
"gesture:button:Start:double_tap" = { text = "{icon:save} Quick save" }
"gesture:button:Start:long_press" = { text = "{icon:load} Quick load" }
"gesture:button:RightBumper:long_press" = { text = "End turn now" }

[[profiles.guide.merged]]
inputs = ["button:DpadUp", "button:DpadDown"]
text = "Zoom in / out"

[[profiles.guide.merged]]
inputs = ["button:DpadLeft", "button:DpadRight"]
text = "Previous / next unit"

