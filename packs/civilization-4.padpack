format = 19
macros = []
overlay_font = "Cinzel"

[pack]
id = "92586738-ac63-4a9c-b4aa-d143b64d5975"
name = "Civilization IV"
version = "1.1"
author = "Padwight"
description = "Civilization IV: Beyond the Sword (Steam) on an Xbox-style pad. The right stick moves the pointer, the left stick pans the map, RT or A left-clicks, LT right-clicks to move units. X skips a unit, Y fortifies, RB goes to the next unit or ends the turn. Hold LB for unit orders. The d-pad zooms and cycles units (hold: cities). Select lists the advisors and screens. Start is the game menu; double tap it to quick save, hold it to quick load."
made_with = "Xbox controller"

[[rules]]
kind = "executable"
value = "Civ4BeyondSword.exe"
profile = "Civilization IV"

[[rules]]
kind = "executable"
value = "Civ4Warlords.exe"
profile = "Civilization IV"

[[rules]]
