format = 20
macros = []
overlay_font = "Rajdhani"

[pack]
id = "eebe16e6-6ecb-4384-b008-d4e068ec5058"
name = "Rust"
version = "1.0"
author = "Padwight"
description = "Rust on an Xbox-style pad, for the game's default keys. A jumps, B crouches (toggle), X uses (hold: options), Y opens the inventory (hold: crafting), RT attacks, LT aims, RB reloads, L3 sprints (toggle), R3 holds free look. Hold LB for the belt, the D-pad steps through it and holds the flashlight and voice. Select lists the map, chat and console; hold it for the Flying mode. Gyro and flick stick profiles are included to try. Rust uses Easy Anti-Cheat: the official servers don't run under Proton."
made_with = "Xbox controller"

[[rules]]
kind = "executable"
value = "RustClient.exe"
profile = "Rust"

[[rules]]
kind = "steam_app_id"
value = "252490"
profile = "Rust"

[[profiles]]
name = "Rust"
combos = []
combo_window_ms = 120
tap_window_ms = 250
long_press_ms = 500

[profiles.buttons]
South = { keys = ["KEY_SPACE"] }
East = { toggle = { action = { keys = ["KEY_LEFTCTRL"] } } }
West = { keys = ["KEY_E"] }
North = { keys = ["KEY_TAB"] }
LeftBumper = { open_menu = "Belt" }
RightBumper = { keys = ["KEY_R"] }
Select = { open_menu = "Screens" }
Start = { keys = ["KEY_ESC"] }
Guide = { mode = "Guide" }
LeftStick = { toggle = { action = { keys = ["KEY_LEFTSHIFT"] } } }
RightStick = { keys = ["KEY_LEFTALT"] }
DpadUp = { keys = ["KEY_F"] }
DpadDown = { keys = ["KEY_V"] }
DpadLeft = { wheel = "Up" }
DpadRight = { wheel = "Down" }

[profiles.gestures.North]
long_press = { keys = ["KEY_Q"] }

[profiles.gestures.Select]
long_press = { mode = "Flying" }

[profiles.left_stick]
deadzone = 0.12
curve = 1.0
key_threshold = 0.25

[profiles.left_stick.action.ring]
sectors = 8
start_angle = 0.0
inner_radius = 0.25
hysteresis = 0.1

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_W"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_W"] },
    { keys = ["KEY_D"] },
]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_D"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_S"] },
    { keys = ["KEY_D"] },
]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_S"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_S"] },
    { keys = ["KEY_A"] },
]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_A"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_W"] },
    { keys = ["KEY_A"] },
]

[profiles.right_stick]
deadzone = 0.1
curve = 2.0
key_threshold = 0.5

[profiles.right_stick.action.mouse]
speed = 2600.0
accel = 0.5
y_scale = 0.75

[profiles.left_trigger.action.button]
threshold = 0.3
action = { multi = [{ layer = "Aim" }, { mouse = "Right" }] }

[profiles.right_trigger.action.button]
threshold = 0.3
action = { mouse = "Left" }

[profiles.guide]
notes = '''Rust uses Easy Anti-Cheat. The pad reaches the game as an ordinary keyboard and mouse, but the official servers don't run under Proton, and some community servers ban macros: this pack has none.
{west} uses and picks up; hold it for the options on a door, box or sleeping bag. {south} jumps, {east} crouches (a toggle) and {l3} sprints (a toggle).
{rt} attacks and {lt} aims or blocks; holding {lt} also slows the right stick for aiming. {rb} reloads.
Hold {lb} for the belt and pick a slot with the right stick {rs}. Pick the slot in your hand again to put it away. {left} and {right} step through the belt.
{north} opens the inventory; hold it for the crafting menu. In both, the right stick {rs} moves the cursor and {rt} clicks.
{up} is the flashlight or laser, hold {down} to talk. Hold {r3} to look around while running.
{select} lists the map, crafting, chat and the console. Hold {select} for the Flying mode (minicopter, scrap heli): {rt} climbs and {lt} drops. Hold {select} again to land back on foot.
Chat and the console need typing: {guide} + {west} opens the on-screen keyboard.'''

[profiles.guide.edits]
"stick:Left" = { text = "Move" }
"stick:Right" = { text = "Look / cursor" }
"trigger:Right" = { text = "{icon:axe} Attack / use tool" }
"trigger:Left" = { text = "{icon:crosshair} Aim / block" }
"button:South" = { text = "Jump" }
"button:East" = { text = "Crouch (toggle)" }
"button:West" = { text = "{icon:hand} Use · hold: options" }
"button:North" = { text = "{icon:bag} Inventory" }
"gesture:button:North:long_press" = { text = "{icon:hammer} Crafting" }
"button:LeftBumper" = { text = "Hold: belt" }
"button:RightBumper" = { text = "Reload" }
"button:LeftStick" = { text = "Sprint (toggle)" }
"button:RightStick" = { text = "Free look (hold)" }
"button:DpadUp" = { text = "{icon:flashlight} Flashlight / laser" }
"button:DpadDown" = { text = "{icon:microphone} Voice (hold)" }
"button:Select" = { text = "{icon:map} Map, chat, console" }
"gesture:button:Select:long_press" = { text = "{icon:helicopter} Flying mode" }
"button:Start" = { text = "Menu" }

[[profiles.guide.merged]]
inputs = ["button:DpadLeft", "button:DpadRight"]
text = "Previous / next belt slot"

