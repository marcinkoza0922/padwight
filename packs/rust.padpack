frame = {kind = "riveted", size = 36, width = 2, color = "#7a3a24"}
concrete = {opacity = 0.35}
vignette = {color = "#000000", opacity = 0.45, reach = 22}

[motion]
keyboard = "brutal"
numpad = "brutal"
menu = "brutal"
media = "brutal"
offer = "brutal"
info = "brutal"
log = "brutal"

[sounds.menu]
step = {kind = "tin", volume = 0.08, pitch = 0.8, length = 0.7}
pick = {kind = "clank", volume = 0.2}
open = {kind = "latch", volume = 0.08}
close = {kind = "latch", volume = 0.06, pitch = 0.8}

[sounds.keyboard]
step = {kind = "tin", volume = 0.07, pitch = 0.9, length = 0.6}
pick = {kind = "keys", volume = 0.25}

[sounds.numpad]
step = {kind = "tin", volume = 0.07, pitch = 0.9, length = 0.6}
pick = {kind = "clank", volume = 0.15, pitch = 1.2}

[sounds.guide]
pick = {kind = "clank", volume = 0.15}

[rumble.menu]
step = {strength = 0.13, length_ms = 18}
pick = {strength = 0.5, length_ms = 35}
open = {strength = 0.11, length_ms = 25}

[rumble.keyboard]
step = {strength = 0.09, length_ms = 14}
pick = {strength = 0.33, length_ms = 22}

[rumble.numpad]
step = {strength = 0.09, length_ms = 14}
pick = {strength = 0.33, length_ms = 22}

[rumble.media]
pick = {strength = 0.33, length_ms = 25}

[rumble.guide]
mode = {strength = 0.33, length_ms = 60}
