format = 20
macros = []
overlay_font = "VT323"

[pack]
id = "a5f15405-94d6-4dee-b789-3d2dd4e99ed3"
name = "System Shock 2"
version = "1.2"
author = "Padwight"
description = "System Shock 2 (GOG, NewDark) on an Xbox-style pad, for the keys GOG ships. A uses, B jumps, RT fires, X reloads (hold: cycle ammo), Y switches to use mode for the inventory and MFDs (hold: med patch), L3 toggles crouch, R3 switches the weapon setting. Hold LB for the quick slots and patches, RB for weapons and the psi amp. D-pad left and right lean, up and down cycle weapons. Select lists the map, logs and messages. Start is the menu; double tap it to quick save, hold it to quick load. Gyro and flick stick profiles are included to try."
made_with = "Xbox controller"

[[rules]]
kind = "executable"
value = "SS2.exe"
profile = "System Shock 2"

[[rules]]
kind = "steam_app_id"
value = "238210"
profile = "System Shock 2"

[[profiles]]
name = "System Shock 2"
combos = []
combo_window_ms = 120
tap_window_ms = 250
long_press_ms = 500

[profiles.buttons]
South = { mouse = "Right" }
East = { keys = ["KEY_SPACE"] }
West = { keys = ["KEY_R"] }
North = { keys = ["KEY_TAB"] }
LeftBumper = { open_menu = "Quick use" }
RightBumper = { open_menu = "Weapons" }
Select = { open_menu = "Screens" }
Start = { keys = ["KEY_ESC"] }
Guide = { mode = "Guide" }
LeftStick = { keys = ["KEY_LEFTSHIFT"] }
RightStick = { keys = ["KEY_O"] }
DpadUp = { wheel = "Up" }
DpadDown = { wheel = "Down" }
DpadLeft = { keys = ["KEY_Q"] }
DpadRight = { keys = ["KEY_E"] }

[profiles.gestures.West.long_press]
keys = ["KEY_B"]

[profiles.gestures.North.long_press]
keys = ["KEY_H"]

[profiles.gestures.Start.double_tap]
keys = ["KEY_LEFTALT", "KEY_S"]

[profiles.gestures.Start.long_press]
keys = ["KEY_LEFTALT", "KEY_L"]

[profiles.left_stick]
deadzone = 0.12
curve = 1.0
key_threshold = 0.25

[profiles.left_stick.action.ring]
sectors = 8
start_angle = 0.0
inner_radius = 0.25
hysteresis = 0.1

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_W"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_W"] },
    { keys = ["KEY_D"] },
]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_D"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_S"] },
    { keys = ["KEY_D"] },
]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_S"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_S"] },
    { keys = ["KEY_A"] },
]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_A"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_W"] },
    { keys = ["KEY_A"] },
]

[profiles.right_stick]
deadzone = 0.12
curve = 2.2
key_threshold = 0.5

[profiles.right_stick.action.mouse]
speed = 2600.0
accel = 0.5
accel_ramp_ms = 350
y_scale = 0.75

[profiles.left_trigger]
action = "disabled"

[profiles.right_trigger.action.button]
threshold = 0.3
action = { mouse = "Left" }

[profiles.guide]
notes = '''{north} switches between shoot mode and use mode (the inventory and MFDs). In use mode the right stick {rs} moves the cursor, {rt} is a left click and {south} a right click.
Keypads, hacking and the research and stats screens all work in use mode: press {north}, then point and click.
Hold {lb} for the F1 to F12 quick slots and the med and rad patches, aiming with the right stick {rs}. Put psi powers and items in the quick slots on the psi and inventory screens (Shift + F-key in the game).
Hold {rb} for the weapons and the psi amp. {r3} switches the weapon setting, such as the pistol's burst.
Hold {west} to cycle ammo, and {north} to use a med patch.
Crouch is a toggle in the game: click {l3} to crouch and again to stand.
{start} (Escape) is the menu. Double tap it to quick save and hold it to quick load.
With gyro aiming, hold {lt} to pause the gyro while you reposition the controller.'''

[profiles.guide.edits]
"stick:Left" = { text = "Move" }
"stick:Right" = { text = "Look / cursor" }
"trigger:Right" = { text = "Fire / swing (left click)" }
"button:South" = { text = "Use / pick up (right click)" }
"button:East" = { text = "Jump" }
"button:West" = { text = "Reload" }
"gesture:button:West:long_press" = { text = "Cycle ammo" }
"button:North" = { text = "{icon:bag} Inventory, use mode" }
"gesture:button:North:long_press" = { text = "Use a med patch" }
"button:LeftBumper" = { text = "Hold: quick slots, patches" }
"button:RightBumper" = { text = "Hold: weapons, psi amp" }
"button:LeftStick" = { text = "Crouch (toggle)" }
"button:RightStick" = { text = "Weapon setting" }
"button:Select" = { text = "{icon:map} Map, logs, messages" }
"button:Start" = { text = "Menu" }
"gesture:button:Start:double_tap" = { text = "{icon:save} Quick save" }
"gesture:button:Start:long_press" = { text = "{icon:load} Quick load" }

[[profiles.guide.merged]]
inputs = ["button:DpadLeft", "button:DpadRight"]
text = "Lean"

[[profiles.guide.merged]]
inputs = ["button:DpadUp", "button:DpadDown"]
text = "Next / previous weapon"

