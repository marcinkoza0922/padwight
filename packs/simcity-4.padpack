format = 18
macros = []
overlay_font = "Inter"

[pack]
id = "561bc3f4-116e-45c8-9622-be5b4c824e06"
name = "SimCity 4"
version = "1.0"
author = "Padwight"
description = "SimCity 4 Deluxe (GOG) on an Xbox-style pad. The right stick moves the pointer, the left stick scrolls the view, RT or A left-clicks, LT right-clicks. Hold LB for the zones and RB for transport and services. X demolishes, Y queries, B drops the tool. The d-pad zooms and rotates, L3 pauses, R3 centers. Select lists the modes and the speed; hold it for a Driving mode for U-Drive-It. Start is the options; double tap it to save quickly, hold it for a full save."
made_with = "Xbox controller"

[[rules]]
kind = "executable"
value = "SimCity 4.exe"
profile = "SimCity 4"

[[rules]]
kind = "steam_app_id"
value = "24780"
profile = "SimCity 4"

[[profiles]]
name = "SimCity 4"
combos = []
combo_window_ms = 120
tap_window_ms = 250
long_press_ms = 500

[profiles.buttons]
Guide = { mode = "Guide" }
South = { mouse = "Left" }
East = { keys = ["KEY_ESC"] }
West = { keys = ["KEY_B"] }
North = { keys = ["KEY_SLASH"] }
LeftBumper = { open_menu = "Zones" }
RightBumper = { open_menu = "Build" }
Select = { open_menu = "Modes and speed" }
Start = { keys = ["KEY_F4"] }
LeftStick = { keys = ["KEY_LEFTCTRL", "KEY_GRAVE"] }
RightStick = { keys = ["KEY_SPACE"] }
DpadUp = { keys = ["KEY_KPPLUS"] }
DpadDown = { keys = ["KEY_KPMINUS"] }
DpadLeft = { keys = ["KEY_PAGEUP"] }
DpadRight = { keys = ["KEY_PAGEDOWN"] }

[profiles.gestures.North.long_press]
keys = ["KEY_LEFTALT", "KEY_SLASH"]

[profiles.gestures.DpadLeft.long_press]
keys = ["KEY_END"]

[profiles.gestures.DpadRight.long_press]
keys = ["KEY_HOME"]

[profiles.gestures.Select.long_press]
mode = "Driving"

[profiles.gestures.Start.double_tap]
keys = ["KEY_LEFTCTRL", "KEY_LEFTALT", "KEY_S"]

[profiles.gestures.Start.long_press]
keys = ["KEY_LEFTCTRL", "KEY_S"]

[profiles.left_stick]
deadzone = 0.15
curve = 1.0
key_threshold = 0.35

[profiles.left_stick.action.keys]
up = "KEY_UP"
down = "KEY_DOWN"
left = "KEY_LEFT"
right = "KEY_RIGHT"

[profiles.right_stick]
deadzone = 0.12
curve = 1.8
key_threshold = 0.5

[profiles.right_stick.action.mouse]
speed = 1500.0
accel = 0.3

[profiles.left_trigger.action.button]
threshold = 0.4
action = { mouse = "Right" }

[profiles.right_trigger.action.button]
threshold = 0.3
action = { mouse = "Left" }

[profiles.guide]
notes = '''
The right stick moves the mouse pointer; RT or A is a left click and LT a right click. Hold Guide and press X for the on-screen keyboard when the game asks for a name.
Hold LB for the zones and RB for transport and services, picking with the right stick, then drag with RT to place. Power, water and other buildings are on the game's toolbar.
B drops the current tool or closes the open panel. Hold the d-pad left or right to turn a building before placing it.
Tap Select for God, Mayor and My Sim modes, the game speed and going back to the region.
U-Drive-It missions: start one in the game, then hold Select for Driving mode. The left stick drives, RT and LT are the mouse buttons, A and X are the special actions, Y snaps to roads, and B leaves the vehicle and the mode.
Double tap Start to save quickly without updating the region view; hold it for a full save.'''

[profiles.guide.edits]
"stick:Left" = { text = "Scroll the view" }
"stick:Right" = { text = "Pointer" }
"trigger:Right" = { text = "Left click (use the tool)" }
"trigger:Left" = { text = "Right click" }
"button:South" = { text = "Left click" }
"button:East" = { text = "Close / drop the tool" }
"button:West" = { text = "Demolish" }
"button:North" = { text = "Query" }
"gesture:button:North:long_press" = { text = "Route query" }
"button:LeftBumper" = { text = "Hold: zones" }
"button:RightBumper" = { text = "Hold: transport, services" }
"button:LeftStick" = { text = "Pause" }
"button:RightStick" = { text = "Center on the pointer" }
"button:Select" = { text = "Modes, speed" }
"gesture:button:Select:long_press" = { text = "Driving mode on / off" }
"button:Start" = { text = "Options" }
"gesture:button:Start:double_tap" = { text = "Fast save" }
"gesture:button:Start:long_press" = { text = "Save with region update" }
"gesture:button:DpadLeft:long_press" = { text = "Turn building left" }
"gesture:button:DpadRight:long_press" = { text = "Turn building right" }

[[profiles.guide.merged]]
inputs = ["button:DpadUp", "button:DpadDown"]
text = "Zoom in / out"

[[profiles.guide.merged]]
inputs = ["button:DpadLeft", "button:DpadRight"]
text = "Rotate the camera"

