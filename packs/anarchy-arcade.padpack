[menu_style.ornament]
frame = {kind = "brackets", size = 8, width = 2, color = "#7a7ae0"}
dividers = {width = 1, color = "#3f3f78", opacity = 0.8}

[motion]
keyboard = "retro"
numpad = "retro"
menu = "retro"
media = "retro"
offer = "retro"
info = "retro"
log = "retro"

[sounds.menu]
step = {kind = "beep", volume = 0.05, pitch = 1.3}
pick = {kind = "blip", volume = 0.08, pitch = 1.1}
open = {kind = "blip", volume = 0.06, pitch = 1.3}
close = {kind = "blip", volume = 0.05, pitch = 0.8}

[sounds.numpad]
step = {kind = "beep", volume = 0.05, pitch = 1.3}
pick = {kind = "blip", volume = 0.08, pitch = 1.1}

[sounds.keyboard]
step = {kind = "beep", volume = 0.05, pitch = 1.3}
pick = {kind = "beep", volume = 0.1}

[sounds.media]
pick = {kind = "blip", volume = 0.08, pitch = 1.1}
