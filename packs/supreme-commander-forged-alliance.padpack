"button:RightStick" = { text = "Special orders" }
"button:DpadLeft" = { text = "{icon:move} Move" }
"button:DpadRight" = { text = "{icon:shield} Assist / guard" }
"button:Start" = { text = "Menu" }
"gesture:button:Select:long_press" = { text = "Menus mode on / off" }
"button:Select" = { text = "Pause, chat, menu" }

