format = 20
macros = []
overlay_font = "Titillium Web"

[pack]
id = "8f43ca96-bf20-4bbd-827f-7f632f3b8fd8"
name = "Supreme Commander: Forged Alliance"
version = "1.0"
author = "Padwight"
description = "Supreme Commander: Forged Alliance on an Xbox-style pad, for the default keys. The game has no controller support, so the layout follows the other strategy packs on the game's keys. The right stick moves the cursor, RT left-clicks to select, LT right-clicks to order, the left stick pans the map and the d-pad zooms (all the way out to the strategic view). A orders an attack, X stops, Y patrols; the d-pad also orders a move and assist. Hold LB for control groups 1-10 (LB + RB sets one), R3 for engineer and special orders. Select lists pause, chat and the menu; hold it for the Menus mode. Start is the menu. The \"+ Gyro\" profile also moves the cursor by tilting the controller."
made_with = "Xbox controller"

[[rules]]
kind = "executable"
value = "Supreme Commander Forged Alliance/bin/SupremeCommander.exe"
profile = "Supreme Commander: Forged Alliance"

[[rules]]
kind = "executable"
value = "ForgedAlliance.exe"
profile = "Supreme Commander: Forged Alliance"

[[rules]]
kind = "steam_app_id"
value = "9420"
profile = "Supreme Commander: Forged Alliance"

[[profiles]]
name = "Supreme Commander: Forged Alliance"
combos = [{buttons = ["LeftBumper", "RightBumper"], action = {open_menu = "Set group"}}]
combo_window_ms = 120
tap_window_ms = 250
long_press_ms = 500

[profiles.buttons]
Guide = {mode = "Guide"}
South = {keys = ["KEY_A"]}
West = {keys = ["KEY_S"]}
North = {keys = ["KEY_P"]}
East = {keys = ["KEY_ESC"]}
LeftBumper = {open_menu = "Groups"}
RightBumper = {keys = ["KEY_LEFTSHIFT"]}
Select = {open_menu = "Game"}
Start = {keys = ["KEY_ESC"]}
LeftStick = {keys = ["KEY_LEFTCTRL"]}
RightStick = {open_menu = "Commands"}
DpadUp = {wheel = "Up"}
DpadDown = {wheel = "Down"}
DpadLeft = {keys = ["KEY_M"]}
DpadRight = {keys = ["KEY_G"]}

[profiles.gestures.Select]
long_press = {mode = "Menus"}

[profiles.left_stick]
deadzone = 0.2
curve = 1.0
key_threshold = 0.45

[profiles.left_stick.action.ring]
sectors = 8
start_angle = 0.0
inner_radius = 0.45
hysteresis = 0.1

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_UP"]

[[profiles.left_stick.action.ring.actions]]
multi = [{ keys = ["KEY_UP"] }, { keys = ["KEY_RIGHT"] }]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_RIGHT"]

[[profiles.left_stick.action.ring.actions]]
multi = [{ keys = ["KEY_DOWN"] }, { keys = ["KEY_RIGHT"] }]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_DOWN"]

[[profiles.left_stick.action.ring.actions]]
multi = [{ keys = ["KEY_DOWN"] }, { keys = ["KEY_LEFT"] }]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_LEFT"]

[[profiles.left_stick.action.ring.actions]]
multi = [{ keys = ["KEY_UP"] }, { keys = ["KEY_LEFT"] }]

[profiles.right_stick]
deadzone = 0.1
curve = 1.6
key_threshold = 0.25

[profiles.right_stick.action.mouse]
speed = 1500.0
accel = 0.25

[profiles.left_trigger.action.button]
threshold = 0.4
action = { mouse = "Right" }

[profiles.right_trigger.action.button]
threshold = 0.3
action = { mouse = "Left" }

[profiles.gyro]
enabled = false
horizontal = "yaw"
invert_x = false
invert_y = false
noise_threshold = 1.0

[profiles.guide]
notes = '''The right stick {rs} moves the cursor: {rt} selects (left click, drag to box units), and {lt} gives the usual order for what's under it (right click: move, attack, assist, reclaim). The left stick {ls} pans the map, and {up} {down} zoom: zoom all the way out for the strategic view.
{south}, {west} and {north} order an attack, stop and patrol; for attack and patrol, click the target with {rt}. {left} orders a move and {right} assist (guard), also clicked with {rt}.
Hold {lb} for the control groups and aim the right stick {rs} at one: release to select it. Hold {lb} and {rb} together to put the selection in a group instead (Ctrl + number).
{rb} is Shift: hold it to queue orders and build orders, or add to the selection. Hold {l3} (Ctrl) while you click.
Click {r3} for the engineer and special orders (reclaim, repair, capture, ferry, dive, overcharge, self-destruct), aimed with the right stick {rs}. Build by clicking the construction menu at the bottom with {rt}.
{select} lists pause, chat and the menu. Hold {select} for the Menus mode (the lobby and the main menu) and hold it again to come back. {start} (Esc) is the menu, and {east} cancels an order or clears the selection.
The keys are the game's defaults as best remembered, not checked on an install: the order keys (A, S, P, M, G and the R3 orders), panning with the arrow keys and self-destruct (Ctrl + K) are the likeliest to differ. The game has no key settings: check the key bindings dialog (F1 in game) or your keymap file. Steam's game runs as SupremeCommander.exe, a name the original Supreme Commander shares, so the rule names its Steam folder; a GOG or disc install has another folder name, so pick the setup by hand there. ForgedAlliance.exe is Forged Alliance Forever's launcher-patched copy. Guide + {west} opens the on-screen keyboard for chat.'''

