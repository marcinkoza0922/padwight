format = 20
macros = []
overlay_font = "Kreon"

[pack]
id = "2fb62838-e337-41b0-8507-570f9b534702"
name = "Victoria 3"
version = "1.0"
author = "Padwight"
description = "Victoria 3 (Steam, Linux or Windows build) on an Xbox-style pad. The right stick moves the pointer, the left stick pans the map, RT or A left-clicks, LT right-clicks. Y pauses, the d-pad zooms and changes the speed (hold it for the slowest or fastest). Tap LB for the map list, hold RB for the speeds and the world overview. Select lists the politics, budget, buildings, trade, military, diplomacy, technology, culture, population and journal panels. Click L3 for politics, R3 for the journal. The \"+ Gyro\" profile also moves the pointer by tilting the controller."
made_with = "Xbox controller"

[[rules]]
kind = "executable"
value = "victoria3"
profile = "Victoria 3"

[[rules]]
kind = "executable"
value = "victoria3.exe"
profile = "Victoria 3"

[[rules]]
kind = "steam_app_id"
value = "529340"
profile = "Victoria 3"


[[profiles]]
name = "Victoria 3"
combos = []
combo_window_ms = 120
tap_window_ms = 250
long_press_ms = 500

[profiles.buttons]
Guide = { mode = "Guide" }
South = { mouse = "Left" }
East = { keys = ["KEY_ESC"] }
West = { keys = ["KEY_LEFTSHIFT"] }
North = { keys = ["KEY_SPACE"] }
LeftBumper = { keys = ["KEY_Q"] }
RightBumper = { open_menu = "Speeds and overview" }
Select = { open_menu = "Panels" }
Start = { keys = ["KEY_ESC"] }
LeftStick = { keys = ["KEY_F1"] }
RightStick = { keys = ["KEY_F10"] }
DpadUp = { wheel = "Up" }
DpadDown = { wheel = "Down" }
DpadLeft = { keys = ["KEY_KPMINUS"] }
DpadRight = { keys = ["KEY_KPPLUS"] }

[profiles.gestures.DpadLeft.long_press]
keys = ["KEY_1"]

[profiles.gestures.DpadRight.long_press]
keys = ["KEY_5"]

[profiles.left_stick]
deadzone = 0.2
curve = 1.0
key_threshold = 0.45

[profiles.left_stick.action.ring]
sectors = 8
start_angle = 0.0
inner_radius = 0.45
hysteresis = 0.1

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_UP"]

[[profiles.left_stick.action.ring.actions]]
multi = [{ keys = ["KEY_UP"] }, { keys = ["KEY_RIGHT"] }]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_RIGHT"]

[[profiles.left_stick.action.ring.actions]]
multi = [{ keys = ["KEY_DOWN"] }, { keys = ["KEY_RIGHT"] }]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_DOWN"]

[[profiles.left_stick.action.ring.actions]]
multi = [{ keys = ["KEY_DOWN"] }, { keys = ["KEY_LEFT"] }]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_LEFT"]

[[profiles.left_stick.action.ring.actions]]
multi = [{ keys = ["KEY_UP"] }, { keys = ["KEY_LEFT"] }]

[profiles.right_stick]
deadzone = 0.1
curve = 1.6
key_threshold = 0.25

[profiles.right_stick.action.mouse]
speed = 1500.0
accel = 0.25

[profiles.left_trigger.action.button]
threshold = 0.4
action = { mouse = "Right" }

[profiles.right_trigger.action.button]
threshold = 0.3
action = { mouse = "Left" }

[profiles.guide]
notes = '''The right stick {rs} moves the pointer: {rt} or {south} is a left click, {lt} a right click. The left stick {ls} pans the map.
{north} pauses and unpauses; the {leftright} d-pad slows the game down and speeds it up (hold it for the slowest or fastest), and {updown} zooms.
Hold {west} for Shift while you click, to queue or add more than one level of a building.
Tap {lb} for the map list (the lenses and map modes, picked with the pointer). Hold {rb} for the five speeds, pause, the world overview and the map list, aimed or moved through and picked with {south}.
{select} lists the panels: politics, budget, buildings, trade routes, military, diplomacy, technology, cultures, population and the journal (tap it, pick with {south}, {east} closes the list). {east} or {start} is Escape: it closes the open panel, and on the map opens the game menu.
Hold {guide} and press {west} for the on-screen keyboard (save names, searches).
Click {l3} for the politics panel (F1) and {r3} for the journal (F10). Victoria 3 has no controller support, so the controller works through these keys. It has no quick save: save from the game menu.
The keys are from a community list, not checked on an install: the F1 to F10 panels, Tab for the world overview, Q for the map list and the number keys for the speeds most of all. The left stick sends the arrow keys; if they don't pan, set them in Settings, Controls (WASD pans too). If a key does nothing, look there.'''

[profiles.guide.edits]
"stick:Right" = { text = "Pointer" }
"stick:Left" = { text = "Pan the map" }
"trigger:Right" = { text = "Left click (select)" }
"trigger:Left" = { text = "Right click (back, context)" }
"button:South" = { text = "Left click" }
"button:East" = { text = "Close panel" }
"button:West" = { text = "Hold: Shift (queue, add levels)" }
"button:North" = { text = "{icon:pause} Pause" }
"button:LeftBumper" = { text = "{icon:map} Map list" }
"button:RightBumper" = { text = "Hold: {icon:speed2} speeds and overview" }
"button:Select" = { text = "Panels" }
"button:Start" = { text = "Game menu" }
"button:LeftStick" = { text = "{icon:palace} Politics" }
"button:RightStick" = { text = "{icon:book} Journal" }
"gesture:button:DpadLeft:long_press" = { text = "{icon:speed1} Slowest" }
"gesture:button:DpadRight:long_press" = { text = "{icon:speed3} Fastest" }

[[profiles.guide.merged]]
inputs = ["button:DpadUp", "button:DpadDown"]
text = "Zoom in / out"

[[profiles.guide.merged]]
inputs = ["button:DpadLeft", "button:DpadRight"]
text = "{icon:speed1} Slower / faster {icon:speed3}"

