[motion]
keyboard = "dreamy"
numpad = "dreamy"
menu = "dreamy"
media = "dreamy"
offer = "dreamy"
info = "dreamy"
log = "dreamy"

[sounds.menu]
step = {kind = "piano", volume = 0.05, pitch = 1.5, length = 0.5}
pick = {kind = "chime", volume = 0.1, pitch = 1.2}
