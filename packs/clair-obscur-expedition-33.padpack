format = 20
macros = []
overlay_font = "Cinzel"

[pack]
id = "0eccd87b-fe7f-4d84-8f45-6f9eee505ce6"
name = "Clair Obscur: Expedition 33"
version = "1.0"
author = "Padwight"
description = "Clair Obscur: Expedition 33 on an Xbox-style pad. The game has its own controller support, so the controller passes through untouched and the game's Controls options set the buttons. Padwight adds the Guide overlay on top, with the media controls and the on-screen keyboard, in the gold and midnight of Belle Époque Lumière."
made_with = "Xbox controller"

[[rules]]
kind = "executable"
value = "SandFallGOG-Win64-Shipping.exe"
profile = "Expedition 33"

[[rules]]
kind = "executable"
value = "Sandfall-Win64-Shipping.exe"
profile = "Expedition 33"

[[rules]]
kind = "steam_app_id"
value = "1903340"
profile = "Expedition 33"

[[profiles]]
name = "Expedition 33"
combos = []
combo_window_ms = 120
tap_window_ms = 250
long_press_ms = 500

[profiles.buttons]
Guide = {mode = "Guide"}
South = {gamepad = "South"}
East = {gamepad = "East"}
North = {gamepad = "North"}
West = {gamepad = "West"}
LeftBumper = {gamepad = "LeftBumper"}
RightBumper = {gamepad = "RightBumper"}
LeftStick = {gamepad = "LeftStick"}
RightStick = {gamepad = "RightStick"}
Select = {gamepad = "Select"}
Start = {gamepad = "Start"}
DpadUp = {gamepad = "DpadUp"}
DpadDown = {gamepad = "DpadDown"}
DpadLeft = {gamepad = "DpadLeft"}
DpadRight = {gamepad = "DpadRight"}

[profiles.left_stick]
deadzone = 0.05
curve = 1.0
key_threshold = 0.3

[profiles.left_stick.action]
gamepad = {stick = "Left", invert_y = false}

[profiles.right_stick]
deadzone = 0.05
curve = 1.0
key_threshold = 0.3

[profiles.right_stick.action]
gamepad = {stick = "Right", invert_y = false}

[profiles.left_trigger]
action = {gamepad = "Left"}

[profiles.right_trigger]
action = {gamepad = "Right"}

[profiles.gyro]
mode = "off"
horizontal = "yaw"
invert_x = false
invert_y = false
noise_threshold = 1.0

[profiles.guide]
notes = '''Expedition 33 has its own controller support, so the controller goes to the game as it is. Set the buttons in the game's own Options → Controls.
{guide} still works over the game: {guide} + {west} opens the on-screen keyboard, and {guide} + {lb} the media controls.
If the game stops answering the pad, check that Steam Input or another remapper isn't also running for it.'''

[keyboard_style]
