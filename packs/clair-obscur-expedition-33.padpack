opacity = 0.95

[keyboard_style.selected]
color = "#d9b36a"
opacity = 1.0

[keyboard_style.border]
width = 1
color = "#c9a85a"
opacity = 0.8

[keyboard_style.gradient]
color = "#1a1020"
opacity = 1.0
angle = 180

[keyboard_style.item_border]
