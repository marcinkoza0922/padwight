format = 20
macros = []
overlay_font = "Cinzel"

[pack]
id = "cb688b1a-b01a-46f2-889b-fec87043b7dd"
name = "Manor Lords"
version = "1.0"
author = "Padwight"
description = "Manor Lords on an Xbox-style pad, for the default keys. The right stick moves the cursor, RT or A left-clicks, LT right-clicks (cancel, move troops), the left stick moves the camera. Hold X and move the right stick to rotate the camera. Y pauses, the d-pad zooms and changes the speed. LB and RB step through the building categories and dismiss or hire a worker. Select lists construction, roads, housing, recruitment, the army and the region map; R3 holds the troops' control groups (LB + RB sets one). L3 jumps back to town. The \"+ Gyro\" profile also moves the cursor by tilting the controller."
made_with = "Xbox controller"

[[rules]]
kind = "executable"
value = "ManorLords-Win64-Shipping.exe"
profile = "Manor Lords"

[[rules]]
kind = "steam_app_id"
value = "1363080"
profile = "Manor Lords"

[[profiles]]
name = "Manor Lords"
combos = [{buttons = ["LeftBumper", "RightBumper"], action = {open_menu = "Set group"}}]
combo_window_ms = 120
tap_window_ms = 250
long_press_ms = 500

[profiles.buttons]
Guide = { mode = "Guide" }
South = { mouse = "Left" }
East = { keys = ["KEY_ESC"] }
West = { mouse = "Middle" }
North = { keys = ["KEY_SPACE"] }
LeftBumper = { keys = ["KEY_Q"] }
RightBumper = { keys = ["KEY_E"] }
Select = { open_menu = "Build and govern" }
Start = { keys = ["KEY_ESC"] }
LeftStick = { keys = ["KEY_T"] }
RightStick = { open_menu = "Groups" }
DpadUp = { wheel = "Up" }
DpadDown = { wheel = "Down" }
DpadLeft = { keys = ["KEY_Z"] }
DpadRight = { keys = ["KEY_X"] }

[profiles.left_stick]
deadzone = 0.15
curve = 1.0
key_threshold = 0.35

[profiles.left_stick.action.ring]
sectors = 8
start_angle = 0.0
inner_radius = 0.35
hysteresis = 0.1

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_W"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_W"] },
    { keys = ["KEY_D"] },
]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_D"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_S"] },
    { keys = ["KEY_D"] },
]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_S"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_S"] },
    { keys = ["KEY_A"] },
]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_A"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_W"] },
    { keys = ["KEY_A"] },
]

[profiles.right_stick]
deadzone = 0.12
curve = 1.8
key_threshold = 0.5

[profiles.right_stick.action.mouse]
speed = 1500.0
accel = 0.3

[profiles.left_trigger.action.button]
threshold = 0.4
action = { mouse = "Right" }

[profiles.right_trigger.action.button]
threshold = 0.3
action = { mouse = "Left" }

[profiles.guide]
notes = '''The right stick {rs} moves the cursor: {rt} or {south} is a left click (select, place), and {lt} a right click (cancel a placement, move troops). The left stick {ls} moves the camera, and {updown} zooms.
Hold {west} (the middle mouse button) and move the right stick {rs} to rotate and tilt the camera. Click {l3} to jump back to town.
{north} pauses and unpauses; {left} slows time down and {right} speeds it up.
{lb} and {rb} step back and forward through the building categories, and on a building's window dismiss or hire a worker.
{select} lists construction, roads, burgage plots, recruitment, the army, the region map, the labels over buildings and the cinematic camera (tap it, pick with {south}, {east} closes the list).
Hold {r3} for the troops' control groups and aim the right stick {rs} at one: release to select it. Hold {lb} and {rb} together to put the selection in a group instead (Ctrl + number).
{start} (Esc) is the game menu; {east} closes windows. Manor Lords has no controller support of its own, so the controller works through these keys. They're the defaults as listed by third-party guides, not checked on an install: if one does nothing, look in Options, Control Settings. Hold {guide} and press {west} for the on-screen keyboard (naming the settlement, saves).'''

[profiles.guide.edits]
"stick:Right" = { text = "Cursor" }
"stick:Left" = { text = "Move the camera" }
"trigger:Right" = { text = "Left click (select, place)" }
"trigger:Left" = { text = "Right click (cancel, move troops)" }
"button:South" = { text = "Left click" }
"button:East" = { text = "Close window" }
"button:West" = { text = "Hold: rotate the camera" }
"button:North" = { text = "{icon:pause} Pause" }
"button:LeftBumper" = { text = "Previous category / dismiss worker" }
"button:RightBumper" = { text = "Next category / hire worker" }
"button:Select" = { text = "Build and govern" }
"button:Start" = { text = "Game menu" }
"button:LeftStick" = { text = "{icon:home} Back to town" }
"button:RightStick" = { text = "Hold: control groups" }

[[profiles.guide.merged]]
inputs = ["button:DpadUp", "button:DpadDown"]
text = "Zoom in / out"

[[profiles.guide.merged]]
inputs = ["button:DpadLeft", "button:DpadRight"]
text = "{icon:speed1} Slower / faster {icon:speed3}"

[[profiles.guide.custom]]
inputs = ["button:LeftBumper", "button:RightBumper"]
text = "Set a control group"

[[profiles]]
name = "Manor Lords + Gyro"
combos = [{buttons = ["LeftBumper", "RightBumper"], action = {open_menu = "Set group"}}, {buttons = ["Select", "Start"], action = "gyro_clutch"}]
combo_window_ms = 120
tap_window_ms = 250
long_press_ms = 500
requires = ["gyro"]

