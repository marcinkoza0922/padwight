"button:LeftStick" = { text = "{icon:home} Back to town" }
"button:RightStick" = { text = "Hold: control groups" }

[[profiles.guide.merged]]
inputs = ["button:DpadUp", "button:DpadDown"]
text = "Zoom in / out"

[[profiles.guide.merged]]
