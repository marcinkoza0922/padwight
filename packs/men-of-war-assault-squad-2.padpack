format = 20
macros = []
overlay_font = "Rajdhani"

[pack]
id = "8efa0306-1eee-4669-ac89-1e2039d7268a"
name = "Men of War: Assault Squad 2"
version = "1.0"
author = "Padwight"
description = "Men of War: Assault Squad 2 (Steam) on an Xbox-style pad, for the default keys. The game has no controller support. The right stick moves the cursor, RT left-clicks, LT right-clicks, the left stick scrolls the map, the d-pad zooms and rotates. LB is Ctrl, RB is Shift (queue orders). Select lists pause, select all and saving; Start is the game menu, double tap it to quick save, hold to quick load. The \"+ Gyro\" profile also moves the cursor by tilting the controller."
made_with = "Xbox controller"

[[rules]]
kind = "executable"
value = "mowas2.exe"
profile = "Men of War: Assault Squad 2"

[[rules]]
kind = "executable"
value = "mowas_2.exe"
profile = "Men of War: Assault Squad 2"

[[rules]]
kind = "steam_app_id"
value = "244450"
profile = "Men of War: Assault Squad 2"

[[rules]]
kind = "steam_app_id"
value = "271850"
profile = "Men of War: Assault Squad 2"

[[profiles]]
name = "Men of War: Assault Squad 2"
combos = []
combo_window_ms = 120
tap_window_ms = 250
long_press_ms = 500

[profiles.buttons]
Guide = {mode = "Guide"}
South = {mouse = "Left"}
East = {keys = ["KEY_SPACE"]}
West = {keys = ["KEY_TAB"]}
LeftBumper = {keys = ["KEY_LEFTCTRL"]}
RightBumper = {keys = ["KEY_LEFTSHIFT"]}
Select = {open_menu = "Orders"}
Start = {keys = ["KEY_ESC"]}
DpadUp = {wheel = "Up"}
DpadDown = {wheel = "Down"}
DpadLeft = {keys = ["KEY_Q"]}
DpadRight = {keys = ["KEY_E"]}

[profiles.gestures.Start]
double_tap = {keys = ["KEY_F5"]}
long_press = {keys = ["KEY_F9"]}

[profiles.left_stick]
deadzone = 0.2
curve = 1.0
key_threshold = 0.45

[profiles.left_stick.action.ring]
sectors = 8
start_angle = 0.0
inner_radius = 0.45
hysteresis = 0.1

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_W"]

[[profiles.left_stick.action.ring.actions]]
multi = [{ keys = ["KEY_W"] }, { keys = ["KEY_D"] }]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_D"]

[[profiles.left_stick.action.ring.actions]]
multi = [{ keys = ["KEY_S"] }, { keys = ["KEY_D"] }]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_S"]

[[profiles.left_stick.action.ring.actions]]
multi = [{ keys = ["KEY_S"] }, { keys = ["KEY_A"] }]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_A"]

[[profiles.left_stick.action.ring.actions]]
multi = [{ keys = ["KEY_W"] }, { keys = ["KEY_A"] }]

[profiles.right_stick]
deadzone = 0.1
curve = 1.6
key_threshold = 0.25

[profiles.right_stick.action.mouse]
speed = 1500.0
accel = 0.25

[profiles.left_trigger.action.button]
threshold = 0.4
action = { mouse = "Right" }

[profiles.right_trigger.action.button]
threshold = 0.3
action = { mouse = "Left" }

[profiles.gyro]
enabled = false
horizontal = "yaw"
invert_x = false
invert_y = false
noise_threshold = 1.0

[profiles.guide]
notes = '''{rt} left-clicks (select; hold to drag a box) and {lt} right-clicks (move, attack), with the right stick {rs} as the cursor. The left stick {ls} scrolls the map (WASD), {up} {down} zoom and {left} {right} rotate the camera.
{lb} is Ctrl and {rb} is Shift: hold {rb} to queue orders or add to the selection. {south} is a left click as well, {east} centers the camera on the selection (Space), {west} is Tab. {select} lists pause, select all and quick save and load; {start} is the game menu (Esc), double tap it to quick save and hold it to quick load.
The keys are the game's defaults as best known, not checked on an install: if one does nothing, look in Options, Controls and set it to the key in this setup. Assault Squad 2 has no controller support, so the pad plays the keyboard and mouse bindings.'''

[profiles.guide.edits]
"stick:Left" = { text = "Scroll the map" }
"stick:Right" = { text = "Cursor" }
"trigger:Right" = { text = "Left click (select, drag a box)" }
"trigger:Left" = { text = "Right click (move, attack)" }
"button:South" = { text = "Left click" }
"button:East" = { text = "Center on selection" }
"button:West" = { text = "Tab" }
"button:LeftBumper" = { text = "Ctrl (force fire, modify click)" }
"button:RightBumper" = { text = "Shift (queue orders)" }
"button:Select" = { text = "Orders list" }
"button:Start" = { text = "Game menu" }
"gesture:button:Start:double_tap" = { text = "{icon:save} Quick save" }
"gesture:button:Start:long_press" = { text = "{icon:load} Quick load" }

[[profiles.guide.merged]]
inputs = ["button:DpadUp", "button:DpadDown"]
text = "Zoom in / out"

[[profiles.guide.merged]]
inputs = ["button:DpadLeft", "button:DpadRight"]
text = "Rotate the camera"

[[profiles]]
name = "Men of War: Assault Squad 2 + Gyro"
combos = [{buttons = ["Select", "Start"], action = "gyro_clutch"}]
combo_window_ms = 120
tap_window_ms = 250
long_press_ms = 500
requires = ["gyro"]

[profiles.buttons]
