text = "Rotate the camera"

[[menus]]
name = "Orders"
kind = "list"

[[menus.items]]
label = "{icon:pause} Pause"
action = {keys = ["KEY_PAUSE"]}

[[menus.items]]
label = "{icon:people} Select all"
action = {keys = ["KEY_LEFTCTRL","KEY_A"]}

[[menus.items]]
label = "{icon:target} Center on selection"
action = {keys = ["KEY_SPACE"]}

[[menus.items]]
label = "{icon:save} {color:green}Quick save{/color}"
action = {keys = ["KEY_F5"]}

[[menus.items]]
label = "{icon:load} Quick load"
action = {keys = ["KEY_F9"]}

[[menus.items]]
label = "{icon:gear} Game menu"
action = {keys = ["KEY_ESC"]}

