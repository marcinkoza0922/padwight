format = 20
macros = []
overlay_font = "Titillium Web"

[pack]
id = "f527be7e-cdd9-44b6-b40b-db06415c5c95"
name = "Stellaris"
version = "1.0"
author = "Padwight"
description = "Stellaris (Steam, Linux or Windows build) on an Xbox-style pad. The right stick moves the pointer, the left stick pans the camera, RT or A left-clicks, LT right-clicks to send fleets. Y pauses (hold it to step one day), the d-pad zooms and changes the speed. Hold LB for the map modes, hold RB for the fleet orders. Select lists the screens on F1 to F10 and the outliner. Click R3 for the galaxy map, L3 for the home system. The \"+ Gyro\" profile also moves the pointer by tilting the controller."
made_with = "Xbox controller"

[[rules]]
kind = "executable"
value = "stellaris"
profile = "Stellaris"

[[rules]]
kind = "executable"
value = "stellaris.exe"
profile = "Stellaris"

[[rules]]
kind = "steam_app_id"
value = "281990"
profile = "Stellaris"

[[profiles]]
name = "Stellaris"
combos = []
combo_window_ms = 120
tap_window_ms = 250
long_press_ms = 500

[profiles.buttons]
Guide = { mode = "Guide" }
South = { mouse = "Left" }
East = { keys = ["KEY_ESC"] }
West = { keys = ["KEY_LEFTSHIFT"] }
North = { keys = ["KEY_SPACE"] }
LeftBumper = { open_menu = "Map modes" }
RightBumper = { open_menu = "Fleet orders" }
Select = { open_menu = "Screens" }
Start = { keys = ["KEY_ESC"] }
LeftStick = { keys = ["KEY_BACKSPACE"] }
RightStick = { keys = ["KEY_M"] }
DpadUp = { wheel = "Up" }
DpadDown = { wheel = "Down" }
DpadLeft = { keys = ["KEY_KPMINUS"] }
DpadRight = { keys = ["KEY_KPPLUS"] }

[profiles.gestures.North.long_press]
keys = ["KEY_DOT"]

[profiles.left_stick]
deadzone = 0.15
curve = 1.0
key_threshold = 0.35

[profiles.left_stick.action.ring]
sectors = 8
start_angle = 0.0
inner_radius = 0.35
hysteresis = 0.1

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_W"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_W"] },
    { keys = ["KEY_D"] },
]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_D"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_S"] },
    { keys = ["KEY_D"] },
]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_S"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_S"] },
    { keys = ["KEY_A"] },
]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_A"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_W"] },
    { keys = ["KEY_A"] },
]

[profiles.right_stick]
deadzone = 0.12
curve = 1.8
key_threshold = 0.5

[profiles.right_stick.action.mouse]
speed = 1500.0
accel = 0.3

[profiles.left_trigger.action.button]
threshold = 0.4
action = { mouse = "Right" }

[profiles.right_trigger.action.button]
threshold = 0.3
action = { mouse = "Left" }

[profiles.guide]
notes = '''The right stick {rs} moves the pointer: {rt} or {south} is a left click, {lt} a right click. The left stick {ls} pans the map.
{north} pauses and unpauses; the {leftright} d-pad slows the game down and speeds it up, and {updown} zooms.
Hold {west} for Shift while you click, to add to a selection or queue orders.
Hold {lb} for the map modes and {rb} for the fleet orders, aimed or moved through and picked with {south}.
{select} lists the screens (tap it, pick with {south}, {east} closes the list). {east} or {start} is Escape: it closes the open window, and on the map opens the game menu.
Hold {guide} and press {west} for the on-screen keyboard (save names, searches).
Hold {north} while paused to step one day. With a fleet selected, the {rb} orders act on it; hold {west} as you right-click with {lt} to queue a move.
Click {r3} to open or close the galaxy map and {l3} to go to the home system. The F1 to F10 screens follow the game's navigation menu, which you can rearrange in the game; the names in the {select} list are its usual order.
Stellaris has no controller support on PC, so the controller works through these keys. It has no quick save: save from the game menu.'''

[profiles.guide.edits]
"stick:Right" = { text = "Pointer" }
"stick:Left" = { text = "Pan the camera" }
"trigger:Right" = { text = "Left click (select)" }
"trigger:Left" = { text = "Right click (move, rotate)" }
"button:South" = { text = "Left click" }
"button:East" = { text = "Close window" }
"button:West" = { text = "Hold: Shift (add, queue)" }
"button:North" = { text = "{icon:pause} Pause" }
"button:LeftBumper" = { text = "Hold: {icon:map} map modes" }
"button:RightBumper" = { text = "Hold: fleet orders" }
"button:Select" = { text = "Screens" }
"button:Start" = { text = "Game menu" }
"button:LeftStick" = { text = "{icon:home} Home system" }
"button:RightStick" = { text = "{icon:map} Galaxy map" }
"gesture:button:North:long_press" = { text = "Next day (while paused)" }

[[profiles.guide.merged]]
inputs = ["button:DpadUp", "button:DpadDown"]
text = "Zoom in / out"

[[profiles.guide.merged]]
inputs = ["button:DpadLeft", "button:DpadRight"]
text = "{icon:speed1} Slower / faster {icon:speed3}"

