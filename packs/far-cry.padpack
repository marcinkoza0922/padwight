RightBumper = { keys = ["KEY_L"] }
LeftStick = { keys = ["KEY_C"] }
RightStick = { keys = ["KEY_B"] }
Select = { keys = ["KEY_TAB"] }
Start = { keys = ["KEY_ESC"] }
DpadUp = { wheel = "Up" }
DpadDown = { wheel = "Down" }
DpadLeft = { keys = ["KEY_Q"] }
DpadRight = { keys = ["KEY_E"] }

