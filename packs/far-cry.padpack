opacity = 0.92

[media_style.items]
color = "#18292a"
opacity = 0.95

[media_style.selected]
color = "#d39a35"
opacity = 1.0

[media_style.border]
width = 1
color = "#e0b04f"
opacity = 0.5

[media_style.gradient]
color = "#112120"
opacity = 1.0
angle = 180

[media_style.item_border]
width = 1
color = "#2c4644"

[media_style.type]
case = "upper"
letter_spacing = 2

[menu_style]
corners = 0.15
position = "center"
scale = 1.0

[menu_style.background]
color = "#0c1716"
opacity = 0.92

[menu_style.items]
color = "#18292a"
opacity = 0.95

[menu_style.selected]
color = "#d39a35"
opacity = 1.0

[menu_style.border]
width = 1
color = "#e0b04f"
opacity = 0.5

[menu_style.gradient]
color = "#112120"
opacity = 1.0
angle = 180

[menu_style.item_border]
width = 1
color = "#2c4644"

[menu_style.glow]
color = "#e0b04f"
opacity = 0.25
blur = 20

[menu_style.type]
case = "upper"
letter_spacing = 2

[menu_style.ornament]
frame = {kind = "brackets", size = 14, width = 2, color = "#e0b04f"}
vignette = {color = "#000000", opacity = 0.45, reach = 26}

[motion]
keyboard = "swift"
numpad = "swift"
menu = "swift"
media = "swift"
offer = "swift"
info = "swift"
log = "swift"

[sounds.menu]
step = {kind = "tick", volume = 0.08, pitch = 1.0}
pick = {kind = "casing", volume = 0.25}
open = {kind = "radio", volume = 0.08}
close = {kind = "swish", volume = 0.03, pitch = 1.2}

[sounds.guide]
open = {kind = "radio", volume = 0.08}

[sounds.keyboard]
step = {kind = "tick", volume = 0.08, pitch = 1.0}
pick = {kind = "keys", volume = 0.2}

[sounds.numpad]
step = {kind = "tick", volume = 0.08, pitch = 1.0}
pick = {kind = "beep", volume = 0.15, pitch = 1.0}

[rumble.menu]
step = {strength = 0.1, length_ms = 16}
pick = {strength = 0.4, length_ms = 35}

[rumble.keyboard]
step = {strength = 0.08, length_ms = 12}
pick = {strength = 0.3, length_ms = 22}

[rumble.numpad]
step = {strength = 0.08, length_ms = 12}
pick = {strength = 0.3, length_ms = 22}

[rumble.media]
pick = {strength = 0.3, length_ms = 25}

[rumble.guide]
mode = {strength = 0.3, length_ms = 60}
