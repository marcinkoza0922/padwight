format = 20
macros = []
overlay_font = "Titillium Web"

[pack]
id = "f9a42a99-8385-4065-924c-02c25991faa1"
name = "Far Cry"
version = "1.0"
author = "Padwight"
description = "Far Cry (2004) on an Xbox-style pad, for the game's default keys. A uses and, held, sprints, B jumps, X reloads (hold it for fire mode), Y throws a grenade (hold it for the next grenade type), RT fires and LT zooms. L3 crouches (hold it to go prone), R3 is the binoculars, RB the flashlight. Hold LB for the weapon ring, the D-pad leans and steps through weapons, and Start is the menu; double tap it to quick save, hold it to quick load, once the game has those keys. The game has no controller support. Gyro and flick stick profiles are included to try."
made_with = "Xbox controller"

[[rules]]
kind = "steam_app_id"
value = "13520"
profile = "Far Cry"

[[rules]]
kind = "executable"
value = "FarCry.exe"
profile = "Far Cry"

[[profiles]]
name = "Far Cry"
combos = []
combo_window_ms = 120
tap_window_ms = 250
long_press_ms = 300

[profiles.buttons]
Guide = { mode = "Guide" }
South = { keys = ["KEY_F"] }
East = { keys = ["KEY_SPACE"] }
West = { keys = ["KEY_R"] }
North = { keys = ["KEY_G"] }
