[sounds.menu]
step = {kind = "click", volume = 0.07, pitch = 1.0}
pick = {kind = "confirm", volume = 0.12, pitch = 1.0}

[sounds.keyboard]
step = {kind = "click", volume = 0.06, pitch = 1.1}
pick = {kind = "keys", volume = 0.1}

[sounds.numpad]
step = {kind = "click", volume = 0.06, pitch = 1.1}
pick = {kind = "keys", volume = 0.1}

[sounds.media]
pick = {kind = "pop", volume = 0.12, pitch = 1.0}

[rumble.menu]
