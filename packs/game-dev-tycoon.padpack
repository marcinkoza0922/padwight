format = 20
macros = []
overlay_font = "Titillium Web"

[pack]
id = "c41e8b93-27d5-4f0a-b6e2-91a7d3f05c28"
name = "Game Dev Tycoon"
version = "1.0"
author = "Padwight"
description = "Game Dev Tycoon on an Xbox-style pad. The game takes only the mouse, so the right stick moves the pointer and the left stick nudges it; A or RT clicks and holds to drag the development sliders, Y opens the on-screen keyboard to name your games. The D-pad scrolls. Start is the menu. Overlays in the game's light office panels with an orange highlight. The \"Game Dev Tycoon + Gyro\" profile also moves the pointer by tilting the controller."
made_with = "Xbox controller"

[[rules]]
kind = "steam_app_id"
value = "239820"
profile = "Game Dev Tycoon"

[[rules]]
kind = "executable"
value = "Game Dev Tycoon/nw.exe"
profile = "Game Dev Tycoon"

[[profiles]]
name = "Game Dev Tycoon"
combos = []
combo_window_ms = 120
tap_window_ms = 250
long_press_ms = 500

[profiles.buttons]
Guide = {mode = "Guide"}
South = {mouse = "Left"}
East = {mouse = "Right"}
North = "toggle_overlay"
Start = {keys = ["KEY_ESC"]}
DpadUp = {wheel = "Up"}
DpadDown = {wheel = "Down"}

[profiles.left_stick]
deadzone = 0.12
curve = 1.6
key_threshold = 0.5

[profiles.left_stick.action.mouse]
speed = 500.0
accel = 0.0

[profiles.right_stick]
deadzone = 0.12
curve = 1.7
key_threshold = 0.5

[profiles.right_stick.action.mouse]
speed = 1300.0
accel = 0.3

[profiles.left_trigger.action.button]
threshold = 0.4
action = {mouse = "Right"}

[profiles.right_trigger.action.button]
threshold = 0.3
action = {mouse = "Left"}

[profiles.gyro]
enabled = false
horizontal = "yaw"
invert_x = false
invert_y = false
noise_threshold = 1.0

[profiles.guide]
notes = '''The game is played with the mouse alone. The right stick {rs} moves the pointer and the left stick {ls} moves it slowly. Click the office floor or your desk to open the action menu (Develop New Game, Research, Train).
{south} or {rt} clicks; hold either and move the pointer to drag the development focus sliders, then let go.
{north} opens the on-screen keyboard to type the name of a game or a company, the same keyboard as {guide} + {west}. {up} and {down} scroll lists such as topics and reviews.
{start} sends Escape, which should close a dialog or open the menu; that is a guess. {east} and {lt} right-click, which the game hardly uses.
The game has no key settings. Its Windows executable is NW.js's generic nw.exe, which other games share, so the executable rule names the install folder too (Game Dev Tycoon/nw.exe); a copy installed under another folder name is found only through Steam.'''

[profiles.guide.edits]
"stick:Left" = {text = "Fine pointer"}
"stick:Right" = {text = "Pointer"}
"trigger:Right" = {text = "{icon:hand} {b}Click{/b} · hold to drag"}
"trigger:Left" = {text = "Right-click"}
"button:South" = {text = "Click · hold to drag"}
"button:East" = {text = "Right-click"}
"button:North" = {text = "{b}Keyboard{/b} (name a game)"}
"button:Start" = {text = "{icon:pause} Menu"}

[[profiles.guide.merged]]
inputs = ["button:DpadUp", "button:DpadDown"]
text = "Scroll"

[[profiles]]
name = "Game Dev Tycoon + Gyro"
combos = [
    {buttons = ["Select", "Start"], action = "gyro_clutch"},
]
combo_window_ms = 120
tap_window_ms = 250
long_press_ms = 500
requires = ["gyro"]

[profiles.buttons]
Guide = {mode = "Guide"}
South = {mouse = "Left"}
East = {mouse = "Right"}
North = "toggle_overlay"
Start = {keys = ["KEY_ESC"]}
DpadUp = {wheel = "Up"}
DpadDown = {wheel = "Down"}

[profiles.left_stick]
deadzone = 0.12
curve = 1.6
key_threshold = 0.5

[profiles.left_stick.action.mouse]
speed = 500.0
accel = 0.0

[profiles.right_stick]
deadzone = 0.12
curve = 1.7
key_threshold = 0.5

[profiles.right_stick.action.mouse]
speed = 1300.0
accel = 0.3

[profiles.left_trigger.action.button]
threshold = 0.4
action = {mouse = "Right"}

[profiles.right_trigger.action.button]
threshold = 0.3
action = {mouse = "Left"}

[profiles.gyro]
horizontal = "yaw"
invert_x = false
invert_y = false
noise_threshold = 1.0

[profiles.gyro.mode.mouse]
sensitivity = 20.0

[profiles.guide]
notes = '''Hold {select} and {start} together to pause the gyro while you reposition the controller. Tilting the controller moves the pointer, as a fine pointer next to the right stick {rs}.
The game is played with the mouse alone. The right stick {rs} moves the pointer and the left stick {ls} moves it slowly. Click the office floor or your desk to open the action menu (Develop New Game, Research, Train).
{south} or {rt} clicks; hold either and move the pointer to drag the development focus sliders, then let go.
{north} opens the on-screen keyboard to type the name of a game or a company, the same keyboard as {guide} + {west}. {up} and {down} scroll lists such as topics and reviews.
{start} sends Escape, which should close a dialog or open the menu; that is a guess. {east} and {lt} right-click, which the game hardly uses.
The game has no key settings. Its Windows executable is NW.js's generic nw.exe, which other games share, so the executable rule names the install folder too (Game Dev Tycoon/nw.exe); a copy installed under another folder name is found only through Steam.'''

[profiles.guide.edits]
"stick:Left" = {text = "Fine pointer"}
"stick:Right" = {text = "Pointer"}
"trigger:Right" = {text = "{icon:hand} {b}Click{/b} · hold to drag"}
"trigger:Left" = {text = "Right-click"}
"button:South" = {text = "Click · hold to drag"}
"button:East" = {text = "Right-click"}
"button:North" = {text = "{b}Keyboard{/b} (name a game)"}
"button:Start" = {text = "{icon:pause} Menu"}
"combo:button:Select+button:Start" = {text = "Pause gyro (hold)"}

[[profiles.guide.merged]]
inputs = ["button:DpadUp", "button:DpadDown"]
text = "Scroll"

