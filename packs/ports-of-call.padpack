[motion]
keyboard = "stagger"
numpad = "stagger"
menu = "stagger"
media = "stagger"
offer = "stagger"
info = "stagger"
log = "stagger"

[sounds.menu]
step = {kind = "wood", volume = 0.07}
pick = {kind = "page", volume = 0.09}
open = {kind = "page", volume = 0.07}
close = {kind = "wood", volume = 0.06, pitch = 0.8}

[sounds.numpad]
