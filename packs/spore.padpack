format = 20
macros = []
overlay_font = "Comfortaa"

[pack]
id = "bc84a015-6038-4108-a7d7-26381ead0a51"
name = "Spore"
version = "1.0"
author = "Padwight"
description = "Spore on an Xbox-style pad, one scheme for every stage and editor, on the game's mouse and keyboard controls. The left stick moves, the right stick moves the pointer, RT or A clicks and LT right-clicks. B jumps, hold Y to turn the camera and the d-pad zooms, undoes and redoes. Hold RB for the 1 to 0 abilities and tools. Overlays in deep space blue with a cyan pick and a green glow."
made_with = "Xbox controller"

[[rules]]
kind = "steam_app_id"
value = "17390"
profile = "Spore"

[[rules]]
kind = "steam_app_id"
value = "17440"
profile = "Spore"

[[rules]]
kind = "steam_app_id"
value = "24720"
profile = "Spore"

[[rules]]
kind = "executable"
value = "SporeApp.exe"
profile = "Spore"

[[profiles]]
name = "Spore"
combos = []
combo_window_ms = 120
tap_window_ms = 250
long_press_ms = 500

[profiles.buttons]
Guide = { mode = "Guide" }
South = { mouse = "Left" }
East = { keys = ["KEY_SPACE"] }
West = { keys = ["KEY_DELETE"] }
North = { mouse = "Middle" }
RightBumper = { open_menu = "Abilities" }
Start = { keys = ["KEY_ESC"] }
DpadUp = { wheel = "Up" }
DpadDown = { wheel = "Down" }
DpadLeft = { keys = ["KEY_LEFTCTRL", "KEY_Z"] }
DpadRight = { keys = ["KEY_LEFTCTRL", "KEY_Y"] }

[profiles.left_stick]
deadzone = 0.15
curve = 1.0
key_threshold = 0.35

[profiles.left_stick.action.ring]
sectors = 8
start_angle = 0.0
inner_radius = 0.35
hysteresis = 0.1

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_W"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_W"] },
    { keys = ["KEY_D"] },
]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_D"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_S"] },
    { keys = ["KEY_D"] },
]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_S"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_S"] },
    { keys = ["KEY_A"] },
]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_A"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_W"] },
    { keys = ["KEY_A"] },
]

[profiles.right_stick]
deadzone = 0.12
curve = 1.8
key_threshold = 0.5

[profiles.right_stick.action.mouse]
speed = 1400.0
accel = 0.3

[profiles.left_trigger.action.button]
threshold = 0.4
action = { mouse = "Right" }

[profiles.right_trigger.action.button]
threshold = 0.3
action = { mouse = "Left" }

[profiles.gyro]
enabled = false
horizontal = "yaw"
invert_x = false
invert_y = false
noise_threshold = 1.0

[profiles.guide]
notes = '''The game has no controller support, so this plays it with the mouse and keys, one scheme for every stage and editor. The right stick {rs} moves the pointer and the left stick {ls} swims, walks or flies (W A S D). {rt} or {south} clicks: move there, eat, attack, socialize, pick a part; {lt} right-clicks, and in the editors holding it and moving the pointer turns the creature.
{east} jumps (Space). Hold {north} (the middle button) and move the pointer to turn the camera; {up} and {down} zoom. Hold {rb} and point the right stick {rs} for the 1 to 0 keys: abilities in the creature and tribal stages, tools in space.
In the editors {left} undoes and {right} redoes, {west} {color:red}deletes{/color} the part in hand. {start} is the menu and backs out. Naming a creature or a planet: {guide} + {west} opens the on-screen keyboard.
Spore can't remap its keys, and these are its remembered defaults, not checked on an install: Space for jump, the middle button for the camera and Delete in the editors most of all.'''

[profiles.guide.edits]
"stick:Left" = { text = "Move (W A S D)" }
"stick:Right" = { text = "Pointer" }
"trigger:Right" = { text = "Click" }
"trigger:Left" = { text = "Right click" }
"button:South" = { text = "Click" }
"button:East" = { text = "Jump" }
"button:West" = { text = "{icon:trash} {color:red}Delete part{/color}" }
"button:North" = { text = "Hold: {icon:rotate} turn the camera" }
"button:RightBumper" = { text = "Hold: {icon:star} abilities 1 to 0" }
"button:Start" = { text = "Menu / back out" }
"button:DpadUp" = { text = "Zoom in" }
"button:DpadDown" = { text = "Zoom out" }
"button:DpadLeft" = { text = "{icon:rotate-left} Undo" }
"button:DpadRight" = { text = "{icon:rotate} Redo" }

