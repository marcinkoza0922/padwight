format = 20
macros = []
overlay_font = "Titillium Web"

[pack]
id = "0e754d85-e547-453c-8024-ea6f8e082e3b"
name = "Portal"
version = "1.0"
author = "Padwight"
description = "Portal (2007) on an Xbox-style pad. The game has its own controller support (the 2022 update added a full gamepad interface, also for DualShock 4 and DualSense), so the controller passes through untouched and the game's Controller options set the buttons. Padwight adds the Guide overlay on top, in the orange and blue of the portals, with the on-screen keyboard and the media controls. Gyro and flick stick profiles are included to try; they move the mouse beside the pad."
made_with = "Xbox controller"

[controllers]
dualshock = true
dualsense = true

[[rules]]
kind = "steam_app_id"
value = "400"
profile = "Portal"

[[rules]]
kind = "executable"
value = "portal/hl2.exe"
profile = "Portal"

[[rules]]
kind = "executable"
value = "hl2p.exe"
profile = "Portal"

[[profiles]]
name = "Portal"
combos = []
combo_window_ms = 120
tap_window_ms = 250
long_press_ms = 500

[profiles.buttons]
Guide = {mode = "Guide"}
South = {gamepad = "South"}
East = {gamepad = "East"}
North = {gamepad = "North"}
West = {gamepad = "West"}
LeftBumper = {gamepad = "LeftBumper"}
RightBumper = {gamepad = "RightBumper"}
LeftStick = {gamepad = "LeftStick"}
RightStick = {gamepad = "RightStick"}
Select = {gamepad = "Select"}
Start = {gamepad = "Start"}
DpadUp = {gamepad = "DpadUp"}
DpadDown = {gamepad = "DpadDown"}
DpadLeft = {gamepad = "DpadLeft"}
DpadRight = {gamepad = "DpadRight"}

[profiles.left_stick]
deadzone = 0.05
curve = 1.0
key_threshold = 0.3

[profiles.left_stick.action]
gamepad = {stick = "Left", invert_y = false}

[profiles.right_stick]
deadzone = 0.05
curve = 1.0
key_threshold = 0.3

[profiles.right_stick.action]
gamepad = {stick = "Right", invert_y = false}

[profiles.left_trigger]
action = {gamepad = "Left"}

[profiles.right_trigger]
action = {gamepad = "Right"}

[profiles.gyro]
enabled = false
horizontal = "yaw"
invert_x = false
invert_y = false
noise_threshold = 1.0

[profiles.guide]
notes = '''Portal has its own controller support, so the controller goes to the game as it is. Set the buttons, sensitivity and look inversion in the game's {b}Options → Controller{/b}. The gamepad interface comes with the 2022 update: if the menus only answer the mouse, add {b}-gamepadui{/b} to the game's launch options in Steam.
{guide} still works over the game: {guide} + {west} opens the on-screen keyboard and {guide} + {lb} the media controls.
If the game stops answering the pad, check that Steam Input or another remapper isn't also running for it.'''

[[profiles]]
name = "Portal + Gyro"
combos = [{buttons = ["Select", "Start"], action = "gyro_clutch"}]
combo_window_ms = 120
tap_window_ms = 250
long_press_ms = 500

[profiles.buttons]
Guide = {mode = "Guide"}
South = {gamepad = "South"}
East = {gamepad = "East"}
North = {gamepad = "North"}
West = {gamepad = "West"}
LeftBumper = {gamepad = "LeftBumper"}
RightBumper = {gamepad = "RightBumper"}
LeftStick = {gamepad = "LeftStick"}
RightStick = {gamepad = "RightStick"}
Select = {gamepad = "Select"}
Start = {gamepad = "Start"}
DpadUp = {gamepad = "DpadUp"}
DpadDown = {gamepad = "DpadDown"}
DpadLeft = {gamepad = "DpadLeft"}
DpadRight = {gamepad = "DpadRight"}

[profiles.left_stick]
deadzone = 0.05
curve = 1.0
key_threshold = 0.3

[profiles.left_stick.action]
gamepad = {stick = "Left", invert_y = false}

[profiles.right_stick]
deadzone = 0.05
curve = 1.0
key_threshold = 0.3

[profiles.right_stick.action]
gamepad = {stick = "Right", invert_y = false}

[profiles.left_trigger]
action = {gamepad = "Left"}

[profiles.right_trigger]
action = {gamepad = "Right"}

[profiles.gyro]
horizontal = "player_space"
invert_x = false
invert_y = false
full_turn_px = 5455.0
noise_threshold = 1.0

[profiles.gyro.mode.mouse]
sensitivity = 1.0

[profiles.guide]
notes = '''Hold {select} and {start} together to pause the gyro while you reposition the controller. The gyro moves the mouse, which the game reads beside the pad.
Portal has its own controller support, so the controller goes to the game as it is. Set the buttons, sensitivity and look inversion in the game's {b}Options → Controller{/b}. The gamepad interface comes with the 2022 update: if the menus only answer the mouse, add {b}-gamepadui{/b} to the game's launch options in Steam.
{guide} still works over the game: {guide} + {west} opens the on-screen keyboard and {guide} + {lb} the media controls.
If the game stops answering the pad, check that Steam Input or another remapper isn't also running for it.'''

[[profiles]]
name = "Portal + Flick stick"
combos = [{buttons = ["Select", "Start"], action = "gyro_clutch"}]
combo_window_ms = 120
tap_window_ms = 250
long_press_ms = 500
requires = ["gyro"]

[profiles.buttons]
Guide = {mode = "Guide"}
South = {gamepad = "South"}
East = {gamepad = "East"}
North = {gamepad = "North"}
West = {gamepad = "West"}
LeftBumper = {gamepad = "LeftBumper"}
RightBumper = {gamepad = "RightBumper"}
LeftStick = {gamepad = "LeftStick"}
RightStick = {gamepad = "RightStick"}
Select = {gamepad = "Select"}
Start = {gamepad = "Start"}
DpadUp = {gamepad = "DpadUp"}
DpadDown = {gamepad = "DpadDown"}
DpadLeft = {gamepad = "DpadLeft"}
DpadRight = {gamepad = "DpadRight"}

[profiles.left_stick]
deadzone = 0.05
curve = 1.0
key_threshold = 0.3

[profiles.left_stick.action]
gamepad = {stick = "Left", invert_y = false}

[profiles.right_stick]
deadzone = 0.1
curve = 2.0
key_threshold = 0.5

[profiles.right_stick.action.flick]
full_turn_px = 5455.0
flick_threshold = 0.9
flick_time_ms = 100
rotate_smoothing_ms = 0
forward_deadzone = 0.0
vertical = "off"
vertical_speed = 1200.0

[profiles.left_trigger]
action = {gamepad = "Left"}

[profiles.right_trigger]
action = {gamepad = "Right"}

[profiles.gyro]
horizontal = "player_space"
invert_x = false
invert_y = false
full_turn_px = 5455.0
noise_threshold = 1.0

[profiles.gyro.mode.mouse]
sensitivity = 1.0

[profiles.guide]
notes = '''Hold {select} and {start} together to pause the gyro while you reposition the controller. Flick stick: push the right stick {rs} toward where you want to face and the view turns to it; the gyro does the fine aiming. Both move the mouse, which the game reads beside the pad.
Portal has its own controller support, so the controller goes to the game as it is. Set the buttons, sensitivity and look inversion in the game's {b}Options → Controller{/b}. The gamepad interface comes with the 2022 update: if the menus only answer the mouse, add {b}-gamepadui{/b} to the game's launch options in Steam.
{guide} still works over the game: {guide} + {west} opens the on-screen keyboard and {guide} + {lb} the media controls.
If the game stops answering the pad, check that Steam Input or another remapper isn't also running for it.'''

