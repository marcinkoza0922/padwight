format = 20
macros = []
overlay_font = "Rajdhani"

[pack]
id = "887cc5f9-70f3-4802-b40f-53fc3713aa42"
name = "Call of Duty: Modern Warfare 2"
version = "1.0"
author = "Padwight"
description = "Call of Duty: Modern Warfare 2 (2009) on an Xbox-style pad, laid out like the Xbox 360 release, for the PC game's default keys. A jumps, B crouches (hold it to go prone), X reloads and, held, uses, Y switches weapons, RT fires and LT aims down the sights. LB and RB throw the tactical and lethal grenades, L3 sprints and holds your breath, R3 is melee. The D-pad has night vision, the attachment, killstreaks and equipment, and Select holds the scoreboard. The game has no controller support. Gyro and flick stick profiles are included to try."
made_with = "Xbox controller"

[[rules]]
kind = "steam_app_id"
value = "10180"
profile = "Call of Duty: Modern Warfare 2"

[[rules]]
kind = "steam_app_id"
value = "10190"
profile = "Call of Duty: Modern Warfare 2"

