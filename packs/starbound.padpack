format = 20
macros = []
overlay_font = "VT323"

[pack]
id = "2907052e-c2a9-4798-bb2f-3de8df665db2"
name = "Starbound"
version = "1.0"
author = "Padwight"
description = "Starbound on an Xbox-style pad, for the game's default keys. The left stick moves (a light push walks), the right stick moves the cursor you aim and mine with, RT and LT use the two hands. A jumps, X interacts, B uses the head tech, Y opens the inventory, RB the inspection mode. Hold LB for the hotbar; the D-pad steps through it and opens crafting and the quest log. Select lists the screens, codex and chat. The \"Starbound + Gyro\" profile also moves the cursor by tilting the controller."
made_with = "Xbox controller"

[[rules]]
kind = "executable"
value = "starbound.exe"
profile = "Starbound"

[[rules]]
kind = "executable"
value = "starbound_opengl.exe"
profile = "Starbound"

[[rules]]
kind = "executable"
value = "starbound"
profile = "Starbound"

[[rules]]
kind = "steam_app_id"
value = "211820"
profile = "Starbound"

[[profiles]]
name = "Starbound"
combos = []
combo_window_ms = 120
tap_window_ms = 250
long_press_ms = 500

[profiles.buttons]
South = { keys = ["KEY_SPACE"] }
East = { keys = ["KEY_F"] }
West = { keys = ["KEY_E"] }
North = { keys = ["KEY_I"] }
LeftBumper = { open_menu = "Hotbar" }
RightBumper = { keys = ["KEY_N"] }
Select = { open_menu = "Screens" }
Start = { keys = ["KEY_ESC"] }
Guide = { mode = "Guide" }
DpadUp = { keys = ["KEY_C"] }
DpadDown = { keys = ["KEY_J"] }
DpadLeft = { wheel = "Up" }
DpadRight = { wheel = "Down" }

[profiles.left_stick]
deadzone = 0.15
curve = 1.0
key_threshold = 0.3

[profiles.left_stick.action.ring]
sectors = 8
start_angle = 0.0
inner_radius = 0.3
hysteresis = 0.1

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_W"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_W"] },
    { keys = ["KEY_D"] },
]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_D"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_S"] },
    { keys = ["KEY_D"] },
]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_S"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_S"] },
    { keys = ["KEY_A"] },
]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_A"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_W"] },
    { keys = ["KEY_A"] },
]

[[profiles.left_stick.zones]]
min = 0.0
max = 0.6
action = { keys = ["KEY_LEFTSHIFT"] }

[profiles.right_stick]
deadzone = 0.12
curve = 1.8
key_threshold = 0.5

[profiles.right_stick.action.mouse]
speed = 1600.0
accel = 0.3

[profiles.left_trigger.action.button]
threshold = 0.3
action = { mouse = "Right" }

[profiles.right_trigger.action.button]
threshold = 0.3
action = { mouse = "Left" }

[profiles.gyro]
mode = "off"
horizontal = "yaw"
invert_x = false
invert_y = false
noise_threshold = 1.0

[profiles.guide]
notes = '''The right stick {rs} moves the cursor, which is where you aim, mine and place. {rt} uses the item in your primary hand and {lt} the one in the other hand (or a two-handed weapon's special).
{ls} moves, climbs ladders and drops through platforms; a light push walks, so you don't run off ledges.
{south} jumps, {west} interacts (doors, chests, the ship's teleporter and navigation), {east} uses the head tech.
Hold {lb} for the hotbar and pick a slot with the right stick {rs}; {left} and {right} step through it.
{north} opens the inventory, {up} crafting, {down} the quest log and {rb} the inspection mode. {select} lists them all, with the codex and chat.
Chat and naming need typing: {guide} + {west} opens the on-screen keyboard.
The tech, inspection, codex and quest keys are inferred from the game's defaults; if one doesn't answer, check Options → Controls.'''

[profiles.guide.edits]
"stick:Left" = { text = "Move · light push walks" }
"stick:Right" = { text = "Cursor / aim" }
"trigger:Right" = { text = "{icon:pick} Primary hand" }
"trigger:Left" = { text = "Alt hand" }
"button:South" = { text = "Jump" }
"button:East" = { text = "{icon:bolt} Tech" }
"button:West" = { text = "{icon:hand} Interact" }
"button:North" = { text = "{icon:bag} Inventory" }
"button:LeftBumper" = { text = "Hold: hotbar" }
"button:RightBumper" = { text = "{icon:search} Inspect mode" }
"button:DpadUp" = { text = "{icon:hammer} Crafting" }
"button:DpadDown" = { text = "{icon:scroll} Quest log" }
"button:Select" = { text = "{icon:book} Codex, chat, screens" }
"button:Start" = { text = "Menu" }

[[profiles.guide.merged]]
inputs = ["button:DpadLeft", "button:DpadRight"]
text = "Previous / next hotbar slot"

