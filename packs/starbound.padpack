[profiles.guide]
notes = '''Tilting the controller moves the cursor, as a fine pointer next to the right stick {rs}. Hold {select} and {start} together to pause the gyro while you reposition the controller.
The right stick {rs} moves the cursor, which is where you aim, mine and place. {rt} uses the item in your primary hand and {lt} the one in the other hand (or a two-handed weapon's special).
{ls} moves, climbs ladders and drops through platforms; a light push walks, so you don't run off ledges.
{south} jumps, {west} interacts (doors, chests, the ship's teleporter and navigation), {east} uses the head tech.
Hold {lb} for the hotbar and pick a slot with the right stick {rs}; {left} and {right} step through it.
{north} opens the inventory, {up} crafting, {down} the quest log and {rb} the inspection mode. {select} lists them all, with the codex and chat.
Chat and naming need typing: {guide} + {west} opens the on-screen keyboard.
The tech, inspection, codex and quest keys are inferred from the game's defaults; if one doesn't answer, check Options → Controls.'''

[profiles.guide.edits]
"stick:Left" = { text = "Move · light push walks" }
"stick:Right" = { text = "Cursor / aim" }
