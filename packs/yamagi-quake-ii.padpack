format = 20
macros = []
overlay_font = "Rajdhani"

[pack]
id = "a9442761-ddfa-4c35-9480-7b7f973032f0"
name = "Yamagi Quake II"
version = "1.0"
author = "Padwight"
description = "Yamagi Quake II, the faithful Quake II source port, on an Xbox-style pad, for Quake II's classic keys. The left stick moves, A jumps, RT fires, LT runs, L3 toggles crouch, and the d-pad scrolls and uses inventory items. Hold LB for the weapon ring, aiming with the right stick, RB cycles to the next weapon and Y to the previous. Start is the menu; double tap it to quick save, hold it to quick load. Gyro and flick stick profiles are included to try."
made_with = "Xbox controller"

[[rules]]
kind = "executable"
value = "yquake2.exe"
profile = "Yamagi Quake II"

[[rules]]
kind = "executable"
value = "yquake2"
profile = "Yamagi Quake II"

[[profiles]]
name = "Yamagi Quake II"
combos = []
combo_window_ms = 120
tap_window_ms = 250
long_press_ms = 500

[profiles.buttons]
Guide = { mode = "Guide" }
South = { keys = ["KEY_SPACE"] }
East = { keys = ["KEY_9"] }
West = { keys = ["KEY_3"] }
North = { wheel = "Down" }
LeftBumper = { open_menu = "Weapons" }
RightBumper = { wheel = "Up" }
Select = { keys = ["KEY_TAB"] }
Start = { keys = ["KEY_ESC"] }
LeftStick = { toggle = { action = { keys = ["KEY_C"] } } }
RightStick = { keys = ["KEY_ENTER"] }
DpadUp = { keys = ["KEY_UP"] }
DpadDown = { keys = ["KEY_DOWN"] }
DpadLeft = { keys = ["KEY_LEFTBRACE"] }
DpadRight = { keys = ["KEY_RIGHTBRACE"] }
[profiles.gestures.Start.double_tap]
keys = ["KEY_F6"]

[profiles.gestures.Start.long_press]
keys = ["KEY_F9"]

[profiles.gestures.Select.long_press]
keys = ["KEY_F1"]

[profiles.left_stick]
deadzone = 0.12
curve = 1.0
key_threshold = 0.25

[profiles.left_stick.action.ring]
sectors = 8
start_angle = 0.0
inner_radius = 0.25
hysteresis = 0.1

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_W"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_W"] },
    { keys = ["KEY_D"] },
]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_D"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_S"] },
    { keys = ["KEY_D"] },
]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_S"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_S"] },
    { keys = ["KEY_A"] },
]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_A"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_W"] },
    { keys = ["KEY_A"] },
]

[profiles.right_stick]
deadzone = 0.1
curve = 1.8
key_threshold = 0.5

[profiles.right_stick.action.mouse]
speed = 1100.0
accel = 0.2

[profiles.left_trigger.action.button]
threshold = 0.4
action = { keys = ["KEY_LEFTSHIFT"] }

[profiles.right_trigger.action.button]
threshold = 0.3
action = { mouse = "Left" }

[profiles.guide]
notes = '''{start} (Escape) opens the game's menu and backs out of every screen in it. In the menu the d-pad {dpad} up and down move the cursor and {r3} (Enter) picks.
Hold {lb} for the weapon ring, aiming with the right stick {rs}. {rb} switches to the next weapon and {y} to the previous one. {x} picks the Super Shotgun and {b} the Railgun.
{a} jumps, and {l3} toggles crouch. Hold {lt} to run; if the port's Always Run is on, it walks instead.
{select} (Tab) opens the inventory: the d-pad {dpad} left and right scroll the items and {r3} (Enter) uses the one shown. A long press of {select} shows your mission objectives (F1).
Quick save is a double tap of {start} (F6), and quick load is a long press of {start} (F9).
These are Quake II's classic keys, written from memory and not checked in the game. The ports don't all bind W, A, S and D, so bind them to forward, left, back and right in the Controls options, and turn on mouse look. Menu sliders need the mouse, since the d-pad left and right scroll the inventory. If a button does nothing, compare the Controls screen with the keys here.'''

[profiles.guide.edits]
"stick:Left" = { text = "Move" }
"stick:Right" = { text = "Look" }
"trigger:Right" = { text = "Fire" }
"trigger:Left" = { text = "Run (hold)" }
"button:South" = { text = "Jump" }
"button:East" = { text = "Railgun" }
"button:West" = { text = "Super Shotgun" }
"button:North" = { text = "Previous weapon" }
"button:LeftBumper" = { text = "Hold: weapons" }
"button:RightBumper" = { text = "Next weapon" }
"button:LeftStick" = { text = "Crouch (toggle)" }
"button:RightStick" = { text = "Use item / confirm" }
"button:Select" = { text = "Inventory" }
"gesture:button:Select:long_press" = { text = "Objectives" }
"button:Start" = { text = "Menu / back out" }
"gesture:button:Start:double_tap" = { text = "{icon:save} Quick save" }
"gesture:button:Start:long_press" = { text = "{icon:load} Quick load" }

