format = 20
macros = []
overlay_font = "Special Elite"

[pack]
id = "b777e526-f25c-4801-875e-849f76578333"
name = "Resident Evil 3: Nemesis"
version = "1.0"
author = "Padwight"
description = "Resident Evil 3: Nemesis (GOG, the 1999 Windows release, with the Mercenaries) on an Xbox-style pad, laid out like the PlayStation original for the game's default keys. Tank controls, A to act, B to run and cancel, RB to ready the weapon on the nearest enemy and RT on anything, LB to quick turn and LT for the map. The menus and keyboard are a typewriter."
made_with = "Xbox controller"

[[rules]]
kind = "executable"
value = "ResidentEvil3.exe"
profile = "Resident Evil 3: Nemesis"

[[rules]]
kind = "executable"
value = "RE3_MERCE.exe"
profile = "Resident Evil 3: Nemesis"


[[profiles]]
name = "Resident Evil 3: Nemesis"
combos = []
combo_window_ms = 120
tap_window_ms = 250
long_press_ms = 500

[profiles.buttons]
Guide = {mode = "Guide"}
South = {keys = ["KEY_C"]}
East = {keys = ["KEY_V"]}
North = {keys = ["KEY_Z"]}
LeftBumper = {keys = ["KEY_B"]}
RightBumper = {keys = ["KEY_S"]}
Select = {open_menu = "Keys"}
Start = {keys = ["KEY_Q"]}
DpadUp = {keys = ["KEY_UP"]}
DpadDown = {keys = ["KEY_DOWN"]}
DpadLeft = {keys = ["KEY_LEFT"]}
DpadRight = {keys = ["KEY_RIGHT"]}

[profiles.left_stick]
deadzone = 0.2
curve = 1.0
key_threshold = 0.4

[profiles.left_stick.action.keys]
up = "KEY_UP"
down = "KEY_DOWN"
left = "KEY_LEFT"
right = "KEY_RIGHT"

[profiles.right_stick]
deadzone = 0.3
curve = 1.0
key_threshold = 0.5
action = "disabled"

[profiles.left_trigger.action.button]
threshold = 0.3
action = {keys = ["KEY_M"]}

[profiles.right_trigger.action.button]
threshold = 0.3
action = {keys = ["KEY_X"]}

[profiles.gyro]
mode = "off"
horizontal = "yaw"
invert_x = false
invert_y = false
activation = "always"
noise_threshold = 1.0

[profiles.guide]
notes = '''The layout follows the PlayStation original and the game's default keys. The stick and {dpad} are tank controls: left and right turn, up walks, down backs away. Hold {east} to run and to back out of menus.
{south} checks, picks up, opens and fires when the weapon is ready; press it as Nemesis swings and you dodge. Hold {rb} to ready the weapon on the nearest enemy, or {rt} to ready it at anything, barrels included. {lb} is the B key, which the game's own pad layout puts on L1. {lt} is the map and {north} the status screen.
{start} is Q, the game's pause. {select} lists the other keys: Escape, Enter, Space and F5, the options window where the keys can be changed.'''

[profiles.guide.edits]
"stick:Left" = {text = "{icon:footprints} Turn and walk"}
"trigger:Left" = {text = "{icon:map} Map"}
"trigger:Right" = {text = "{icon:crosshair} Ready weapon at anything (hold)"}
"button:South" = {text = "{icon:hand} Action / fire / dodge"}
"button:East" = {text = "{icon:fast} Run (hold) / cancel"}
"button:North" = {text = "{icon:bag} Status: items, files"}
"button:LeftBumper" = {text = "{icon:rotate} Quick turn"}
"button:RightBumper" = {text = "{icon:holster} Ready weapon at enemy (hold)"}
"button:Select" = {text = "{icon:key} Escape, Enter, Space, options"}
"button:Start" = {text = "{icon:pause} Pause"}

[[info_overlays]]
name = "Controls"
title = "Resident Evil 3: Nemesis"
rows = [
    ["{south}", "Action / fire / dodge", "{east}", "Run (hold) / cancel"],
    ["{rb}", "Ready at enemy (hold)", "{rt}", "Ready at anything (hold)"],
    ["{north}", "Status screen", "{lt}", "Map"],
    ["{lb}", "Quick turn", "{start}", "Pause"],
    ["{ls} {dpad}", "Turn and walk", "{select}", "Escape, Enter, Space, options"],
]

[info_overlays.style]
corners = 0.05
position = "top_right"
scale = 1.0

[info_overlays.style.background]
color = "#e8dfc6"
opacity = 0.96

[info_overlays.style.items]
color = "#d6cbab"
opacity = 0.9

[info_overlays.style.selected]
color = "#1d1b18"
opacity = 1.0

[info_overlays.style.border]
width = 2
color = "#3a342a"
opacity = 0.9

[info_overlays.style.gradient]
color = "#f3ecd8"
opacity = 1.0
angle = 180

[info_overlays.style.item_border]
width = 1
color = "#b9ad8c"

[info_overlays.style.type]
