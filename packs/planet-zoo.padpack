format = 20
macros = []
overlay_font = "Comfortaa"

[pack]
id = "8b0d3c3e-6a41-4e1f-9a2e-3f7c5d1b9a64"
name = "Planet Zoo"
version = "1.0"
author = "Padwight"
description = "Planet Zoo on an Xbox-style pad, for the game's default keys. The left stick pans the camera and the right stick moves the pointer; RT and A click, hold LT to turn the camera. Hold LB for the build categories and Select for the zoo dashboard. X rotates, hold Y for height and RB for Ctrl, L3 switches angle snap and R3 pauses. Rounded overlays in the zoo's leaf green."
made_with = "Xbox controller"

[[rules]]
kind = "steam_app_id"
value = "703080"
profile = "Planet Zoo"

[[rules]]
kind = "executable"
value = "PlanetZoo.exe"
profile = "Planet Zoo"

[[profiles]]
name = "Planet Zoo"
combos = []
combo_window_ms = 120
tap_window_ms = 250
long_press_ms = 500

[profiles.buttons]
Guide = {mode = "Guide"}
South = {mouse = "Left"}
East = {keys = ["KEY_ESC"]}
West = {keys = ["KEY_Z"]}
North = {keys = ["KEY_LEFTSHIFT"]}
LeftBumper = {open_menu = "Build"}
RightBumper = {keys = ["KEY_LEFTCTRL"]}
Select = {open_menu = "Zoo"}
Start = {keys = ["KEY_ESC"]}
LeftStick = {keys = ["KEY_SPACE"]}
RightStick = {keys = ["KEY_P"]}
DpadUp = {keys = ["KEY_PAGEUP"]}
DpadDown = {keys = ["KEY_PAGEDOWN"]}
DpadLeft = {keys = ["KEY_LEFTCTRL", "KEY_Z"]}
DpadRight = {keys = ["KEY_LEFTCTRL", "KEY_Y"]}

[profiles.gestures.Start]
double_tap = {keys = ["KEY_F5"]}
long_press = {keys = ["KEY_F9"]}

[profiles.gestures.RightStick]
long_press = {keys = ["KEY_O"]}

[profiles.left_stick]
deadzone = 0.15
curve = 1.0
key_threshold = 0.35

[profiles.left_stick.action.ring]
sectors = 8
start_angle = 0.0
inner_radius = 0.35
hysteresis = 0.1

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_W"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_W"] },
    { keys = ["KEY_D"] },
]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_D"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_S"] },
    { keys = ["KEY_D"] },
]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_S"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_S"] },
    { keys = ["KEY_A"] },
]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_A"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_W"] },
    { keys = ["KEY_A"] },
]

[profiles.right_stick]
deadzone = 0.12
curve = 1.7
key_threshold = 0.5

[profiles.right_stick.action.mouse]
speed = 1400.0
accel = 0.3

[profiles.left_trigger.action.button]
threshold = 0.4
action = {mouse = "Middle"}

[profiles.right_trigger.action.button]
threshold = 0.3
action = {mouse = "Left"}

[profiles.gyro]
enabled = false
horizontal = "yaw"
invert_x = false
invert_y = false
noise_threshold = 1.0

[profiles.guide]
notes = '''The right stick {rs} moves the pointer and the left stick {ls} pans the camera. {rt} or {south} clicks; hold {lt} and move the right stick {rs} to turn and tilt the camera. {up} and {down} zoom.
Hold {lb} for the build categories, aiming with the right stick {rs}. {select} holds the zoo dashboard: management, trading, heat maps, the move and copy tools, brush and path sizes, freelook, save and load.
{west} turns what you're placing a quarter; hold it and move the pointer to turn it freely. Hold {north} and move the pointer up or down to change its height, tap it to reset. Hold {rb} for Ctrl: lock to the surface's axes, select several pieces, invert a terrain brush, or place a path without joins.
{l3} switches angle snap. {r3} pauses; hold it to change the speed. {left} and {right} undo and redo. {east} cancels and deselects, {start} is the menu: double tap it for the save menu, hold it for the load menu.
Keys are the game's defaults from a community list, not read from an install: if one is off, check Settings → Controls. Naming an animal or a guest attraction: {guide} + {west} opens the on-screen keyboard.'''

[profiles.guide.edits]
"stick:Left" = {text = "Pan the camera"}
"stick:Right" = {text = "Pointer"}
"trigger:Right" = {text = "Click"}
"trigger:Left" = {text = "Hold: turn the camera"}
"button:South" = {text = "Click"}
"button:East" = {text = "Cancel / deselect"}
"button:West" = {text = "{icon:rotate} Rotate (hold: freely)"}
"button:North" = {text = "{icon:height} Hold: height (tap: reset)"}
"button:LeftBumper" = {text = "Hold: build"}
"button:RightBumper" = {text = "Hold: Ctrl"}
"button:Select" = {text = "Zoo dashboard"}
"button:Start" = {text = "Menu"}
"gesture:button:Start:double_tap" = {text = "{icon:save} Save menu"}
"gesture:button:Start:long_press" = {text = "{icon:load} Load menu"}
"button:LeftStick" = {text = "{icon:grid} Angle snap on / off"}
"button:RightStick" = {text = "{icon:pause} Pause"}
"gesture:button:RightStick:long_press" = {text = "{icon:speed2} Change speed"}
"button:DpadLeft" = {text = "{icon:rotate-left} Undo"}
"button:DpadRight" = {text = "{icon:rotate} Redo"}

[[profiles.guide.merged]]
inputs = ["button:DpadUp", "button:DpadDown"]
text = "Zoom in / out"


