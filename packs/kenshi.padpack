[profiles.gyro]
horizontal = "yaw"
invert_x = false
invert_y = false
noise_threshold = 1.0

[profiles.gyro.mode.mouse]
sensitivity = 20.0

[profiles.guide]
notes = '''Hold {select} and {start} together to pause the gyro while you reposition the controller. Tilting the controller moves the pointer, as a fine pointer next to the right stick {rs}.
The right stick {rs} moves the pointer and the left stick {ls} pans the camera. {rt} or {south} clicks to select; {lt} right-clicks to move, attack, pick up and talk.
Hold {west} and move the pointer to turn the camera, or turn it with {lb} and {rb}. {up} and {down} zoom.
Click {l3} to pause. Hold {north} and press the {dpad} for the speed: left normal, up fast, right faster, down pause.
Hold {r3} while you click to add to the selection or queue orders. {east} closes windows and {start} is the menu.
{select} lists the inventory, character, map, build and research screens. Naming a character or a town: {guide} + {west} opens the on-screen keyboard.
The speed and screen keys are inferred from the game's defaults; if one doesn't answer, check Options → Controls.'''

