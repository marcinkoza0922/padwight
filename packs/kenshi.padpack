format = 20
macros = []
overlay_font = "Cantarell"

[pack]
id = "8f9b73e4-9b77-4e4e-b823-0ca35b37f6b1"
name = "Kenshi"
version = "1.0"
author = "Padwight"
description = "Kenshi on an Xbox-style pad, for the game's default keys. The right stick moves the pointer and the left stick pans the camera; RT or A clicks and LT right-clicks to give orders. B closes windows, hold X to turn the camera with the pointer, hold Y and press the D-pad for the speed, L3 pauses, R3 holds Shift to queue. The bumpers turn the camera, the D-pad zooms, Select lists the screens. The \"Kenshi + Gyro\" profile also moves the pointer by tilting the controller."
made_with = "Xbox controller"

[[rules]]
kind = "executable"
value = "kenshi_x64.exe"
profile = "Kenshi"

[[rules]]
kind = "steam_app_id"
value = "233860"
profile = "Kenshi"

[[profiles]]
name = "Kenshi"
combos = [
    {buttons = ["North", "DpadLeft"], action = { keys = ["KEY_F2"] }},
    {buttons = ["North", "DpadUp"], action = { keys = ["KEY_F3"] }},
    {buttons = ["North", "DpadRight"], action = { keys = ["KEY_F4"] }},
    {buttons = ["North", "DpadDown"], action = { keys = ["KEY_SPACE"] }},
]
combo_window_ms = 120
tap_window_ms = 250
long_press_ms = 500

[profiles.buttons]
South = { mouse = "Left" }
East = { keys = ["KEY_ESC"] }
West = { mouse = "Middle" }
North = { open_menu = "Speed" }
LeftBumper = { keys = ["KEY_Q"] }
RightBumper = { keys = ["KEY_E"] }
LeftStick = { keys = ["KEY_SPACE"] }
RightStick = { keys = ["KEY_LEFTSHIFT"] }
DpadUp = { wheel = "Up" }
DpadDown = { wheel = "Down" }
Select = { open_menu = "Screens" }
Start = { keys = ["KEY_ESC"] }
Guide = { mode = "Guide" }

[profiles.left_stick]
deadzone = 0.15
curve = 1.0
key_threshold = 0.35

[profiles.left_stick.action.ring]
sectors = 8
start_angle = 0.0
inner_radius = 0.35
hysteresis = 0.1

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_W"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_W"] },
    { keys = ["KEY_D"] },
]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_D"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_S"] },
    { keys = ["KEY_D"] },
]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_S"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_S"] },
    { keys = ["KEY_A"] },
]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_A"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_W"] },
    { keys = ["KEY_A"] },
]

[profiles.right_stick]
deadzone = 0.12
curve = 1.8
key_threshold = 0.5

[profiles.right_stick.action.mouse]
speed = 1500.0
accel = 0.3

[profiles.left_trigger.action.button]
threshold = 0.3
action = { mouse = "Right" }

[profiles.right_trigger.action.button]
threshold = 0.3
action = { mouse = "Left" }

[profiles.gyro]
mode = "off"
horizontal = "yaw"
invert_x = false
invert_y = false
noise_threshold = 1.0

[profiles.guide]
notes = '''The right stick {rs} moves the pointer and the left stick {ls} pans the camera. {rt} or {south} clicks to select; {lt} right-clicks to move, attack, pick up and talk.
Hold {west} and move the pointer to turn the camera, or turn it with {lb} and {rb}. {up} and {down} zoom.
Click {l3} to pause. Hold {north} and press the {dpad} for the speed: left normal, up fast, right faster, down pause.
Hold {r3} while you click to add to the selection or queue orders. {east} closes windows and {start} is the menu.
{select} lists the inventory, character, map, build and research screens. Naming a character or a town: {guide} + {west} opens the on-screen keyboard.
The speed and screen keys are inferred from the game's defaults; if one doesn't answer, check Options → Controls.'''

[profiles.guide.edits]
"stick:Left" = { text = "Pan the camera" }
"stick:Right" = { text = "Pointer" }
"trigger:Right" = { text = "Click (select)" }
"trigger:Left" = { text = "Right-click (orders)" }
"button:South" = { text = "Click" }
"button:East" = { text = "Close / cancel" }
"button:West" = { text = "Turn camera (hold)" }
"button:North" = { text = "Hold: speed" }
"button:LeftStick" = { text = "{icon:pause} Pause" }
"button:RightStick" = { text = "Add / queue (hold)" }
"button:Select" = { text = "{icon:map} Screens" }
"button:Start" = { text = "Menu" }
"combo:button:North+button:DpadLeft" = { text = "{icon:speed1} Normal" }
"combo:button:North+button:DpadUp" = { text = "{icon:speed2} Fast" }
"combo:button:North+button:DpadRight" = { text = "{icon:speed3} Faster" }
"combo:button:North+button:DpadDown" = { text = "{icon:pause} Pause" }

[[profiles.guide.merged]]
inputs = ["button:LeftBumper", "button:RightBumper"]
text = "Turn camera left / right"

[[profiles.guide.merged]]
inputs = ["button:DpadUp", "button:DpadDown"]
text = "Zoom in / out"

[[profiles]]
name = "Kenshi + Gyro"
combos = [
    {buttons = ["North", "DpadLeft"], action = { keys = ["KEY_F2"] }},
    {buttons = ["North", "DpadUp"], action = { keys = ["KEY_F3"] }},
    {buttons = ["North", "DpadRight"], action = { keys = ["KEY_F4"] }},
    {buttons = ["North", "DpadDown"], action = { keys = ["KEY_SPACE"] }},
    {buttons = ["Select", "Start"], action = "gyro_clutch"},
]
combo_window_ms = 120
tap_window_ms = 250
long_press_ms = 500
requires = ["gyro"]

[profiles.buttons]
