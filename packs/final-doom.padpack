format = 20
macros = []
overlay_font = "Silkscreen"

[pack]
id = "48f53bef-9c02-4f5b-9432-175207111910"
name = "Final Doom"
version = "1.0"
author = "Padwight"
description = "Final Doom (1996: TNT: Evilution and The Plutonia Experiment) on an Xbox-style pad, for DOS Doom's default keys. The left stick walks and strafes, the right stick turns, RT fires, A uses, L3 toggles run and the d-pad sends the arrow keys. Hold LB for the weapon ring. Start is the menu."
made_with = "Xbox controller"

[[rules]]
kind = "steam_app_id"
value = "2290"
profile = "Final Doom"

[[profiles]]
name = "Final Doom"
combos = []
combo_window_ms = 120
tap_window_ms = 250
long_press_ms = 500

[profiles.buttons]
Guide = { mode = "Guide" }
South = { keys = ["KEY_SPACE"] }
West = { keys = ["KEY_LEFTALT"] }
East = { keys = ["KEY_ENTER"] }
North = { keys = ["KEY_TAB"] }
LeftBumper = { open_menu = "Weapons" }
RightBumper = { keys = ["KEY_RIGHTBRACE"] }
Select = { keys = ["KEY_TAB"] }
Start = { keys = ["KEY_ESC"] }
LeftStick = { toggle = { action = { keys = ["KEY_LEFTSHIFT"] } } }
DpadUp = { keys = ["KEY_UP"] }
DpadDown = { keys = ["KEY_DOWN"] }
DpadLeft = { keys = ["KEY_LEFT"] }
DpadRight = { keys = ["KEY_RIGHT"] }

[profiles.left_stick]
deadzone = 0.12
curve = 1.0
key_threshold = 0.25

[profiles.left_stick.action.ring]
sectors = 8
start_angle = 0.0
inner_radius = 0.25
hysteresis = 0.1

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_UP"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_UP"] },
    { keys = ["KEY_DOT"] },
]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_DOT"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_DOWN"] },
    { keys = ["KEY_DOT"] },
]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_DOWN"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_DOWN"] },
    { keys = ["KEY_COMMA"] },
]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_COMMA"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_UP"] },
    { keys = ["KEY_COMMA"] },
]

[profiles.right_stick]
deadzone = 0.15
curve = 1.0
key_threshold = 0.4

[profiles.right_stick.action.ring]
sectors = 8
start_angle = 0.0
inner_radius = 0.25
hysteresis = 0.1

[[profiles.right_stick.action.ring.actions]]
keys = ["KEY_UP"]

[[profiles.right_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_UP"] },
    { keys = ["KEY_RIGHT"] },
]

[[profiles.right_stick.action.ring.actions]]
keys = ["KEY_RIGHT"]

[[profiles.right_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_DOWN"] },
    { keys = ["KEY_RIGHT"] },
]

[[profiles.right_stick.action.ring.actions]]
keys = ["KEY_DOWN"]

[[profiles.right_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_DOWN"] },
    { keys = ["KEY_LEFT"] },
]

[[profiles.right_stick.action.ring.actions]]
keys = ["KEY_LEFT"]

[[profiles.right_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_UP"] },
    { keys = ["KEY_LEFT"] },
]

[profiles.left_trigger.action.button]
threshold = 0.4
action = { keys = ["KEY_LEFTSHIFT"] }

[profiles.right_trigger.action.button]
threshold = 0.3
action = { keys = ["KEY_LEFTCTRL"] }

[profiles.guide]
notes = '''Final Doom runs as DOS Doom: the left stick walks and strafes, the right stick turns, {rt} is the Ctrl key (fire) and {a} uses doors and switches (Space).
{lb} opens the weapon ring, aiming with the right stick {rs}. {x} holds Alt, which turns the stick's sideways push into a strafe in DOS Doom.
{l3} toggles Shift, which is run. {start} (Escape) opens the game's menu, {b} is Enter in it, and the d-pad {dpad} moves the menu cursor.
{select} (Tab) shows the automap.
These are DOS Doom's default keys, written from memory and not checked in the game. If a button does nothing, compare the game's controls screen with the keys here.'''

[profiles.guide.edits]
"stick:Left" = { text = "Move" }
"stick:Right" = { text = "Turn" }
"trigger:Right" = { text = "Fire" }
"button:South" = { text = "Use" }
"button:West" = { text = "Strafe (hold)" }
"button:East" = { text = "Enter" }
"button:North" = { text = "Automap" }
"button:LeftBumper" = { text = "Hold: weapons" }
"button:RightBumper" = { text = "Cycle weapon" }
"button:LeftStick" = { text = "Run (toggle)" }
"button:Select" = { text = "Automap" }
"button:Start" = { text = "Menu / back out" }

