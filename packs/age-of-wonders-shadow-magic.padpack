"button:LeftBumper" = { text = "Hold: party orders" }
"button:RightBumper" = { text = "Next event" }
"gesture:button:RightBumper:long_press" = { text = "End turn" }
"button:Select" = { text = "Map commands" }
"button:Start" = { text = "Escape" }
"gesture:button:Start:double_tap" = { text = "{icon:save} Save" }
"gesture:button:Start:long_press" = { text = "{icon:load} Load" }
"stick:Left" = { text = "Scroll the map" }
"button:LeftStick" = { text = "Magic domain" }
"button:RightStick" = { text = "Center on party" }
"button:DpadUp" = { text = "Zoom in" }
"button:DpadDown" = { text = "Zoom out" }
"gesture:button:DpadDown:long_press" = { text = "Zoom 100%" }
"button:DpadLeft" = { text = "Previous party" }
"button:DpadRight" = { text = "Next party" }


