[profiles.right_trigger.action.button]
threshold = 0.3
action = { mouse = "Left" }

[profiles.guide]
notes = '''Hearts of Iron IV + Gyro: tilting the controller moves the cursor too, as a fine pointer next to the right stick {rs}. Hold {select} and {start} together to pause the gyro while you reposition the controller.
The right stick {rs} moves the pointer: {rt} or {south} is a left click, {lt} a right click. The left stick {ls} pans the map.
{north} pauses and unpauses; the {leftright} d-pad slows the game down and speeds it up, and {updown} zooms.
Hold {west} for Shift while you click, to add to a selection or queue orders.
Hold {lb} for the map modes and {rb} for the battle plans and orders, aimed or moved through and picked with {south}.
{select} lists the screens (tap it, pick with {south}, {east} closes the list). {east} or {start} is Escape: it closes the open window, and on the map opens the game menu.
Hold {guide} and press {west} for the on-screen keyboard (save names, searches).
With divisions selected, the {rb} orders draw front lines, offensive lines, spearheads and fallback lines: pick one, then click on the map with {rt}. The navy and air force reuse the same letters for their own missions; use the keyboard ({guide} + {west}) for those.
Click {l3} to jump to the capital and {r3} to search. Hearts of Iron IV has no controller support on PC, so the controller works through these keys. It has no quick save: save from the game menu.'''

