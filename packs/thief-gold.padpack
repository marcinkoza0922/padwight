format = 20
macros = []
overlay_font = "Cinzel"

[pack]
id = "a0952773-970d-4a45-ac71-1c671b537646"
name = "Thief Gold"
version = "1.3"
author = "Padwight"
description = "Thief Gold (GOG, NewDark) on an Xbox-style pad, for the keys GOG ships. A uses and picks up, B jumps, RT attacks and draws the bow, LT blocks, X drops, Y leans forward, L3 toggles crouch. A light push of the left stick creeps. Hold LB for items and RB for weapons and arrows; double tap to put them away. D-pad left and right lean, up and down cycle items. Select lists the map and objectives. Start is the menu; double tap it to quick save, hold it to quick load. Gyro and flick stick profiles are included to try."
made_with = "Xbox controller"

[[rules]]
kind = "executable"
value = "THIEF.EXE"
profile = "Thief Gold"

[[rules]]
kind = "steam_app_id"
value = "211600"
profile = "Thief Gold"

[[profiles]]
name = "Thief Gold"
combos = []
combo_window_ms = 120
tap_window_ms = 250
long_press_ms = 500

[profiles.buttons]
South = { mouse = "Right" }
East = { keys = ["KEY_SPACE"] }
West = { keys = ["KEY_R"] }
North = { keys = ["KEY_X"] }
LeftBumper = { open_menu = "Items" }
RightBumper = { open_menu = "Weapons" }
Select = { open_menu = "Screens" }
Start = { keys = ["KEY_ESC"] }
Guide = { mode = "Guide" }
LeftStick = { keys = ["KEY_C"] }
DpadUp = { keys = ["KEY_LEFTSHIFT", "KEY_TAB"] }
DpadDown = { keys = ["KEY_TAB"] }
DpadLeft = { keys = ["KEY_Q"] }
DpadRight = { keys = ["KEY_E"] }

[profiles.gestures.LeftBumper.double_tap]
keys = ["KEY_BACKSPACE"]

[profiles.gestures.RightBumper.double_tap]
keys = ["KEY_GRAVE"]

[profiles.gestures.Start.double_tap]
keys = ["KEY_F11"]

[profiles.gestures.Start.long_press]
keys = ["KEY_F12"]

[profiles.left_stick]
deadzone = 0.12
curve = 1.0
key_threshold = 0.25

[profiles.left_stick.action.ring]
sectors = 8
start_angle = 0.0
inner_radius = 0.25
hysteresis = 0.1

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_W"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_W"] },
    { keys = ["KEY_D"] },
]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_D"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_S"] },
    { keys = ["KEY_D"] },
]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_S"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_S"] },
    { keys = ["KEY_A"] },
]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_A"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_W"] },
    { keys = ["KEY_A"] },
]

[[profiles.left_stick.zones]]
min = 0.0
max = 0.6
action = { keys = ["KEY_LEFTSHIFT"] }

[profiles.right_stick]
deadzone = 0.12
curve = 2.2
key_threshold = 0.5

[profiles.right_stick.action.mouse]
speed = 2600.0
accel = 0.5
accel_ramp_ms = 350
y_scale = 0.75

[profiles.left_trigger.action.button]
threshold = 0.4
action = { mouse = "Middle" }

[profiles.right_trigger.action.button]
threshold = 0.3
action = { mouse = "Left" }

[profiles.guide]
notes = '''A light push of the left stick {ls} creeps (Shift), a full push walks at full speed.
Hold {rt} to draw the bow and let go to loose the arrow; a sword or blackjack swings when {rt} is pulled.
{south} frobs the world: opens doors, picks up loot and uses the item in hand on what you're looking at.
Hold {lb} for the items (potions, lockpicks, flash bombs) and {rb} for the weapons and arrows, aiming with the right stick {rs}. Double tap either to put the item or weapon away.
Crouch is a toggle in the game: click {l3} to crouch and again to stand.
{start} (Escape) is the menu. Double tap it to quick save and hold it to quick load.
If the game also reacts to the controller itself, turn Joystick off in Options, Controls.'''

[profiles.guide.edits]
"stick:Left" = { text = "Move (light push: creep)" }
"stick:Right" = { text = "Look" }
"trigger:Right" = { text = "Attack / draw the bow" }
"trigger:Left" = { text = "Block" }
"button:South" = { text = "Use / pick up" }
"button:East" = { text = "Jump / mantle" }
"button:West" = { text = "Drop item" }
"button:North" = { text = "Lean forward" }
"button:LeftBumper" = { text = "Hold: items" }
"gesture:button:LeftBumper:double_tap" = { text = "Put item away" }
"button:RightBumper" = { text = "Hold: weapons" }
"gesture:button:RightBumper:double_tap" = { text = "Put weapon away" }
"button:LeftStick" = { text = "Crouch (toggle)" }
"button:Select" = { text = "{icon:map} Map, objectives" }
"button:Start" = { text = "Menu" }
"gesture:button:Start:double_tap" = { text = "{icon:save} Quick save" }
"gesture:button:Start:long_press" = { text = "{icon:load} Quick load" }

[[profiles.guide.merged]]
inputs = ["button:DpadLeft", "button:DpadRight"]
text = "Lean"

[[profiles.guide.merged]]
inputs = ["button:DpadUp", "button:DpadDown"]
text = "Previous / next item"

