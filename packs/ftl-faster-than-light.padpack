[motion]
keyboard = "swift"
numpad = "swift"
menu = "swift"
media = "swift"
offer = "swift"
info = "swift"
log = "swift"

[sounds.menu]
step = {kind = "blip", volume = 0.06, pitch = 0.8}
pick = {kind = "switch", volume = 0.14}

[sounds.keyboard]
step = {kind = "click", volume = 0.07, pitch = 1.0}
pick = {kind = "blip", volume = 0.08, pitch = 1.1}

[sounds.numpad]
step = {kind = "click", volume = 0.07, pitch = 1.0}
pick = {kind = "blip", volume = 0.08, pitch = 1.1}

[sounds.media]
pick = {kind = "switch", volume = 0.12}

[rumble.menu]
step = {strength = 0.07, length_ms = 18}
pick = {strength = 0.25, length_ms = 35}

[rumble.keyboard]
step = {strength = 0.05, length_ms = 14}
pick = {strength = 0.17, length_ms = 22}

[rumble.numpad]
step = {strength = 0.05, length_ms = 14}
pick = {strength = 0.17, length_ms = 22}

[rumble.media]
pick = {strength = 0.17, length_ms = 25}

[rumble.guide]
mode = {strength = 0.17, length_ms = 60}
