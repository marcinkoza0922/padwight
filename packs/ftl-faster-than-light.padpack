format = 20
macros = []
overlay_font = "Rajdhani"

[pack]
id = "e6db16f4-2729-4693-b317-a0ffd534b118"
name = "FTL: Faster Than Light"
version = "1.0"
author = "Padwight"
description = "FTL: Faster Than Light on an Xbox-style pad. The right stick moves the pointer and RT or A clicks to select crew, target rooms and power systems; LT or B right-clicks to move crew. X pauses. Hold LB to power systems, RB for weapons and drones, L3 for the cloak, teleporter and hacking, and the D-pad left for the crew. Overlays in the ship's grey panels and amber highlights. The \"FTL + Gyro\" profile also moves the pointer by tilting the controller."
made_with = "Xbox controller"

[[rules]]
kind = "steam_app_id"
value = "212680"
profile = "FTL: Faster Than Light"

[[rules]]
kind = "executable"
value = "FTLGame.exe"
profile = "FTL: Faster Than Light"

[[rules]]
kind = "executable"
value = "FTL.amd64"
profile = "FTL: Faster Than Light"

[[rules]]
kind = "executable"
value = "FTL.x86"
profile = "FTL: Faster Than Light"

[[profiles]]
name = "FTL: Faster Than Light"
combos = []
combo_window_ms = 120
tap_window_ms = 250
long_press_ms = 500

[profiles.buttons]
Guide = {mode = "Guide"}
South = {mouse = "Left"}
East = {mouse = "Right"}
West = {keys = ["KEY_SPACE"]}
North = {keys = ["KEY_J"]}
LeftBumper = {open_menu = "Systems"}
RightBumper = {open_menu = "Weapons"}
LeftStick = {open_menu = "Ship abilities"}
RightStick = {keys = ["KEY_V"]}
Select = {open_menu = "Ship"}
Start = {keys = ["KEY_ESC"]}
DpadUp = {keys = ["KEY_Z"]}
DpadDown = {keys = ["KEY_X"]}
DpadLeft = {open_menu = "Crew"}
DpadRight = {keys = ["KEY_ENTER"]}

[profiles.gestures.DpadRight.long_press]
keys = ["KEY_SLASH"]

[profiles.left_stick]
deadzone = 0.12
curve = 1.6
key_threshold = 0.5

[profiles.left_stick.action.mouse]
speed = 500.0
accel = 0.0

[profiles.right_stick]
deadzone = 0.12
curve = 1.7
key_threshold = 0.5

[profiles.right_stick.action.mouse]
speed = 1400.0
accel = 0.3

[profiles.left_trigger.action.button]
threshold = 0.4
action = {mouse = "Right"}

[profiles.right_trigger.action.button]
threshold = 0.3
action = {mouse = "Left"}

[profiles.gyro]
enabled = false
horizontal = "yaw"
invert_x = false
invert_y = false
noise_threshold = 1.0

[profiles.guide]
notes = '''The right stick {rs} moves the pointer and the left stick {ls} moves it slowly. {rt} or {south} clicks: select crew, target a room, power a system. {lt} or {east} right-clicks: send the selected crew to a room, take a bar of power off a system, put a weapon back.
{west} pauses and unpauses (Space). Pause often: every order works while the game is paused.
Hold {lb} for the systems and aim {rs} at one to give it a bar of power. Hold {rb} for the weapons and drones, and {l3} for the cloak, teleporter, hacking, mind control, battery and lockdown. {r3} turns autofire on and off.
Hold {left} to pick a crew member, or all of them. {right} sends everyone back to their saved stations; hold {right} to save where they stand now.
{up} opens every door and {down} closes them, to vent a fire or a boarding party.
{north} opens the star map to jump. {select} lists the upgrades, cargo and star map. {start} is the menu, and closes any screen.
The keys are the game's defaults, read from its settings.ini. To take power off with a key, the game uses Shift and the system's key, unchecked; right-clicking the system's bar does the same.'''

[profiles.guide.edits]
"stick:Left" = {text = "Fine pointer"}
"stick:Right" = {text = "Pointer"}
"trigger:Right" = {text = "{icon:crosshair} Click (select, target)"}
"trigger:Left" = {text = "Right-click (move crew)"}
"button:South" = {text = "Click"}
"button:East" = {text = "Right-click"}
"button:West" = {text = "{icon:pause} {b}Pause{/b}"}
"button:North" = {text = "{icon:rocket} Jump (star map)"}
"button:LeftBumper" = {text = "Hold: {icon:bolt} power systems"}
"button:RightBumper" = {text = "Hold: {icon:attack} weapons, drones"}
"button:LeftStick" = {text = "Hold: ship abilities"}
"button:RightStick" = {text = "Autofire on / off"}
"button:Select" = {text = "{icon:wrench} Upgrades, cargo"}
"button:Start" = {text = "Menu"}
"button:DpadUp" = {text = "{icon:gate} Open all doors"}
"button:DpadDown" = {text = "Close all doors"}
"button:DpadLeft" = {text = "Hold: {icon:people} pick crew"}
"button:DpadRight" = {text = "Crew to stations"}
"gesture:button:DpadRight:long_press" = {text = "{icon:save} Save stations"}


[[profiles]]
name = "FTL + Gyro"
combos = [
    {buttons = ["Select", "Start"], action = "gyro_clutch"},
]
combo_window_ms = 120
tap_window_ms = 250
long_press_ms = 500
requires = ["gyro"]

[profiles.buttons]
Guide = {mode = "Guide"}
South = {mouse = "Left"}
East = {mouse = "Right"}
