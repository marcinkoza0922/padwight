format = 20
macros = []
overlay_font = "Rajdhani"

[pack]
id = "26508ccf-e70d-4407-89b1-442ac4d39bf4"
name = "Call of Duty 4: Modern Warfare"
version = "1.0"
author = "Padwight"
description = "Call of Duty 4: Modern Warfare (2007) on an Xbox-style pad, laid out like the Xbox 360 release, for the PC game's default keys. A jumps, B crouches (hold it to go prone), X reloads and, held, uses, Y switches weapons, RT fires and LT aims down the sights. LB throws the special grenade and RB the frag, L3 sprints and holds your breath, R3 is melee. The D-pad has night vision, the inventory item and the airstrike or helicopter, and Select holds the scoreboard. The game has no controller support. Gyro and flick stick profiles are included to try."
made_with = "Xbox controller"

[[rules]]
kind = "steam_app_id"
value = "7940"
profile = "Call of Duty 4: Modern Warfare"

[[rules]]
kind = "executable"
value = "iw3sp.exe"
profile = "Call of Duty 4: Modern Warfare"

[[rules]]
kind = "executable"
value = "iw3mp.exe"
profile = "Call of Duty 4: Modern Warfare"
[[profiles]]
name = "Call of Duty 4: Modern Warfare"
combos = []
combo_window_ms = 120
tap_window_ms = 250
long_press_ms = 300

