RightBumper = { keys = ["KEY_G"] }
LeftStick = { keys = ["KEY_LEFTSHIFT"] }
RightStick = { keys = ["KEY_V"] }
Select = { keys = ["KEY_TAB"] }
Start = { keys = ["KEY_ESC"] }
DpadUp = { keys = ["KEY_N"] }
DpadLeft = { keys = ["KEY_3"] }
DpadRight = { keys = ["KEY_5"] }

[profiles.gestures.East]
long_press = { keys = ["KEY_LEFTCTRL"] }

[profiles.gestures.West]
long_press = { keys = ["KEY_F"] }

[profiles.left_stick]
deadzone = 0.12
curve = 1.0
key_threshold = 0.25

[profiles.left_stick.action.ring]
sectors = 8
start_angle = 0.0
inner_radius = 0.25
hysteresis = 0.1

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_W"]

[[profiles.left_stick.action.ring.actions]]
multi = [{ keys = ["KEY_W"] }, { keys = ["KEY_D"] }]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_D"]

[[profiles.left_stick.action.ring.actions]]
multi = [{ keys = ["KEY_S"] }, { keys = ["KEY_D"] }]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_S"]

[[profiles.left_stick.action.ring.actions]]
multi = [{ keys = ["KEY_S"] }, { keys = ["KEY_A"] }]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_A"]

[[profiles.left_stick.action.ring.actions]]
multi = [{ keys = ["KEY_W"] }, { keys = ["KEY_A"] }]

[profiles.right_stick]
deadzone = 0.08
curve = 2.0
key_threshold = 0.5

[profiles.right_stick.action.mouse]
speed = 1440.0
accel = 0.2

[profiles.left_trigger.action.button]
threshold = 0.4
action = { multi = [{ layer = "Aim" }, { mouse = "Right" }] }

[profiles.right_trigger.action.button]
threshold = 0.3
action = { mouse = "Left" }

[profiles.guide]
notes = '''{start} (Escape) pauses and backs out of the game's menus. The campaign has no quick save; it saves at checkpoints.
The buttons follow the Xbox 360 release's default layout. {south} jumps, {east} crouches and a long press of {east} goes prone, {west} reloads and, held, uses: pick up a weapon, plant, open doors. {north} switches weapons.
Hold {lt} to aim down the sights; the game must have aiming set to hold (its default), not toggle. The right stick turns more finely while it's held.
{lb} throws your special grenade (flash, stun, smoke) and {rb} a frag: hold to cook it, let go to throw. Hold {l3} to sprint, and while aiming hold it to steady a sniper rifle. {r3} is melee.
{up} switches night vision on and off, {left} takes out your inventory item (C4, claymores, the RPG or the grenade launcher attachment) and {right} calls in an airstrike or helicopter in multiplayer. Hold {select} for the scoreboard and objectives. The PC game's lean (Q and E) isn't on the pad, as the console game had none.
Chat in multiplayer needs typing: open the on-screen keyboard with {guide} + {west} and press T (all) or Y (team).
Online play: many players use the CoD4x client and its servers. On servers with PunkBuster or VAC, the pad reaches the game as an ordinary keyboard and mouse.
These are the game's default PC keys, written from memory and not checked in the game (the special grenade, melee and the D-pad's inventory and airstrike keys especially), and the D-pad's order follows the Xbox 360 release as remembered. Compare them with Options → Controls and change the buttons here to match. The gyro's real-world turn assumes the default mouse sensitivity of 5; set the full turn to 16364 divided by your sensitivity.'''

[profiles.guide.edits]
"stick:Left" = { text = "Move" }
"stick:Right" = { text = "Look" }
"trigger:Right" = { text = "Fire" }
"trigger:Left" = { text = "{icon:scope} Aim" }
"button:South" = { text = "Jump" }
"button:East" = { text = "Crouch" }
"gesture:button:East:long_press" = { text = "Prone" }
"button:West" = { text = "Reload" }
"gesture:button:West:long_press" = { text = "{icon:hand} Use (hold)" }
"button:North" = { text = "{icon:rifle} Switch weapon" }
"button:LeftBumper" = { text = "{icon:flashlight} Special grenade" }
"button:RightBumper" = { text = "{icon:grenade} Frag" }
"button:LeftStick" = { text = "Sprint · hold breath" }
"button:RightStick" = { text = "{icon:dagger} Melee" }
"button:DpadUp" = { text = "{icon:eye} Night vision" }
"button:DpadLeft" = { text = "{icon:bomb} Inventory" }
"button:DpadRight" = { text = "{icon:plane} Airstrike · helicopter" }
"button:Select" = { text = "Scoreboard" }
"button:Start" = { text = "Pause" }

