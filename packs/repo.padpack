format = 20
macros = []
overlay_font = "Bangers"

[pack]
id = "cf8a42a4-3a68-4033-bd92-2aeb512d1c76"
name = "R.E.P.O."
version = "1.0"
author = "Padwight"
description = "R.E.P.O. on an Xbox-style pad, for the game's default keys. RT grabs and holds, LT is the right mouse button, and the bumpers pull a held object closer or push it away. A interacts and, held, sprints; B jumps, X tumbles, L3 toggles crouch, and the D-pad picks inventory slots and holds push-to-talk. Select holds the map, Y opens chat. The game has no controller support. Gyro and flick stick profiles are included to try."
made_with = "Xbox controller"

[[rules]]
kind = "steam_app_id"
value = "3241660"
profile = "R.E.P.O."

[[rules]]
kind = "executable"
value = "REPO.exe"
profile = "R.E.P.O."

[[profiles]]
name = "R.E.P.O."
combos = []
combo_window_ms = 120
tap_window_ms = 250
long_press_ms = 300

[profiles.buttons]
