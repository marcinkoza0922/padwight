format = 20
macros = []
overlay_font = "Cinzel"

[pack]
id = "a8f4c6d0-73b6-4b98-a94c-0596270ccd00"
name = "Warhammer 40,000: Dawn of War: Dark Crusade"
version = "1.0"
author = "Padwight"
description = "Warhammer 40,000: Dawn of War: Dark Crusade (2006) on an Xbox-style pad, for the default hotkeys. It shares the layout of the other Dawn of War packs. The PC game has no controller support, so the layout is built on its keys: the right stick moves the cursor, RT left-clicks, LT right-clicks, the left stick scrolls the map, the d-pad zooms and finds builders and idle troops. A attack-moves, X stops, Y reinforces. Hold LB for control groups 1-10 (LB + RB sets one), R3 for unit commands. Select lists pause, chat and events; hold it for the Menus mode. Start is the game menu. The \"+ Gyro\" profile also moves the cursor by tilting the controller."
made_with = "Xbox controller"

[[rules]]
kind = "executable"
value = "DarkCrusade.exe"
profile = "Warhammer 40,000: Dawn of War: Dark Crusade"

[[rules]]
kind = "steam_app_id"
value = "4580"
profile = "Warhammer 40,000: Dawn of War: Dark Crusade"

[[profiles]]
name = "Warhammer 40,000: Dawn of War: Dark Crusade"
combos = [{buttons = ["LeftBumper", "RightBumper"], action = {open_menu = "Set group"}}]
combo_window_ms = 120
tap_window_ms = 250
long_press_ms = 500

[profiles.buttons]
Guide = {mode = "Guide"}
South = {keys = ["KEY_A"]}
West = {keys = ["KEY_Q"]}
North = {keys = ["KEY_R"]}
East = {keys = ["KEY_ESC"]}
LeftBumper = {open_menu = "Groups"}
RightBumper = {keys = ["KEY_LEFTSHIFT"]}
Select = {open_menu = "Game"}
Start = {keys = ["KEY_F10"]}
LeftStick = {keys = ["KEY_TAB"]}
RightStick = {open_menu = "Commands"}
DpadUp = {wheel = "Up"}
DpadDown = {wheel = "Down"}
DpadLeft = {keys = ["KEY_DOT"]}
DpadRight = {keys = ["KEY_COMMA"]}

[profiles.gestures.Select]
long_press = {mode = "Menus"}

[profiles.left_stick]
deadzone = 0.2
curve = 1.0
key_threshold = 0.45

[profiles.left_stick.action.ring]
sectors = 8
start_angle = 0.0
inner_radius = 0.45
hysteresis = 0.1

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_UP"]

[[profiles.left_stick.action.ring.actions]]
multi = [{ keys = ["KEY_UP"] }, { keys = ["KEY_RIGHT"] }]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_RIGHT"]

[[profiles.left_stick.action.ring.actions]]
multi = [{ keys = ["KEY_DOWN"] }, { keys = ["KEY_RIGHT"] }]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_DOWN"]

[[profiles.left_stick.action.ring.actions]]
multi = [{ keys = ["KEY_DOWN"] }, { keys = ["KEY_LEFT"] }]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_LEFT"]

[[profiles.left_stick.action.ring.actions]]
multi = [{ keys = ["KEY_UP"] }, { keys = ["KEY_LEFT"] }]

[profiles.right_stick]
deadzone = 0.1
curve = 1.6
key_threshold = 0.25

[profiles.right_stick.action.mouse]
speed = 1500.0
accel = 0.25

[profiles.left_trigger.action.button]
threshold = 0.4
action = { mouse = "Right" }

[profiles.right_trigger.action.button]
threshold = 0.3
action = { mouse = "Left" }

[profiles.gyro]
mode = "off"
horizontal = "yaw"
invert_x = false
invert_y = false
noise_threshold = 1.0

[profiles.guide]
notes = '''The right stick {rs} moves the cursor: {rt} selects (left click, hold to drag a box), and {lt} moves, attacks or captures a point (right click). The left stick {ls} scrolls the map, and {up} {down} zoom.
{south} is attack move (then click the target with {rt}), {west} stops and {north} reinforces the selected squad. {left} jumps to the next builder, {right} to idle military. Click {l3} for the next unit type in the selection.
Hold {lb} for the control groups and aim the right stick {rs} at one: release to select it. Hold {lb} and {rb} together to put the selection in a group instead (Ctrl + number).
{rb} is Shift: hold it to queue orders or add to the selection. Abilities, stances and wargear are the buttons on the taskbar: click them with {rt}.
Click {r3} for the other unit commands (move, melee, attack ground, build, attach, unload, repair, leader, scuttle), aimed with the right stick {rs}.
{select} lists pause, chat and the next event. Hold {select} for the Menus mode (the main menu, the army painter, the lobbies) and hold it again to come back. {start} (F10) is the game menu; {east} cancels.
The keys can't be changed in the game. They're the defaults as listed for the Definitive Edition, which keeps the original's keys, not checked on this version: the commands on {r3} and next builder and idle military are the likeliest to differ. Guide + {west} opens the on-screen keyboard for chat.
On the campaign map, {rt} picks a territory to attack and {start} opens the menu.'''

[profiles.guide.edits]
"stick:Left" = { text = "Scroll the map" }
"stick:Right" = { text = "Cursor" }
"trigger:Right" = { text = "Left click (select, drag a box)" }
"trigger:Left" = { text = "Right click (move, attack, capture)" }
"button:South" = { text = "{icon:sword} Attack move" }
"button:West" = { text = "{icon:stop} Stop" }
"button:North" = { text = "{icon:reinforce} Reinforce" }
"button:East" = { text = "Cancel" }
"button:RightBumper" = { text = "Shift (queue, add)" }
"button:LeftBumper" = { text = "Hold: control groups" }
"button:LeftStick" = { text = "Next unit in selection" }
"button:RightStick" = { text = "Unit commands" }
"button:DpadLeft" = { text = "{icon:hammer} Next builder" }
"button:DpadRight" = { text = "{icon:sleep} Idle military" }
"button:Select" = { text = "Pause, chat, events" }
"button:Start" = { text = "Game menu" }
"gesture:button:Select:long_press" = { text = "Menus mode on / off" }

[[profiles.guide.merged]]
inputs = ["button:DpadUp", "button:DpadDown"]
text = "Zoom in / out"

[[profiles.guide.custom]]
inputs = ["button:LeftBumper", "button:RightBumper"]
text = "Set a control group"

[[profiles]]
