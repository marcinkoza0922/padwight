format = 20
macros = []
overlay_font = "Kreon"

[pack]
id = "a19266c5-3f5c-5a03-84a8-dc2bd1cf304c"
name = "Street Legal Racing: Redline v2.3.1"
version = "1.0"
author = "Padwight"
description = "Street Legal Racing: Redline v2.3.1 on an Xbox-style pad. The left stick walks on WASD and the right stick points or looks; RT and A click, LT right-clicks. Overlays in street-racing orange and grey."
made_with = "Xbox controller"

[[rules]]
kind = "steam_app_id"
value = "497180"
profile = "Street Legal Racing: Redline v2.3.1"

[[rules]]
kind = "executable"
value = "streetlegal_redline.exe"
profile = "Street Legal Racing: Redline v2.3.1"

[[profiles]]
name = "Street Legal Racing: Redline v2.3.1"
combos = []
combo_window_ms = 120
tap_window_ms = 250
long_press_ms = 500

[profiles.buttons]
Guide = {mode = "Guide"}
South = {keys = ["KEY_SPACE"]}
East = {mouse = "Right"}
DpadUp = {wheel = "Up"}
DpadDown = {wheel = "Down"}
Start = {keys = ["KEY_ESC"]}
LeftBumper = {keys = ["KEY_Q"]}
RightBumper = {keys = ["KEY_E"]}

[profiles.left_stick]
deadzone = 0.15
curve = 1.0
key_threshold = 0.35

[profiles.left_stick.action.ring]
sectors = 8
start_angle = 0.0
inner_radius = 0.35
hysteresis = 0.1

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_W"]

[[profiles.left_stick.action.ring.actions]]
multi = [{ keys = ["KEY_W"] }, { keys = ["KEY_D"] }]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_D"]

[[profiles.left_stick.action.ring.actions]]
multi = [{ keys = ["KEY_S"] }, { keys = ["KEY_D"] }]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_S"]

[[profiles.left_stick.action.ring.actions]]
multi = [{ keys = ["KEY_S"] }, { keys = ["KEY_A"] }]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_A"]

[[profiles.left_stick.action.ring.actions]]
multi = [{ keys = ["KEY_W"] }, { keys = ["KEY_A"] }]

[profiles.right_stick]
deadzone = 0.12
curve = 1.7
key_threshold = 0.5

[profiles.right_stick.action.mouse]
speed = 1400.0
accel = 0.3

[profiles.left_trigger.action.button]
threshold = 0.4
action = {mouse = "Right"}

[profiles.right_trigger.action.button]
threshold = 0.3
action = {mouse = "Left"}

[profiles.gyro]
enabled = false
horizontal = "yaw"
invert_x = false
invert_y = false
noise_threshold = 1.0

[profiles.guide]
notes = '''The right stick {rs} moves the pointer. {rt} or {south} clicks, {lt} right-clicks. {up} and {down} scroll the wheel. The left stick {ls} moves.
Buttons: {south} Handbrake; {east} Right-click / back; {start} Menu; {lb} Shift down; {rb} Shift up.
Space, Q and E for handbrake and shifting are guesses at the usual keys. Typical defaults for the genre, not checked against the game. Keys are the game's defaults as remembered, not read from an install; if one doesn't answer, check the game's controls options and change the buttons here to match. The Windows executable is from Discord's list. The game has no controller support, so the pad plays it with the pointer.
Typing a name or text: {guide} + {west} opens the on-screen keyboard.'''

[profiles.guide.edits]
"stick:Left" = {text = "Move"}
"stick:Right" = {text = "Pointer"}
"trigger:Right" = {text = "Left click"}
"trigger:Left" = {text = "Right click"}
"button:South" = {text = "Handbrake"}
"button:East" = {text = "Right-click / back"}
"button:Start" = {text = "Menu"}
"button:LeftBumper" = {text = "Shift down"}
"button:RightBumper" = {text = "Shift up"}

[[profiles.guide.merged]]
inputs = ["button:DpadUp", "button:DpadDown"]
text = "Zoom in / out"



