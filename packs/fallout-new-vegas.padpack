format = 20
macros = []
overlay_font = "VT323"

[pack]
id = "a2dc1693-d502-5114-b919-14e15b675d26"
name = "Fallout: New Vegas"
version = "1.0"
author = "Padwight"
description = "Fallout: New Vegas (2010) on an Xbox-style pad. The game has its own controller support, so the controller passes through untouched and the game's own options set the buttons. Padwight adds the Guide overlay on top, with the on-screen keyboard and the media controls, in the amber of the Mojave."
made_with = "Xbox controller"

[[rules]]
kind = "executable"
value = "FalloutNV.exe"
profile = "Fallout: New Vegas"

[[rules]]
kind = "steam_app_id"
value = "22380"
profile = "Fallout: New Vegas"

[[rules]]
kind = "steam_app_id"
value = "22490"
profile = "Fallout: New Vegas"

[[profiles]]
name = "Fallout: New Vegas"
combos = []
combo_window_ms = 120
tap_window_ms = 250
long_press_ms = 500

[profiles.buttons]
South = {gamepad = "South"}
East = {gamepad = "East"}
North = {gamepad = "North"}
West = {gamepad = "West"}
LeftBumper = {gamepad = "LeftBumper"}
RightBumper = {gamepad = "RightBumper"}
LeftStick = {gamepad = "LeftStick"}
RightStick = {gamepad = "RightStick"}
Select = {gamepad = "Select"}
Start = {gamepad = "Start"}
DpadUp = {gamepad = "DpadUp"}
DpadDown = {gamepad = "DpadDown"}
DpadLeft = {gamepad = "DpadLeft"}
DpadRight = {gamepad = "DpadRight"}
Guide = {mode = "Guide"}

[profiles.left_stick]
deadzone = 0.05
curve = 1.0
key_threshold = 0.3

[profiles.left_stick.action]
gamepad = {stick = "Left", invert_y = false}

[profiles.right_stick]
deadzone = 0.05
curve = 1.0
key_threshold = 0.3

[profiles.right_stick.action]
gamepad = {stick = "Right", invert_y = false}

[profiles.left_trigger]
action = {gamepad = "Left"}

[profiles.right_trigger]
action = {gamepad = "Right"}

[profiles.gyro]
mode = "off"
horizontal = "yaw"
invert_x = false
invert_y = false
activation = "always"
noise_threshold = 1.0

[profiles.guide]
notes = '''New Vegas has its own controller support, so the controller goes to the game as it is. Set the buttons in the game's own Options → Controls.
{guide} still works over the game: {guide} + {west} opens the on-screen keyboard, and {guide} + {lb} the media controls.
If the game stops answering the pad, check that Steam Input or another remapper isn't also running for it.'''

[keyboard_style]
corners = 0.15
position = "bottom_center"
scale = 1.0

[keyboard_style.background]
color = "#160e04"
opacity = 0.92

[keyboard_style.items]
color = "#2e1d08"
opacity = 0.95

[keyboard_style.selected]
color = "#e8a31e"
opacity = 1.0

[keyboard_style.border]
width = 1
color = "#e8a31e"
opacity = 0.8

[keyboard_style.gradient]
color = "#201305"
opacity = 1.0
angle = 180

[keyboard_style.item_border]
width = 1
color = "#6a4510"

[keyboard_style.type]
letter_spacing = 1
case = "upper"

[numpad_style]
corners = 0.15
position = "center"
scale = 1.0

[numpad_style.background]
color = "#160e04"
opacity = 0.92

[numpad_style.items]
color = "#2e1d08"
opacity = 0.95

[numpad_style.selected]
color = "#e8a31e"
opacity = 1.0

[numpad_style.border]
width = 1
color = "#e8a31e"
opacity = 0.8

[numpad_style.gradient]
color = "#201305"
opacity = 1.0
angle = 180

[numpad_style.item_border]
width = 1
color = "#6a4510"

[numpad_style.type]
letter_spacing = 1
case = "upper"

[media_style]
corners = 0.15
position = "top_right"
scale = 0.9

[media_style.background]
color = "#160e04"
opacity = 0.92

[media_style.items]
color = "#2e1d08"
opacity = 0.95

[media_style.selected]
color = "#e8a31e"
opacity = 1.0

[media_style.border]
width = 1
color = "#e8a31e"
opacity = 0.8

[media_style.gradient]
color = "#201305"
opacity = 1.0
angle = 180

[media_style.item_border]
width = 1
color = "#6a4510"

[media_style.type]
letter_spacing = 1
case = "upper"

[menu_style]
corners = 0.15
position = "center"
scale = 1.0

[menu_style.background]
color = "#160e04"
opacity = 0.92

[menu_style.items]
color = "#2e1d08"
opacity = 0.95

[menu_style.selected]
color = "#e8a31e"
opacity = 1.0

[menu_style.border]
width = 1
color = "#e8a31e"
opacity = 0.8

[menu_style.gradient]
color = "#201305"
opacity = 1.0
angle = 180

[menu_style.item_border]
width = 1
color = "#6a4510"

[menu_style.glow]
color = "#ffc94d"
opacity = 0.6
blur = 18
pulse = true

[menu_style.type]
letter_spacing = 1
case = "upper"

[menu_style.ornament]
scanlines = {spacing = 3, opacity = 0.2, color = "#000000", drift = true}
vignette = {color = "#000000", opacity = 0.5, reach = 20}

[motion]
keyboard = "retro"
numpad = "retro"
menu = "retro"
media = "retro"
offer = "retro"
info = "retro"
log = "retro"

[sounds.menu]
step = {kind = "geiger", volume = 0.1}
pick = {kind = "beep", volume = 0.16, pitch = 0.9, length = 0.8}
open = {kind = "blip", volume = 0.06, pitch = 0.7}
close = {kind = "blip", volume = 0.05, pitch = 0.55}

[sounds.keyboard]
step = {kind = "geiger", volume = 0.1}
pick = {kind = "typewriter", volume = 0.2, length = 0.6}

[sounds.numpad]
step = {kind = "geiger", volume = 0.1}
pick = {kind = "typewriter", volume = 0.2, length = 0.6}

[sounds.media]
pick = {kind = "typewriter", volume = 0.2, length = 0.6}

[rumble.menu]
step = {strength = 0.1, length_ms = 18}
pick = {strength = 0.35, length_ms = 35}

[rumble.keyboard]
step = {strength = 0.07, length_ms = 14}
pick = {strength = 0.24, length_ms = 22}

[rumble.numpad]
step = {strength = 0.07, length_ms = 14}
pick = {strength = 0.24, length_ms = 22}

[rumble.media]
pick = {strength = 0.24, length_ms = 25}

[rumble.guide]
mode = {strength = 0.24, length_ms = 60}
