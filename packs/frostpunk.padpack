format = 20
macros = []
overlay_font = "Cinzel"

[pack]
id = "3f29e80c-c44f-4cbd-8ea7-59f4511d7fba"
name = "Frostpunk"
version = "1.0"
author = "Padwight"
description = "Frostpunk on an Xbox-style pad. The left stick moves the camera and the right stick the pointer; RT and A click, LT right-clicks to cancel. X pauses, Y steps through the speeds (hold it with the D-pad for one), the bumpers turn the camera and the D-pad zooms. Overlays in riveted iron with a frost rim and the generator's orange glow."
made_with = "Xbox controller"

[[rules]]
kind = "steam_app_id"
value = "323190"
profile = "Frostpunk"

[[rules]]
kind = "executable"
value = "Frostpunk.exe"
profile = "Frostpunk"

[[profiles]]
name = "Frostpunk"
combos = [
    {buttons = ["North", "DpadUp"], action = {keys = ["KEY_2"]}},
    {buttons = ["North", "DpadRight"], action = {keys = ["KEY_3"]}},
    {buttons = ["North", "DpadDown"], action = {keys = ["KEY_SPACE"]}},
    {buttons = ["North", "DpadLeft"], action = {keys = ["KEY_1"]}},
]
combo_window_ms = 120
tap_window_ms = 250
long_press_ms = 500

[profiles.buttons]
Guide = {mode = "Guide"}
South = {mouse = "Left"}
East = {keys = ["KEY_ESC"]}
West = {keys = ["KEY_SPACE"]}
North = {cycle = {name = "Game speed"}}
LeftBumper = {keys = ["KEY_Q"]}
RightBumper = {keys = ["KEY_E"]}
Start = {keys = ["KEY_ESC"]}
DpadUp = {wheel = "Up"}
DpadDown = {wheel = "Down"}

[profiles.gestures.North.long_press]
open_menu = "Speed"

[profiles.left_stick]
deadzone = 0.15
curve = 1.0
key_threshold = 0.35

[profiles.left_stick.action.ring]
sectors = 8
start_angle = 0.0
inner_radius = 0.35
hysteresis = 0.1

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_W"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_W"] },
    { keys = ["KEY_D"] },
]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_D"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_S"] },
    { keys = ["KEY_D"] },
]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_S"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_S"] },
    { keys = ["KEY_A"] },
]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_A"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_W"] },
    { keys = ["KEY_A"] },
]

[profiles.right_stick]
deadzone = 0.12
curve = 1.8
key_threshold = 0.5

[profiles.right_stick.action.mouse]
speed = 1400.0
accel = 0.3

[profiles.left_trigger.action.button]
threshold = 0.4
action = {mouse = "Right"}

[profiles.right_trigger.action.button]
threshold = 0.3
action = {mouse = "Left"}

[profiles.gyro]
enabled = false
horizontal = "yaw"
invert_x = false
invert_y = false
noise_threshold = 1.0

[profiles.guide]
notes = '''The right stick {rs} moves the pointer and the left stick {ls} moves the camera around the generator. {rt} or {south} clicks; {lt} right-clicks to drop the building in hand and close a panel.
{west} pauses and resumes. Tap {north} for the next speed: fast, fastest, then normal again. Press {north} with the {dpad} for one speed (left normal, up fast, right fastest, down pause); hold {north} to see them.
{lb} and {rb} turn the camera around the city, {up} and {down} zoom. {east} and {start} close windows and open the menu.
The speed keys 1 to 3 are a guess at the defaults, not read from an install: check Options → Controls if they don't answer. Media controls for the long nights: {guide} + {lb}.'''

[profiles.guide.edits]
"stick:Left" = {text = "Move the camera"}
"stick:Right" = {text = "Pointer"}
"trigger:Right" = {text = "Click"}
"trigger:Left" = {text = "Right-click (cancel)"}
"button:South" = {text = "Click"}
"button:East" = {text = "Close"}
"button:West" = {text = "{icon:pause} Pause"}
"button:North" = {text = "{icon:speed2} Next speed"}
"gesture:button:North:long_press" = {text = "Hold: speed menu"}
"button:Start" = {text = "Menu"}
"combo:button:North+button:DpadUp" = {text = "{icon:speed2} Fast"}
"combo:button:North+button:DpadRight" = {text = "{icon:speed3} Fastest"}
"combo:button:North+button:DpadDown" = {text = "{icon:pause} Pause"}
"combo:button:North+button:DpadLeft" = {text = "{icon:speed1} Normal"}

[[profiles.guide.merged]]
inputs = ["button:LeftBumper", "button:RightBumper"]
text = "{icon:rotate} Turn the camera"

[[profiles.guide.merged]]
inputs = ["button:DpadUp", "button:DpadDown"]
text = "Zoom in / out"


[[profiles]]
name = "Frostpunk + Gyro"
combos = [
    {buttons = ["North", "DpadUp"], action = {keys = ["KEY_2"]}},
    {buttons = ["North", "DpadRight"], action = {keys = ["KEY_3"]}},
    {buttons = ["North", "DpadDown"], action = {keys = ["KEY_SPACE"]}},
    {buttons = ["North", "DpadLeft"], action = {keys = ["KEY_1"]}},
    {buttons = ["Select", "Start"], action = "gyro_clutch"},
]
