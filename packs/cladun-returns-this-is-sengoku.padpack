dividers = {width = 1, color = "#55402e", opacity = 0.8}

[motion]
keyboard = "grim"
numpad = "grim"
menu = "grim"
media = "grim"
offer = "grim"
info = "grim"
log = "grim"

[sounds.menu]
step = {kind = "wood", volume = 0.06}
pick = {kind = "shing", volume = 0.08, pitch = 0.9}
open = {kind = "page", volume = 0.07}
close = {kind = "wood", volume = 0.05, pitch = 0.8}

[sounds.numpad]
step = {kind = "wood", volume = 0.06}
pick = {kind = "shing", volume = 0.08, pitch = 0.9}

[sounds.keyboard]
step = {kind = "wood", volume = 0.06}
pick = {kind = "keys", volume = 0.12}

[sounds.media]
pick = {kind = "shing", volume = 0.08, pitch = 0.9}
