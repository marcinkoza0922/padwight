position = "top_right"
scale = 0.9

[media_style.background]
color = "#1b1511"
opacity = 0.93

[media_style.items]
color = "#32261d"
opacity = 0.95

[media_style.selected]
color = "#c8372d"
opacity = 1.0

[media_style.border]
width = 1
