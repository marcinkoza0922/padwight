format = 20
macros = []
overlay_font = "Titillium Web"

[pack]
id = "71d4c9a2-0b6e-4f38-b2a7-5c8e3f1d6a90"
name = "Command & Conquer: Red Alert 3"
version = "1.0"
author = "Padwight"
description = "Command & Conquer: Red Alert 3 on an Xbox-style pad, for the default keys. The PC version has no controller support, so the layout borrows the Xbox 360 edition's ideas (X uses the special ability, the build tabs and unit commands in quick menus) on the PC keys. The right stick moves the cursor, RT left-clicks to select and order, LT right-clicks to deselect, the left stick scrolls the map. A selects every unit on screen, X fires the special ability, Y jumps to the last alert, B stops. The d-pad zooms, selects the same type and steps through the build tabs. Hold LB for control groups 1-10 (LB + RB sets one), R3 for unit commands. Select lists chat and the menu; hold it for the Menus mode. Start is the menu. The \"+ Gyro\" profile also moves the cursor by tilting the controller."
made_with = "Xbox controller"

[[rules]]
kind = "executable"
value = "RA3.exe"
profile = "Command & Conquer: Red Alert 3"

[[rules]]
kind = "executable"
value = "ra3_1.12.game"
profile = "Command & Conquer: Red Alert 3"

[[rules]]
kind = "steam_app_id"
value = "17480"
profile = "Command & Conquer: Red Alert 3"

[[profiles]]
name = "Command & Conquer: Red Alert 3"
combos = [{buttons = ["LeftBumper", "RightBumper"], action = {open_menu = "Set group"}}]
combo_window_ms = 120
tap_window_ms = 250
long_press_ms = 500

[profiles.buttons]
Guide = {mode = "Guide"}
South = {keys = ["KEY_Q"]}
West = {keys = ["KEY_F"]}
North = {keys = ["KEY_SPACE"]}
East = {keys = ["KEY_S"]}
LeftBumper = {open_menu = "Groups"}
RightBumper = {keys = ["KEY_LEFTSHIFT"]}
Select = {open_menu = "Game"}
Start = {keys = ["KEY_ESC"]}
LeftStick = {keys = ["KEY_LEFTCTRL"]}
RightStick = {open_menu = "Commands"}
DpadUp = {wheel = "Up"}
DpadDown = {wheel = "Down"}
DpadLeft = {keys = ["KEY_W"]}
DpadRight = {keys = ["KEY_TAB"]}

[profiles.gestures.Select]
long_press = {mode = "Menus"}

[profiles.left_stick]
deadzone = 0.2
curve = 1.0
key_threshold = 0.45

[profiles.left_stick.action.ring]
sectors = 8
start_angle = 0.0
inner_radius = 0.45
hysteresis = 0.1

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_UP"]

[[profiles.left_stick.action.ring.actions]]
multi = [{ keys = ["KEY_UP"] }, { keys = ["KEY_RIGHT"] }]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_RIGHT"]

[[profiles.left_stick.action.ring.actions]]
multi = [{ keys = ["KEY_DOWN"] }, { keys = ["KEY_RIGHT"] }]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_DOWN"]

[[profiles.left_stick.action.ring.actions]]
multi = [{ keys = ["KEY_DOWN"] }, { keys = ["KEY_LEFT"] }]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_LEFT"]

[[profiles.left_stick.action.ring.actions]]
multi = [{ keys = ["KEY_UP"] }, { keys = ["KEY_LEFT"] }]

[profiles.right_stick]
deadzone = 0.1
curve = 1.6
key_threshold = 0.25

[profiles.right_stick.action.mouse]
speed = 1500.0
accel = 0.25

[profiles.left_trigger.action.button]
threshold = 0.4
action = { mouse = "Right" }

[profiles.right_trigger.action.button]
threshold = 0.3
action = { mouse = "Left" }

[profiles.gyro]
enabled = false
horizontal = "yaw"
invert_x = false
invert_y = false
noise_threshold = 1.0

[profiles.guide]
notes = '''The right stick {rs} moves the cursor. {rt} is the left click: it selects, places structures and gives orders, and a drag boxes units. {lt} is the right click: it deselects, and a drag pans the camera. The left stick {ls} scrolls the map, and {up} {down} zoom.
{south} selects every unit on screen (press it twice for the whole map), {left} every unit of the selected type. {west} fires the selected units' special ability, as X did on the Xbox 360. {north} jumps to the last alert and {east} stops.
{right} steps through the build tabs on the sidebar; click a unit or structure there with {rt}. Sell and repair are the buttons above the sidebar.
Hold {lb} for the control groups and aim the right stick {rs} at one: release to select it. Hold {lb} and {rb} together to put the selection in a group instead (Ctrl + number).
{rb} is Shift, to add to the selection. Hold {l3} (Ctrl) while clicking with {rt} to force-fire.
Click {r3} for the unit commands (attack-move, reverse, scatter, stop), aimed with the right stick {rs}.
{select} lists chat and the menu. Hold {select} for the Menus mode (the main menu, the co-commander and lobby screens) and hold it again to come back. {start} (Esc) is the menu, and pauses a campaign or skirmish.
The keys are the game's defaults as best remembered, not checked on an install: the build tabs (Tab), select same type (W), the special ability (F) and the unit commands are the likeliest to differ. If a key does nothing, look in Options, Key Mappings. The game's process may be ra3_1.12.game rather than RA3.exe, which only launches it. Guide + {west} opens the on-screen keyboard for chat.'''

[profiles.guide.edits]
"stick:Left" = { text = "Scroll the map" }
"stick:Right" = { text = "Cursor" }
"trigger:Right" = { text = "Left click (select, order)" }
"trigger:Left" = { text = "Right click (deselect, pan)" }
"button:South" = { text = "{icon:people} All units on screen" }
"button:West" = { text = "{icon:bolt} Special ability" }
"button:North" = { text = "{icon:bell} Last alert" }
"button:East" = { text = "{icon:stop} Stop" }
"button:RightBumper" = { text = "Shift (add to selection)" }
"button:LeftBumper" = { text = "Hold: control groups" }
"button:LeftStick" = { text = "Hold: force-fire (Ctrl)" }
"button:RightStick" = { text = "Unit commands" }
"button:DpadLeft" = { text = "{icon:copy} Same type" }
"button:DpadRight" = { text = "{icon:layers} Next build tab" }
"button:Start" = { text = "Menu" }
"gesture:button:Select:long_press" = { text = "Menus mode on / off" }
"button:Select" = { text = "Chat, menu" }

[[profiles.guide.merged]]
inputs = ["button:DpadUp", "button:DpadDown"]
text = "Zoom in / out"

[[profiles.guide.custom]]
inputs = ["button:LeftBumper", "button:RightBumper"]
text = "Set a control group"

