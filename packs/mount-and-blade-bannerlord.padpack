format = 20
macros = []
overlay_font = "Cinzel"

[pack]
id = "d8473596-72e8-4aca-9846-781bd7daa7c8"
name = "Mount & Blade II: Bannerlord"
version = "1.0"
author = "Padwight"
description = "Mount & Blade II: Bannerlord on an Xbox-style pad. The game has its own gamepad layout, so the controller passes through untouched and the game's controller options set the buttons. Padwight adds the Guide overlay on top, with the on-screen keyboard for names and the media controls, in the game's colors."
made_with = "Xbox controller"

[[rules]]
kind = "executable"
value = "Bannerlord.exe"
profile = "Mount & Blade II: Bannerlord"

[[rules]]
kind = "steam_app_id"
value = "261550"
profile = "Mount & Blade II: Bannerlord"

[[profiles]]
name = "Mount & Blade II: Bannerlord"
combos = []
combo_window_ms = 120
tap_window_ms = 250
long_press_ms = 500

[profiles.buttons]
South = {gamepad = "South"}
East = {gamepad = "East"}
North = {gamepad = "North"}
West = {gamepad = "West"}
LeftBumper = {gamepad = "LeftBumper"}
RightBumper = {gamepad = "RightBumper"}
LeftStick = {gamepad = "LeftStick"}
RightStick = {gamepad = "RightStick"}
Select = {gamepad = "Select"}
Start = {gamepad = "Start"}
DpadUp = {gamepad = "DpadUp"}
DpadDown = {gamepad = "DpadDown"}
DpadLeft = {gamepad = "DpadLeft"}
DpadRight = {gamepad = "DpadRight"}
Guide = {mode = "Guide"}

[profiles.left_stick]
deadzone = 0.05
curve = 1.0
key_threshold = 0.3

[profiles.left_stick.action]
gamepad = {stick = "Left", invert_y = false}

[profiles.right_stick]
deadzone = 0.05
curve = 1.0
key_threshold = 0.3

[profiles.right_stick.action]
gamepad = {stick = "Right", invert_y = false}

[profiles.left_trigger]
action = {gamepad = "Left"}

[profiles.right_trigger]
action = {gamepad = "Right"}

[profiles.gyro]
mode = "off"
horizontal = "yaw"
invert_x = false
invert_y = false
noise_threshold = 1.0

[profiles.guide]
notes = '''Bannerlord has its own controller support, so the controller goes to the game as it is. Set the buttons in the game's options, on the Controls tab.
The game's gamepad support is partial: some things, such as the full order menus in battle and a few dialogs, still want the mouse and keyboard.
{guide} still works over the game: {guide} + {west} opens the on-screen keyboard for naming your character, clan or kingdom, and {guide} + {lb} the media controls.
If the game stops answering the pad, check that Steam Input or another remapper isn't also running for it.'''

[keyboard_style]
corners = 0.1
position = "bottom_center"
scale = 1.0

[keyboard_style.background]
color = "#1a1410"
opacity = 0.92

[keyboard_style.items]
color = "#2e2418"
opacity = 0.95

[keyboard_style.selected]
color = "#b8893a"
opacity = 1.0

[keyboard_style.border]
width = 1
color = "#b8893a"
opacity = 0.7

[keyboard_style.gradient]
color = "#241b12"
opacity = 1.0
angle = 180

[keyboard_style.item_border]
width = 1
color = "#4d3b24"

[numpad_style]
corners = 0.1
position = "center"
scale = 1.0

[numpad_style.background]
color = "#1a1410"
opacity = 0.92

[numpad_style.items]
color = "#2e2418"
opacity = 0.95

[numpad_style.selected]
color = "#b8893a"
opacity = 1.0

[numpad_style.border]
width = 1
color = "#b8893a"
opacity = 0.7

[numpad_style.gradient]
color = "#241b12"
opacity = 1.0
angle = 180

[numpad_style.item_border]
width = 1
color = "#4d3b24"

[media_style]
corners = 0.1
position = "top_right"
scale = 0.9

[media_style.background]
color = "#1a1410"
opacity = 0.92

[media_style.items]
color = "#2e2418"
opacity = 0.95

[media_style.selected]
color = "#b8893a"
opacity = 1.0

[media_style.border]
width = 1
color = "#b8893a"
opacity = 0.7

[media_style.gradient]
color = "#241b12"
opacity = 1.0
angle = 180

[media_style.item_border]
width = 1
color = "#4d3b24"

[media_style.type]
letter_spacing = 1

[menu_style]
corners = 0.1
position = "center"
scale = 1.0

[menu_style.background]
color = "#1a1410"
opacity = 0.92

[menu_style.items]
color = "#2e2418"
opacity = 0.95

[menu_style.selected]
color = "#b8893a"
opacity = 1.0

[menu_style.border]
width = 1
color = "#b8893a"
opacity = 0.7

[menu_style.gradient]
color = "#241b12"
opacity = 1.0
angle = 180
drift = true

[menu_style.item_border]
width = 1
color = "#4d3b24"

[menu_style.glow]
color = "#b8893a"
opacity = 0.45
blur = 18

[menu_style.type]
letter_spacing = 1

[menu_style.ornament]
vignette = {color = "#000000", opacity = 0.4, reach = 20}

[motion]
keyboard = "stagger"
numpad = "stagger"
menu = "stagger"
media = "stagger"
offer = "stagger"
info = "stagger"
log = "stagger"

[sounds.keyboard]
step = {kind = "click", volume = 0.08, pitch = 0.8}
pick = {kind = "wood", volume = 0.16}

[sounds.numpad]
step = {kind = "click", volume = 0.08, pitch = 0.8}
pick = {kind = "wood", volume = 0.16}

[sounds.media]
pick = {kind = "clank", volume = 0.16}

[rumble.keyboard]
step = {strength = 0.1, length_ms = 14}
pick = {strength = 0.32, length_ms = 22}

[rumble.numpad]
step = {strength = 0.1, length_ms = 14}
pick = {strength = 0.32, length_ms = 22}

[rumble.media]
pick = {strength = 0.32, length_ms = 25}

[rumble.guide]
mode = {strength = 0.32, length_ms = 60}
