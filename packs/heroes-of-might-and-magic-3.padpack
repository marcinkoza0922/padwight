format = 20
macros = []
overlay_font = "Cinzel"

[pack]
id = "cf1eda2b-4f60-4485-b09a-72b46203de01"
name = "Heroes of Might and Magic III"
version = "1.0"
author = "Padwight"
description = "Heroes of Might and Magic III Complete (GOG) on an Xbox-style pad. The right stick moves the pointer, RT or A left-clicks, LT right-clicks (hold it for creature and object info). The left stick moves the hero a step, the d-pad scrolls the map, Y picks the next hero, RB ends the turn, R3 casts a spell. Hold LB for hero orders; Select lists the map screens. Click L3 to switch to the Battle mode, which puts wait, defend, cast and the combat commands on the buttons. Start is the system options."
made_with = "Xbox controller"

[[rules]]
kind = "executable"
value = "Heroes3.exe"
profile = "Heroes of Might and Magic III"

[[rules]]
kind = "executable"
value = "Heroes3 HD.exe"
profile = "Heroes of Might and Magic III"

[[rules]]
kind = "executable"
value = "h3hota.exe"
profile = "Heroes of Might and Magic III"

[[rules]]
kind = "executable"
value = "h3hota HD.exe"
profile = "Heroes of Might and Magic III"

[[rules]]
kind = "steam_app_id"
value = "4921760"
profile = "Heroes of Might and Magic III"

[[profiles]]
name = "Heroes of Might and Magic III"
combos = []
combo_window_ms = 120
tap_window_ms = 250
long_press_ms = 500

[profiles.buttons]
Guide = { mode = "Guide" }
South = { mouse = "Left" }
East = { keys = ["KEY_ESC"] }
West = { keys = ["KEY_ENTER"] }
North = { keys = ["KEY_H"] }
LeftBumper = { open_menu = "Hero" }
RightBumper = { keys = ["KEY_E"] }
Select = { open_menu = "Screens" }
Start = { keys = ["KEY_O"] }
LeftStick = { mode = "Battle" }
RightStick = { keys = ["KEY_C"] }
DpadUp = { keys = ["KEY_LEFTCTRL", "KEY_UP"] }
DpadDown = { keys = ["KEY_LEFTCTRL", "KEY_DOWN"] }
DpadLeft = { keys = ["KEY_LEFTCTRL", "KEY_LEFT"] }
DpadRight = { keys = ["KEY_LEFTCTRL", "KEY_RIGHT"] }

[profiles.left_stick]
deadzone = 0.25
curve = 1.0
key_threshold = 0.5

[profiles.left_stick.action.ring]
sectors = 8
start_angle = 0.0
inner_radius = 0.3
hysteresis = 0.1

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_UP"]

[[profiles.left_stick.action.ring.actions]]
multi = [{ keys = ["KEY_UP"] }, { keys = ["KEY_RIGHT"] }]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_RIGHT"]

[[profiles.left_stick.action.ring.actions]]
multi = [{ keys = ["KEY_DOWN"] }, { keys = ["KEY_RIGHT"] }]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_DOWN"]

[[profiles.left_stick.action.ring.actions]]
multi = [{ keys = ["KEY_DOWN"] }, { keys = ["KEY_LEFT"] }]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_LEFT"]

[[profiles.left_stick.action.ring.actions]]
multi = [{ keys = ["KEY_UP"] }, { keys = ["KEY_LEFT"] }]

[profiles.right_stick]
deadzone = 0.12
curve = 1.8
key_threshold = 0.5

[profiles.right_stick.action.mouse]
speed = 1500.0
accel = 0.3

[profiles.left_trigger.action.button]
threshold = 0.4
action = { mouse = "Right" }

[profiles.right_trigger.action.button]
threshold = 0.3
action = { mouse = "Left" }

[profiles.guide]
notes = '''The right stick moves the mouse pointer; {rt} or {south} is a left click and {lt} a right click. Hold {guide} and press {west} for the on-screen keyboard when the game asks for a name.
Moving a hero is two clicks, as with a mouse: the first shows the route, the second walks it. The left stick {ls} moves the hero one step with the arrow keys, and in a town it switches to the previous or next town. The d-pad scrolls the map; so does moving the pointer to the screen edge.
{west} is Enter: it confirms dialogs and centers the map on the hero. {east} is Escape and cancels them; on the map it asks whether to quit, so answer No.
{y} selects the next hero, {rb} ends the turn (confirm with {west}), {rs} casts a spell. Hold {lb} for hero orders, picking with the right stick.
Click {ls} to switch to Battle and back. In Battle {y} waits, {x} defends, {rb} picks the next creature, {rs} casts and {lb} opens the combat commands.
Heroes III has no quick save: {start} opens the system options, where S saves and L loads.'''

[profiles.guide.edits]
"stick:Right" = { text = "Pointer" }
"trigger:Right" = { text = "Left click" }
"trigger:Left" = { text = "Right click (info)" }
"button:South" = { text = "Left click" }
"button:East" = { text = "Cancel / No" }
"button:West" = { text = "OK / Yes / center hero" }
"button:North" = { text = "Next hero" }
"button:LeftBumper" = { text = "Hold: hero orders" }
"button:RightBumper" = { text = "End turn" }
"button:Select" = { text = "Map screens" }
"button:Start" = { text = "System options" }
"stick:Left" = { text = "Move the hero (arrow keys)" }
"button:LeftStick" = { text = "Battle mode on / off" }
"button:RightStick" = { text = "{icon:book} Cast spell" }
"button:DpadUp" = { text = "Scroll the map up" }
"button:DpadDown" = { text = "Scroll the map down" }
"button:DpadLeft" = { text = "Scroll the map left" }
"button:DpadRight" = { text = "Scroll the map right" }


