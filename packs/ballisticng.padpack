format = 20
macros = []
overlay_font = "Orbitron"

[pack]
id = "1645fefa-cc79-5621-b14b-515d0d32d616"
name = "BallisticNG"
version = "1.0"
author = "Padwight"
description = "BallisticNG on an Xbox-style pad. The game has its own controller support, including DualShock 4 and DualSense pads, so the controller passes through untouched and the game's Controls options set the buttons. Padwight adds the Guide overlay on top, with the on-screen keyboard for names and the media controls, in neon."
made_with = "Xbox controller"

[controllers]
dualshock = true
dualsense = true

[[rules]]
kind = "executable"
value = "BallisticNG"
profile = "BallisticNG"

[[rules]]
kind = "executable"
value = "BallisticNG.exe"
profile = "BallisticNG"

[[rules]]
kind = "steam_app_id"
value = "473770"
profile = "BallisticNG"

[[profiles]]
name = "BallisticNG"
combos = []
combo_window_ms = 120
tap_window_ms = 250
long_press_ms = 500

[profiles.buttons]
Guide = {mode = "Guide"}
South = {gamepad = "South"}
East = {gamepad = "East"}
North = {gamepad = "North"}
West = {gamepad = "West"}
LeftBumper = {gamepad = "LeftBumper"}
RightBumper = {gamepad = "RightBumper"}
LeftStick = {gamepad = "LeftStick"}
RightStick = {gamepad = "RightStick"}
Select = {gamepad = "Select"}
Start = {gamepad = "Start"}
DpadUp = {gamepad = "DpadUp"}
DpadDown = {gamepad = "DpadDown"}
DpadLeft = {gamepad = "DpadLeft"}
DpadRight = {gamepad = "DpadRight"}

[profiles.left_stick]
deadzone = 0.05
curve = 1.0
key_threshold = 0.3

[profiles.left_stick.action]
gamepad = {stick = "Left", invert_y = false}

[profiles.right_stick]
deadzone = 0.05
curve = 1.0
key_threshold = 0.3

[profiles.right_stick.action]
gamepad = {stick = "Right", invert_y = false}

[profiles.left_trigger]
action = {gamepad = "Left"}

[profiles.right_trigger]
action = {gamepad = "Right"}

[profiles.gyro]
mode = "off"
horizontal = "yaw"
invert_x = false
invert_y = false
noise_threshold = 1.0

[profiles.guide]
notes = '''BallisticNG has its own controller support, so the controller goes to the game as it is. Set the buttons in the game's own Options → Controls.
{guide} still works over the game: {guide} + {west} opens the on-screen keyboard for a pilot or track name, and {guide} + {lb} the media controls.
If the game stops answering the pad, check that Steam Input or another remapper isn't also running for it.'''

[keyboard_style]
