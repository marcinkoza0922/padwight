position = "bottom_center"
scale = 1.0

[keyboard_style.background]
color = "#07070d"
opacity = 0.92

[keyboard_style.items]
color = "#16162a"
opacity = 0.95

[keyboard_style.selected]
color = "#00d5ff"
opacity = 1.0

[keyboard_style.border]
width = 1
color = "#ff2bd6"
opacity = 0.8

[keyboard_style.gradient]
color = "#120a1e"
opacity = 1.0
angle = 180

[keyboard_style.item_border]
width = 1
color = "#2a2a48"

[keyboard_style.type]
letter_spacing = 3
case = "upper"

