[motion]
keyboard = "swift"
numpad = "swift"
menu = "swift"
media = "swift"
offer = "swift"
info = "swift"
log = "swift"

[sounds.menu]
step = {kind = "blip", volume = 0.06, pitch = 1.4}
pick = {kind = "zap", volume = 0.12}

[sounds.keyboard]
step = {kind = "blip", volume = 0.06, pitch = 1.4}
pick = {kind = "beep", volume = 0.1, pitch = 1.3}

[sounds.numpad]
step = {kind = "blip", volume = 0.06, pitch = 1.4}
pick = {kind = "beep", volume = 0.1, pitch = 1.3}

[sounds.media]
pick = {kind = "zap", volume = 0.12}

[rumble.menu]
step = {strength = 0.1, length_ms = 18}
pick = {strength = 0.35, length_ms = 35}

[rumble.keyboard]
step = {strength = 0.07, length_ms = 14}
pick = {strength = 0.24, length_ms = 22}

[rumble.numpad]
step = {strength = 0.07, length_ms = 14}
pick = {strength = 0.24, length_ms = 22}

[rumble.media]
