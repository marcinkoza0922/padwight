format = 20
macros = []
overlay_font = "Kreon"

[pack]
id = "dfeb2fc4-7fe7-4e9f-97f2-c751c503df24"
name = "Plants vs. Zombies"
version = "1.0"
author = "Padwight"
description = "Plants vs. Zombies on an Xbox-style pad. The game takes only the mouse, so the right stick moves the pointer and the left stick nudges it; RT and A click to pick and plant, LT and B right-click to put a packet back. Hold X and sweep to gather sun. Start is the menu."
made_with = "Xbox controller"

[[rules]]
kind = "steam_app_id"
value = "3590"
profile = "Plants vs. Zombies"

[[rules]]
kind = "executable"
value = "PlantsVsZombies.exe"
profile = "Plants vs. Zombies"

[[rules]]
kind = "executable"
value = "popcapgame1.exe"
profile = "Plants vs. Zombies"

[[profiles]]
name = "Plants vs. Zombies"
combos = []
combo_window_ms = 120
tap_window_ms = 250
long_press_ms = 500

[profiles.buttons]
Guide = {mode = "Guide"}
South = {mouse = "Left"}
East = {mouse = "Right"}
West = {turbo = {action = {mouse = "Left"}, rate = 12.0}}
Start = {keys = ["KEY_ESC"]}

[profiles.left_stick]
deadzone = 0.12
curve = 1.6
key_threshold = 0.5

[profiles.left_stick.action.mouse]
speed = 500.0
accel = 0.0

[profiles.right_stick]
deadzone = 0.12
curve = 1.7
key_threshold = 0.5

[profiles.right_stick.action.mouse]
speed = 1500.0
accel = 0.3

[profiles.left_trigger.action.button]
threshold = 0.4
action = {mouse = "Right"}

[profiles.right_trigger.action.button]
threshold = 0.3
action = {mouse = "Left"}

[profiles.gyro]
enabled = false
horizontal = "yaw"
invert_x = false
invert_y = false
noise_threshold = 1.0

[profiles.guide]
notes = '''The game is played with the mouse alone. The right stick {rs} moves the pointer and the left stick {ls} moves it slowly, for a precise tile.
{rt} or {south} clicks: pick a seed packet, then click the lawn to plant it. {lt} or {east} right-clicks to put the packet or the shovel back.
Hold {west} and sweep the pointer over the lawn to click again and again, gathering sun and coins as you pass.
{start} opens the menu and pauses. Typing your name: {guide} + {west} opens the on-screen keyboard. Media controls: {guide} + {lb}.'''

[profiles.guide.edits]
"stick:Left" = {text = "Fine pointer"}
"stick:Right" = {text = "Pointer"}
"trigger:Right" = {text = "{icon:plant} Click (plant)"}
"trigger:Left" = {text = "Right-click (put back)"}
"button:South" = {text = "{icon:plant} Click"}
"button:East" = {text = "Put back"}
"button:West" = {text = "Hold: {icon:sun} gather sun"}
"button:Start" = {text = "{icon:pause} Menu"}


[[profiles]]
name = "Plants vs. Zombies + Gyro"
combos = [
    {buttons = ["Select", "Start"], action = "gyro_clutch"},
]
combo_window_ms = 120
tap_window_ms = 250
long_press_ms = 500
requires = ["gyro"]

[profiles.buttons]
Guide = {mode = "Guide"}
South = {mouse = "Left"}
East = {mouse = "Right"}
West = {turbo = {action = {mouse = "Left"}, rate = 12.0}}
Start = {keys = ["KEY_ESC"]}

[profiles.left_stick]
deadzone = 0.12
curve = 1.6
key_threshold = 0.5

[profiles.left_stick.action.mouse]
speed = 500.0
accel = 0.0

[profiles.right_stick]
deadzone = 0.12
curve = 1.7
key_threshold = 0.5

[profiles.right_stick.action.mouse]
speed = 1500.0
accel = 0.3

[profiles.left_trigger.action.button]
threshold = 0.4
action = {mouse = "Right"}

[profiles.right_trigger.action.button]
threshold = 0.3
action = {mouse = "Left"}

[profiles.gyro]
horizontal = "yaw"
invert_x = false
invert_y = false
noise_threshold = 1.0

[profiles.gyro.mode.mouse]
sensitivity = 20.0

[profiles.guide]
notes = '''Hold {select} and {start} together to pause the gyro while you reposition the controller. Tilting the controller moves the pointer, as a fine pointer next to the right stick {rs}.
The game is played with the mouse alone. The right stick {rs} moves the pointer and the left stick {ls} moves it slowly, for a precise tile.
{rt} or {south} clicks: pick a seed packet, then click the lawn to plant it. {lt} or {east} right-clicks to put the packet or the shovel back.
Hold {west} and sweep the pointer over the lawn to click again and again, gathering sun and coins as you pass.
{start} opens the menu and pauses. Typing your name: {guide} + {west} opens the on-screen keyboard. Media controls: {guide} + {lb}.'''

[profiles.guide.edits]
"stick:Left" = {text = "Fine pointer"}
"stick:Right" = {text = "Pointer"}
"trigger:Right" = {text = "{icon:plant} Click (plant)"}
"trigger:Left" = {text = "Right-click (put back)"}
"button:South" = {text = "{icon:plant} Click"}
"button:East" = {text = "Put back"}
"button:West" = {text = "Hold: {icon:sun} gather sun"}
"button:Start" = {text = "{icon:pause} Menu"}


