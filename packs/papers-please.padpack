format = 20
macros = []
overlay_font = "Silkscreen"

[pack]
id = "f5f6e70d-7395-4da6-a09d-30d01673d5ba"
name = "Papers, Please"
version = "1.0"
author = "Padwight"
description = "Papers, Please on an Xbox-style pad. The game takes only the mouse, so the right stick moves the pointer and the left stick nudges it; hold RT or A to drag documents and stamps, Y toggles inspection mode. Start is the menu. Overlays in booth brown, document paper and stamp red. The \"Papers, Please + Gyro\" profile also moves the pointer by tilting the controller."
made_with = "Xbox controller"

[[rules]]
kind = "steam_app_id"
value = "239030"
profile = "Papers, Please"

[[rules]]
kind = "executable"
value = "PapersPlease.exe"
profile = "Papers, Please"

[[rules]]
kind = "executable"
value = "PapersPlease.x86_64"
profile = "Papers, Please"

[[profiles]]
name = "Papers, Please"
combos = []
combo_window_ms = 120
tap_window_ms = 250
long_press_ms = 500

[profiles.buttons]
Guide = {mode = "Guide"}
South = {mouse = "Left"}
East = {mouse = "Right"}
North = {keys = ["KEY_TAB"]}
Start = {keys = ["KEY_ESC"]}

[profiles.left_stick]
deadzone = 0.12
curve = 1.6
key_threshold = 0.5

[profiles.left_stick.action.mouse]
speed = 500.0
accel = 0.0

[profiles.right_stick]
deadzone = 0.12
curve = 1.7
key_threshold = 0.5

[profiles.right_stick.action.mouse]
speed = 1300.0
accel = 0.3

[profiles.left_trigger.action.button]
threshold = 0.4
action = {mouse = "Right"}

[profiles.right_trigger.action.button]
threshold = 0.3
action = {mouse = "Left"}

[profiles.gyro]
enabled = false
horizontal = "yaw"
invert_x = false
invert_y = false
noise_threshold = 1.0

[profiles.guide]
notes = '''The game is played with the mouse alone. The right stick {rs} moves the pointer and the left stick {ls} moves it slowly, for a small line of text on a document.
Hold {rt} or {south} to drag: hand papers across the desk, pull out the stamp tray, slide documents back to the entrant. Let go to drop. A quick press clicks: the loudspeaker, the shutter, a stamp.
{north} toggles inspection mode (Tab), where you click two lines that don't match to question the entrant. The key is from memory and unchecked; if it doesn't answer, click the inspect button at the bottom right of the desk.
{lt} or {east} right-clicks. {start} opens the menu.
The game has no key settings, and the Vita release was played by touch, so there was no console layout to copy. The Linux executable name is a guess.'''

[profiles.guide.edits]
"stick:Left" = {text = "Fine pointer"}
"stick:Right" = {text = "Pointer"}
"trigger:Right" = {text = "{icon:hand} Click · {b}hold to drag{/b}"}
"trigger:Left" = {text = "Right-click"}
"button:South" = {text = "Click · hold to drag"}
"button:East" = {text = "Right-click"}
"button:North" = {text = "{icon:search} {b}Inspect{/b}"}
"button:Start" = {text = "{icon:pause} Menu"}


[[profiles]]
name = "Papers, Please + Gyro"
combos = [
    {buttons = ["Select", "Start"], action = "gyro_clutch"},
]
combo_window_ms = 120
tap_window_ms = 250
long_press_ms = 500
requires = ["gyro"]

[profiles.buttons]
Guide = {mode = "Guide"}
South = {mouse = "Left"}
East = {mouse = "Right"}
North = {keys = ["KEY_TAB"]}
Start = {keys = ["KEY_ESC"]}

[profiles.left_stick]
deadzone = 0.12
curve = 1.6
key_threshold = 0.5

[profiles.left_stick.action.mouse]
speed = 500.0
accel = 0.0

[profiles.right_stick]
deadzone = 0.12
curve = 1.7
key_threshold = 0.5

[profiles.right_stick.action.mouse]
speed = 1300.0
accel = 0.3

[profiles.left_trigger.action.button]
threshold = 0.4
action = {mouse = "Right"}

[profiles.right_trigger.action.button]
threshold = 0.3
action = {mouse = "Left"}

[profiles.gyro]
horizontal = "yaw"
invert_x = false
invert_y = false
noise_threshold = 1.0

[profiles.gyro.mode.mouse]
sensitivity = 20.0

[profiles.guide]
notes = '''Hold {select} and {start} together to pause the gyro while you reposition the controller. Tilting the controller moves the pointer, as a fine pointer next to the right stick {rs}.
The game is played with the mouse alone. The right stick {rs} moves the pointer and the left stick {ls} moves it slowly, for a small line of text on a document.
Hold {rt} or {south} to drag: hand papers across the desk, pull out the stamp tray, slide documents back to the entrant. Let go to drop. A quick press clicks: the loudspeaker, the shutter, a stamp.
{north} toggles inspection mode (Tab), where you click two lines that don't match to question the entrant. The key is from memory and unchecked; if it doesn't answer, click the inspect button at the bottom right of the desk.
{lt} or {east} right-clicks. {start} opens the menu.
The game has no key settings, and the Vita release was played by touch, so there was no console layout to copy. The Linux executable name is a guess.'''

[profiles.guide.edits]
"stick:Left" = {text = "Fine pointer"}
"stick:Right" = {text = "Pointer"}
"trigger:Right" = {text = "{icon:hand} Click · {b}hold to drag{/b}"}
"trigger:Left" = {text = "Right-click"}
"button:South" = {text = "Click · hold to drag"}
"button:East" = {text = "Right-click"}
"button:North" = {text = "{icon:search} {b}Inspect{/b}"}
"button:Start" = {text = "{icon:pause} Menu"}
"combo:button:Select+button:Start" = {text = "Pause gyro (hold)"}


