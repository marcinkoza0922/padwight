format = 20
macros = []
overlay_font = "Comfortaa"

[pack]
id = "2b7e6f0e-5d1c-4a8e-9f4b-7c3e2d1a9b60"
name = "Doki Doki Literature Club!"
version = "1.0"
author = "Padwight"
description = "Doki Doki Literature Club! (the 2017 free release) on an Xbox-style pad. The game takes only the mouse and keyboard, so the right stick moves the pointer and the left stick nudges it; A or RT clicks to read on and choose, B or LT opens the game menu. Y toggles skip, RB holds it, LB and the D-pad roll back and forward, X hides the text box. Start is the menu. Overlays in the club's pink and white, with the menu's polka dots. The \"Doki Doki Literature Club! + Gyro\" profile also moves the pointer by tilting the controller."
made_with = "Xbox controller"

[[rules]]
kind = "steam_app_id"
value = "698780"
profile = "Doki Doki Literature Club!"

[[rules]]
kind = "executable"
value = "DDLC.exe"
profile = "Doki Doki Literature Club!"

[[rules]]
kind = "executable"
value = "DDLC"
profile = "Doki Doki Literature Club!"

[[profiles]]
name = "Doki Doki Literature Club!"
combos = []
combo_window_ms = 120
tap_window_ms = 250
long_press_ms = 500

[profiles.buttons]
Guide = {mode = "Guide"}
South = {mouse = "Left"}
East = {mouse = "Right"}
West = {keys = ["KEY_H"]}
North = {keys = ["KEY_TAB"]}
LeftBumper = {keys = ["KEY_PAGEUP"]}
RightBumper = {keys = ["KEY_LEFTCTRL"]}
Start = {keys = ["KEY_ESC"]}
DpadUp = {wheel = "Up"}
DpadDown = {wheel = "Down"}

[profiles.left_stick]
deadzone = 0.12
curve = 1.6
key_threshold = 0.5

[profiles.left_stick.action.mouse]
speed = 500.0
accel = 0.0

[profiles.right_stick]
deadzone = 0.12
curve = 1.7
key_threshold = 0.5

[profiles.right_stick.action.mouse]
speed = 1300.0
accel = 0.3

[profiles.left_trigger.action.button]
threshold = 0.4
action = {mouse = "Right"}

[profiles.right_trigger.action.button]
threshold = 0.3
action = {mouse = "Left"}

[profiles.gyro]
enabled = false
horizontal = "yaw"
invert_x = false
invert_y = false
noise_threshold = 1.0

[profiles.guide]
notes = '''The game is a Ren'Py visual novel played with the mouse. The right stick {rs} moves the pointer and the left stick {ls} moves it slowly.
{south} or {rt} clicks: it reads on to the next line and picks a choice, a menu button or a word in the poem game. {east} or {lt} right-clicks, which opens the game menu (save, load, settings) and closes it again.
{north} toggles skip (Tab) and holding {rb} skips while held (Ctrl); both skip only text you have read unless the settings say otherwise. {lb} and {up} roll back to earlier lines, {down} rolls forward again. {west} hides the text box (H), to see the picture; press it again to bring it back.
{start} opens the game menu too (Escape). Naming the player at the start needs typing: {guide} + {west} opens the on-screen keyboard.
The game has no key settings and the keys are Ren'Py's defaults, from memory and unchecked on an install. The wiki lists no controller support for this release; the 2021 Plus edition is a different game with a pad scheme of its own. The Linux executable name is a guess.'''

[profiles.guide.edits]
"stick:Left" = {text = "Fine pointer"}
"stick:Right" = {text = "Pointer"}
"trigger:Right" = {text = "{icon:hand} {b}Click{/b} · read on"}
"trigger:Left" = {text = "Game menu"}
"button:South" = {text = "{b}Click{/b} · read on"}
"button:East" = {text = "Game menu (right-click)"}
"button:West" = {text = "{icon:eye} Hide text box"}
"button:North" = {text = "{icon:fast} {b}Skip{/b} on / off"}
"button:LeftBumper" = {text = "{icon:rotate-left} Roll back"}
"button:RightBumper" = {text = "{icon:fast} Skip (hold)"}
"button:Start" = {text = "{icon:pause} Menu"}

[[profiles.guide.merged]]
inputs = ["button:DpadUp", "button:DpadDown"]
text = "{icon:rotate-left} Roll back · forward"

[[profiles]]
name = "Doki Doki Literature Club! + Gyro"
combos = [
    {buttons = ["Select", "Start"], action = "gyro_clutch"},
]
combo_window_ms = 120
tap_window_ms = 250
long_press_ms = 500
requires = ["gyro"]

