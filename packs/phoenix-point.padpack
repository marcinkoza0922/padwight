format = 20
macros = []
overlay_font = "Cinzel"

[pack]
id = "ee9195cc-8d50-5432-bed4-21bebb05ff64"
name = "Phoenix Point"
version = "1.0"
author = "Padwight"
description = "Phoenix Point with its own controller support. The controller passes through to the game untouched; the game's options set the buttons. Padwight adds the Guide overlay in the game's colors."
made_with = "Xbox controller"

[[rules]]
kind = "steam_app_id"
value = "839770"
profile = "Phoenix Point"

[[rules]]
kind = "executable"
value = "phoenixpointwin64.exe"
profile = "Phoenix Point"

[[profiles]]
name = "Phoenix Point"
combos = []
combo_window_ms = 120
tap_window_ms = 250
long_press_ms = 500

[profiles.buttons]
South = {gamepad = "South"}
East = {gamepad = "East"}
North = {gamepad = "North"}
West = {gamepad = "West"}
LeftBumper = {gamepad = "LeftBumper"}
RightBumper = {gamepad = "RightBumper"}
LeftStick = {gamepad = "LeftStick"}
RightStick = {gamepad = "RightStick"}
Select = {gamepad = "Select"}
Start = {gamepad = "Start"}
DpadUp = {gamepad = "DpadUp"}
DpadDown = {gamepad = "DpadDown"}
DpadLeft = {gamepad = "DpadLeft"}
DpadRight = {gamepad = "DpadRight"}
Guide = {mode = "Guide"}

[profiles.left_stick]
deadzone = 0.05
curve = 1.0
key_threshold = 0.3

[profiles.left_stick.action]
gamepad = {stick = "Left", invert_y = false}

[profiles.right_stick]
deadzone = 0.05
curve = 1.0
key_threshold = 0.3

[profiles.right_stick.action]
gamepad = {stick = "Right", invert_y = false}

[profiles.left_trigger]
action = {gamepad = "Left"}

[profiles.right_trigger]
action = {gamepad = "Right"}

[profiles.gyro]
enabled = false
horizontal = "yaw"
invert_x = false
invert_y = false
noise_threshold = 1.0

[profiles.guide]
notes = '''The game has its own controller support, so the controller passes through untouched and the game's own options set the buttons. {guide} still works over the game: {guide} + {west} opens the on-screen keyboard for names and text, and {guide} + {lb} the media controls.'''


[keyboard_style]
corners = 0.1
position = "bottom_center"
scale = 1.0

[keyboard_style.background]
color = "#2b2118"
opacity = 0.93

[keyboard_style.items]
color = "#44331f"
opacity = 0.95

[keyboard_style.selected]
color = "#c9a24b"
opacity = 1.0

[keyboard_style.border]
width = 1
color = "#b08d3c"
opacity = 0.8

[keyboard_style.gradient]
color = "#1d1610"
opacity = 1.0
angle = 180

[keyboard_style.item_border]
width = 1
color = "#6b5430"

[keyboard_style.type]
letter_spacing = 0

[numpad_style]
corners = 0.1
position = "center"
scale = 1.0

[numpad_style.background]
color = "#2b2118"
opacity = 0.93

[numpad_style.items]
color = "#44331f"
opacity = 0.95

[numpad_style.selected]
color = "#c9a24b"
opacity = 1.0

[numpad_style.border]
width = 1
color = "#b08d3c"
opacity = 0.8

[numpad_style.gradient]
color = "#1d1610"
opacity = 1.0
angle = 180

[numpad_style.item_border]
width = 1
color = "#6b5430"

[numpad_style.type]
letter_spacing = 0

[media_style]
corners = 0.1
position = "top_right"
scale = 0.9

[media_style.background]
color = "#2b2118"
opacity = 0.93

[media_style.items]
color = "#44331f"
opacity = 0.95

[media_style.selected]
color = "#c9a24b"
opacity = 1.0

[media_style.border]
width = 1
color = "#b08d3c"
opacity = 0.8

[media_style.gradient]
color = "#1d1610"
opacity = 1.0
angle = 180

[media_style.item_border]
width = 1
color = "#6b5430"

[media_style.type]
letter_spacing = 0

[menu_style]
corners = 0.1
position = "center"
scale = 1.0

[menu_style.background]
color = "#2b2118"
opacity = 0.93

[menu_style.items]
color = "#44331f"
opacity = 0.95

[menu_style.selected]
color = "#c9a24b"
opacity = 1.0

[menu_style.border]
width = 1
color = "#b08d3c"
opacity = 0.8

[menu_style.gradient]
color = "#1d1610"
opacity = 1.0
angle = 180

[menu_style.item_border]
width = 1
color = "#6b5430"

[menu_style.type]
letter_spacing = 0

[menu_style.ornament]
frame = {kind = "brackets", size = 12, width = 2, color = "#b08d3c"}
dividers = {width = 1, color = "#6b5430", opacity = 0.8}

[motion]
keyboard = "stagger"
numpad = "stagger"
menu = "stagger"
media = "stagger"
offer = "stagger"
info = "stagger"
log = "stagger"

[sounds.menu]
step = {kind = "wood", volume = 0.07}
pick = {kind = "page", volume = 0.09}
open = {kind = "page", volume = 0.07}
close = {kind = "wood", volume = 0.06, pitch = 0.8}

[sounds.numpad]
step = {kind = "wood", volume = 0.07}
pick = {kind = "page", volume = 0.09}

[sounds.keyboard]
step = {kind = "wood", volume = 0.07}
pick = {kind = "keys", volume = 0.12}

[sounds.media]
pick = {kind = "page", volume = 0.09}
