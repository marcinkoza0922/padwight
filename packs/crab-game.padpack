format = 20
macros = []
overlay_font = "Comfortaa"

[pack]
id = "1c3061a9-323b-42c4-947d-2dff9d26ebed"
name = "Crab Game"
version = "1.0"
author = "Padwight"
description = "Crab Game on an Xbox-style pad, for the game's default keys. A picks up and uses things and, held, sprints, B jumps, X is push-to-talk, Y drops your item, RT punches or uses what you hold and LT is the right mouse button. L3 toggles crouch, D-pad up opens chat and Select holds the player list. The game has no controller support. Gyro and flick stick profiles are included to try."
made_with = "Xbox controller"

[[rules]]
kind = "steam_app_id"
value = "1782210"
profile = "Crab Game"

[[rules]]
kind = "executable"
value = "Crab Game.exe"
profile = "Crab Game"
[[profiles]]
name = "Crab Game"
combos = []
combo_window_ms = 120
tap_window_ms = 250
long_press_ms = 250

[profiles.buttons]
Guide = { mode = "Guide" }
South = { keys = ["KEY_E"] }
East = { keys = ["KEY_SPACE"] }
West = { keys = ["KEY_V"] }
North = { keys = ["KEY_Q"] }
LeftStick = { toggle = { action = { keys = ["KEY_LEFTCTRL"] } } }
Select = { keys = ["KEY_TAB"] }
Start = { keys = ["KEY_ESC"] }
DpadUp = { keys = ["KEY_T"] }

[profiles.gestures.South]
long_press = { keys = ["KEY_LEFTSHIFT"] }

[profiles.left_stick]
deadzone = 0.12
curve = 1.0
key_threshold = 0.25

[profiles.left_stick.action.ring]
sectors = 8
start_angle = 0.0
inner_radius = 0.25
hysteresis = 0.1

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_W"]

[[profiles.left_stick.action.ring.actions]]
multi = [{ keys = ["KEY_W"] }, { keys = ["KEY_D"] }]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_D"]

[[profiles.left_stick.action.ring.actions]]
multi = [{ keys = ["KEY_S"] }, { keys = ["KEY_D"] }]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_S"]

[[profiles.left_stick.action.ring.actions]]
multi = [{ keys = ["KEY_S"] }, { keys = ["KEY_A"] }]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_A"]

[[profiles.left_stick.action.ring.actions]]
multi = [{ keys = ["KEY_W"] }, { keys = ["KEY_A"] }]

[profiles.right_stick]
deadzone = 0.08
curve = 2.0
key_threshold = 0.5

[profiles.right_stick.action.mouse]
speed = 3500.0
accel = 0.2

[profiles.left_trigger.action.button]
threshold = 0.4
action = { mouse = "Right" }

[profiles.right_trigger.action.button]
threshold = 0.3
action = { mouse = "Left" }

[profiles.guide]
notes = '''{start} (Escape) opens the game's menu and closes the other screens.
{south} picks up and uses things; hold {south} to sprint. {east} jumps, and {l3} toggles crouch. {rt} punches, swings or shoots what you're holding, {lt} is the right mouse button, and {north} drops your item.
Hold {west} to talk on proximity voice chat. {up} opens the text chat: type with the on-screen keyboard ({guide} + {west}), then press Enter. Hold {select} for the player list.
These keys are written from memory and not checked in the game (sprint, crouch, drop, voice and chat especially); compare them with the game's Settings → Controls and change the buttons here to match. The gyro's full turn is a guess, not measured: turn in place and adjust it until a full turn of the controller turns you around once.'''

[profiles.guide.edits]
"stick:Left" = { text = "Move" }
"stick:Right" = { text = "Look" }
"trigger:Right" = { text = "{icon:fist} Punch / use item" }
"trigger:Left" = { text = "Right click" }
"button:South" = { text = "{icon:hand} Pick up · interact" }
"gesture:button:South:long_press" = { text = "Sprint (hold)" }
"button:East" = { text = "Jump" }
"button:West" = { text = "{icon:microphone} Voice (hold)" }
"button:North" = { text = "{icon:drop-item} Drop item" }
"button:LeftStick" = { text = "Crouch (toggle)" }
"button:DpadUp" = { text = "{icon:messages} Chat" }
"button:Select" = { text = "{icon:people} Players" }
"button:Start" = { text = "Menu" }

