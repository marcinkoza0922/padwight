format = 20
macros = []
overlay_font = "Cinzel"

[pack]
id = "19ea66dd-4b94-5e17-990e-c74838dd50a5"
name = "The Elder Scrolls III: Morrowind"
version = "1.0"
author = "Padwight"
description = "Morrowind (GOG and Steam, 2002) on an Xbox-style pad, laid out like the original Xbox release for the game's default keys. A activates, RT attacks and casts, LT jumps, X readies the weapon (hold: fists) and Y readies magic. LB opens the journal, RB waits and rests. A light push on the left stick walks and a full push runs. In menus the right stick moves the cursor and RT clicks."
made_with = "Xbox controller"

[[rules]]
kind = "executable"
value = "Morrowind.exe"
profile = "The Elder Scrolls III: Morrowind"

[[rules]]
kind = "steam_app_id"
value = "22320"
profile = "The Elder Scrolls III: Morrowind"

[[profiles]]
name = "The Elder Scrolls III: Morrowind"
combos = []
combo_window_ms = 120
tap_window_ms = 250
long_press_ms = 500

[profiles.buttons]
Guide = {mode = "Guide"}
South = {keys = ["KEY_SPACE"]}
East = {mouse = "Right"}
West = {keys = ["KEY_F"]}
North = {keys = ["KEY_R"]}
LeftBumper = {keys = ["KEY_J"]}
RightBumper = {keys = ["KEY_T"]}
LeftStick = {toggle = {keys = ["KEY_LEFTCTRL"]}}
RightStick = {keys = ["KEY_TAB"]}
DpadLeft = {keys = ["KEY_LEFTBRACE"]}
DpadRight = {keys = ["KEY_RIGHTBRACE"]}
DpadUp = {keys = ["KEY_EQUAL"]}
DpadDown = {keys = ["KEY_MINUS"]}
Select = {open_menu = "Screens"}
Start = {keys = ["KEY_ESC"]}

[profiles.gestures.West.long_press]
keys = ["KEY_0"]

[profiles.gestures.LeftBumper.long_press]
open_menu = "Quick keys"

[profiles.gestures.Start.double_tap]
keys = ["KEY_F5"]

[profiles.gestures.Start.long_press]
keys = ["KEY_F9"]

[profiles.left_stick]
deadzone = 0.12
curve = 1.0
key_threshold = 0.25

[profiles.left_stick.action.ring]
sectors = 8
start_angle = 0.0
inner_radius = 0.25
hysteresis = 0.1

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_W"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_W"] },
    { keys = ["KEY_D"] },
]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_D"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_S"] },
    { keys = ["KEY_D"] },
]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_S"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_S"] },
    { keys = ["KEY_A"] },
]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_A"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_W"] },
    { keys = ["KEY_A"] },
]

[[profiles.left_stick.zones]]
min = 0.6
max = 1.0
action = {keys = ["KEY_LEFTSHIFT"]}

[profiles.right_stick]
deadzone = 0.1
curve = 1.6
key_threshold = 0.5

[profiles.right_stick.action.mouse]
speed = 1300.0
accel = 0.2

[profiles.left_trigger.action.button]
threshold = 0.3
action = {keys = ["KEY_E"]}

[profiles.right_trigger.action.button]
threshold = 0.3
action = {mouse = "Left"}

[profiles.gyro]
enabled = false
horizontal = "yaw"
invert_x = false
invert_y = false
noise_threshold = 1.0

[profiles.guide]
notes = '''This is the original Xbox layout: {south} activates, {rt} attacks, casts and uses, and {lt} jumps. {west} readies your weapon (hold it for fists) and {north} readies magic.
A light push on the left stick {ls} walks; push it all the way to run. Click {ls} to turn sneaking on or off.
{lb} opens the journal and {rb} waits or rests. Hold {lb} for the quick keys 1 to 9. {dpad} left and right cycle weapons, up and down cycle spells.
Morrowind's menus want a mouse: move the cursor with {rs} and click with {rt}. {b} opens and closes the inventory menu. {start} is the game menu; double tap it to quick save, hold it to quick load.'''

[profiles.guide.edits]
"stick:Left" = {text = "Move (light push: walk)"}
"stick:Right" = {text = "Look / menu cursor"}
"trigger:Right" = {text = "{icon:sword} {b}Attack{/b}, cast, click"}
"trigger:Left" = {text = "Jump"}
"button:South" = {text = "Activate"}
"button:East" = {text = "{icon:bag} Inventory menu"}
"button:West" = {text = "{icon:sword} Ready weapon (hold: fists)"}
"button:North" = {text = "{icon:scroll} Ready magic"}
"button:LeftBumper" = {text = "{icon:book} Journal (hold: quick keys)"}
"button:RightBumper" = {text = "{icon:sleep} Wait / rest"}
"button:LeftStick" = {text = "{icon:footprints} Sneak (toggle)"}
"button:RightStick" = {text = "{icon:eye} Change view"}
"button:DpadLeft" = {text = "Previous weapon"}
"button:DpadRight" = {text = "Next weapon"}
"button:DpadUp" = {text = "Next spell"}
"button:DpadDown" = {text = "Previous spell"}
"button:Select" = {text = "{icon:map} Screens, run options"}
"button:Start" = {text = "Menu (2x: save, hold: load)"}

