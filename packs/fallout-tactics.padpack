format = 19
macros = []
overlay_font = "Rajdhani"

[pack]
id = "1bbbd1f1-26ed-4898-bf24-64025dd69651"
name = "Fallout Tactics"
version = "1.1"
author = "Padwight"
description = "Fallout Tactics: Brotherhood of Steel (GOG) on an Xbox-style pad. The right stick moves the pointer, the left stick scrolls the map, RT or A left-clicks and LT right-clicks to fire. Hold RB to run. X reloads (hold: weapon mode, double tap: targeted shot), Y is the inventory, B stops or ends a character's turn (hold: end turn). The d-pad sets the stance. R3 switches turn-based play (hold: pause). Hold LB for the squad and sentry modes. Select lists the Skilldex, character screen and Pip-Boy. Start is the menu; double tap it to quick save, hold it to quick load."
made_with = "Xbox controller"

[[rules]]
kind = "executable"
value = "BOS.exe"
profile = "Fallout Tactics"

[[rules]]
kind = "executable"
value = "BOS_HR.exe"
profile = "Fallout Tactics"

[[rules]]
kind = "steam_app_id"
value = "38420"
profile = "Fallout Tactics"

[[profiles]]
name = "Fallout Tactics"
combos = []
combo_window_ms = 120
tap_window_ms = 250
long_press_ms = 500

[profiles.buttons]
Guide = { mode = "Guide" }
South = { mouse = "Left" }
East = { keys = ["KEY_BACKSPACE"] }
West = { keys = ["KEY_R"] }
North = { keys = ["KEY_I"] }
LeftBumper = { open_menu = "Squad" }
RightBumper = { keys = ["KEY_LEFTSHIFT"] }
Select = { open_menu = "Screens" }
Start = { keys = ["KEY_ESC"] }
LeftStick = { keys = ["KEY_LEFTCTRL"] }
RightStick = { keys = ["KEY_ENTER"] }
DpadUp = { keys = ["KEY_Q"] }
DpadRight = { keys = ["KEY_A"] }
DpadDown = { keys = ["KEY_Z"] }
DpadLeft = { keys = ["KEY_U"] }

[profiles.gestures.East.long_press]
keys = ["KEY_LEFTCTRL", "KEY_SPACE"]

[profiles.gestures.West.long_press]
keys = ["KEY_Y"]

[profiles.gestures.West.double_tap]
keys = ["KEY_T"]

[profiles.gestures.LeftBumper.double_tap]
keys = ["KEY_SPACE"]

[profiles.gestures.RightStick.long_press]
keys = ["KEY_PAUSE"]

[profiles.gestures.Start.double_tap]
keys = ["KEY_LEFTALT", "KEY_S"]

[profiles.gestures.Start.long_press]
keys = ["KEY_LEFTALT", "KEY_L"]

[profiles.left_stick]
deadzone = 0.15
curve = 1.0
key_threshold = 0.35

[profiles.left_stick.action.keys]
up = "KEY_UP"
down = "KEY_DOWN"
left = "KEY_LEFT"
right = "KEY_RIGHT"

[profiles.right_stick]
deadzone = 0.12
curve = 1.8
key_threshold = 0.5

[profiles.right_stick.action.mouse]
speed = 1500.0
accel = 0.3

[profiles.left_trigger.action.button]
threshold = 0.4
action = { mouse = "Right" }

[profiles.right_trigger.action.button]
threshold = 0.3
action = { mouse = "Left" }

[profiles.guide]
notes = '''The right stick moves the mouse pointer; {rt} or {south} is a left click and {lt} a right click. Hold {guide} and press {west} for the on-screen keyboard when the game asks for a name.
Hold {rb} while clicking to run there. Hold {l3} while clicking to force a move to the same level, or to get in and out of a vehicle.
{r3} switches between continuous and turn-based play; hold it to pause continuous play.
In turn-based play, {east} ends the selected character's turn, holding {east} ends the whole turn, and double tapping {lb} goes to the next character.
Hold {lb} for squad members, the whole squad and the sentry modes, picking with the right stick {rs}.
The {dpad} sets the stance: up stands, right crouches, down goes prone. Left swaps hands.
Tap {west} to reload, hold it for the weapon mode, double tap it for a targeted shot.'''

[profiles.guide.edits]
"stick:Left" = { text = "Scroll the map" }
"stick:Right" = { text = "Pointer" }
"trigger:Right" = { text = "Left click (move, use, fire)" }
"trigger:Left" = { text = "Right click (fire)" }
"button:South" = { text = "Left click" }
"button:East" = { text = "Stop / end this one's turn" }
"gesture:button:East:long_press" = { text = "End turn" }
"button:West" = { text = "Reload" }
"gesture:button:West:long_press" = { text = "Weapon mode" }
"gesture:button:West:double_tap" = { text = "Targeted shot" }
"button:North" = { text = "Inventory" }
"button:LeftBumper" = { text = "Hold: squad, sentry modes" }
"gesture:button:LeftBumper:double_tap" = { text = "Next character" }
"button:RightBumper" = { text = "Hold: run (Shift)" }
"button:LeftStick" = { text = "Hold: Ctrl (force move, vehicles)" }
"button:RightStick" = { text = "Turn-based on / off" }
"gesture:button:RightStick:long_press" = { text = "Pause" }
"button:Select" = { text = "Skilldex, character, Pip-Boy" }
"button:Start" = { text = "Menu" }
"gesture:button:Start:double_tap" = { text = "Quick save" }
"gesture:button:Start:long_press" = { text = "Quick load" }
"button:DpadUp" = { text = "Stand" }
"button:DpadRight" = { text = "Crouch" }
"button:DpadDown" = { text = "Prone" }
"button:DpadLeft" = { text = "Swap hands" }

