format = 20
macros = []
overlay_font = "Rajdhani"

[pack]
id = "7379b186-e6d9-43ce-8f7e-141e0e1c30f6"
name = "Command & Conquer Remastered Collection"
version = "1.0"
author = "Padwight"
description = "Command & Conquer Remastered Collection (Tiberian Dawn and Red Alert) on an Xbox-style pad, for the default keys and the left-click control scheme. The game has no controller support, so the layout follows the other strategy packs on the game's keys. The right stick moves the cursor, RT left-clicks to select and order, LT right-clicks to deselect, the left stick scrolls the map. A selects every unit on screen, X guards, Y centers on your base, B stops; the d-pad zooms, holds Alt to force-move and scatters. Hold LB for control groups 1-10 (LB + RB sets one), L3 for force-fire (Ctrl). Select lists the graphics switch, chat and the menu; hold it for the Menus mode. Start is the menu. The \"+ Gyro\" profile also moves the cursor by tilting the controller."
made_with = "Xbox controller"

[[rules]]
kind = "executable"
value = "CnCRemastered/ClientG.exe"
profile = "Command & Conquer Remastered Collection"

[[rules]]
kind = "steam_app_id"
value = "1213210"
profile = "Command & Conquer Remastered Collection"

[[profiles]]
name = "Command & Conquer Remastered Collection"
combos = [{buttons = ["LeftBumper", "RightBumper"], action = {open_menu = "Set group"}}]
combo_window_ms = 120
tap_window_ms = 250
long_press_ms = 500

[profiles.buttons]
Guide = {mode = "Guide"}
South = {keys = ["KEY_E"]}
West = {keys = ["KEY_G"]}
North = {keys = ["KEY_H"]}
East = {keys = ["KEY_S"]}
LeftBumper = {open_menu = "Groups"}
RightBumper = {keys = ["KEY_LEFTSHIFT"]}
Select = {open_menu = "Game"}
Start = {keys = ["KEY_ESC"]}
LeftStick = {keys = ["KEY_LEFTCTRL"]}
DpadUp = {wheel = "Up"}
DpadDown = {wheel = "Down"}
DpadLeft = {keys = ["KEY_LEFTALT"]}
DpadRight = {keys = ["KEY_X"]}

[profiles.gestures.Select]
long_press = {mode = "Menus"}

[profiles.left_stick]
deadzone = 0.2
curve = 1.0
key_threshold = 0.45

[profiles.left_stick.action.ring]
sectors = 8
start_angle = 0.0
inner_radius = 0.45
hysteresis = 0.1

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_UP"]

[[profiles.left_stick.action.ring.actions]]
multi = [{ keys = ["KEY_UP"] }, { keys = ["KEY_RIGHT"] }]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_RIGHT"]

[[profiles.left_stick.action.ring.actions]]
multi = [{ keys = ["KEY_DOWN"] }, { keys = ["KEY_RIGHT"] }]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_DOWN"]

[[profiles.left_stick.action.ring.actions]]
multi = [{ keys = ["KEY_DOWN"] }, { keys = ["KEY_LEFT"] }]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_LEFT"]

[[profiles.left_stick.action.ring.actions]]
multi = [{ keys = ["KEY_UP"] }, { keys = ["KEY_LEFT"] }]

[profiles.right_stick]
deadzone = 0.1
curve = 1.6
key_threshold = 0.25

[profiles.right_stick.action.mouse]
speed = 1500.0
accel = 0.25

[profiles.left_trigger.action.button]
threshold = 0.4
action = { mouse = "Right" }

[profiles.right_trigger.action.button]
threshold = 0.3
action = { mouse = "Left" }

[profiles.gyro]
enabled = false
horizontal = "yaw"
invert_x = false
invert_y = false
noise_threshold = 1.0

[profiles.guide]
notes = '''The right stick {rs} moves the cursor. {rt} is the left click: it selects, gives orders and places structures, and a drag boxes units. {lt} is the right click: it deselects. The left stick {ls} scrolls the map, and {up} {down} zoom.
{south} selects every unit on screen, {west} guards, {north} centers the view on your base and {east} stops. {right} scatters the selected units.
Build from the sidebar on the right: click a unit or structure with {rt}, then click where it goes. Sell and repair are the buttons above it.
Hold {l3} (Ctrl) while clicking with {rt} to force-fire, and hold {left} (Alt) to force-move. Neither key can be changed in the game.
Hold {lb} for the control groups and aim the right stick {rs} at one: release to select it. Hold {lb} and {rb} together to put the selection in a group instead (Ctrl + number).
{rb} is Shift, to add to the selection.
{select} lists the classic / remastered graphics switch, chat and the menu. Hold {select} for the Menus mode (the launcher, the main menu, the lobbies and the map editor) and hold it again to come back. {start} (Esc) is the menu, and pauses a campaign or skirmish.
The keys are the game's defaults as best remembered, not checked on an install: select on screen (E), guard (G), center on base (H), scatter (X) and the graphics switch (Space) are the likeliest to differ. If a key does nothing, look in Options, Hotkeys. If you switched to the right-click control scheme, {lt} gives orders instead. Guide + {west} opens the on-screen keyboard for chat.'''

[profiles.guide.edits]
"stick:Left" = { text = "Scroll the map" }
"stick:Right" = { text = "Cursor" }
"trigger:Right" = { text = "Left click (select, order)" }
"trigger:Left" = { text = "Right click (deselect)" }
"button:South" = { text = "{icon:people} All units on screen" }
"button:West" = { text = "{icon:shield} Guard" }
"button:North" = { text = "{icon:home} Center on base" }
"button:East" = { text = "{icon:stop} Stop" }
"button:RightBumper" = { text = "Shift (add to selection)" }
"button:LeftBumper" = { text = "Hold: control groups" }
"button:LeftStick" = { text = "Hold: force-fire (Ctrl)" }
"button:DpadLeft" = { text = "Hold: force-move (Alt)" }
"button:DpadRight" = { text = "{icon:split} Scatter" }
"button:Start" = { text = "Menu" }
"gesture:button:Select:long_press" = { text = "Menus mode on / off" }
"button:Select" = { text = "Graphics, chat, menu" }

[[profiles.guide.merged]]
inputs = ["button:DpadUp", "button:DpadDown"]
text = "Zoom in / out"

[[profiles.guide.custom]]
inputs = ["button:LeftBumper", "button:RightBumper"]
text = "Set a control group"

[[profiles]]
