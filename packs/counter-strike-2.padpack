format = 20
macros = []
overlay_font = "Titillium Web"

[pack]
id = "14c16b7a-f56b-43c2-bda4-68bcac2da99b"
name = "Counter-Strike 2"
version = "1.0"
author = "Padwight"
description = "Counter-Strike 2 on an Xbox-style pad, for the game's default keys. A uses and defuses, B jumps, X reloads, Y takes out grenades, RT fires and LT is the scope or alternate fire. A light push of the left stick walks quietly, L3 toggles crouch and R3 pings. Hold LB for the weapon ring, RB switches to your last weapon (hold it to talk), the D-pad opens the buy menu, holds the scoreboard and cycles weapons, and Select lists chat, the radio and the team menu. The game has no controller support. Gyro and flick stick profiles are included to try."
made_with = "Xbox controller"

[[rules]]
kind = "steam_app_id"
value = "730"
profile = "Counter-Strike 2"

[[rules]]
kind = "executable"
value = "cs2"
profile = "Counter-Strike 2"

[[rules]]
kind = "executable"
value = "cs2.exe"
profile = "Counter-Strike 2"

[[profiles]]
name = "Counter-Strike 2"
combos = []
combo_window_ms = 120
tap_window_ms = 250
long_press_ms = 500

[profiles.buttons]
Guide = { mode = "Guide" }
South = { keys = ["KEY_E"] }
East = { keys = ["KEY_SPACE"] }
West = { keys = ["KEY_R"] }
North = { keys = ["KEY_4"] }
LeftBumper = { open_menu = "Weapons" }
RightBumper = { keys = ["KEY_Q"] }
LeftStick = { toggle = { action = { keys = ["KEY_LEFTCTRL"] } } }
RightStick = { mouse = "Middle" }
Select = { open_menu = "Comms" }
Start = { keys = ["KEY_ESC"] }
DpadUp = { keys = ["KEY_B"] }
DpadDown = { keys = ["KEY_TAB"] }
DpadLeft = { wheel = "Up" }
DpadRight = { wheel = "Down" }

[profiles.gestures.RightBumper]
long_press = { keys = ["KEY_K"] }

[profiles.left_stick]
deadzone = 0.12
curve = 1.0
key_threshold = 0.25

[profiles.left_stick.action.ring]
sectors = 8
start_angle = 0.0
inner_radius = 0.25
hysteresis = 0.1

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_W"]

[[profiles.left_stick.action.ring.actions]]
multi = [{ keys = ["KEY_W"] }, { keys = ["KEY_D"] }]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_D"]

[[profiles.left_stick.action.ring.actions]]
multi = [{ keys = ["KEY_S"] }, { keys = ["KEY_D"] }]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_S"]

[[profiles.left_stick.action.ring.actions]]
multi = [{ keys = ["KEY_S"] }, { keys = ["KEY_A"] }]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_A"]

[[profiles.left_stick.action.ring.actions]]
multi = [{ keys = ["KEY_W"] }, { keys = ["KEY_A"] }]

[[profiles.left_stick.zones]]
min = 0.0
max = 0.6
action = { keys = ["KEY_LEFTSHIFT"] }

[profiles.right_stick]
deadzone = 0.08
curve = 2.0
key_threshold = 0.5

[profiles.right_stick.action.mouse]
speed = 5800.0
accel = 0.2

[profiles.left_trigger.action.button]
threshold = 0.4
action = { mouse = "Right" }

[profiles.right_trigger.action.button]
threshold = 0.3
action = { mouse = "Left" }

[profiles.guide]
notes = '''{start} (Escape) opens the game's menu and closes the buy menu and other screens.
{south} uses and, held, defuses the bomb. {east} jumps, {west} reloads, {north} takes out your grenades (press again to cycle them). A light push of the left stick {ls} walks quietly (Shift), and {l3} toggles crouch.
{lt} is the right mouse button: it steps through a sniper's zoom levels, or the knife's and pistols' alternate attack. The game toggles the scope, so there's no slower aim while it's held.
Hold {lb} for the weapon ring, aiming with the right stick {rs}. {rb} switches to your last weapon; hold {rb} for voice chat (K). {left} and {right} step through weapons.
{up} opens the buy menu, and hold {down} for the scoreboard. {select} opens a list for team and all chat, the radio, inspecting or dropping your weapon and picking a team. {r3} pings where you look.
Chat needs typing: pick it from {select}, then {guide} + {west} opens the on-screen keyboard.
Valve's servers and anti-cheat: the pad reaches the game as an ordinary keyboard and mouse, which VAC allows. Valve kicks players whose inputs are automated (snap tap, one press doing several moves), so this setup has no macros. If a match ever kicks you for it, take the walk zone off the left stick.
These are the game's default keys, written from memory and not checked in the game. If you rebound keys in Settings, change the buttons here to match. The gyro's real-world turn assumes the game's default sensitivity of 1.25; set the full turn to 16364 divided by your sensitivity.'''

[profiles.guide.edits]
"stick:Left" = { text = "Move · light push: walk" }
"stick:Right" = { text = "Look" }
"trigger:Right" = { text = "Fire" }
"trigger:Left" = { text = "{icon:scope} Scope / alt fire" }
"button:South" = { text = "Use · hold: defuse" }
"button:East" = { text = "Jump" }
"button:West" = { text = "Reload" }
"button:North" = { text = "{icon:grenade} Grenades" }
"button:LeftBumper" = { text = "Hold: weapons" }
"button:RightBumper" = { text = "Last weapon" }
"gesture:button:RightBumper:long_press" = { text = "{icon:microphone} Voice" }
"button:LeftStick" = { text = "Crouch (toggle)" }
"button:RightStick" = { text = "Ping" }
"button:DpadUp" = { text = "{icon:money} Buy menu" }
"button:DpadDown" = { text = "Scoreboard" }
"button:Select" = { text = "{icon:radio} Comms" }
"button:Start" = { text = "Menu" }

[[profiles.guide.merged]]
inputs = ["button:DpadLeft", "button:DpadRight"]
text = "Previous / next weapon"

