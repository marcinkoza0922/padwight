position = "top_right"
scale = 0.9

[media_style.background]
color = "#0a1218"
opacity = 0.92

[media_style.items]
color = "#14242e"
opacity = 0.95

[media_style.selected]
color = "#3fd0e0"
opacity = 1.0

[media_style.border]
width = 1
color = "#2a8fa0"
opacity = 0.8

[media_style.gradient]
color = "#0e1a22"
