format = 20
macros = []
overlay_font = "Orbitron"

[pack]
id = "7b9619d9-9d08-49f1-aef4-a72002f7683e"
name = "No Man's Sky"
version = "1.0"
author = "Padwight"
description = "No Man's Sky on an Xbox-style pad, a DualShock 4 or a DualSense. The game has its own controller support, so the controller passes through untouched and the game's Controls options set the buttons. Padwight adds the Guide overlay on top, with the on-screen keyboard for naming discoveries and the media controls, in a visor's cyan."
made_with = "Xbox controller"

[controllers]
dualshock = true
dualsense = true

[[rules]]
kind = "steam_app_id"
value = "275850"
profile = "No Man's Sky"

[[rules]]
kind = "executable"
value = "NMS.exe"
profile = "No Man's Sky"

[[profiles]]
name = "No Man's Sky"
combos = []
combo_window_ms = 120
tap_window_ms = 250
long_press_ms = 500

[profiles.buttons]
South = {gamepad = "South"}
East = {gamepad = "East"}
North = {gamepad = "North"}
West = {gamepad = "West"}
LeftBumper = {gamepad = "LeftBumper"}
RightBumper = {gamepad = "RightBumper"}
LeftStick = {gamepad = "LeftStick"}
RightStick = {gamepad = "RightStick"}
Select = {gamepad = "Select"}
Start = {gamepad = "Start"}
DpadUp = {gamepad = "DpadUp"}
DpadDown = {gamepad = "DpadDown"}
DpadLeft = {gamepad = "DpadLeft"}
DpadRight = {gamepad = "DpadRight"}
Guide = {mode = "Guide"}

[profiles.left_stick]
deadzone = 0.05
curve = 1.0
key_threshold = 0.3

[profiles.left_stick.action]
gamepad = {stick = "Left", invert_y = false}

[profiles.right_stick]
deadzone = 0.05
curve = 1.0
key_threshold = 0.3

[profiles.right_stick.action]
gamepad = {stick = "Right", invert_y = false}

[profiles.left_trigger]
action = {gamepad = "Left"}

[profiles.right_trigger]
action = {gamepad = "Right"}

[profiles.gyro]
enabled = false
horizontal = "yaw"
invert_x = false
invert_y = false
noise_threshold = 1.0

[profiles.guide]
notes = '''No Man's Sky has its own controller support, so the controller goes to the game as it is. Set the buttons in the game's options, on the Controls tab. Walking and flight have separate invert options there.
On the Steam version the game reads the controller through Steam Input, so leave Steam Input on for this game.
{guide} still works over the game: {guide} + {west} opens the on-screen keyboard for naming a planet, a creature or a base, and {guide} + {lb} the media controls.
A DualShock 4 or DualSense is shown to the game as itself, with PlayStation prompts.'''

[keyboard_style]
corners = 0.1
position = "bottom_center"
scale = 1.0

[keyboard_style.background]
color = "#0a1218"
opacity = 0.92

[keyboard_style.items]
color = "#14242e"
opacity = 0.95

[keyboard_style.selected]
color = "#3fd0e0"
opacity = 1.0

[keyboard_style.border]
width = 1
color = "#2a8fa0"
opacity = 0.8

[keyboard_style.gradient]
color = "#0e1a22"
opacity = 1.0
angle = 180

[keyboard_style.item_border]
width = 1
color = "#25414d"

[numpad_style]
corners = 0.1
position = "center"
scale = 1.0

[numpad_style.background]
color = "#0a1218"
opacity = 0.92

[numpad_style.items]
color = "#14242e"
opacity = 0.95

[numpad_style.selected]
color = "#3fd0e0"
opacity = 1.0

[numpad_style.border]
width = 1
color = "#2a8fa0"
opacity = 0.8

[numpad_style.gradient]
color = "#0e1a22"
opacity = 1.0
angle = 180

[numpad_style.item_border]
width = 1
color = "#25414d"

[media_style]
