position = "center"
scale = 1.0

[menu_style.background]
color = "#0a1218"
opacity = 0.92

[menu_style.items]
color = "#14242e"
opacity = 0.95

[menu_style.selected]
color = "#3fd0e0"
opacity = 1.0

[menu_style.border]
width = 1
color = "#2a8fa0"
opacity = 0.8

[menu_style.gradient]
color = "#0e1a22"
opacity = 1.0
angle = 180
drift = true

[menu_style.item_border]
width = 1
