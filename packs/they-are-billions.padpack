format = 20
macros = []
overlay_font = "Cinzel"

[pack]
id = "67acc600-e443-491e-9ae1-d0a7477ba0b4"
name = "They Are Billions"
version = "1.0"
author = "Padwight"
description = "They Are Billions (Steam, Windows) on an Xbox-style pad, for the default keys. The right stick moves the cursor, RT or A left-clicks, LT right-clicks to move and attack, the left stick scrolls the map. Y pauses, X shows the health bars, the d-pad zooms, rotates a building and shows the grid. Hold LB for control groups 1-9 (LB + RB sets one), RB is Shift and L3 is Ctrl for selecting. Select lists pause and the game menu. The \"+ Gyro\" profile also moves the cursor by tilting the controller."
made_with = "Xbox controller"

[[rules]]
kind = "executable"
value = "theyarebillions.exe"
profile = "They Are Billions"

[[rules]]
kind = "steam_app_id"
value = "644930"
profile = "They Are Billions"


[[profiles]]
name = "They Are Billions"
combos = [{buttons = ["LeftBumper", "RightBumper"], action = {open_menu = "Set group"}}]
combo_window_ms = 120
tap_window_ms = 250
long_press_ms = 500

[profiles.buttons]
Guide = {mode = "Guide"}
South = {mouse = "Left"}
East = {keys = ["KEY_ESC"]}
West = {keys = ["KEY_LEFTALT"]}
North = {keys = ["KEY_SPACE"]}
LeftBumper = {open_menu = "Groups"}
RightBumper = {keys = ["KEY_LEFTSHIFT"]}
Select = {open_menu = "Colony"}
Start = {keys = ["KEY_ESC"]}
LeftStick = {keys = ["KEY_LEFTCTRL"]}
DpadUp = {wheel = "Up"}
DpadDown = {wheel = "Down"}
DpadLeft = {keys = ["KEY_TAB"]}
DpadRight = {keys = ["KEY_E"]}

[profiles.left_stick]
deadzone = 0.2
curve = 1.0
key_threshold = 0.45

[profiles.left_stick.action.ring]
sectors = 8
start_angle = 0.0
inner_radius = 0.45
hysteresis = 0.1

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_W"]

[[profiles.left_stick.action.ring.actions]]
multi = [{ keys = ["KEY_W"] }, { keys = ["KEY_D"] }]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_D"]

[[profiles.left_stick.action.ring.actions]]
multi = [{ keys = ["KEY_S"] }, { keys = ["KEY_D"] }]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_S"]

[[profiles.left_stick.action.ring.actions]]
multi = [{ keys = ["KEY_S"] }, { keys = ["KEY_A"] }]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_A"]

[[profiles.left_stick.action.ring.actions]]
multi = [{ keys = ["KEY_W"] }, { keys = ["KEY_A"] }]

[profiles.right_stick]
deadzone = 0.1
curve = 1.6
key_threshold = 0.25

[profiles.right_stick.action.mouse]
speed = 1500.0
accel = 0.25

[profiles.left_trigger.action.button]
threshold = 0.4
action = { mouse = "Right" }

[profiles.right_trigger.action.button]
threshold = 0.3
action = { mouse = "Left" }

[profiles.guide]
notes = '''The right stick {rs} moves the cursor: {rt} or {south} selects and places (left click, hold to drag a box), and {lt} moves and attacks (right click). The left stick {ls} scrolls the map (WASD), and {up} {down} zoom.
{north} pauses and unpauses: you can still give orders and place buildings while paused, so pause often.
Hold {lb} for the control groups and aim the right stick {rs} at one: release to select it. Hold {lb} and {rb} together to put the selection in a group instead (Ctrl + number).
{rb} is Shift: hold it to add to the selection, or click a unit to select every one of its kind on screen. Hold {l3} (Ctrl) and click a unit to select every one of its kind on the map.
Hold {west} (Alt) to show every unit's and building's health bar. {left} rotates the building or gate being placed (Tab), and {right} shows the building grid (E).
{select} lists pause, the building grid, rotating and the game menu. {east} cancels and closes; {start} is the game menu.
They Are Billions saves only when you leave a game, so there is no quick save. The PS4 and Xbox One release had a pad scheme, but no layout for it was found, so this one is built on the PC keys.
The keys are from players' lists, not checked on an install: Alt for the health bars, Tab for rotating and E for the grid most of all. The groups are 1 to 9 here; if a key does nothing, look in Options, Controls (the Custom keyboard layout lets you set each key). The building and unit commands are on the bottom panel: click them.'''

[profiles.guide.edits]
"stick:Left" = { text = "Scroll the map" }
"stick:Right" = { text = "Cursor" }
"trigger:Right" = { text = "Left click (select, place, drag a box)" }
"trigger:Left" = { text = "Right click (move, attack)" }
"button:South" = { text = "Left click" }
"button:East" = { text = "Cancel / close" }
"button:West" = { text = "Hold: {icon:heart} health bars" }
"button:North" = { text = "{icon:pause} Pause" }
"button:LeftBumper" = { text = "Hold: control groups" }
"button:RightBumper" = { text = "Shift (add, all on screen)" }
"button:Select" = { text = "Pause, grid, menu" }
"button:Start" = { text = "Game menu" }
"button:LeftStick" = { text = "Ctrl (all of a kind on the map)" }
"button:DpadLeft" = { text = "{icon:rotate} Rotate building" }
"button:DpadRight" = { text = "{icon:grid} Building grid" }

[[profiles.guide.merged]]
inputs = ["button:DpadUp", "button:DpadDown"]
text = "Zoom in / out"

[[profiles.guide.custom]]
inputs = ["button:LeftBumper", "button:RightBumper"]
text = "Set a control group"

[[profiles]]
name = "They Are Billions + Gyro"
