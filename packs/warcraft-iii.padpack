format = 20
macros = []
overlay_font = "Cinzel"

[pack]
id = "2234cfca-7ef0-43b1-93fb-97aabcaf8488"
name = "Warcraft III"
version = "1.0"
author = "Padwight"
description = "Warcraft III on an Xbox-style pad, for the default hotkeys. The right stick moves the cursor, RT left-clicks, LT right-clicks, the left stick scrolls the map. Face buttons are Attack / Cancel / Stop / Hold, the d-pad is Move / Patrol / Basic and Advanced structures, RB is Shift (queue). Hold LB for control groups 1-8 (also hold RB in there to assign the group instead). R3 opens a radial menu of hero keys, idle workers, learn skill and town hall. Select jumps to the last alert, Start is the game menu. Hold Select for the Menus mode (clicks, Enter, arrows) and again to come back. Hero abilities and unit spells aren't mapped: click their cards."
made_with = "Xbox controller"

[[rules]]
kind = "executable"
value = "Warcraft III.exe"
profile = "Warcraft III"

[[rules]]
kind = "executable"
value = "war3.exe"
profile = "Warcraft III"

[[rules]]
kind = "executable"
value = "w3x.exe"
profile = "Warcraft III"

[[profiles]]
name = "Warcraft III"
combos = []
combo_window_ms = 120
tap_window_ms = 250
long_press_ms = 500

[profiles.buttons]
Guide = {mode = "Guide"}

[profiles.buttons.South]
keys = ["KEY_A"]

[profiles.buttons.East]
keys = ["KEY_ESC"]

[profiles.buttons.North]
keys = ["KEY_H"]

[profiles.buttons.West]
keys = ["KEY_S"]

[profiles.buttons.LeftBumper]
layer = "Groups"

[profiles.buttons.RightBumper]
keys = ["KEY_LEFTSHIFT"]

[profiles.buttons.Select]
keys = ["KEY_SPACE"]

[profiles.buttons.Start]
keys = ["KEY_F10"]

[profiles.buttons.LeftStick]
multi = [
    { keys = ["KEY_LEFTCTRL"] },
    { mouse = "Left" },
]

[profiles.buttons.RightStick]
open_menu = "Commands"

[profiles.buttons.DpadUp]
keys = ["KEY_M"]

[profiles.buttons.DpadDown]
keys = ["KEY_V"]

[profiles.buttons.DpadLeft]
keys = ["KEY_B"]

[profiles.buttons.DpadRight]
keys = ["KEY_P"]

[profiles.left_stick]
deadzone = 0.2
curve = 1.0
key_threshold = 0.45

[profiles.left_stick.action.ring]
sectors = 8
start_angle = 0.0
inner_radius = 0.45
hysteresis = 0.1

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_UP"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_UP"] },
    { keys = ["KEY_RIGHT"] },
]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_RIGHT"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_DOWN"] },
    { keys = ["KEY_RIGHT"] },
]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_DOWN"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_DOWN"] },
    { keys = ["KEY_LEFT"] },
]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_LEFT"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_UP"] },
    { keys = ["KEY_LEFT"] },
]

[profiles.right_stick]
deadzone = 0.1
curve = 1.6
key_threshold = 0.25

[profiles.right_stick.action.mouse]
speed = 1500.0
accel = 0.25

[profiles.left_trigger.action.button]
threshold = 0.4

[profiles.left_trigger.action.button.action]
mouse = "Right"

[profiles.right_trigger.action.button]
threshold = 0.3

[profiles.right_trigger.action.button.action]
mouse = "Left"

[profiles.gestures.Select.long_press]
mode = "Menus"

[profiles.gyro]
mode = "off"
horizontal = "yaw"
invert_x = false
invert_y = false
noise_threshold = 1.0
[profiles.guide]
notes = '''The right stick {rs} moves the cursor: {rt} selects (left click), and {lt} moves or targets (right click). The left stick {ls} scrolls the map.
Hold {lb} for the control groups: the face buttons and the {dpad} recall groups 1 to 8. Hold {rb} as well to assign the selection to the group instead.
{rb} is Shift: hold it to queue orders or add to the selection. Click {l3} to select every unit of that type on screen (Ctrl + click).
Click {r3} for the heroes (F1 to F3), idle workers (F8), learn skill, town hall and subgroup cycling, aimed with the right stick {rs}. Hero spells and unit abilities aren't mapped: click their cards, or use {guide} + {west} for the keyboard.
{select} jumps to the last alert. Hold {select} for the Menus mode, and hold it again to come back.
{start} (F10) is the game menu.'''

[profiles.guide.edits]
"stick:Left" = {text = "Scroll map"}
"stick:Right" = {text = "Cursor"}
"trigger:Right" = { text = "Left click (select)" }
"trigger:Left" = { text = "Right click (move / target)" }
"button:South" = { text = "Attack" }
"button:East" = { text = "Cancel" }
"button:West" = { text = "Stop" }
"button:North" = { text = "Hold position" }
"button:DpadUp" = { text = "Move" }
"button:DpadRight" = { text = "Patrol" }
"button:DpadLeft" = { text = "Basic structures" }
"button:DpadDown" = { text = "Advanced structures" }
"button:RightBumper" = { text = "Shift (queue)" }
"button:LeftStick" = { text = "Click: ctrl-click (select same type)" }
"button:LeftBumper" = { text = "Hold: control groups 1-8" }
"button:RightStick" = { text = "Worker / unit commands" }
"button:Select" = {text = "{icon:bell} Jump to last alert"}
"button:Start" = { text = "Game menu" }
"gesture:button:Select:long_press" = { text = "Menus mode on / off" }
[[profiles.guide.custom]]
inputs = ["button:LeftBumper", "button:RightBumper"]
text = "Assign group instead"

