[motion]
keyboard = "playful"
numpad = "playful"
menu = "playful"
media = "playful"
offer = "playful"
info = "playful"
log = "playful"

[sounds.menu]
step = {kind = "pop", volume = 0.07, pitch = 1.3}
pick = {kind = "boing", volume = 0.12, pitch = 1.1}
open = {kind = "swish", volume = 0.05, pitch = 1.1}
close = {kind = "swish", volume = 0.04, pitch = 0.9}

[sounds.numpad]
step = {kind = "pop", volume = 0.07, pitch = 1.3}
pick = {kind = "boing", volume = 0.12, pitch = 1.1}

[sounds.keyboard]
step = {kind = "pop", volume = 0.07, pitch = 1.3}
pick = {kind = "keys", volume = 0.2}

[rumble.menu]
step = {strength = 0.08, length_ms = 18}
pick = {strength = 0.32, length_ms = 35}
open = {strength = 0.07, length_ms = 25}

[rumble.keyboard]
step = {strength = 0.06, length_ms = 14}
pick = {strength = 0.21, length_ms = 22}

[rumble.numpad]
step = {strength = 0.06, length_ms = 14}
pick = {strength = 0.21, length_ms = 22}

[rumble.media]
pick = {strength = 0.21, length_ms = 25}

[rumble.guide]
mode = {strength = 0.21, length_ms = 60}
