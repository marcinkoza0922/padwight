position = "center"
scale = 1.0

[menu_style.background]
color = "#0d0d14"
opacity = 0.92

[menu_style.items]
color = "#23232f"
opacity = 0.95

[menu_style.selected]
color = "#ff2e93"
opacity = 1.0

[menu_style.border]
