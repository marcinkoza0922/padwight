position = "top_right"
scale = 0.9

[media_style.background]
color = "#0d0d14"
opacity = 0.92

[media_style.items]
color = "#23232f"
opacity = 0.95

[media_style.selected]
color = "#ff2e93"
opacity = 1.0

[media_style.border]
width = 1
color = "#f5e100"
opacity = 0.8

[media_style.gradient]
color = "#171722"
