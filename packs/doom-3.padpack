format = 20
macros = []
overlay_font = "Orbitron"

[pack]
id = "1c7b74b5-d1dc-4395-9446-1382c21020fb"
name = "Doom 3"
version = "1.0"
author = "Padwight"
description = "Doom 3 (2004) and Resurrection of Evil on an Xbox-style pad, for the game's default keys. A uses, B jumps, X reloads, RT fires, LT is the flashlight and L3 toggles crouch. Hold LB for the weapon ring, aiming with the right stick, RB cycles to the next weapon and Y to the previous. Start is the menu; double tap it to quick save, hold it to quick load. Gyro and flick stick profiles are included to try."
made_with = "Xbox controller"

[[rules]]
kind = "steam_app_id"
value = "9050"
profile = "Doom 3"

[[rules]]
kind = "steam_app_id"
value = "9070"
profile = "Doom 3"

[[rules]]
kind = "executable"
value = "Doom3.exe"
profile = "Doom 3"

[[profiles]]
name = "Doom 3"
combos = []
combo_window_ms = 120
tap_window_ms = 250
long_press_ms = 500

[profiles.buttons]
Guide = { mode = "Guide" }
South = { keys = ["KEY_E"] }
East = { keys = ["KEY_SPACE"] }
West = { keys = ["KEY_R"] }
North = { wheel = "Down" }
LeftBumper = { open_menu = "Weapons" }
RightBumper = { wheel = "Up" }
Select = { keys = ["KEY_TAB"] }
Start = { keys = ["KEY_ESC"] }
LeftStick = { toggle = { action = { keys = ["KEY_C"] } } }
DpadUp = { keys = ["KEY_F"] }
DpadDown = { keys = ["KEY_G"] }
DpadLeft = { keys = ["KEY_LEFT"] }
DpadRight = { keys = ["KEY_RIGHT"] }
[profiles.gestures.Start.double_tap]
keys = ["KEY_F5"]

[profiles.gestures.Start.long_press]
keys = ["KEY_F9"]

[profiles.left_stick]
deadzone = 0.12
curve = 1.0
key_threshold = 0.25

[profiles.left_stick.action.ring]
sectors = 8
start_angle = 0.0
inner_radius = 0.25
hysteresis = 0.1

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_W"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_W"] },
    { keys = ["KEY_D"] },
]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_D"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_S"] },
    { keys = ["KEY_D"] },
]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_S"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_S"] },
    { keys = ["KEY_A"] },
]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_A"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_W"] },
    { keys = ["KEY_A"] },
]

[[profiles.left_stick.zones]]
min = 0.0
max = 0.6
action = { keys = ["KEY_LEFTSHIFT"] }

[profiles.right_stick]
deadzone = 0.1
curve = 1.8
key_threshold = 0.5

[profiles.right_stick.action.mouse]
speed = 1100.0
accel = 0.2

[profiles.left_trigger.action.button]
threshold = 0.4
action = { keys = ["KEY_F"] }

[profiles.right_trigger.action.button]
threshold = 0.3
action = { mouse = "Left" }

[profiles.guide]
notes = '''{start} (Escape) opens the game's menu and backs out of every screen in it.
Hold {lb} for the weapon ring, aiming with the right stick {rs}. {rb} switches to the next weapon and {y} to the previous one.
{a} uses things and talks to terminals, {b} jumps, {x} reloads and {l3} toggles crouch. {lt} is the flashlight. A light push of the left stick {ls} walks.
{select} (Tab) opens your PDA. Quick save is a double tap of {start}, and quick load is a long press of {start}.
These are Doom 3's default keys, written from memory and not checked in the game. If a button does nothing, compare the game's Controls screen with the keys here.'''

[profiles.guide.edits]
"stick:Left" = { text = "Move" }
"stick:Right" = { text = "Look" }
"trigger:Right" = { text = "Fire" }
"trigger:Left" = { text = "{icon:eye} Flashlight" }
"button:South" = { text = "Use" }
"button:East" = { text = "Jump" }
"button:West" = { text = "Reload" }
"button:North" = { text = "Previous weapon" }
"button:LeftBumper" = { text = "Hold: weapons" }
"button:RightBumper" = { text = "Next weapon" }
"button:LeftStick" = { text = "Crouch (toggle)" }
"button:Select" = { text = "PDA" }
"button:Start" = { text = "Menu / back out" }
"gesture:button:Start:double_tap" = { text = "{icon:save} Quick save" }
"gesture:button:Start:long_press" = { text = "{icon:load} Quick load" }

