format = 20
macros = []
overlay_font = "Special Elite"

[pack]
id = "3829a380-15c9-400a-bb55-cd956f272f01"
name = "Medal of Honor: Allied Assault"
version = "1.0"
author = "Padwight"
description = "Medal of Honor: Allied Assault (2002) and its Spearhead and Breakthrough expansions on an Xbox-style pad, for the game's default keys. A uses, B jumps, X reloads, Y switches weapons, RT fires and LT is the secondary attack: the rifle butt, or the scope on a sniper rifle. RB picks the grenade, L3 toggles crouch, R3 is the binoculars and a light push of the left stick walks. Hold LB for the weapon ring, the D-pad leans and holsters, and Start is the menu; double tap it to quick save, hold it to quick load. The game has no controller support. Gyro and flick stick profiles are included to try."
made_with = "Xbox controller"

[[rules]]
kind = "executable"
value = "MOHAA.exe"
profile = "Medal of Honor: Allied Assault"

[[rules]]
kind = "executable"
value = "moh_spearhead.exe"
profile = "Medal of Honor: Allied Assault"

[[rules]]
kind = "executable"
value = "moh_breakthrough.exe"
profile = "Medal of Honor: Allied Assault"

[[profiles]]
name = "Medal of Honor: Allied Assault"
combos = []
combo_window_ms = 120
tap_window_ms = 250
long_press_ms = 300

[profiles.buttons]
Guide = { mode = "Guide" }
South = { keys = ["KEY_E"] }
East = { keys = ["KEY_SPACE"] }
West = { keys = ["KEY_R"] }
North = { wheel = "Down" }
LeftBumper = { open_menu = "Weapons" }
RightBumper = { keys = ["KEY_5"] }
LeftStick = { toggle = { action = { keys = ["KEY_LEFTCTRL"] } } }
RightStick = { keys = ["KEY_7"] }
Select = { keys = ["KEY_TAB"] }
Start = { keys = ["KEY_ESC"] }
DpadUp = { wheel = "Up" }
DpadDown = { keys = ["KEY_Q"] }
DpadLeft = { keys = ["KEY_Z"] }
DpadRight = { keys = ["KEY_C"] }

[profiles.gestures.Start]
double_tap = { keys = ["KEY_F5"] }
long_press = { keys = ["KEY_F9"] }

[profiles.left_stick]
deadzone = 0.12
curve = 1.0
key_threshold = 0.25

[profiles.left_stick.action.ring]
sectors = 8
start_angle = 0.0
inner_radius = 0.25
hysteresis = 0.1

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_W"]

[[profiles.left_stick.action.ring.actions]]
multi = [{ keys = ["KEY_W"] }, { keys = ["KEY_D"] }]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_D"]

[[profiles.left_stick.action.ring.actions]]
multi = [{ keys = ["KEY_S"] }, { keys = ["KEY_D"] }]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_S"]

[[profiles.left_stick.action.ring.actions]]
multi = [{ keys = ["KEY_S"] }, { keys = ["KEY_A"] }]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_A"]

[[profiles.left_stick.action.ring.actions]]
multi = [{ keys = ["KEY_W"] }, { keys = ["KEY_A"] }]

[[profiles.left_stick.zones]]
min = 0.0
max = 0.6
action = { keys = ["KEY_LEFTSHIFT"] }

[profiles.right_stick]
deadzone = 0.08
curve = 2.0
key_threshold = 0.5

[profiles.right_stick.action.mouse]
speed = 1150.0
accel = 0.2

[profiles.left_trigger.action.button]
threshold = 0.4
action = { mouse = "Right" }

[profiles.right_trigger.action.button]
threshold = 0.3
action = { mouse = "Left" }

[profiles.guide]
notes = '''{start} (Escape) opens the game's menu and backs out of it. Double tap {start} to quick save (F5) and hold it to quick load (F9).
{south} uses: doors, mounted guns, levers. {east} jumps, {west} reloads and {north} switches to the next weapon; {up} goes back to the previous one. A light push of the left stick {ls} walks quietly, and {l3} toggles crouch.
{lt} is the secondary attack: a rifle butt or pistol whip with most weapons, and the scope on a sniper rifle, which it puts up and takes down again. {rb} picks the grenade; throw it with {rt}.
Hold {lb} for the weapon ring, aiming with the right stick {rs}: pistol, rifle, submachine gun, machine gun, grenade, heavy weapon, binoculars and holster. {r3} brings out the binoculars or your papers, and {down} holsters the weapon.
{left} and {right} lean. In the base game leaning works only in multiplayer; Spearhead and Breakthrough lean everywhere.
{select} (Tab) shows the objectives, or the scores in multiplayer. Multiplayer chat needs typing: open the on-screen keyboard with {guide} + {west} and press T (all) or Y (team).
OpenMoHAA, the open-source engine for the game, uses its own executable names; add a rule for it on the Details tab to use this setup there.
These are the game's default keys from community lists and memory, not checked in the game (walk, quick save and quick load, and the leans, which are Spearhead's Z and C, especially). Compare them with Options → Controls and change the buttons here to match. The game isn't on Steam; the executable names are remembered from the GOG War Chest install and not checked. The gyro's real-world turn assumes the id Tech 3 turn of 0.022 degrees a count and a mouse sensitivity of 5, worked out, not measured; set the full turn to 16364 divided by your sensitivity.'''

[profiles.guide.edits]
"stick:Left" = { text = "Move · light push: walk" }
"stick:Right" = { text = "Look" }
"trigger:Right" = { text = "Fire" }
"trigger:Left" = { text = "{icon:scope} Secondary · scope" }
"button:South" = { text = "{icon:hand} Use" }
"button:East" = { text = "Jump" }
"button:West" = { text = "Reload" }
"button:North" = { text = "{icon:rifle} Next weapon" }
"button:LeftBumper" = { text = "Hold: weapons" }
"button:RightBumper" = { text = "{icon:grenade} Grenade" }
"button:LeftStick" = { text = "Crouch (toggle)" }
"button:RightStick" = { text = "{icon:binoculars} Binoculars · papers" }
"button:DpadUp" = { text = "Previous weapon" }
"button:DpadDown" = { text = "{icon:holster} Holster" }
"button:Select" = { text = "Objectives · scores" }
"button:Start" = { text = "Menu" }
"gesture:button:Start:double_tap" = { text = "{icon:save} Quick save" }
"gesture:button:Start:long_press" = { text = "{icon:load} Quick load" }

[[profiles.guide.merged]]
inputs = ["button:DpadLeft", "button:DpadRight"]
text = "Lean"

