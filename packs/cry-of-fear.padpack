format = 20
macros = []
overlay_font = "SpecialElite"

[pack]
id = "198ed2dc-1d26-4617-a1bf-d1416ea9743f"
name = "Cry of Fear"
version = "1.0"
author = "Padwight"
description = "Cry of Fear (2013, a GoldSrc mod turned standalone) on an Xbox-style pad, mapped to the game's default keyboard and mouse bindings. The game's own joystick support is poor (the left stick turns instead of strafing), so Padwight sends keys and mouse movement instead. Gyro and flick stick profiles are there to try."
made_with = "Xbox controller"

[[rules]]
kind = "steam_app_id"
value = "223710"
profile = "Cry of Fear"

[[rules]]
kind = "executable"
value = "cof.exe"
profile = "Cry of Fear"

[[profiles]]
name = "Cry of Fear"
combos = []
combo_window_ms = 120
tap_window_ms = 250
long_press_ms = 300

[profiles.buttons]
Guide = { mode = "Guide" }
South = { keys = ["KEY_SPACE"] }
East = { keys = ["KEY_LEFTCTRL"] }
West = { keys = ["KEY_R"] }
North = { wheel = "Down" }
LeftBumper = { wheel = "Up" }
RightBumper = { wheel = "Down" }
LeftStick = { keys = ["KEY_LEFTSHIFT"] }
RightStick = { keys = ["KEY_V"] }
Select = { keys = ["KEY_TAB"] }
Start = { keys = ["KEY_ESC"] }
DpadUp = { keys = ["KEY_F"] }
DpadDown = { keys = ["KEY_G"] }
DpadLeft = { keys = ["KEY_Q"] }
DpadRight = { keys = ["KEY_E"] }

[profiles.gestures.West]
long_press = { keys = ["KEY_E"] }

[profiles.gestures.Start]
double_tap = { keys = ["KEY_F6"] }
long_press = { keys = ["KEY_F7"] }

[profiles.left_stick]
deadzone = 0.12
curve = 1.0
key_threshold = 0.25

[profiles.left_stick.action.ring]
sectors = 8
start_angle = 0.0
inner_radius = 0.25
hysteresis = 0.1

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_W"]

[[profiles.left_stick.action.ring.actions]]
multi = [{ keys = ["KEY_W"] }, { keys = ["KEY_D"] }]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_D"]

[[profiles.left_stick.action.ring.actions]]
multi = [{ keys = ["KEY_S"] }, { keys = ["KEY_D"] }]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_S"]

[[profiles.left_stick.action.ring.actions]]
multi = [{ keys = ["KEY_S"] }, { keys = ["KEY_A"] }]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_A"]

[[profiles.left_stick.action.ring.actions]]
multi = [{ keys = ["KEY_W"] }, { keys = ["KEY_A"] }]

[profiles.right_stick]
deadzone = 0.08
curve = 2.0
key_threshold = 0.5

[profiles.right_stick.action.mouse]
speed = 1300.0
accel = 0.2

[profiles.left_trigger.action.button]
threshold = 0.4
action = { multi = [{ layer = "Aim" }, { mouse = "Right" }] }

[profiles.right_trigger.action.button]
threshold = 0.3
action = { mouse = "Left" }

[profiles.guide]
notes = '''{start} (Escape) pauses and backs out of the game's menus. Tap {start} twice to quick save and hold it to quick load.
{south} jumps, {east} crouches, {west} reloads and, held, uses: open doors, pick things up, read notes. {right} taps the use key. {rs} is melee, {l3} sprints, {up} is the flashlight and {select} the inventory. {lb} and {rb} step through your weapons; {north} steps forward too.
Hold {lt} for the weapon's alt fire (aim). The right stick turns more finely while it's held.
Cry of Fear has its own joystick support, but it only turns left and right and would fight this setup. Turn the joystick off in the game's controls options, so only the keys and mouse count.
These are the Half-Life style default keys, written from memory and not checked in the game (melee, the flashlight, lean, quick save and quick load especially). Check them in the game's Controls menu, which lets you rebind every one.
{guide} still works over the game: {guide} + {west} opens the on-screen keyboard and {guide} + {lb} the media controls.
If the game stops answering the pad, check that Steam Input or another remapper isn't also running for it.'''

[profiles.guide.edits]
"stick:Left" = { text = "Move" }
"stick:Right" = { text = "Look" }
"trigger:Right" = { text = "Fire" }
"trigger:Left" = { text = "Aim · alt fire" }
"button:South" = { text = "Jump" }
"button:East" = { text = "Crouch" }
"button:West" = { text = "Reload" }
"gesture:button:West:long_press" = { text = "Use (hold)" }
"button:North" = { text = "Next weapon" }
"button:LeftBumper" = { text = "Previous weapon" }
"button:RightBumper" = { text = "Next weapon" }
"button:LeftStick" = { text = "Sprint" }
"button:RightStick" = { text = "Melee" }
"button:DpadUp" = { text = "Flashlight" }
"button:DpadDown" = { text = "Drop" }
"button:DpadLeft" = { text = "Lean" }
"button:DpadRight" = { text = "Use" }
"button:Select" = { text = "Inventory" }
"button:Start" = { text = "Pause" }
"gesture:button:Start:double_tap" = { text = "Quick save" }
"gesture:button:Start:long_press" = { text = "Quick load" }

