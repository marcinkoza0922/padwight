threshold = 0.4
action = { mouse = "Right" }

[profiles.right_trigger.action.button]
threshold = 0.3
action = { layer = "More abilities" }

[profiles.guide]
notes = '''Laid out like the Xbox 360 version: {south} is the default action, {west} {north} {east} fire abilities, and holding {rt} swaps them for the second set, as the console's {rt} did. The PC game needs a pointer, so the right stick {rs} moves it; {south} left-clicks (move, talk, attack, loot) and {lt} right-clicks.
The quickbar: {west} {north} {east} are slots 1 to 3. Hold {rt} for slots 4 to 6 on the same buttons, 7 to 0 on {up} {right} {down} {left}, hold position on {lb} and swap weapon sets on {rb}.
{rb} pauses and unpauses: pause, pick abilities and targets, unpause. Hold {lb} with the {dpad} to pick a party member (up first, then clockwise), or {lb} + {rb} for the whole party.
The left stick {ls} runs (forward, back, sideways); {left} and {right} turn the camera, {up} and {down} zoom. Click {l3} to walk, hold {r3} to highlight what you can use.
{select} lists the character record, inventory, skills, spells and talents, tactics, journal and maps. {start} is the menu; double tap it to {color:green}quick save{/color}, hold it to quick load.
The keys are the game's defaults as a controls list gives them, not read from an install, and the Xbox layout is from a walkthrough's controls table: if a key doesn't answer, check Options, Key Mapping. Naming your Warden: {guide} + {west} opens the on-screen keyboard.'''

