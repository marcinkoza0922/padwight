"button:Select" = { text = "{icon:book} Character, journal, maps" }
"button:Start" = { text = "Menu" }
"gesture:button:Start:double_tap" = { text = "{icon:save} Quick save" }
"gesture:button:Start:long_press" = { text = "{icon:load} Quick load" }
"button:LeftStick" = { text = "Walk / run" }
"button:RightStick" = { text = "Hold: {icon:eye} highlight" }
"button:DpadUp" = { text = "Zoom in" }
"button:DpadDown" = { text = "Zoom out" }
"combo:button:LeftBumper+button:RightBumper" = { text = "{icon:people} Whole party" }

