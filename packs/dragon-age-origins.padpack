format = 20
macros = []
overlay_font = "Cinzel"

[pack]
id = "c7607cef-e0e8-42c2-9fa5-b6697e3d2411"
name = "Dragon Age: Origins"
version = "1.0"
author = "Padwight"
description = "Dragon Age: Origins on an Xbox-style pad, laid out like the Xbox 360 version on the PC game's keys. The left stick runs, the right stick moves the pointer, A is the default action and LT right-clicks. X, Y and B fire abilities 1 to 3; hold RT for 4 to 0. RB pauses, hold LB with the d-pad to pick a party member. The d-pad turns and zooms the camera. Select lists the character record, inventory, journal and maps; Start is the menu, double tap it to quick save and hold it to quick load. Overlays in black, old gold and blood red."
made_with = "Xbox controller"

[[rules]]
kind = "steam_app_id"
value = "47810"
profile = "Dragon Age: Origins"

[[rules]]
kind = "steam_app_id"
value = "17450"
profile = "Dragon Age: Origins"

[[rules]]
kind = "executable"
value = "daorigins.exe"
profile = "Dragon Age: Origins"

[[profiles]]
name = "Dragon Age: Origins"
combos = [
    {buttons = ["LeftBumper", "DpadUp"], action = {keys = ["KEY_F1"]}},
    {buttons = ["LeftBumper", "DpadRight"], action = {keys = ["KEY_F2"]}},
    {buttons = ["LeftBumper", "DpadDown"], action = {keys = ["KEY_F3"]}},
    {buttons = ["LeftBumper", "DpadLeft"], action = {keys = ["KEY_F4"]}},
    {buttons = ["LeftBumper", "RightBumper"], action = {keys = ["KEY_EQUAL"]}},
]
combo_window_ms = 120
tap_window_ms = 250
long_press_ms = 500

