RightStick = { keys = ["KEY_TAB"] }
DpadUp = { wheel = "Up" }
DpadDown = { wheel = "Down" }
DpadLeft = { keys = ["KEY_A"] }
DpadRight = { keys = ["KEY_D"] }

[profiles.gestures.Start.double_tap]
