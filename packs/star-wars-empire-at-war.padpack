[motion]
keyboard = "swift"
numpad = "swift"
menu = "swift"
media = "swift"
offer = "swift"
info = "swift"
log = "swift"

[sounds.menu]
step = {kind = "tick", volume = 0.07, pitch = 1.2}
pick = {kind = "beep", volume = 0.04, pitch = 0.9}
open = {kind = "rise", volume = 0.04}
close = {kind = "fall", volume = 0.035}

[sounds.numpad]
step = {kind = "tick", volume = 0.06, pitch = 1.2}
pick = {kind = "beep", volume = 0.04, pitch = 0.9}

[sounds.keyboard]
step = {kind = "tick", volume = 0.06, pitch = 1.2}
pick = {kind = "beep", volume = 0.04, pitch = 0.9}

[rumble.menu]
step = {strength = 0.08, length_ms = 18}
pick = {strength = 0.3, length_ms = 35}
open = {strength = 0.07, length_ms = 25}

[rumble.keyboard]
step = {strength = 0.06, length_ms = 14}
pick = {strength = 0.2, length_ms = 22}

[rumble.numpad]
step = {strength = 0.06, length_ms = 14}
pick = {strength = 0.2, length_ms = 22}

[rumble.media]
pick = {strength = 0.2, length_ms = 25}

[rumble.guide]
mode = {strength = 0.2, length_ms = 60}
