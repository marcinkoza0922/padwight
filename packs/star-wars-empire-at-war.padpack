format = 20
macros = []
overlay_font = "Rajdhani"

[pack]
id = "1273c144-ccb4-4dcf-91f0-6f5fa8ed921d"
name = "Star Wars: Empire at War"
version = "1.0"
author = "Padwight"
description = "Star Wars: Empire at War and Forces of Corruption (Steam Gold Pack) on an Xbox-style pad, for the default keys. The right stick moves the cursor, RT or A left-clicks, LT right-clicks to move and attack, the left stick scrolls the camera. Y is attack, X stop, the d-pad zooms and steps through your units. Hold LB for control groups 1-10 (LB + RB sets one), RB for the unit orders. Select lists the overview, holocron, planet information and chat. Start is the game menu; double-tap it to quick save, hold it to quick load. The \"+ Gyro\" profile also moves the cursor by tilting the controller."
made_with = "Xbox controller"

[[rules]]
kind = "executable"
value = "StarWarsG.exe"
profile = "Star Wars: Empire at War"

[[rules]]
kind = "executable"
value = "sweaw.exe"
profile = "Star Wars: Empire at War"

[[rules]]
kind = "executable"
value = "swfoc.exe"
profile = "Star Wars: Empire at War"

[[rules]]
kind = "steam_app_id"
value = "32470"
profile = "Star Wars: Empire at War"

[[profiles]]
name = "Star Wars: Empire at War"
combos = [{buttons = ["LeftBumper", "RightBumper"], action = {open_menu = "Set group"}}]
combo_window_ms = 120
tap_window_ms = 250
long_press_ms = 500

[profiles.buttons]
Guide = { mode = "Guide" }
South = { mouse = "Left" }
East = { keys = ["KEY_ESC"] }
West = { keys = ["KEY_S"] }
North = { keys = ["KEY_A"] }
LeftBumper = { open_menu = "Groups" }
RightBumper = { open_menu = "Orders" }
Select = { open_menu = "Interface" }
Start = { keys = ["KEY_ESC"] }
LeftStick = { keys = ["KEY_LEFTCTRL", "KEY_A"] }
RightStick = { keys = ["KEY_END"] }
DpadUp = { wheel = "Up" }
DpadDown = { wheel = "Down" }
DpadLeft = { keys = ["KEY_D"] }
DpadRight = { keys = ["KEY_F"] }

[profiles.gestures.Start.double_tap]
keys = ["KEY_F6"]

[profiles.gestures.Start.long_press]
keys = ["KEY_F5"]

[profiles.left_stick]
deadzone = 0.15
curve = 1.0
key_threshold = 0.35

[profiles.left_stick.action.ring]
sectors = 8
start_angle = 0.0
inner_radius = 0.35
hysteresis = 0.1

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_UP"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_UP"] },
    { keys = ["KEY_RIGHT"] },
]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_RIGHT"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_DOWN"] },
    { keys = ["KEY_RIGHT"] },
]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_DOWN"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_DOWN"] },
    { keys = ["KEY_LEFT"] },
]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_LEFT"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_UP"] },
    { keys = ["KEY_LEFT"] },
]

[profiles.right_stick]
deadzone = 0.12
curve = 1.8
key_threshold = 0.5

[profiles.right_stick.action.mouse]
speed = 1500.0
accel = 0.3

[profiles.left_trigger.action.button]
threshold = 0.4
action = { mouse = "Right" }

[profiles.right_trigger.action.button]
threshold = 0.3
action = { mouse = "Left" }

[profiles.guide]
notes = '''The right stick {rs} moves the cursor: {rt} or {south} selects (left click, hold to drag a box), and {lt} moves or attacks (right click). The left stick {ls} scrolls the camera, {updown} zooms and {r3} resets the camera.
{north} is attack and {west} stop: press attack, then pick the target with {rt}. {left} and {right} step to the previous and next unit; {l3} selects every unit.
Hold {lb} for the control groups and aim the right stick {rs} at one: release to select it. Hold {lb} and {rb} together to put the selection in a group instead (Ctrl + number).
Hold {rb} for the unit orders (guard, move, waypoint, retreat, reinforce, the units of one type, the superweapon), aimed with the right stick {rs}. A unit's own abilities are on its buttons at the bottom of the screen: click them with {rt}.
{select} lists the tactical overview, the mission holocron, planet information, the player list, chat and the cinematic camera.
{start} (Esc) is the game menu. Double-tap {start} to quick save and hold it to quick load. {east} cancels and closes.
The game has no controller support of its own, so the controller works through these keys. They're the defaults as remembered by a community FAQ, not checked on an install: if one does nothing, look in Options, Controls. Hold {guide} and press {west} for the on-screen keyboard (chat, save names).'''

[profiles.guide.edits]
"stick:Right" = { text = "Cursor" }
"stick:Left" = { text = "Scroll the camera" }
"trigger:Right" = { text = "Left click (select, drag a box)" }
"trigger:Left" = { text = "Right click (move, attack)" }
"button:South" = { text = "Left click" }
"button:East" = { text = "Cancel / close" }
"button:West" = { text = "{icon:stop} Stop" }
"button:North" = { text = "{icon:crosshair} Attack" }
"button:LeftBumper" = { text = "Hold: control groups" }
"button:RightBumper" = { text = "Hold: unit orders" }
"button:Select" = { text = "Interface" }
"button:Start" = { text = "Game menu" }
"button:LeftStick" = { text = "{icon:people} Select all units" }
"button:RightStick" = { text = "Reset camera" }
"button:DpadLeft" = { text = "Previous unit" }
"button:DpadRight" = { text = "Next unit" }
"gesture:button:Start:double_tap" = { text = "{icon:save} Quick save" }
"gesture:button:Start:long_press" = { text = "{icon:load} Quick load" }

[[profiles.guide.merged]]
inputs = ["button:DpadUp", "button:DpadDown"]
text = "Zoom in / out"

[[profiles.guide.custom]]
inputs = ["button:LeftBumper", "button:RightBumper"]
text = "Set a control group"

[[profiles]]
name = "Star Wars: Empire at War + Gyro"
combos = [{buttons = ["LeftBumper", "RightBumper"], action = {open_menu = "Set group"}}, {buttons = ["Select", "Start"], action = "gyro_clutch"}]
combo_window_ms = 120
tap_window_ms = 250
long_press_ms = 500
requires = ["gyro"]

