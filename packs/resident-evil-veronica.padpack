[motion]
keyboard = "retro"
numpad = "retro"
menu = "retro"
media = "retro"
offer = "retro"
info = "retro"
log = "retro"

[sounds.menu]
step = {kind = "typewriter", volume = 0.09, pitch = 1.3}
pick = {kind = "typewriter", volume = 0.24, pitch = 0.95}
open = {kind = "carriage", volume = 0.1}
close = {kind = "bell", volume = 0.05, pitch = 1.5}

[sounds.numpad]
step = {kind = "typewriter", volume = 0.09, pitch = 1.3}
pick = {kind = "typewriter", volume = 0.24, pitch = 0.95}

[sounds.keyboard]
step = {kind = "typewriter", volume = 0.09, pitch = 1.3}
pick = {kind = "typewriter", volume = 0.3, pitch = 0.9}

[sounds.media]
pick = {kind = "typewriter", volume = 0.24, pitch = 0.95}
