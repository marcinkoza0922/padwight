format = 20
macros = []
overlay_font = "Silkscreen"

[pack]
id = "3d632919-3b6f-4aa3-8673-084a36a5f579"
name = "Ironwail"
version = "1.0"
author = "Padwight"
description = "Ironwail, the fast Quake source port, on an Xbox-style pad, for Quake's classic keys. The left stick moves, A jumps, RT fires, LT runs and the d-pad sends the arrow keys for the menus. Hold LB for the weapon ring, aiming with the right stick, RB cycles to the next weapon and Y to the previous. Start is the menu; double tap it to quick save, hold it to quick load. Gyro and flick stick profiles are included to try."
made_with = "Xbox controller"

[[rules]]
kind = "executable"
value = "ironwail.exe"
profile = "Ironwail"

[[rules]]
kind = "executable"
value = "ironwail"
profile = "Ironwail"

[[profiles]]
name = "Ironwail"
combos = []
combo_window_ms = 120
tap_window_ms = 250
long_press_ms = 500

[profiles.buttons]
Guide = { mode = "Guide" }
South = { multi = [{ keys = ["KEY_SPACE"] }, { keys = ["KEY_ENTER"] }] }
East = { keys = ["KEY_7"] }
West = { keys = ["KEY_3"] }
North = { wheel = "Down" }
LeftBumper = { open_menu = "Weapons" }
RightBumper = { wheel = "Up" }
Select = { keys = ["KEY_TAB"] }
Start = { keys = ["KEY_ESC"] }
LeftStick = { keys = ["KEY_END"] }
RightStick = { keys = ["KEY_1"] }
DpadUp = { keys = ["KEY_UP"] }
DpadDown = { keys = ["KEY_DOWN"] }
DpadLeft = { keys = ["KEY_LEFT"] }
DpadRight = { keys = ["KEY_RIGHT"] }
[profiles.gestures.Start.double_tap]
keys = ["KEY_F6"]

[profiles.gestures.Start.long_press]
keys = ["KEY_F9"]

[profiles.left_stick]
deadzone = 0.12
curve = 1.0
key_threshold = 0.25

[profiles.left_stick.action.ring]
sectors = 8
start_angle = 0.0
inner_radius = 0.25
hysteresis = 0.1

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_W"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_W"] },
    { keys = ["KEY_D"] },
]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_D"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_S"] },
    { keys = ["KEY_D"] },
]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_S"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_S"] },
    { keys = ["KEY_A"] },
]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_A"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_W"] },
    { keys = ["KEY_A"] },
]

[profiles.right_stick]
deadzone = 0.1
curve = 1.8
key_threshold = 0.5

[profiles.right_stick.action.mouse]
speed = 1100.0
accel = 0.2

[profiles.left_trigger.action.button]
threshold = 0.4
action = { keys = ["KEY_LEFTSHIFT"] }

[profiles.right_trigger.action.button]
threshold = 0.3
action = { mouse = "Left" }

[profiles.guide]
notes = '''{start} (Escape) opens the game's menu and backs out of every screen in it. In the menu the d-pad {dpad} moves the cursor and {a} picks.
Hold {lb} for the weapon ring, aiming with the right stick {rs}. {rb} switches to the next weapon and {y} to the previous one. {x} picks the Super Shotgun, {b} the Rocket Launcher and {r3} the Axe.
{a} jumps, and swims up in water. Hold {lt} to run; if the port's Always Run is on, it walks instead. {l3} centres the view.
Quake has no use key, reload or crouch: doors open as you walk into them and buttons by being shot or touched.
Hold {select} (Tab) for the scoreboard.
Quick save is a double tap of {start} (F6), and quick load is a long press of {start} (F9).
These are the port's classic keys, written from memory and not checked in the game. Ironwail and vkQuake only ship with the arrow keys bound for movement, so bind W, A, S and D to forward, left, back and right in Options, Controls, and mouse look to always on. If a button does nothing, compare the Controls screen with the keys here.'''

[profiles.guide.edits]
"stick:Left" = { text = "Move" }
"stick:Right" = { text = "Look" }
"trigger:Right" = { text = "Fire" }
"trigger:Left" = { text = "Run (hold)" }
"button:South" = { text = "Jump" }
"button:East" = { text = "Rocket Launcher" }
"button:West" = { text = "Super Shotgun" }
"button:North" = { text = "Previous weapon" }
"button:LeftBumper" = { text = "Hold: weapons" }
"button:RightBumper" = { text = "Next weapon" }
"button:LeftStick" = { text = "Center view" }
"button:RightStick" = { text = "Axe" }
"button:Select" = { text = "Scoreboard" }
"button:Start" = { text = "Menu / back out" }
"gesture:button:Start:double_tap" = { text = "{icon:save} Quick save" }
"gesture:button:Start:long_press" = { text = "{icon:load} Quick load" }

