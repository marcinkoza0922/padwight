format = 20
macros = []
overlay_font = "Special Elite"

[pack]
id = "1beb61b8-44ef-464a-91b4-e1bdea6f9ace"
name = "Inscryption"
version = "1.0"
author = "Padwight"
description = "Inscryption on an Xbox-style pad. The right stick moves the pointer and RT or A clicks to play cards and ring the bell; LT or B right-clicks. The left stick and the D-pad look around the cabin and walk. A third profile passes the controller through for a build that reads it. Overlays in candlelit wood and shadow."
made_with = "Xbox controller"

[[rules]]
kind = "steam_app_id"
value = "1092790"
profile = "Inscryption"

[[rules]]
kind = "executable"
value = "Inscryption.exe"
profile = "Inscryption"

[[rules]]
kind = "executable"
value = "Inscryption.x86_64"
profile = "Inscryption"

[[profiles]]
name = "Inscryption"
combos = []
combo_window_ms = 120
tap_window_ms = 250
long_press_ms = 500

[profiles.buttons]
Guide = {mode = "Guide"}
South = {mouse = "Left"}
East = {mouse = "Right"}
Start = {keys = ["KEY_ESC"]}
DpadUp = {keys = ["KEY_UP"]}
DpadDown = {keys = ["KEY_DOWN"]}
DpadLeft = {keys = ["KEY_LEFT"]}
DpadRight = {keys = ["KEY_RIGHT"]}

[profiles.left_stick]
deadzone = 0.2
curve = 1.0
key_threshold = 0.5

[profiles.left_stick.action.ring]
sectors = 4
start_angle = 0.0
inner_radius = 0.4
hysteresis = 0.1

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_W"]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_D"]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_S"]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_A"]

[profiles.right_stick]
deadzone = 0.12
curve = 1.7
key_threshold = 0.5

[profiles.right_stick.action.mouse]
speed = 1300.0
accel = 0.3

[profiles.left_trigger.action.button]
threshold = 0.4
action = {mouse = "Right"}

[profiles.right_trigger.action.button]
threshold = 0.3
action = {mouse = "Left"}

[profiles.gyro]
mode = "off"
horizontal = "yaw"
invert_x = false
invert_y = false
noise_threshold = 1.0

[profiles.guide]
notes = '''The right stick {rs} moves the pointer; {rt} or {south} clicks to pick up a card, play it, ring the bell and use what is on the table. {lt} or {east} right-clicks.
The left stick {ls} presses W, A, S and D: look up and down and around the cabin, and walk in the other acts. The {dpad} presses the arrow keys, which do the same.
{start} opens the pause menu, which also closes it.
If your copy of the game reads the controller itself (the console update brought pad support to some builds), pick the Inscryption (game's own pad support) profile, which passes the controller through. Media controls: {guide} + {lb}.'''

[profiles.guide.edits]
"stick:Left" = {text = "Look / walk (WASD)"}
"stick:Right" = {text = "Pointer"}
"trigger:Right" = {text = "{icon:candle} Click"}
"trigger:Left" = {text = "Right-click"}
"button:South" = {text = "Click"}
"button:East" = {text = "Right-click"}
"button:Start" = {text = "Pause menu"}

[[profiles.guide.merged]]
inputs = ["button:DpadUp", "button:DpadDown", "button:DpadLeft", "button:DpadRight"]
text = "Arrow keys (look)"


[[profiles]]
name = "Inscryption + Gyro"
combos = [
    {buttons = ["Select", "Start"], action = "gyro_clutch"},
]
combo_window_ms = 120
tap_window_ms = 250
long_press_ms = 500
