[profiles.guide]
notes = '''Hold {select} and {start} together to pause the gyro while you reposition the controller. Tilting the controller moves the pointer, as a fine pointer next to the right stick {rs}.
The right stick {rs} moves the pointer; {rt} or {south} clicks to pick up a card, play it, ring the bell and use what is on the table. {lt} or {east} right-clicks.
The left stick {ls} presses W, A, S and D: look up and down and around the cabin, and walk in the other acts. The {dpad} presses the arrow keys, which do the same.
{start} opens the pause menu, which also closes it.
If your copy of the game reads the controller itself (the console update brought pad support to some builds), pick the Inscryption (game's own pad support) profile, which passes the controller through. Media controls: {guide} + {lb}.'''

[profiles.guide.edits]
"stick:Left" = {text = "Look / walk (WASD)"}
"stick:Right" = {text = "Pointer"}
"trigger:Right" = {text = "{icon:candle} Click"}
"trigger:Left" = {text = "Right-click"}
"button:South" = {text = "Click"}
"button:East" = {text = "Right-click"}
"button:Start" = {text = "Pause menu"}

[[profiles.guide.merged]]
inputs = ["button:DpadUp", "button:DpadDown", "button:DpadLeft", "button:DpadRight"]
text = "Arrow keys (look)"


[[profiles]]
name = "Inscryption (game's own pad support)"
combos = []
combo_window_ms = 120
tap_window_ms = 250
long_press_ms = 500

[profiles.buttons]
Guide = {mode = "Guide"}
South = {gamepad = "South"}
East = {gamepad = "East"}
North = {gamepad = "North"}
West = {gamepad = "West"}
LeftBumper = {gamepad = "LeftBumper"}
RightBumper = {gamepad = "RightBumper"}
LeftStick = {gamepad = "LeftStick"}
RightStick = {gamepad = "RightStick"}
Select = {gamepad = "Select"}
Start = {gamepad = "Start"}
DpadUp = {gamepad = "DpadUp"}
DpadDown = {gamepad = "DpadDown"}
DpadLeft = {gamepad = "DpadLeft"}
DpadRight = {gamepad = "DpadRight"}

[profiles.left_stick]
deadzone = 0.05
curve = 1.0
key_threshold = 0.3

[profiles.left_stick.action]
gamepad = {stick = "Left", invert_y = false}

[profiles.right_stick]
deadzone = 0.05
curve = 1.0
key_threshold = 0.3

[profiles.right_stick.action]
gamepad = {stick = "Right", invert_y = false}

[profiles.left_trigger]
action = {gamepad = "Left"}

[profiles.right_trigger]
action = {gamepad = "Right"}

[profiles.gyro]
mode = "off"
horizontal = "yaw"
invert_x = false
invert_y = false
noise_threshold = 1.0

[profiles.guide]
notes = '''The controller goes to the game as it is, for a build of Inscryption that reads a gamepad itself. If the game ignores the pad, switch back to the Inscryption profile, which plays it with the mouse and keys.
{guide} still works over the game: {guide} + {lb} opens the media controls.'''

