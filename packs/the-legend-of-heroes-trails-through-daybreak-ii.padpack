dividers = {width = 1, color = "#4a5666", opacity = 0.8}

[motion]
keyboard = "stagger"
numpad = "stagger"
menu = "stagger"
media = "stagger"
offer = "stagger"
info = "stagger"
log = "stagger"

[sounds.menu]
step = {kind = "click", volume = 0.06}
pick = {kind = "page", volume = 0.09}
open = {kind = "page", volume = 0.07}
close = {kind = "click", volume = 0.06, pitch = 0.8}

[sounds.numpad]
step = {kind = "click", volume = 0.06}
pick = {kind = "page", volume = 0.09}

[sounds.keyboard]
step = {kind = "click", volume = 0.06}
pick = {kind = "keys", volume = 0.12}

[sounds.media]
pick = {kind = "page", volume = 0.09}
