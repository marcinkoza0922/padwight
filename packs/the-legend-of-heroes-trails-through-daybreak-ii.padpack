format = 20
macros = []
overlay_font = "Cinzel"

[pack]
id = "7006ca63-d5d2-5006-a0dc-51ac3fdaf461"
name = "The Legend of Heroes: Trails through Daybreak II"
version = "1.0"
author = "Padwight"
description = "The Legend of Heroes: Trails through Daybreak II with its own controller support. The controller passes through to the game untouched; the game's options set the buttons. Padwight adds the Guide overlay in the game's colors."
made_with = "Xbox controller"

[[rules]]
kind = "steam_app_id"
value = "2113920"
profile = "The Legend of Heroes: Trails through Daybreak II"

[[profiles]]
name = "The Legend of Heroes: Trails through Daybreak II"
combos = []
combo_window_ms = 120
tap_window_ms = 250
long_press_ms = 500

[profiles.buttons]
South = {gamepad = "South"}
East = {gamepad = "East"}
North = {gamepad = "North"}
West = {gamepad = "West"}
LeftBumper = {gamepad = "LeftBumper"}
RightBumper = {gamepad = "RightBumper"}
LeftStick = {gamepad = "LeftStick"}
RightStick = {gamepad = "RightStick"}
Select = {gamepad = "Select"}
Start = {gamepad = "Start"}
DpadUp = {gamepad = "DpadUp"}
DpadDown = {gamepad = "DpadDown"}
DpadLeft = {gamepad = "DpadLeft"}
DpadRight = {gamepad = "DpadRight"}
Guide = {mode = "Guide"}

[profiles.left_stick]
deadzone = 0.05
curve = 1.0
key_threshold = 0.3

[profiles.left_stick.action]
gamepad = {stick = "Left", invert_y = false}

[profiles.right_stick]
deadzone = 0.05
curve = 1.0
key_threshold = 0.3

[profiles.right_stick.action]
gamepad = {stick = "Right", invert_y = false}

[profiles.left_trigger]
action = {gamepad = "Left"}

[profiles.right_trigger]
action = {gamepad = "Right"}

[profiles.gyro]
enabled = false
horizontal = "yaw"
invert_x = false
invert_y = false
noise_threshold = 1.0

[profiles.guide]
notes = '''The game has its own controller support, so the controller passes through untouched and the game's own options set the buttons. {guide} still works over the game: {guide} + {west} opens the on-screen keyboard for names and text, and {guide} + {lb} the media controls.'''


[keyboard_style]
corners = 0.06
position = "bottom_center"
scale = 1.0

[keyboard_style.background]
color = "#1c2128"
opacity = 0.93

[keyboard_style.items]
color = "#323a46"
opacity = 0.95

[keyboard_style.selected]
color = "#d8ad4a"
opacity = 1.0

[keyboard_style.border]
width = 1
color = "#8c9aae"
opacity = 0.8

[keyboard_style.gradient]
color = "#13171c"
opacity = 1.0
angle = 180

[keyboard_style.item_border]
width = 1
color = "#4a5666"

[keyboard_style.type]
letter_spacing = 0

[numpad_style]
corners = 0.06
position = "center"
scale = 1.0

[numpad_style.background]
color = "#1c2128"
opacity = 0.93

[numpad_style.items]
color = "#323a46"
opacity = 0.95

[numpad_style.selected]
color = "#d8ad4a"
opacity = 1.0

[numpad_style.border]
width = 1
color = "#8c9aae"
opacity = 0.8

[numpad_style.gradient]
color = "#13171c"
opacity = 1.0
angle = 180

[numpad_style.item_border]
width = 1
color = "#4a5666"

[numpad_style.type]
letter_spacing = 0

[media_style]
corners = 0.06
position = "top_right"
scale = 0.9

[media_style.background]
color = "#1c2128"
opacity = 0.93

[media_style.items]
color = "#323a46"
opacity = 0.95

[media_style.selected]
color = "#d8ad4a"
