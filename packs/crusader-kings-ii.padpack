format = 20
macros = []
overlay_font = "Cinzel"

[pack]
id = "84235c85-e006-4f5b-8e45-5eade87363ac"
name = "Crusader Kings II"
version = "1.0"
author = "Padwight"
description = "Crusader Kings II (Steam, Linux or Windows build) on an Xbox-style pad. The right stick moves the pointer, the left stick pans the map, RT or A left-clicks, LT right-clicks to move armies. Y pauses, the d-pad zooms and changes the speed. Hold LB for the map modes, hold RB for the army orders. Select lists the screens, the ledger and the finders. Click L3 for your character (hold it to go to your capital), R3 to find a character. The \"+ Gyro\" profile also moves the pointer by tilting the controller."
made_with = "Xbox controller"

[[rules]]
kind = "executable"
value = "ck2"
profile = "Crusader Kings II"

[[rules]]
kind = "executable"
value = "CK2game.exe"
profile = "Crusader Kings II"

[[rules]]
kind = "steam_app_id"
value = "203770"
profile = "Crusader Kings II"

[[profiles]]
name = "Crusader Kings II"
combos = []
combo_window_ms = 120
tap_window_ms = 250
long_press_ms = 500

[profiles.buttons]
Guide = { mode = "Guide" }
South = { mouse = "Left" }
East = { keys = ["KEY_ESC"] }
West = { keys = ["KEY_LEFTSHIFT"] }
North = { keys = ["KEY_SPACE"] }
LeftBumper = { open_menu = "Map modes" }
RightBumper = { open_menu = "Army orders" }
Select = { open_menu = "Screens" }
Start = { keys = ["KEY_ESC"] }
LeftStick = { keys = ["KEY_F2"] }
RightStick = { keys = ["KEY_DOT"] }
DpadUp = { wheel = "Up" }
DpadDown = { wheel = "Down" }
DpadLeft = { keys = ["KEY_KPMINUS"] }
DpadRight = { keys = ["KEY_KPPLUS"] }

[profiles.gestures.LeftStick.long_press]
keys = ["KEY_HOME"]

[profiles.left_stick]
deadzone = 0.15
curve = 1.0
key_threshold = 0.35

[profiles.left_stick.action.ring]
sectors = 8
start_angle = 0.0
inner_radius = 0.35
hysteresis = 0.1

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_UP"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_UP"] },
    { keys = ["KEY_RIGHT"] },
]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_RIGHT"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_DOWN"] },
    { keys = ["KEY_RIGHT"] },
]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_DOWN"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_DOWN"] },
    { keys = ["KEY_LEFT"] },
]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_LEFT"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_UP"] },
    { keys = ["KEY_LEFT"] },
]

[profiles.right_stick]
deadzone = 0.12
curve = 1.8
key_threshold = 0.5

[profiles.right_stick.action.mouse]
speed = 1500.0
accel = 0.3

[profiles.left_trigger.action.button]
threshold = 0.4
action = { mouse = "Right" }

[profiles.right_trigger.action.button]
threshold = 0.3
action = { mouse = "Left" }

[profiles.guide]
notes = '''The right stick {rs} moves the pointer: {rt} or {south} is a left click, {lt} a right click (move an army, or open a province holder's character). The left stick {ls} pans the map.
{north} pauses and unpauses; the {leftright} d-pad slows the game down and speeds it up, and {updown} zooms.
Hold {west} for Shift while you click: add an army to the selection, add a waypoint, or open the top liege of a province.
Hold {lb} for the map modes and {rb} for the army orders, aimed with the right stick {rs}: release to pick.
{select} lists the screens, the ledger and the finders (tap it, pick with {south}, {east} closes the list). {east} or {start} is Escape: it closes the open window, and on the map opens the game menu.
Click {l3} for your character, and hold it to go back to your capital. Click {r3} for the character finder.
Hold {guide} and press {west} for the on-screen keyboard (save names, searches).
The keys are the game's defaults from the Paradox wiki's hotkey list, not checked on an install, and Crusader Kings II can't rebind them. Its speed keys are + and -, sent here from the numpad. It has no controller support and no quick save: save from the game menu.'''

[profiles.guide.edits]
"stick:Right" = { text = "Pointer" }
"stick:Left" = { text = "Pan the map" }
"trigger:Right" = { text = "Left click (select)" }
"trigger:Left" = { text = "Right click (move armies)" }
"button:South" = { text = "Left click" }
"button:East" = { text = "Close window" }
"button:West" = { text = "Hold: Shift (add, waypoint)" }
"button:North" = { text = "{icon:pause} Pause" }
"button:LeftBumper" = { text = "Hold: {icon:map} map modes" }
"button:RightBumper" = { text = "Hold: {icon:sword-cross} army orders" }
"button:Select" = { text = "Screens" }
"button:Start" = { text = "Game menu" }
"button:LeftStick" = { text = "{icon:person} Your character" }
"button:RightStick" = { text = "{icon:search} Find a character" }
"gesture:button:LeftStick:long_press" = { text = "{icon:home} Your capital" }

[[profiles.guide.merged]]
inputs = ["button:DpadUp", "button:DpadDown"]
text = "Zoom in / out"

[[profiles.guide.merged]]
inputs = ["button:DpadLeft", "button:DpadRight"]
text = "{icon:speed1} Slower / faster {icon:speed3}"

