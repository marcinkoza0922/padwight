format = 19
macros = []
overlay_font = "Cinzel"

[pack]
id = "df3b51f9-c2dc-4e7f-95f9-4dd0d0ae9873"
name = "Thief II: The Metal Age"
version = "1.2"
author = "Padwight"
description = "Thief II: The Metal Age (GOG, NewDark) on an Xbox-style pad, for the game's default keys. A uses and picks up, B jumps, RT attacks and draws the bow, LT blocks, X drops, Y leans forward, L3 toggles crouch, R3 zooms the mechanical eye. A full push of the left stick runs. Hold LB for items and RB for weapons and arrows; double tap to put them away. D-pad left and right lean, up and down cycle items. Select lists the map and objectives. Start is the menu; double tap it to quick save, hold it to quick load. Gyro and flick stick profiles are included to try."
made_with = "Xbox controller"

[[rules]]
kind = "executable"
value = "Thief2.exe"
profile = "Thief II"

[[rules]]
kind = "steam_app_id"
value = "211740"
profile = "Thief II"

[[profiles]]
name = "Thief II"
combos = []
combo_window_ms = 120
tap_window_ms = 250
long_press_ms = 500

[profiles.buttons]
South = { mouse = "Right" }
East = { keys = ["KEY_SPACE"] }
West = { keys = ["KEY_R"] }
North = { keys = ["KEY_LEFTALT", "KEY_W"] }
LeftBumper = { open_menu = "Items" }
RightBumper = { open_menu = "Weapons" }
Select = { open_menu = "Screens" }
Start = { keys = ["KEY_ESC"] }
Guide = { mode = "Guide" }
LeftStick = { keys = ["KEY_X"] }
DpadUp = { keys = ["KEY_LEFTSHIFT", "KEY_TAB"] }
DpadDown = { keys = ["KEY_TAB"] }
DpadLeft = { keys = ["KEY_Q"] }
DpadRight = { keys = ["KEY_E"] }
RightStick = { keys = ["KEY_RIGHTBRACE"] }

[profiles.gestures.LeftBumper.double_tap]
keys = ["KEY_BACKSPACE"]

[profiles.gestures.RightBumper.double_tap]
keys = ["KEY_GRAVE"]

[profiles.gestures.Start.double_tap]
keys = ["KEY_LEFTALT", "KEY_S"]

[profiles.gestures.Start.long_press]
keys = ["KEY_LEFTALT", "KEY_L"]

[profiles.gestures.RightStick.long_press]
keys = ["KEY_P"]

[profiles.left_stick]
deadzone = 0.12
curve = 1.0
key_threshold = 0.25

[profiles.left_stick.action.keys]
up = "KEY_W"
down = "KEY_S"
left = "KEY_A"
right = "KEY_D"

[[profiles.left_stick.zones]]
min = 0.7
max = 1.0
action = { keys = ["KEY_LEFTSHIFT"] }

[profiles.right_stick]
deadzone = 0.12
curve = 2.2
key_threshold = 0.5

[profiles.right_stick.action.mouse]
speed = 2600.0
accel = 0.5
accel_ramp_ms = 350
y_scale = 0.75

[profiles.left_trigger.action.button]
threshold = 0.4
action = { mouse = "Middle" }

[profiles.right_trigger.action.button]
threshold = 0.3
action = { mouse = "Left" }

[profiles.guide]
notes = '''A light push of the left stick {ls} walks, a full push runs (Shift).
Hold {rt} to draw the bow and let go to loose the arrow; a sword or blackjack swings when {rt} is pulled.
{south} frobs the world: opens doors, picks up loot and uses the item in hand on what you're looking at.
Hold {lb} for the items (potions, lockpicks, flash bombs) and {rb} for the weapons and arrows, aiming with the right stick {rs}. Double tap either to put the item or weapon away.
Crouch is a toggle in the game: click {l3} to crouch and again to stand.
{start} (Escape) is the menu. Double tap it to quick save and hold it to quick load.
If the game also reacts to the controller itself, turn Joystick off in Options, Controls.'''

[profiles.guide.edits]
"stick:Left" = { text = "Move (full push: run)" }
"stick:Right" = { text = "Look" }
"trigger:Right" = { text = "Attack / draw the bow" }
"trigger:Left" = { text = "Block" }
"button:South" = { text = "Use / pick up" }
"button:East" = { text = "Jump / mantle" }
"button:West" = { text = "Drop item" }
"button:North" = { text = "Lean forward" }
"button:LeftBumper" = { text = "Hold: items" }
"gesture:button:LeftBumper:double_tap" = { text = "Put item away" }
"button:RightBumper" = { text = "Hold: weapons" }
"gesture:button:RightBumper:double_tap" = { text = "Put weapon away" }
"button:LeftStick" = { text = "Crouch (toggle)" }
"button:Select" = { text = "Map, objectives" }
"button:Start" = { text = "Menu" }
"gesture:button:Start:double_tap" = { text = "Quick save" }
"gesture:button:Start:long_press" = { text = "Quick load" }
"button:RightStick" = { text = "Zoom in (scope, eye)" }
"gesture:button:RightStick:long_press" = { text = "Zoom all the way out" }

[[profiles.guide.merged]]
inputs = ["button:DpadLeft", "button:DpadRight"]
text = "Lean"

[[profiles.guide.merged]]
inputs = ["button:DpadUp", "button:DpadDown"]
text = "Previous / next item"

