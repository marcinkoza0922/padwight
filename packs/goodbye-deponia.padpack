[motion]
keyboard = "playful"
numpad = "playful"
menu = "playful"
media = "playful"
offer = "playful"
info = "playful"
log = "playful"

[sounds.menu]
step = {kind = "marimba", volume = 0.07, pitch = 1.1}
pick = {kind = "chime", volume = 0.08}
open = {kind = "pop", volume = 0.06}
close = {kind = "pop", volume = 0.05, pitch = 0.8}

[sounds.numpad]
step = {kind = "marimba", volume = 0.07, pitch = 1.1}
pick = {kind = "chime", volume = 0.08}

[sounds.keyboard]
step = {kind = "marimba", volume = 0.07, pitch = 1.1}
pick = {kind = "keys", volume = 0.14}

[sounds.media]
pick = {kind = "chime", volume = 0.08}
