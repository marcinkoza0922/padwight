format = 20
macros = []
overlay_font = "Orbitron"

[pack]
id = "44271cc3-0a10-4e0b-82c5-6a94a9d948d4"
name = "Knights of the Old Republic"
version = "1.0"
author = "Padwight"
description = "Knights of the Old Republic on an Xbox-style pad, for the game's default mouse and keyboard controls. The left stick walks and turns, the right stick moves the pointer, RT or A left-clicks and LT right-clicks. B pauses, X runs the default action on the target and LB and RB cycle targets. The d-pad fires the target's action slots, click the right stick to switch party member. Select lists the character sheet, inventory, abilities, journal and map."
made_with = "Xbox controller"

[[rules]]
kind = "executable"
value = "swkotor.exe"
profile = "Knights of the Old Republic"

[[rules]]
kind = "steam_app_id"
value = "32370"
profile = "Knights of the Old Republic"

[[profiles]]
name = "Knights of the Old Republic"
combos = []
combo_window_ms = 120
tap_window_ms = 250
long_press_ms = 500

[profiles.buttons]
Guide = { mode = "Guide" }
South = { mouse = "Left" }
East = { keys = ["KEY_SPACE"] }
West = { keys = ["KEY_R"] }
North = { keys = ["KEY_I"] }
LeftBumper = { keys = ["KEY_Q"] }
RightBumper = { keys = ["KEY_E"] }
Select = { open_menu = "Screens" }
Start = { keys = ["KEY_ESC"] }
LeftStick = { keys = ["KEY_LEFTSHIFT"] }
RightStick = { keys = ["KEY_TAB"] }
DpadUp = { keys = ["KEY_1"] }
DpadLeft = { keys = ["KEY_2"] }
DpadRight = { keys = ["KEY_3"] }
DpadDown = { keys = ["KEY_4"] }

[profiles.left_stick]
deadzone = 0.15
curve = 1.0
key_threshold = 0.35

[profiles.left_stick.action.ring]
sectors = 8
start_angle = 0.0
inner_radius = 0.35
hysteresis = 0.1

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_W"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_W"] },
    { keys = ["KEY_D"] },
]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_D"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_S"] },
    { keys = ["KEY_D"] },
]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_S"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_S"] },
    { keys = ["KEY_A"] },
]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_A"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_W"] },
    { keys = ["KEY_A"] },
]

[profiles.right_stick]
deadzone = 0.12
curve = 1.8
key_threshold = 0.5

[profiles.right_stick.action.mouse]
speed = 1500.0
accel = 0.3

[profiles.left_trigger.action.button]
threshold = 0.4
action = { mouse = "Right" }

[profiles.right_trigger.action.button]
threshold = 0.3
action = { mouse = "Left" }

[profiles.guide]
notes = '''The left stick walks: up and down move, left and right turn. The right stick moves the mouse pointer; {rt} or {south} is a left click (move there, talk, attack) and {lt} a right click.
{east} pauses and unpauses, so you can queue actions mid-fight. {lb} and {rb} cycle through targets, {west} runs the default action on the target and the {dpad} fires the first four slots of the target's action menu.
{rs} (click) switches the party member you steer. {start} (Escape) closes screens and opens the menu.
{select} lists the character sheet, inventory, abilities, journal, map and options. The keys behind them are the game's defaults; if one does nothing, check Options, Configure Controls.'''

[profiles.guide.edits]
"stick:Left" = { text = "Walk and turn" }
"stick:Right" = { text = "Pointer" }
"trigger:Right" = { text = "Left click" }
"trigger:Left" = { text = "Right click" }
"button:South" = { text = "Left click" }
"button:East" = { text = "{icon:pause} Pause" }
"button:West" = { text = "Default action on target" }
"button:North" = { text = "{icon:bag} Inventory" }
"button:LeftBumper" = { text = "Previous target" }
"button:RightBumper" = { text = "Next target" }
"button:LeftStick" = { text = "Walk (hold)" }
"button:RightStick" = { text = "Switch party member" }
"button:Select" = { text = "{icon:book} Character, journal, map" }
"button:Start" = { text = "Menu / back out" }
"button:DpadUp" = { text = "Target action 1" }
"button:DpadLeft" = { text = "Target action 2" }
"button:DpadRight" = { text = "Target action 3" }
"button:DpadDown" = { text = "Target action 4" }

