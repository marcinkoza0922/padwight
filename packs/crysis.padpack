format = 20
macros = []
overlay_font = "Orbitron"

[pack]
id = "1ab3e074-942f-4a31-82be-b2adabacd833"
name = "Crysis"
version = "1.0"
author = "Padwight"
description = "Crysis (2007) on an Xbox-style pad, modeled on the game's own controller table: A jumps, B goes prone, X reloads (hold to use), Y throws a grenade, RT fires, LB sprints, RB toggles zoom, L3 toggles crouch and LT is the suit key. Hold D-pad right for the suit menu and pick with the right stick. Start is the menu; double tap it to quick save, hold to quick load. Select lists the map, objectives and gadgets. Gyro and flick stick profiles are included to try."
made_with = "Xbox controller"

[[rules]]
kind = "executable"
value = "Crysis.exe"
profile = "Crysis"

[[rules]]
kind = "executable"
value = "Crysis64.exe"
profile = "Crysis"

[[rules]]
kind = "steam_app_id"
value = "17300"
profile = "Crysis"

[[profiles]]
name = "Crysis"
combos = []
combo_window_ms = 120
tap_window_ms = 250
long_press_ms = 500

[profiles.buttons]
South = { keys = ["KEY_SPACE"] }
East = { keys = ["KEY_Z"] }
West = { keys = ["KEY_R"] }
North = { keys = ["KEY_G"] }
LeftBumper = { keys = ["KEY_LEFTSHIFT"] }
RightBumper = { toggle = { action = { mouse = "Right" } } }
LeftStick = { toggle = { action = { keys = ["KEY_LEFTCTRL"] } } }
RightStick = { keys = ["KEY_T"] }
Select = { open_menu = "Screens" }
Start = { keys = ["KEY_ESC"] }
Guide = { mode = "Guide" }
DpadUp = { keys = ["KEY_X"] }
DpadDown = { keys = ["KEY_C"] }
DpadLeft = { wheel = "Up" }
DpadRight = { multi = [{ layer = "Suit menu" }, { mouse = "Middle" }] }

[profiles.gestures.West.long_press]
keys = ["KEY_F"]

[profiles.gestures.DpadLeft.long_press]
wheel = "Down"

[profiles.gestures.Start.double_tap]
keys = ["KEY_F5"]

[profiles.gestures.Start.long_press]
keys = ["KEY_F9"]

[profiles.left_stick]
deadzone = 0.12
curve = 1.0
key_threshold = 0.25

[profiles.left_stick.action.ring]
sectors = 8
start_angle = 0.0
inner_radius = 0.25
hysteresis = 0.1

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_W"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_W"] },
    { keys = ["KEY_D"] },
]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_D"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_S"] },
    { keys = ["KEY_D"] },
]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_S"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_S"] },
    { keys = ["KEY_A"] },
]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_A"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_W"] },
    { keys = ["KEY_A"] },
]

[profiles.right_stick]
deadzone = 0.1
curve = 1.8
key_threshold = 0.5

[profiles.right_stick.action.mouse]
speed = 1100.0
accel = 0.2

[profiles.left_trigger.action.button]
threshold = 0.4
action = { keys = ["KEY_V"] }

[profiles.right_trigger.action.button]
threshold = 0.3
action = { mouse = "Left" }

[profiles.guide]
notes = '''{start} (Escape) opens the game's menu and backs out of every screen in it.
{lt} holds the suit key (V). {rt} fires, {rb} toggles zoom, {lb} sprints, {l3} toggles crouch and {r3} is T, the special key.
Hold {dr} to open the suit menu, then turn the right stick {rs} toward Armor, Speed, Strength or Cloak and let go to pick it.
{x} reloads, and holding {x} uses. {a} jumps, {b} goes prone, {y} throws a grenade.
{dl} switches weapon; hold {dl} to go back one. {du} changes the fire mode and {dd} opens the weapon attachments.
Tap {select} for a list of the map, objectives, night vision, binoculars and gravity boots.
Quick save is a double tap of {start}, and quick load is a long press of {start}.
Crysis has no controller support of its own; the keys follow the game's default controls.'''

[profiles.guide.edits]
"stick:Left" = { text = "Move" }
"stick:Right" = { text = "Look" }
"trigger:Right" = { text = "Fire" }
"trigger:Left" = { text = "Suit key" }
"button:South" = { text = "Jump" }
"button:East" = { text = "Prone" }
"button:West" = { text = "Reload · hold: use" }
"button:North" = { text = "{icon:grenade} Throw grenade" }
"button:LeftBumper" = { text = "Sprint" }
"button:RightBumper" = { text = "{icon:scope} Zoom (toggle)" }
"button:LeftStick" = { text = "Crouch (toggle)" }
"button:RightStick" = { text = "Special" }
"button:DpadUp" = { text = "Fire mode" }
"button:DpadDown" = { text = "Weapon attachments" }
"button:DpadLeft" = { text = "Next weapon · hold: previous" }
"button:DpadRight" = { text = "Hold: suit menu" }
"button:Select" = { text = "Screens" }
"button:Start" = { text = "Menu / back out" }
"gesture:button:Start:double_tap" = { text = "{icon:save} Quick save" }
"gesture:button:Start:long_press" = { text = "{icon:load} Quick load" }

