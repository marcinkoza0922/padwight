format = 20
macros = []
overlay_font = "Rajdhani"

[pack]
id = "ff810e33-62bc-485a-b6e6-9adfb4b41154"
name = "Call of Duty: Black Ops"
version = "1.0"
author = "Padwight"
description = "Call of Duty: Black Ops (2010) on an Xbox-style pad. The PC game has its own XInput support during play, so the controller passes through untouched and you pick one of the game's controller presets in its options. Padwight adds the Guide overlay on top, with mouse mode for the menus the game's pad support can't drive. Gyro and flick stick profiles are there to try."
made_with = "Xbox controller"

[[rules]]
kind = "steam_app_id"
value = "42700"
profile = "Call of Duty: Black Ops"

[[rules]]
kind = "steam_app_id"
value = "42710"
profile = "Call of Duty: Black Ops"

[[rules]]
kind = "executable"
value = "BlackOps.exe"
profile = "Call of Duty: Black Ops"

[[rules]]
kind = "executable"
value = "BlackOpsMP.exe"
profile = "Call of Duty: Black Ops"

[[profiles]]
name = "Call of Duty: Black Ops"
combos = []
combo_window_ms = 120
tap_window_ms = 250
long_press_ms = 500

[profiles.buttons]
Guide = {mode = "Guide"}
South = {gamepad = "South"}
East = {gamepad = "East"}
North = {gamepad = "North"}
West = {gamepad = "West"}
LeftBumper = {gamepad = "LeftBumper"}
RightBumper = {gamepad = "RightBumper"}
LeftStick = {gamepad = "LeftStick"}
RightStick = {gamepad = "RightStick"}
Select = {gamepad = "Select"}
Start = {gamepad = "Start"}
DpadUp = {gamepad = "DpadUp"}
DpadDown = {gamepad = "DpadDown"}
DpadLeft = {gamepad = "DpadLeft"}
DpadRight = {gamepad = "DpadRight"}

[profiles.left_stick]
deadzone = 0.05
curve = 1.0
key_threshold = 0.3

[profiles.left_stick.action]
gamepad = {stick = "Left", invert_y = false}

[profiles.right_stick]
deadzone = 0.05
curve = 1.0
key_threshold = 0.3

[profiles.right_stick.action]
gamepad = {stick = "Right", invert_y = false}

[profiles.left_trigger]
action = {gamepad = "Left"}

[profiles.right_trigger]
action = {gamepad = "Right"}

[profiles.gyro]
enabled = false
horizontal = "yaw"
invert_x = false
invert_y = false
noise_threshold = 1.0

[profiles.guide]
notes = '''Black Ops has its own XInput support, so the controller goes to the game as it is. The game offers five button layouts and four stick presets in its controller options; pick them there.
The pad only works during play, not in the menus: press {guide} + {rs} for mouse mode to click through the menus and the lobby, and {guide} to leave it. Chat in multiplayer needs typing: open the on-screen keyboard with {guide} + {west}.
{guide} still works over the game: {guide} + {west} opens the on-screen keyboard and {guide} + {lb} the media controls.
If the game stops answering the pad, check that Steam Input or another remapper isn't also running for it.'''

[[profiles]]
name = "Call of Duty: Black Ops + Gyro"
combos = [
    {buttons = ["Select", "Start"], action = "gyro_clutch"},
]
combo_window_ms = 120
tap_window_ms = 250
long_press_ms = 500

[profiles.buttons]
Guide = {mode = "Guide"}
South = {gamepad = "South"}
East = {gamepad = "East"}
North = {gamepad = "North"}
West = {gamepad = "West"}
LeftBumper = {gamepad = "LeftBumper"}
RightBumper = {gamepad = "RightBumper"}
LeftStick = {gamepad = "LeftStick"}
RightStick = {gamepad = "RightStick"}
Select = {gamepad = "Select"}
Start = {gamepad = "Start"}
DpadUp = {gamepad = "DpadUp"}
DpadDown = {gamepad = "DpadDown"}
DpadLeft = {gamepad = "DpadLeft"}
DpadRight = {gamepad = "DpadRight"}

[profiles.gestures.Start]
long_press = "gyro_toggle"

[profiles.gestures.RightStick]
long_press = "gyro_recenter"

[profiles.left_stick]
deadzone = 0.05
curve = 1.0
key_threshold = 0.3

[profiles.left_stick.action]
gamepad = {stick = "Left", invert_y = false}

[profiles.right_stick]
deadzone = 0.05
curve = 1.0
key_threshold = 0.3

[profiles.right_stick.action]
gamepad = {stick = "Right", invert_y = false}

[profiles.left_trigger]
action = {gamepad = "Left"}

[profiles.right_trigger]
action = {gamepad = "Right"}

[profiles.gyro]
horizontal = "player_space"
invert_x = false
invert_y = false
full_turn_px = 3272.7
noise_threshold = 1.0

[profiles.gyro.mode.mouse]
sensitivity = 1.0

[profiles.guide]
notes = '''Hold {select} and {start} together to pause the gyro while you reposition the controller. Hold {start} to switch the gyro off or on, and hold {r3} to recenter it.
Black Ops has its own XInput support, so the controller goes to the game as it is. The game offers five button layouts and four stick presets in its controller options; pick them there.
The pad only works during play, not in the menus: press {guide} + {rs} for mouse mode to click through the menus and the lobby, and {guide} to leave it. Chat in multiplayer needs typing: open the on-screen keyboard with {guide} + {west}.
{guide} still works over the game: {guide} + {west} opens the on-screen keyboard and {guide} + {lb} the media controls.
If the game stops answering the pad, check that Steam Input or another remapper isn't also running for it.'''

[profiles.guide.edits]
"gesture:button:Start:long_press" = { text = "Gyro active / inactive" }
"gesture:button:RightStick:long_press" = { text = "Recenter gyro" }

[[profiles]]
name = "Call of Duty: Black Ops + Flick stick"
combos = [
    {buttons = ["Select", "Start"], action = "gyro_clutch"},
]
combo_window_ms = 120
tap_window_ms = 250
long_press_ms = 500
requires = ["gyro"]

[profiles.buttons]
Guide = {mode = "Guide"}
South = {gamepad = "South"}
East = {gamepad = "East"}
North = {gamepad = "North"}
West = {gamepad = "West"}
LeftBumper = {gamepad = "LeftBumper"}
RightBumper = {gamepad = "RightBumper"}
LeftStick = {gamepad = "LeftStick"}
RightStick = {gamepad = "RightStick"}
Select = {gamepad = "Select"}
Start = {gamepad = "Start"}
DpadUp = {gamepad = "DpadUp"}
DpadDown = {gamepad = "DpadDown"}
DpadLeft = {gamepad = "DpadLeft"}
DpadRight = {gamepad = "DpadRight"}

[profiles.gestures.Start]
long_press = "gyro_toggle"

[profiles.gestures.RightStick]
long_press = "gyro_recenter"

[profiles.left_stick]
deadzone = 0.05
curve = 1.0
key_threshold = 0.3

[profiles.left_stick.action]
gamepad = {stick = "Left", invert_y = false}

[profiles.right_stick]
deadzone = 0.1
curve = 2.0
key_threshold = 0.5

[profiles.right_stick.action.flick]
full_turn_px = 3272.7
flick_threshold = 0.9
flick_time_ms = 100
rotate_smoothing_ms = 0
forward_deadzone = 0.0
vertical = "off"
vertical_speed = 1200.0

[profiles.left_trigger]
action = {gamepad = "Left"}

[profiles.right_trigger]
action = {gamepad = "Right"}

[profiles.gyro]
horizontal = "player_space"
invert_x = false
invert_y = false
full_turn_px = 3272.7
noise_threshold = 1.0

[profiles.gyro.mode.mouse]
sensitivity = 1.0

[profiles.guide]
notes = '''Hold {select} and {start} together to pause the gyro while you reposition the controller. Hold {start} to switch the gyro off or on, and hold {r3} to recenter it.
Flick stick: push the right stick {rs} toward where you want to face and the view turns to it; turn it around the rim to keep turning. The gyro aims up, down and finely.
Black Ops has its own XInput support, so the controller goes to the game as it is. The game offers five button layouts and four stick presets in its controller options; pick them there.
The pad only works during play, not in the menus: press {guide} + {rs} for mouse mode to click through the menus and the lobby, and {guide} to leave it. Chat in multiplayer needs typing: open the on-screen keyboard with {guide} + {west}.
{guide} still works over the game: {guide} + {west} opens the on-screen keyboard and {guide} + {lb} the media controls.
If the game stops answering the pad, check that Steam Input or another remapper isn't also running for it.'''

[profiles.guide.edits]
"gesture:button:Start:long_press" = { text = "Gyro active / inactive" }
"gesture:button:RightStick:long_press" = { text = "Recenter gyro" }

