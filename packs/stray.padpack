[menu_style]
corners = 0.3
position = "center"
scale = 1.0

[menu_style.background]
color = "#0b1216"
opacity = 0.92

[menu_style.items]
color = "#18242a"
opacity = 0.95

[menu_style.selected]
color = "#2fd0c0"
