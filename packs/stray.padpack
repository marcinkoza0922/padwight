[menu_style.border]
width = 1
color = "#d0507a"
opacity = 0.8

[menu_style.gradient]
color = "#16121c"
opacity = 1.0
angle = 180
drift = true

[menu_style.item_border]
width = 1
color = "#2a3a40"

[menu_style.glow]
color = "#ff7aa8"
opacity = 0.6
blur = 18

[menu_style.type]
