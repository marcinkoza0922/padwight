format = 20
macros = []
overlay_font = "Rajdhani"

[pack]
id = "0e76470b-e02a-5cb0-9892-dbf865d90105"
name = "Stray"
version = "1.0"
author = "Padwight"
description = "Stray on an Xbox-style pad. The game has its own controller support, so the controller passes through untouched and the game's Controls options set the buttons. Padwight adds the Guide overlay on top, with the media controls and the on-screen keyboard, in the colors of the Dead City."
made_with = "Xbox controller"
native_controller = true

[[rules]]
kind = "executable"
value = "Stray-Win64-Shipping.exe"
profile = "Stray"

[[rules]]
kind = "steam_app_id"
value = "1332010"
profile = "Stray"

[[profiles]]
name = "Stray"
combos = []
combo_window_ms = 120
tap_window_ms = 250
long_press_ms = 500

[profiles.buttons]
Guide = {mode = "Guide"}
South = {gamepad = "South"}
East = {gamepad = "East"}
North = {gamepad = "North"}
West = {gamepad = "West"}
LeftBumper = {gamepad = "LeftBumper"}
RightBumper = {gamepad = "RightBumper"}
LeftStick = {gamepad = "LeftStick"}
RightStick = {gamepad = "RightStick"}
Select = {gamepad = "Select"}
Start = {gamepad = "Start"}
DpadUp = {gamepad = "DpadUp"}
DpadDown = {gamepad = "DpadDown"}
DpadLeft = {gamepad = "DpadLeft"}
DpadRight = {gamepad = "DpadRight"}

[profiles.left_stick]
deadzone = 0.05
curve = 1.0
key_threshold = 0.3

[profiles.left_stick.action]
gamepad = {stick = "Left", invert_y = false}

[profiles.right_stick]
deadzone = 0.05
curve = 1.0
key_threshold = 0.3

[profiles.right_stick.action]
gamepad = {stick = "Right", invert_y = false}

[profiles.left_trigger]
action = {gamepad = "Left"}

[profiles.right_trigger]
action = {gamepad = "Right"}

[profiles.gyro]
mode = "off"
horizontal = "yaw"
invert_x = false
invert_y = false
activation = "always"
noise_threshold = 1.0

[profiles.guide]
notes = '''Stray has its own controller support, so the controller goes to the game as it is. Set the buttons in the game's own Options → Controls.
{guide} still works over the game: {guide} + {west} opens the on-screen keyboard, and {guide} + {lb} the media controls.
If the game stops answering the pad, check that Steam Input or another remapper isn't also running for it.'''

[keyboard_style]
corners = 0.3
position = "bottom_center"
scale = 1.0

[keyboard_style.background]
color = "#0b1216"
opacity = 0.92

[keyboard_style.items]
color = "#18242a"
opacity = 0.95

[keyboard_style.selected]
color = "#2fd0c0"
opacity = 1.0

[keyboard_style.border]
width = 1
color = "#d0507a"
opacity = 0.8

[keyboard_style.gradient]
color = "#16121c"
opacity = 1.0
angle = 180

[keyboard_style.item_border]
width = 1
color = "#2a3a40"

[keyboard_style.type]
letter_spacing = 2
case = "upper"

[numpad_style]
corners = 0.3
position = "center"
scale = 1.0

[numpad_style.background]
color = "#0b1216"
opacity = 0.92

[numpad_style.items]
color = "#18242a"
opacity = 0.95

[numpad_style.selected]
color = "#2fd0c0"
opacity = 1.0

[numpad_style.border]
width = 1
color = "#d0507a"
opacity = 0.8

[numpad_style.gradient]
color = "#16121c"
opacity = 1.0
angle = 180

[numpad_style.item_border]
width = 1
color = "#2a3a40"

[numpad_style.type]
letter_spacing = 2
case = "upper"

[media_style]
corners = 0.3
position = "top_right"
scale = 0.9

[media_style.background]
color = "#0b1216"
opacity = 0.92

[media_style.items]
color = "#18242a"
opacity = 0.95

[media_style.selected]
color = "#2fd0c0"
opacity = 1.0

[media_style.border]
width = 1
color = "#d0507a"
opacity = 0.8

[media_style.gradient]
color = "#16121c"
