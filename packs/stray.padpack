case = "upper"

[menu_style.ornament]
scanlines = {spacing = 4, opacity = 0.06, color = "#000000"}
vignette = {color = "#000000", opacity = 0.45, reach = 25}

[motion]
keyboard = "dreamy"
numpad = "dreamy"
menu = "dreamy"
media = "dreamy"
offer = "dreamy"
info = "dreamy"
log = "dreamy"

[sounds.menu]
step = {kind = "pulse", volume = 0.06, pitch = 1.2}
pick = {kind = "beep", volume = 0.1, pitch = 1.2}
open = {kind = "purr", volume = 0.12}

[sounds.keyboard]
step = {kind = "pulse", volume = 0.05, pitch = 1.2}
pick = {kind = "beep", volume = 0.1, pitch = 1.4}

[sounds.numpad]
step = {kind = "pulse", volume = 0.05, pitch = 1.2}
pick = {kind = "beep", volume = 0.1, pitch = 1.4}

[sounds.media]
pick = {kind = "purr", volume = 0.12}

[rumble.menu]
step = {strength = 0.07, length_ms = 18}
pick = {strength = 0.25, length_ms = 35}

[rumble.keyboard]
step = {strength = 0.05, length_ms = 14}
pick = {strength = 0.17, length_ms = 22}

[rumble.numpad]
step = {strength = 0.05, length_ms = 14}
pick = {strength = 0.17, length_ms = 22}

[rumble.media]
pick = {strength = 0.17, length_ms = 25}

[rumble.guide]
mode = {strength = 0.17, length_ms = 60}
