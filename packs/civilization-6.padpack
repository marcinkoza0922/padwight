format = 19
macros = []
overlay_font = "Inter"

[pack]
id = "382fee5e-a2f6-4a2f-88c3-fefae1d29a12"
name = "Civilization VI"
version = "1.2"
author = "Padwight"
description = "Civilization VI (Steam, Linux or Windows build) on an Xbox-style pad. The right stick moves the pointer, the left stick pans the map, RT or A left-clicks, LT right-clicks to move units. X skips a unit, Y fortifies, RB goes to the next unit or ends the turn. Hold LB for unit orders. The d-pad zooms and cycles units (hold: cities). Select lists the advisors and screens. Start is the game menu; double tap it to quick save, hold it to quick load."
made_with = "Xbox controller"

[[rules]]
kind = "executable"
value = "Civ6"
profile = "Civilization VI"

[[rules]]
kind = "executable"
value = "Civ6Sub"
profile = "Civilization VI"

[[rules]]
kind = "executable"
value = "CivilizationVI.exe"
profile = "Civilization VI"

[[rules]]
