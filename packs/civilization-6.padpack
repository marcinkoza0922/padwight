"button:Start" = { text = "Game menu" }
"stick:Left" = { text = "Pan the map" }
"button:West" = { text = "Skip the unit's turn" }
"button:North" = { text = "Fortify" }
"button:RightBumper" = { text = "Next action / end turn" }
"button:LeftStick" = { text = "Go to the capital" }
"button:RightStick" = { text = "Lenses" }
"gesture:button:DpadLeft:long_press" = { text = "Previous city" }
"gesture:button:DpadRight:long_press" = { text = "Next city" }
"gesture:button:Start:double_tap" = { text = "Quick save" }
"gesture:button:Start:long_press" = { text = "Quick load" }

