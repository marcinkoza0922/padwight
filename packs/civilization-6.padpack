format = 18
macros = []
overlay_font = "Inter"

[pack]
id = "382fee5e-a2f6-4a2f-88c3-fefae1d29a12"
name = "Civilization VI"
version = "1.0"
author = "Padwight"
description = "Civilization VI (Steam, Linux or Windows build) on an Xbox-style pad. The right stick moves the pointer, the left stick pans the map, RT or A left-clicks, LT right-clicks to move units. X skips a unit, Y fortifies, RB goes to the next unit or ends the turn. Hold LB for unit orders. The d-pad zooms and cycles units (hold: cities). Select lists the advisors and screens. Start is the game menu; double tap it to quick save, hold it to quick load."
made_with = "Xbox controller"

[[rules]]
kind = "executable"
value = "Civ6"
profile = "Civilization VI"

[[rules]]
kind = "executable"
value = "Civ6Sub"
profile = "Civilization VI"

[[rules]]
kind = "executable"
value = "CivilizationVI.exe"
profile = "Civilization VI"

[[rules]]
kind = "executable"
value = "CivilizationVI_DX12.exe"
profile = "Civilization VI"

[[rules]]
kind = "steam_app_id"
value = "289070"
profile = "Civilization VI"

[[profiles]]
name = "Civilization VI"
combos = []
combo_window_ms = 120
tap_window_ms = 250
long_press_ms = 500

[profiles.buttons]
Guide = { mode = "Guide" }
South = { mouse = "Left" }
East = { keys = ["KEY_ESC"] }
West = { keys = ["KEY_SPACE"] }
North = { keys = ["KEY_F"] }
LeftBumper = { open_menu = "Orders" }
RightBumper = { keys = ["KEY_ENTER"] }
Select = { open_menu = "Screens" }
Start = { keys = ["KEY_ESC"] }
LeftStick = { keys = ["KEY_BACKSLASH"] }
RightStick = { open_menu = "Lenses" }
DpadUp = { wheel = "Up" }
DpadDown = { wheel = "Down" }
DpadLeft = { keys = ["KEY_COMMA"] }
DpadRight = { keys = ["KEY_DOT"] }

[profiles.gestures.DpadLeft.long_press]
keys = ["KEY_LEFTBRACE"]

[profiles.gestures.DpadRight.long_press]
keys = ["KEY_RIGHTBRACE"]

[profiles.gestures.Start.double_tap]
keys = ["KEY_F5"]

[profiles.gestures.Start.long_press]
keys = ["KEY_F6"]

[profiles.left_stick]
deadzone = 0.15
curve = 1.0
key_threshold = 0.35

[profiles.left_stick.action.keys]
up = "KEY_UP"
down = "KEY_DOWN"
left = "KEY_LEFT"
right = "KEY_RIGHT"

[profiles.right_stick]
deadzone = 0.12
curve = 1.8
key_threshold = 0.5

[profiles.right_stick.action.mouse]
speed = 1500.0
accel = 0.3

[profiles.left_trigger.action.button]
threshold = 0.4
action = { mouse = "Right" }

[profiles.right_trigger.action.button]
threshold = 0.3
action = { mouse = "Left" }

[profiles.guide]
notes = '''
The right stick moves the mouse pointer; RT or A is a left click and LT a right click. Hold Guide and press X for the on-screen keyboard when the game asks for a name.
LT gives a right click, which moves the selected unit to the tile under the pointer.
B closes the open screen. Start opens the game menu.
Hold LB for the unit orders, picking with the right stick.
RB goes to the next unit that needs orders, and ends the turn when none do.
Double tap Start to quick save and hold it to quick load. Click R3 for the lens list. Civilization VI on PC has no controller support of its own, so the controller works through these keys.'''

[profiles.guide.edits]
"stick:Right" = { text = "Pointer" }
"trigger:Right" = { text = "Left click (select)" }
"trigger:Left" = { text = "Right click (move to)" }
"button:South" = { text = "Left click" }
"button:East" = { text = "Close screen" }
"button:LeftBumper" = { text = "Hold: unit orders" }
"button:Select" = { text = "Advisors, screens" }
"button:Start" = { text = "Game menu" }
"stick:Left" = { text = "Pan the map" }
"button:West" = { text = "Skip the unit's turn" }
"button:North" = { text = "Fortify" }
"button:RightBumper" = { text = "Next action / end turn" }
"button:LeftStick" = { text = "Go to the capital" }
"button:RightStick" = { text = "Lenses" }
"gesture:button:DpadLeft:long_press" = { text = "Previous city" }
"gesture:button:DpadRight:long_press" = { text = "Next city" }
"gesture:button:Start:double_tap" = { text = "Quick save" }
"gesture:button:Start:long_press" = { text = "Quick load" }

[[profiles.guide.merged]]
inputs = ["button:DpadUp", "button:DpadDown"]
text = "Zoom in / out"

[[profiles.guide.merged]]
inputs = ["button:DpadLeft", "button:DpadRight"]
text = "Previous / next unit"

