format = 20
macros = []
overlay_font = "Cinzel"

[pack]
id = "44a3108d-7c89-517d-a010-c5b5bd2f7cde"
name = "The Elder Scrolls V: Skyrim Special Edition"
version = "1.0"
author = "Padwight"
description = "The Elder Scrolls V: Skyrim Special Edition, including the Anniversary Edition (the same program with the Creation Club content added) on an Xbox-style pad. The game has its own controller support, so the controller passes through untouched and the game's own options set the buttons. Padwight adds the Guide overlay on top, with the on-screen keyboard and the media controls, in the colors of the North."
made_with = "Xbox controller"

[[rules]]
kind = "executable"
value = "SkyrimSE.exe"
profile = "The Elder Scrolls V: Skyrim Special Edition"

[[rules]]
kind = "steam_app_id"
value = "489830"
profile = "The Elder Scrolls V: Skyrim Special Edition"

[[profiles]]
name = "The Elder Scrolls V: Skyrim Special Edition"
combos = []
combo_window_ms = 120
tap_window_ms = 250
long_press_ms = 500

[profiles.buttons]
South = {gamepad = "South"}
East = {gamepad = "East"}
North = {gamepad = "North"}
West = {gamepad = "West"}
LeftBumper = {gamepad = "LeftBumper"}
RightBumper = {gamepad = "RightBumper"}
LeftStick = {gamepad = "LeftStick"}
RightStick = {gamepad = "RightStick"}
Select = {gamepad = "Select"}
Start = {gamepad = "Start"}
DpadUp = {gamepad = "DpadUp"}
DpadDown = {gamepad = "DpadDown"}
DpadLeft = {gamepad = "DpadLeft"}
DpadRight = {gamepad = "DpadRight"}
Guide = {mode = "Guide"}

[profiles.left_stick]
deadzone = 0.05
curve = 1.0
key_threshold = 0.3

[profiles.left_stick.action]
gamepad = {stick = "Left", invert_y = false}

[profiles.right_stick]
deadzone = 0.05
curve = 1.0
key_threshold = 0.3

[profiles.right_stick.action]
gamepad = {stick = "Right", invert_y = false}

[profiles.left_trigger]
action = {gamepad = "Left"}

[profiles.right_trigger]
action = {gamepad = "Right"}

[profiles.gyro]
mode = "off"
horizontal = "yaw"
invert_x = false
invert_y = false
noise_threshold = 1.0

[profiles.guide]
notes = '''Skyrim Special Edition has its own controller support, so the controller goes to the game as it is. Set the buttons in the game's own Settings → Controls.
{guide} still works over the game: {guide} + {west} opens the on-screen keyboard, and {guide} + {lb} the media controls.
If the game stops answering the pad, check that Steam Input or another remapper isn't also running for it.'''

[keyboard_style]
corners = 0.15
position = "bottom_center"
scale = 1.0

[keyboard_style.background]
color = "#0f141a"
opacity = 0.92

[keyboard_style.items]
color = "#222c36"
opacity = 0.95

[keyboard_style.selected]
color = "#8fb4d4"
opacity = 1.0

[keyboard_style.border]
width = 1
color = "#6a8196"
opacity = 0.8

[keyboard_style.gradient]
color = "#19222c"
opacity = 1.0
angle = 180

[keyboard_style.item_border]
width = 1
color = "#3a4856"

[keyboard_style.type]
letter_spacing = 2
case = "upper"

[numpad_style]
corners = 0.15
position = "center"
scale = 1.0

[numpad_style.background]
color = "#0f141a"
opacity = 0.92

[numpad_style.items]
color = "#222c36"
opacity = 0.95

[numpad_style.selected]
color = "#8fb4d4"
opacity = 1.0

[numpad_style.border]
width = 1
color = "#6a8196"
opacity = 0.8

[numpad_style.gradient]
color = "#19222c"
opacity = 1.0
angle = 180

[numpad_style.item_border]
width = 1
color = "#3a4856"

[numpad_style.type]
letter_spacing = 2
case = "upper"

[media_style]
