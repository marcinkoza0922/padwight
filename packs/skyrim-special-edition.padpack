position = "center"
scale = 1.0

[menu_style.background]
color = "#0f141a"
opacity = 0.92

[menu_style.items]
color = "#222c36"
opacity = 0.95

[menu_style.selected]
color = "#8fb4d4"
opacity = 1.0

[menu_style.border]
width = 1
color = "#6a8196"
opacity = 0.8

[menu_style.gradient]
color = "#19222c"
opacity = 1.0
angle = 180

[menu_style.item_border]
width = 1
color = "#3a4856"

[menu_style.glow]
color = "#bcd8f0"
opacity = 0.6
blur = 18
pulse = true

[menu_style.type]
