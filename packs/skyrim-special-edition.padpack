case = "upper"

[menu_style.ornament]
frame = {kind = "chamfer", size = 12, width = 1, color = "#8fb4d4"}
vignette = {color = "#000000", opacity = 0.45, reach = 25}

[motion]
keyboard = "dreamy"
numpad = "dreamy"
menu = "dreamy"
media = "dreamy"
offer = "dreamy"
info = "dreamy"
log = "dreamy"

[sounds.menu]
step = {kind = "tick", volume = 0.07, pitch = 0.8}
pick = {kind = "clank", volume = 0.1}
open = {kind = "swish", volume = 0.04}
close = {kind = "swish", volume = 0.03, pitch = 0.8}

[sounds.keyboard]
step = {kind = "tick", volume = 0.07, pitch = 0.8}
pick = {kind = "wood", volume = 0.16}

[sounds.numpad]
step = {kind = "tick", volume = 0.07, pitch = 0.8}
pick = {kind = "wood", volume = 0.16}

[sounds.media]
pick = {kind = "wood", volume = 0.16}

[rumble.menu]
step = {strength = 0.1, length_ms = 18}
pick = {strength = 0.35, length_ms = 35}

[rumble.keyboard]
step = {strength = 0.07, length_ms = 14}
pick = {strength = 0.24, length_ms = 22}

[rumble.numpad]
step = {strength = 0.07, length_ms = 14}
pick = {strength = 0.24, length_ms = 22}

[rumble.media]
pick = {strength = 0.24, length_ms = 25}

[rumble.guide]
mode = {strength = 0.24, length_ms = 60}
