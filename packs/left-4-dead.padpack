[motion]
keyboard = "grim"
numpad = "grim"
menu = "grim"
media = "grim"
offer = "grim"
info = "grim"
log = "grim"

[sounds.menu]
step = {kind = "click", volume = 0.1, pitch = 0.8}
pick = {kind = "thud", volume = 0.2, pitch = 0.8}

[sounds.keyboard]
step = {kind = "tick", volume = 0.07, pitch = 1.2}
pick = {kind = "keys", volume = 0.2}

[sounds.numpad]
step = {kind = "tick", volume = 0.07, pitch = 1.2}
pick = {kind = "beep", volume = 0.15, pitch = 0.8}

[sounds.media]
pick = {kind = "beep", volume = 0.15, pitch = 0.8}

[rumble.menu]
step = {strength = 0.1, length_ms = 18}
pick = {strength = 0.4, length_ms = 40}

[rumble.keyboard]
step = {strength = 0.08, length_ms = 14}
pick = {strength = 0.3, length_ms = 22}

[rumble.numpad]
