format = 20
macros = []
overlay_font = "Titillium Web"

[pack]
id = "0c9785fd-ffe0-59a5-a19f-f1071796f0a6"
name = "Kerbal Space Program 2"
version = "1.0"
author = "Padwight"
description = "Kerbal Space Program 2 (Steam, early access 2023) on an Xbox-style pad, flight scheme. The left stick pitches and yaws, LB and RB roll, the d-pad throttles and warps time. A stages, X toggles SAS, Y toggles RCS, B cuts the throttle. The right stick is the pointer, hold LT to orbit the camera. Select lists the ship controls."
made_with = "Xbox controller"

[[rules]]
kind = "executable"
value = "ksp2_x64.exe"
profile = "Kerbal Space Program 2"

[[rules]]
kind = "steam_app_id"
value = "954850"
profile = "Kerbal Space Program 2"

[[profiles]]
name = "Kerbal Space Program 2"
combos = []
combo_window_ms = 120
tap_window_ms = 250
long_press_ms = 500

[profiles.buttons]
Guide = { mode = "Guide" }
South = { keys = ["KEY_SPACE"] }
East = { keys = ["KEY_X"] }
West = { keys = ["KEY_T"] }
North = { keys = ["KEY_R"] }
LeftBumper = { keys = ["KEY_Q"] }
RightBumper = { keys = ["KEY_E"] }
Select = { open_menu = "Ship controls" }
Start = { keys = ["KEY_ESC"] }
LeftStick = { keys = ["KEY_M"] }
RightStick = { mouse = "Left" }
DpadUp = { keys = ["KEY_LEFTSHIFT"] }
DpadDown = { keys = ["KEY_LEFTCTRL"] }
DpadLeft = { keys = ["KEY_COMMA"] }
DpadRight = { keys = ["KEY_DOT"] }

[profiles.left_stick]
deadzone = 0.15
curve = 1.0
key_threshold = 0.35

[profiles.left_stick.action.ring]
sectors = 8
start_angle = 0.0
inner_radius = 0.35
hysteresis = 0.1

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_W"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_W"] },
    { keys = ["KEY_D"] },
]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_D"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_S"] },
    { keys = ["KEY_D"] },
]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_S"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_S"] },
    { keys = ["KEY_A"] },
]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_A"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_W"] },
    { keys = ["KEY_A"] },
]

[profiles.right_stick]
deadzone = 0.12
curve = 1.8
key_threshold = 0.5

[profiles.right_stick.action.mouse]
speed = 1500.0
accel = 0.3

[profiles.left_trigger.action.button]
threshold = 0.4
action = { mouse = "Right" }

[profiles.right_trigger.action.button]
threshold = 0.3
action = { mouse = "Left" }

[profiles.guide]
notes = '''Flight scheme. The left stick {ls} is pitch (up and down) and yaw (left and right), W S A D. {lb} and {rb} roll (Q and E).
{south} stages (Space), {west} toggles SAS (T), {north} toggles RCS (R), {east} cuts the throttle (X). {start} is Escape.
The {updown} d-pad holds Shift (throttle up) and Ctrl (throttle down); {leftright} slows and speeds time warp (comma and period). Click {l3} for the map (M).
The right stick {rs} moves the pointer and {r3} left-clicks, for menus and the builder. Hold {lt} for the right mouse button and move {rs} to orbit the camera; {rt} left-clicks.
{select} lists the ship controls: full throttle, landing gear, brakes, lights, camera mode.
In the vehicle assembly building, use the pointer: {rt} places and picks parts, {lt} held rotates the view.
Hold {guide} and press {west} for the on-screen keyboard (ship names).
KSP2 has no controller support on PC. INFERRED, not checked on an install: all keys, taken from Kerbal Space Program 1 defaults (the second game keeps most of them but allows remapping in its Controls settings). Check Settings, Input if something does nothing.'''

[profiles.guide.edits]
"stick:Right" = { text = "Pointer" }
"stick:Left" = { text = "Pitch and yaw" }
"trigger:Right" = { text = "Left click" }
"trigger:Left" = { text = "Hold: right click (orbit camera)" }
"button:South" = { text = "{icon:rocket} Stage" }
"button:East" = { text = "Cut throttle" }
"button:West" = { text = "SAS on / off" }
"button:North" = { text = "RCS on / off" }
"button:LeftBumper" = { text = "Roll left" }
"button:RightBumper" = { text = "Roll right" }
"button:Select" = { text = "Ship controls" }
"button:Start" = { text = "Game menu" }
"button:LeftStick" = { text = "{icon:map} Map" }
"button:RightStick" = { text = "Left click" }
"button:DpadUp" = { text = "Throttle up (hold)" }
"button:DpadDown" = { text = "Throttle down (hold)" }
"button:DpadLeft" = { text = "Slower time warp" }
"button:DpadRight" = { text = "Faster time warp" }

[[menus]]
name = "Ship controls"
kind = "list"

[[menus.items]]
label = "{icon:fast} Full throttle {color:gray}Z{/color}"
action = { keys = ["KEY_Z"] }

[[menus.items]]
label = "{icon:stop} Cut throttle {color:gray}X{/color}"
action = { keys = ["KEY_X"] }

[[menus.items]]
label = "{icon:anchor} Landing gear {color:gray}G{/color}"
action = { keys = ["KEY_G"] }

[[menus.items]]
label = "{icon:forbid} Brakes {color:gray}B{/color}"
action = { keys = ["KEY_B"] }

[[menus.items]]
label = "{icon:bulb} Lights {color:gray}U{/color}"
action = { keys = ["KEY_U"] }

[[menus.items]]
label = "{icon:camera} Camera mode {color:gray}C{/color}"
action = { keys = ["KEY_C"] }

[[menus.items]]
label = "{icon:map} Map {color:gray}M{/color}"
action = { keys = ["KEY_M"] }

