format = 20
macros = []
overlay_font = "Special Elite"

[pack]
id = "ad3ad955-c6bc-47a4-86a8-e99efc233c8c"
name = "Resident Evil 4 Remake"
version = "1.0"
author = "Padwight"
description = "Resident Evil 4 (the 2023 remake, Steam) on an Xbox-style pad. The game has its own controller support, so the controller passes through untouched and the game's Controls options, where the buttons and the sticks can be changed set the buttons. Padwight adds the Guide overlay on top, with the on-screen keyboard and the media controls, typed out in typewriter ink."
made_with = "Xbox controller"

[[rules]]
kind = "executable"
value = "re4.exe"
profile = "Resident Evil 4 Remake"

[[rules]]
kind = "steam_app_id"
value = "2050650"
profile = "Resident Evil 4 Remake"


[[profiles]]
name = "Resident Evil 4 Remake"
combos = []
combo_window_ms = 120
tap_window_ms = 250
long_press_ms = 500

[profiles.buttons]
Guide = {mode = "Guide"}
South = {gamepad = "South"}
East = {gamepad = "East"}
North = {gamepad = "North"}
West = {gamepad = "West"}
LeftBumper = {gamepad = "LeftBumper"}
RightBumper = {gamepad = "RightBumper"}
LeftStick = {gamepad = "LeftStick"}
RightStick = {gamepad = "RightStick"}
Select = {gamepad = "Select"}
Start = {gamepad = "Start"}
DpadUp = {gamepad = "DpadUp"}
DpadDown = {gamepad = "DpadDown"}
DpadLeft = {gamepad = "DpadLeft"}
DpadRight = {gamepad = "DpadRight"}

[profiles.left_stick]
deadzone = 0.05
curve = 1.0
key_threshold = 0.3

[profiles.left_stick.action]
gamepad = {stick = "Left", invert_y = false}

[profiles.right_stick]
deadzone = 0.05
curve = 1.0
key_threshold = 0.3

[profiles.right_stick.action]
gamepad = {stick = "Right", invert_y = false}

[profiles.left_trigger]
action = {gamepad = "Left"}

[profiles.right_trigger]
action = {gamepad = "Right"}

[profiles.gyro]
mode = "off"
horizontal = "yaw"
invert_x = false
invert_y = false
noise_threshold = 1.0

[profiles.guide]
notes = '''Resident Evil 4 (the 2023 remake, Steam) has its own controller support, so the controller goes to the game as it is. Set the buttons in the game's Controls options, where the buttons and the sticks can be changed.
{guide} still works over the game: {guide} + {west} opens the on-screen keyboard and {guide} + {lb} the media controls.
If the game stops answering the pad, check that Steam Input or another remapper isn't also running for it.'''

[menu_style]
