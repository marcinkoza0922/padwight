position = "center"
scale = 1.0

[menu_style.background]
color = "#e8dfc6"
opacity = 0.96

[menu_style.items]
color = "#d6cbab"
opacity = 0.9

[menu_style.selected]
color = "#1d1b18"
opacity = 1.0

