format = 20
macros = []
overlay_font = "Comfortaa"

[pack]
id = "c41f7e92-2d5b-4b8a-8e36-71a0d9c5e2b7"
name = "Planet Coaster"
version = "1.0"
author = "Padwight"
description = "Planet Coaster on an Xbox-style pad, for the game's default keys. The left stick pans the camera and the right stick moves the pointer; RT and A click, hold LT to turn the camera. Hold LB with the D-pad for the move tools. X rotates, hold Y for height and RB for Ctrl, L3 switches angle snap, and the D-pad zooms and turns. Rounded overlays in the park's night blue, a family with Planet Zoo."
made_with = "Xbox controller"

[[rules]]
kind = "steam_app_id"
value = "493340"
profile = "Planet Coaster"

[[rules]]
kind = "executable"
value = "PlanetCoaster.exe"
profile = "Planet Coaster"

[[profiles]]
name = "Planet Coaster"
combos = []
combo_window_ms = 120
tap_window_ms = 250
long_press_ms = 500

[profiles.buttons]
Guide = {mode = "Guide"}
South = {mouse = "Left"}
East = {keys = ["KEY_ESC"]}
West = {keys = ["KEY_Z"]}
North = {keys = ["KEY_LEFTSHIFT"]}
LeftBumper = {open_menu = "Tools"}
RightBumper = {keys = ["KEY_LEFTCTRL"]}
Start = {keys = ["KEY_ESC"]}
LeftStick = {keys = ["KEY_SPACE"]}
RightStick = {keys = ["KEY_TAB"]}
DpadUp = {keys = ["KEY_PAGEUP"]}
DpadDown = {keys = ["KEY_PAGEDOWN"]}
DpadLeft = {keys = ["KEY_Q"]}
DpadRight = {keys = ["KEY_E"]}

[profiles.left_stick]
deadzone = 0.15
curve = 1.0
key_threshold = 0.35

[profiles.left_stick.action.ring]
sectors = 8
start_angle = 0.0
inner_radius = 0.35
hysteresis = 0.1

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_W"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_W"] },
    { keys = ["KEY_D"] },
]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_D"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_S"] },
    { keys = ["KEY_D"] },
]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_S"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_S"] },
    { keys = ["KEY_A"] },
]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_A"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_W"] },
    { keys = ["KEY_A"] },
]

[profiles.right_stick]
deadzone = 0.12
curve = 1.7
key_threshold = 0.5

[profiles.right_stick.action.mouse]
speed = 1400.0
accel = 0.3

[profiles.left_trigger.action.button]
threshold = 0.4
action = {mouse = "Middle"}

[profiles.right_trigger.action.button]
threshold = 0.3
action = {mouse = "Left"}

[profiles.gyro]
enabled = false
horizontal = "yaw"
invert_x = false
invert_y = false
noise_threshold = 1.0

[profiles.guide]
notes = '''The right stick {rs} moves the pointer and the left stick {ls} pans the camera. {rt} or {south} clicks; hold {lt} and move the right stick {rs} to turn and tilt the camera. {up} and {down} zoom, {left} and {right} turn the camera.
Hold {lb} and press the {dpad} for the move tools: up moves, right is the advanced move, down deletes and left switches the freelook camera.
{west} turns what you're placing a quarter; hold it and move the pointer to turn it freely. Hold {north} and move the pointer up or down to change its height, {r3} resets it. Hold {rb} for Ctrl. {l3} switches angle snap.
{east} cancels and deselects, {start} is the menu. The park's screens and build categories have no keys we could confirm: point at them on the toolbar.
Keys are the game's defaults from its v1.0 keybind list and players' notes, not read from an install; the move tools, delete and freelook are assumed to match Planet Zoo's. If one is off, check Settings → Controls. The Console Edition's rebuilt interface can't be copied, so this follows the PC keys. Naming a ride or the park: {guide} + {west} opens the on-screen keyboard.'''

[profiles.guide.edits]
"stick:Left" = {text = "Pan the camera"}
"stick:Right" = {text = "Pointer"}
"trigger:Right" = {text = "Click"}
"trigger:Left" = {text = "Hold: turn the camera"}
"button:South" = {text = "Click"}
"button:East" = {text = "Cancel / deselect"}
"button:West" = {text = "{icon:rotate} Rotate (hold: freely)"}
"button:North" = {text = "{icon:height} Hold: height"}
"button:LeftBumper" = {text = "Hold + {dpad}: move tools"}
"button:RightBumper" = {text = "Hold: Ctrl"}
"button:Start" = {text = "Menu"}
"button:LeftStick" = {text = "{icon:grid} Angle snap on / off"}
"button:RightStick" = {text = "{icon:height} Reset height"}

[[profiles.guide.merged]]
inputs = ["button:DpadUp", "button:DpadDown"]
text = "Zoom in / out"

[[profiles.guide.merged]]
inputs = ["button:DpadLeft", "button:DpadRight"]
text = "Turn the camera"


