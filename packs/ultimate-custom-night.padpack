[profiles.gyro]
horizontal = "yaw"
invert_x = false
invert_y = false
noise_threshold = 1.0

[profiles.gyro.mode.mouse]
sensitivity = 20.0

[profiles.guide]
notes = '''Hold {select} and {start} together to pause the gyro while you reposition the controller. Tilting the controller moves the pointer, as a fine pointer next to the right stick {rs}.
The office is played with the mouse: the right stick {rs} moves the pointer, and pushing it to the screen's edge looks left and right; the left stick {ls} moves it slowly. {south} or {rt} clicks. The Freddy mask has no key: flick the pointer over its bar at the bottom left.
{lb} and {rb} shut the left and right doors (A, D), {north} the front vent (W) and {east} the side vent (F). {lt} raises and lowers the monitor (S). Hold {west} for the flashlight (Z).
The D-pad picks a power tool: {up} power generator, {right} silent ventilation, {down} heater, {left} power A/C (1 to 4); {select} is the global music box (5) and {r3} switches them all off (X). {l3} turns the desk fan on and off (Space).
{start} is Escape; hold it to leave the night. The game also came out on PlayStation 4, Xbox One and Switch, but their button layout couldn't be looked up, so this is built on the PC keys, which come from community guides and are unchecked on an install.'''

[profiles.guide.edits]
"stick:Left" = {text = "Fine pointer"}
"stick:Right" = {text = "Pointer · look"}
