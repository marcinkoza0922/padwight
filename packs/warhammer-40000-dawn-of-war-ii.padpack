format = 20
macros = []
overlay_font = "Cinzel"

[pack]
id = "751926d0-cc3b-4be5-8884-cefe47e0c318"
name = "Warhammer 40,000: Dawn of War II"
version = "1.0"
author = "Padwight"
description = "Warhammer 40,000: Dawn of War II (2009, Steam, Windows or Linux build) on an Xbox-style pad, for the default hotkeys. The game has no controller support, so the layout is built on its keys: the right stick moves the cursor, RT left-clicks, LT right-clicks, the left stick scrolls the map, the d-pad zooms, reinforces and jumps to the last event. A attack-moves, X stops, Y retreats. Hold LB for control groups 1-10 (LB + RB sets one), R3 for squad commands. Select lists pause, chat and the game menu; hold it for the Menus mode. Start is the game menu. The \"+ Gyro\" profile also moves the cursor by tilting the controller."
made_with = "Xbox controller"

[[rules]]
kind = "executable"
value = "DOW2.exe"
profile = "Warhammer 40,000: Dawn of War II"

[[rules]]
kind = "executable"
value = "DawnOfWar2"
profile = "Warhammer 40,000: Dawn of War II"

[[rules]]
kind = "steam_app_id"
value = "15620"
profile = "Warhammer 40,000: Dawn of War II"

[[profiles]]
name = "Warhammer 40,000: Dawn of War II"
combos = [{buttons = ["LeftBumper", "RightBumper"], action = {open_menu = "Set group"}}]
combo_window_ms = 120
tap_window_ms = 250
long_press_ms = 500

[profiles.buttons]
Guide = {mode = "Guide"}
South = {keys = ["KEY_A"]}
West = {keys = ["KEY_S"]}
North = {keys = ["KEY_T"]}
East = {keys = ["KEY_ESC"]}
LeftBumper = {open_menu = "Groups"}
RightBumper = {keys = ["KEY_LEFTSHIFT"]}
Select = {open_menu = "Game"}
Start = {keys = ["KEY_ESC"]}
LeftStick = {keys = ["KEY_TAB"]}
RightStick = {open_menu = "Commands"}
DpadUp = {wheel = "Up"}
DpadDown = {wheel = "Down"}
DpadLeft = {keys = ["KEY_R"]}
DpadRight = {keys = ["KEY_SPACE"]}

[profiles.gestures.Select]
long_press = {mode = "Menus"}

[profiles.left_stick]
deadzone = 0.2
curve = 1.0
key_threshold = 0.45

[profiles.left_stick.action.ring]
sectors = 8
start_angle = 0.0
inner_radius = 0.45
hysteresis = 0.1

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_UP"]

[[profiles.left_stick.action.ring.actions]]
multi = [{ keys = ["KEY_UP"] }, { keys = ["KEY_RIGHT"] }]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_RIGHT"]

[[profiles.left_stick.action.ring.actions]]
multi = [{ keys = ["KEY_DOWN"] }, { keys = ["KEY_RIGHT"] }]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_DOWN"]

[[profiles.left_stick.action.ring.actions]]
multi = [{ keys = ["KEY_DOWN"] }, { keys = ["KEY_LEFT"] }]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_LEFT"]

[[profiles.left_stick.action.ring.actions]]
multi = [{ keys = ["KEY_UP"] }, { keys = ["KEY_LEFT"] }]

[profiles.right_stick]
deadzone = 0.1
curve = 1.6
key_threshold = 0.25

[profiles.right_stick.action.mouse]
speed = 1500.0
accel = 0.25

[profiles.left_trigger.action.button]
threshold = 0.4
action = { mouse = "Right" }

[profiles.right_trigger.action.button]
threshold = 0.3
action = { mouse = "Left" }

[profiles.gyro]
enabled = false
horizontal = "yaw"
invert_x = false
invert_y = false
noise_threshold = 1.0

[profiles.guide]
notes = '''The right stick {rs} moves the cursor: {rt} selects (left click, hold to drag a box), and {lt} moves, attacks, takes cover or captures a point (right click). The left stick {ls} scrolls the map, and {up} {down} zoom.
{south} is attack move (then click the target with {rt}), {west} stops and {north} retreats the squad to base. {left} reinforces a squad standing near a building or a reinforcement point, and {right} jumps to the last event. Click {l3} for the next squad in the selection.
Hold {lb} for the control groups and aim the right stick {rs} at one: release to select it. Hold {lb} and {rb} together to put the selection in a group instead (Ctrl + number).
{rb} is Shift: hold it to queue orders or add to the selection. Abilities, items and the wargear are the buttons on the taskbar: click them with {rt}.
Click {r3} for the squad commands, aimed with the right stick {rs}. {select} lists pause, chat and the game menu. Hold {select} for the Menus mode (the main menu, wargear and lobbies) and hold it again to come back. {start} (Esc) is the game menu; {east} cancels.
The keys are the defaults as best known, not checked on an install: reinforce (R) and retreat (T) follow Company of Heroes; stop (S), attack ground (G) and last event (Space) are the likeliest to differ. Keys can be changed only in keydefaults.lua (copy _keydefaults.lua in the settings folder); the grid keys option changes them too. The Linux executable name (DawnOfWar2) is a guess. Guide + {west} opens the on-screen keyboard for chat.'''

[profiles.guide.edits]
"stick:Left" = { text = "Scroll the map" }
"stick:Right" = { text = "Cursor" }
"trigger:Right" = { text = "Left click (select, drag a box)" }
"trigger:Left" = { text = "Right click (move, attack, take cover)" }
"button:South" = { text = "{icon:sword} Attack move" }
"button:West" = { text = "{icon:stop} Stop" }
"button:North" = { text = "{icon:retreat} {color:red}Retreat{/color}" }
"button:East" = { text = "Cancel" }
"button:RightBumper" = { text = "Shift (queue, add)" }
"button:LeftBumper" = { text = "Hold: control groups" }
"button:LeftStick" = { text = "Next squad in selection" }
"button:RightStick" = { text = "Squad commands" }
"button:DpadLeft" = { text = "{icon:reinforce} Reinforce" }
"button:DpadRight" = { text = "{icon:bell} Last event" }
"button:Select" = { text = "Pause, chat, menu" }
"button:Start" = { text = "Game menu" }
"gesture:button:Select:long_press" = { text = "Menus mode on / off" }

[[profiles.guide.merged]]
inputs = ["button:DpadUp", "button:DpadDown"]
text = "Zoom in / out"

[[profiles.guide.custom]]
inputs = ["button:LeftBumper", "button:RightBumper"]
text = "Set a control group"

[[profiles]]
