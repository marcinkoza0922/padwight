format = 20
macros = []
overlay_font = "Orbitron"

[pack]
id = "92ed435f-4501-4d64-8ba1-2814953632c0"
name = "Quake Champions"
version = "1.0"
author = "Padwight"
description = "Quake Champions on an Xbox-style pad, for the game's default keys. A jumps, B crouches while held, RT fires and LT zooms. RB is your champion's ability, Y and X step to the next and the last weapon, and LB holds a ring of all the weapons. The D-pad picks the rocket launcher, railgun, lightning gun and super shotgun straight away, R3 takes out the gauntlet, and Select holds the scoreboard. The game has no controller support. Gyro and flick stick profiles are included to try."
made_with = "Xbox controller"

[[rules]]
kind = "steam_app_id"
value = "611500"
profile = "Quake Champions"

[[rules]]
kind = "executable"
value = "QuakeChampions.exe"
profile = "Quake Champions"

[[profiles]]
name = "Quake Champions"
combos = []
combo_window_ms = 120
tap_window_ms = 250
long_press_ms = 300

[profiles.buttons]
Guide = { mode = "Guide" }
South = { keys = ["KEY_SPACE"] }
East = { keys = ["KEY_LEFTCTRL"] }
West = { keys = ["KEY_Q"] }
North = { wheel = "Down" }
LeftBumper = { open_menu = "Weapons" }
RightBumper = { keys = ["KEY_F"] }
RightStick = { keys = ["KEY_1"] }
Select = { keys = ["KEY_TAB"] }
Start = { keys = ["KEY_ESC"] }
DpadUp = { keys = ["KEY_5"] }
DpadRight = { keys = ["KEY_7"] }
DpadDown = { keys = ["KEY_6"] }
DpadLeft = { keys = ["KEY_3"] }

[profiles.left_stick]
deadzone = 0.12
curve = 1.0
key_threshold = 0.25

[profiles.left_stick.action.ring]
sectors = 8
start_angle = 0.0
inner_radius = 0.25
hysteresis = 0.1

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_W"]

[[profiles.left_stick.action.ring.actions]]
multi = [{ keys = ["KEY_W"] }, { keys = ["KEY_D"] }]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_D"]

[[profiles.left_stick.action.ring.actions]]
multi = [{ keys = ["KEY_S"] }, { keys = ["KEY_D"] }]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_S"]

[[profiles.left_stick.action.ring.actions]]
multi = [{ keys = ["KEY_S"] }, { keys = ["KEY_A"] }]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_A"]

[[profiles.left_stick.action.ring.actions]]
multi = [{ keys = ["KEY_W"] }, { keys = ["KEY_A"] }]

[profiles.right_stick]
deadzone = 0.08
curve = 2.0
key_threshold = 0.5

[profiles.right_stick.action.mouse]
speed = 1600.0
accel = 0.2

[profiles.left_trigger.action.button]
threshold = 0.4
action = { multi = [{ layer = "Aim" }, { mouse = "Right" }] }

[profiles.right_trigger.action.button]
threshold = 0.3
action = { mouse = "Left" }

[profiles.guide]
notes = '''{start} (Escape) opens the game's menu and backs out of its screens.
{south} jumps; hold it to keep bunny hopping where your champion can. {east} crouches while held, as the game expects for crouch slides and crouch jumps, so it isn't a toggle. {rb} is your champion's active ability.
Hold {lt} to zoom; the right stick turns more finely while it's held.
{north} switches to the next weapon and {west} back to the last one you held. Hold {lb} for a ring of all the weapon slots, aiming with the right stick {rs}. The D-pad picks one straight away: {up} rocket launcher, {right} railgun, {down} lightning gun, {left} super shotgun. {r3} takes out the gauntlet.
Hold {select} for the scoreboard. Chat needs typing: open the on-screen keyboard with {guide} + {west}.
These keys and weapon slots are written from memory and not checked in the game (the ability, last weapon and the slot order especially). Compare them with Settings → Controls and change the buttons here to match; the game lets you bind each weapon to its own key. The executable name comes from Discord's detection list. The gyro's real-world turn assumes a mouse sensitivity of 3 and 0.022° a count like the older Quakes; set the full turn to 16364 divided by your sensitivity.'''

[profiles.guide.edits]
"stick:Left" = { text = "Move" }
"stick:Right" = { text = "Look" }
"trigger:Right" = { text = "Fire" }
"trigger:Left" = { text = "{icon:scope} Zoom" }
"button:South" = { text = "Jump" }
"button:East" = { text = "Crouch (hold)" }
"button:West" = { text = "Last weapon" }
"button:North" = { text = "Next weapon" }
"button:LeftBumper" = { text = "Hold: weapons" }
"button:RightBumper" = { text = "{icon:star} Ability" }
"button:RightStick" = { text = "{icon:fist} Gauntlet" }
"button:DpadUp" = { text = "{icon:rocket} Rocket launcher" }
"button:DpadRight" = { text = "{icon:crosshair} Railgun" }
"button:DpadDown" = { text = "{icon:bolt} Lightning gun" }
"button:DpadLeft" = { text = "{icon:rifle} Super shotgun" }
"button:Select" = { text = "Scoreboard" }
"button:Start" = { text = "Menu" }

