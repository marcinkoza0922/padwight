format = 20
macros = []
overlay_font = "Kreon"

[pack]
id = "07f5ee18-fe91-4940-8e90-0aa7c2a88866"
name = "Raft"
version = "1.0"
author = "Padwight"
description = "Raft on an Xbox-style pad, for the game's default keys. X interacts, A jumps and swims up, B crouches and dives (hold), Y opens the inventory, RT uses the item in hand, LT right-clicks (the hammer's build menu), RB rotates a piece, L3 sprints (toggle). Hold LB for the hotbar; the D-pad steps through it, removes a piece and drops the item. Select lists the notebook and chat. Gyro and flick stick profiles are included to try."
made_with = "Xbox controller"

[[rules]]
kind = "executable"
value = "Raft.exe"
profile = "Raft"

[[rules]]
kind = "steam_app_id"
value = "648800"
profile = "Raft"

[[profiles]]
name = "Raft"
combos = []
combo_window_ms = 120
tap_window_ms = 250
long_press_ms = 500

[profiles.buttons]
South = { keys = ["KEY_SPACE"] }
East = { keys = ["KEY_LEFTCTRL"] }
West = { keys = ["KEY_E"] }
North = { keys = ["KEY_TAB"] }
LeftBumper = { open_menu = "Hotbar" }
RightBumper = { keys = ["KEY_R"] }
Select = { open_menu = "Screens" }
Start = { keys = ["KEY_ESC"] }
Guide = { mode = "Guide" }
LeftStick = { toggle = { action = { keys = ["KEY_LEFTSHIFT"] } } }
DpadUp = { keys = ["KEY_X"] }
DpadDown = { keys = ["KEY_Q"] }
DpadLeft = { wheel = "Up" }
DpadRight = { wheel = "Down" }

[profiles.left_stick]
deadzone = 0.12
curve = 1.0
key_threshold = 0.25

[profiles.left_stick.action.ring]
sectors = 8
start_angle = 0.0
inner_radius = 0.25
hysteresis = 0.1

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_W"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_W"] },
    { keys = ["KEY_D"] },
]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_D"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_S"] },
    { keys = ["KEY_D"] },
]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_S"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_S"] },
    { keys = ["KEY_A"] },
]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_A"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_W"] },
    { keys = ["KEY_A"] },
]

[profiles.right_stick]
deadzone = 0.1
curve = 2.0
key_threshold = 0.5

[profiles.right_stick.action.mouse]
speed = 2400.0
accel = 0.4
y_scale = 0.75

[profiles.left_trigger.action.button]
threshold = 0.3
action = { mouse = "Right" }

[profiles.right_trigger.action.button]
threshold = 0.3
action = { mouse = "Left" }

[profiles.guide]
notes = '''{west} interacts: pick up debris, use the sail, anchor and wheel, sleep. {south} jumps and swims up, hold {east} to crouch and to dive.
{rt} uses what's in your hand (hook, spear, rod, hammer); {lt} is the right-click, such as the hammer's build menu. Pick a piece with the right stick {rs}.
Building: {rb} rotates the piece, {up} removes the one you're looking at.
Hold {lb} for the hotbar and pick a slot with the right stick {rs}; {left} and {right} step through it. {down} drops the item in hand.
{north} opens the inventory, where the right stick {rs} moves the cursor and {rt} clicks. {l3} sprints (a toggle).
{select} lists the inventory, the notebook and chat. Naming a save or chatting: {guide} + {west} opens the on-screen keyboard.
The remove, drop and notebook keys are inferred: if they don't answer, check them in the game's Settings → Controls.'''

[profiles.guide.edits]
"stick:Left" = { text = "Move / swim" }
"stick:Right" = { text = "Look / cursor" }
"trigger:Right" = { text = "{icon:hand} Use item (left click)" }
"trigger:Left" = { text = "Right click · build menu" }
"button:South" = { text = "Jump / swim up" }
"button:East" = { text = "Crouch / dive (hold)" }
"button:West" = { text = "Interact" }
"button:North" = { text = "{icon:bag} Inventory" }
"button:LeftBumper" = { text = "Hold: hotbar" }
"button:RightBumper" = { text = "{icon:rotate} Rotate piece" }
"button:LeftStick" = { text = "Sprint (toggle)" }
"button:DpadUp" = { text = "{icon:hammer} Remove piece" }
"button:DpadDown" = { text = "{icon:drop-item} Drop item" }
"button:Select" = { text = "{icon:book} Notebook, chat" }
"button:Start" = { text = "Menu" }

[[profiles.guide.merged]]
inputs = ["button:DpadLeft", "button:DpadRight"]
text = "Previous / next hotbar slot"

