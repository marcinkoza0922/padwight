invert_y = false
noise_threshold = 1.0

[profiles.gyro.mode.mouse]
sensitivity = 20.0

[profiles.guide]
notes = '''Hold {select} and {start} together to pause the gyro while you reposition the controller. Tilting the controller moves the pointer, as a fine pointer next to the right stick {rs}.
The game is played with the mouse. The right stick {rs} moves the pointer and the left stick {ls} moves it slowly, onto a golden cookie or a small upgrade icon.
{south} or {rt} clicks: the big cookie, a golden cookie, an upgrade, a building in the store. Hold {west} to click fifteen times a second while you keep the pointer on the big cookie. The game counts very fast clicking as an autoclicker for one achievement, so let go of it if that matters to you.
Hold {lb} (Ctrl) and click a building to buy ten, or {rb} (Shift) for a hundred; the store's own Buy and Sell buttons do the same. {up} and {down} scroll the store and the stats.
{east} closes a prompt (Escape). {start} does the same, and a double tap of {start} saves (Ctrl+S); the game also saves itself every minute. Naming your bakery needs typing: {guide} + {west} opens the on-screen keyboard. {lt} right-clicks, which the game hardly uses.
The keys are remembered from the web version and unchecked on an install; the game has no key settings.'''

[profiles.guide.edits]
"stick:Left" = {text = "Fine pointer"}
"stick:Right" = {text = "Pointer"}
"trigger:Right" = {text = "{icon:cookie} {b}Click{/b}"}
"trigger:Left" = {text = "Right-click"}
"button:South" = {text = "{icon:cookie} {b}Click{/b}"}
"button:West" = {text = "{icon:fast} Rapid click (hold)"}
"button:East" = {text = "{icon:cancel} Close"}
"button:LeftBumper" = {text = "{icon:coin} Buy 10 (hold)"}
"button:RightBumper" = {text = "{icon:money-bag} Buy 100 (hold)"}
"button:Start" = {text = "Close · {icon:save} {b}save{/b} (double tap)"}
