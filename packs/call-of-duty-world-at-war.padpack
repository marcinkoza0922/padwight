format = 20
macros = []
overlay_font = "Rajdhani"

[pack]
id = "a3b429c6-10dd-4e74-ac7e-3a8f22506d57"
name = "Call of Duty: World at War"
version = "1.0"
author = "Padwight"
description = "Call of Duty: World at War (2008) on an Xbox-style pad, laid out like the Xbox 360 release, for the PC game's default keys. A jumps, B crouches (hold it to go prone), X reloads and, held, uses, Y switches weapons, RT fires and LT aims down the sights. LB throws the special grenade and RB the frag, L3 sprints and holds your breath, R3 is melee. The D-pad has the equipment or attachment and the killstreak, and Select holds the scoreboard. The game has no working controller support. Gyro and flick stick profiles are included to try."
made_with = "Xbox controller"

[[rules]]
kind = "steam_app_id"
value = "10090"
profile = "Call of Duty: World at War"

[[rules]]
kind = "executable"
value = "CoDWaW.exe"
profile = "Call of Duty: World at War"

[[rules]]
kind = "executable"
value = "CoDWaWmp.exe"
profile = "Call of Duty: World at War"
[[profiles]]
name = "Call of Duty: World at War"
combos = []
combo_window_ms = 120
tap_window_ms = 250
long_press_ms = 300

[profiles.buttons]
Guide = { mode = "Guide" }
South = { keys = ["KEY_SPACE"] }
East = { keys = ["KEY_C"] }
West = { keys = ["KEY_R"] }
North = { wheel = "Down" }
LeftBumper = { keys = ["KEY_4"] }
RightBumper = { keys = ["KEY_G"] }
LeftStick = { keys = ["KEY_LEFTSHIFT"] }
RightStick = { keys = ["KEY_V"] }
Select = { keys = ["KEY_TAB"] }
Start = { keys = ["KEY_ESC"] }
DpadLeft = { keys = ["KEY_3"] }
DpadRight = { keys = ["KEY_5"] }

[profiles.gestures.East]
long_press = { keys = ["KEY_LEFTCTRL"] }

[profiles.gestures.West]
long_press = { keys = ["KEY_F"] }

[profiles.left_stick]
deadzone = 0.12
curve = 1.0
key_threshold = 0.25

[profiles.left_stick.action.ring]
sectors = 8
start_angle = 0.0
inner_radius = 0.25
hysteresis = 0.1

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_W"]

[[profiles.left_stick.action.ring.actions]]
multi = [{ keys = ["KEY_W"] }, { keys = ["KEY_D"] }]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_D"]

[[profiles.left_stick.action.ring.actions]]
multi = [{ keys = ["KEY_S"] }, { keys = ["KEY_D"] }]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_S"]

[[profiles.left_stick.action.ring.actions]]
multi = [{ keys = ["KEY_S"] }, { keys = ["KEY_A"] }]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_A"]

[[profiles.left_stick.action.ring.actions]]
multi = [{ keys = ["KEY_W"] }, { keys = ["KEY_A"] }]

[profiles.right_stick]
deadzone = 0.08
curve = 2.0
key_threshold = 0.5

[profiles.right_stick.action.mouse]
speed = 1440.0
accel = 0.2

[profiles.left_trigger.action.button]
threshold = 0.4
action = { multi = [{ layer = "Aim" }, { mouse = "Right" }] }

[profiles.right_trigger.action.button]
threshold = 0.3
action = { mouse = "Left" }

[profiles.guide]
notes = '''{start} (Escape) pauses and backs out of the game's menus. The campaign has no quick save; it saves at checkpoints.
The buttons follow the Xbox 360 release's default layout. {south} jumps, {east} crouches and a long press of {east} goes prone, {west} reloads and, held, uses: pick up a weapon, plant, open doors, revive a partner in co-op. In Nazi Zombies hold {west} to buy weapons, perks and doors, and to rebuild barriers.
Hold {lt} to aim down the sights; the game must have aiming set to hold (its default), not toggle. The right stick turns more finely while it's held.
{lb} throws your special grenade (smoke, signal flare, Tabun gas) and {rb} a frag, Molotov or sticky grenade: hold to cook a frag, let go to throw. Hold {l3} to sprint, and while aiming hold it to steady a sniper rifle. {r3} is melee, with a bayonet if the rifle has one. {north} switches weapons.
{left} takes out your equipment or the attachment (satchel charges, Bouncing Betties, the rifle grenade or flamethrower) and {right} calls in a killstreak in multiplayer (recon plane, artillery, dogs). Hold {select} for the scoreboard and objectives. The PC game's lean (Q and E) isn't on the pad, as the console game had none.
The tank and the Black Cat gunner levels use the same buttons: the left stick drives, the right stick turns the gun and {rt} fires.
Chat in multiplayer needs typing: open the on-screen keyboard with {guide} + {west} and press T (all) or Y (team).
The game has a hidden controller scheme (exec default_controller in the console, patch 1.6) that doesn't work in the menus; leave it off, or it would fight this setup. Many players use the Plutonium client for multiplayer and zombies.
These are the game's default PC keys, written from memory and not checked in the game (the special grenade, melee and the D-pad's equipment and killstreak keys especially), and the D-pad's order follows the Xbox 360 release as remembered. Compare them with Options → Controls and change the buttons here to match. The gyro's real-world turn assumes the default mouse sensitivity of 5; set the full turn to 16364 divided by your sensitivity.'''

[profiles.guide.edits]
"stick:Left" = { text = "Move" }
"stick:Right" = { text = "Look" }
"trigger:Right" = { text = "Fire" }
"trigger:Left" = { text = "{icon:scope} Aim" }
"button:South" = { text = "Jump" }
"button:East" = { text = "Crouch" }
"gesture:button:East:long_press" = { text = "Prone" }
"button:West" = { text = "Reload" }
"gesture:button:West:long_press" = { text = "{icon:hand} Use (hold)" }
"button:North" = { text = "{icon:rifle} Switch weapon" }
"button:LeftBumper" = { text = "{icon:flame} Special grenade" }
"button:RightBumper" = { text = "{icon:grenade} Frag" }
"button:LeftStick" = { text = "Sprint · hold breath" }
"button:RightStick" = { text = "{icon:dagger} Melee" }
"button:DpadLeft" = { text = "{icon:bomb} Equipment · attachment" }
"button:DpadRight" = { text = "{icon:radio} Killstreak" }
"button:Select" = { text = "Scoreboard" }
"button:Start" = { text = "Pause" }

