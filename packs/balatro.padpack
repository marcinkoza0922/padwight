format = 20
macros = []
overlay_font = "Silkscreen"

[pack]
id = "fc34354b-f342-5ae2-a615-7e7ce363a7cd"
name = "Balatro"
version = "1.0"
author = "Padwight"
description = "Balatro on an Xbox-style pad. The game has its own controller support, so the controller passes through untouched and the game's own scheme sets the buttons. Padwight adds the Guide overlay on top, with the media controls and the on-screen keyboard, in Balatro's slate panels and red buttons."
made_with = "Xbox controller"

[controllers]
dualshock = true
dualsense = true
switch_pro = true

[[rules]]
kind = "steam_app_id"
value = "2379780"
profile = "Balatro"

[[rules]]
kind = "executable"
value = "Balatro.exe"
profile = "Balatro"

[[profiles]]
name = "Balatro"
combos = []
combo_window_ms = 120
tap_window_ms = 250
long_press_ms = 500

[profiles.buttons]
Guide = {mode = "Guide"}
South = {gamepad = "South"}
East = {gamepad = "East"}
North = {gamepad = "North"}
West = {gamepad = "West"}
LeftBumper = {gamepad = "LeftBumper"}
RightBumper = {gamepad = "RightBumper"}
LeftStick = {gamepad = "LeftStick"}
RightStick = {gamepad = "RightStick"}
Select = {gamepad = "Select"}
Start = {gamepad = "Start"}
DpadUp = {gamepad = "DpadUp"}
DpadDown = {gamepad = "DpadDown"}
DpadLeft = {gamepad = "DpadLeft"}
DpadRight = {gamepad = "DpadRight"}

[profiles.left_stick]
deadzone = 0.05
curve = 1.0
key_threshold = 0.3

[profiles.left_stick.action]
gamepad = {stick = "Left", invert_y = false}

[profiles.right_stick]
deadzone = 0.05
curve = 1.0
key_threshold = 0.3

[profiles.right_stick.action]
gamepad = {stick = "Right", invert_y = false}

[profiles.left_trigger]
action = {gamepad = "Left"}

[profiles.right_trigger]
action = {gamepad = "Right"}

[profiles.gyro]
mode = "off"
horizontal = "yaw"
invert_x = false
invert_y = false
noise_threshold = 1.0

[profiles.guide]
notes = '''The controller goes to the game as it is. Balatro has no button settings of its own, so its controller scheme is the one you get, with PlayStation glyphs on a DualShock or DualSense.
{guide} still works over the game: {guide} + {west} opens the on-screen keyboard for a custom seed, and {guide} + {lb} the media controls, for music or a podcast between antes.
If the game stops answering the pad, check that no other remapper is running for it.'''

