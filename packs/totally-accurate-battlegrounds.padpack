[sounds.menu]
step = {kind = "pop", volume = 0.08, pitch = 1.2}
pick = {kind = "boing", volume = 0.15}
open = {kind = "pop", volume = 0.1}
close = {kind = "swish", volume = 0.03, pitch = 1.4}

[sounds.guide]
