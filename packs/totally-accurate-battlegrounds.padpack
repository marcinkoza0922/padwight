format = 20
macros = []
overlay_font = "Bangers"

[pack]
id = "43fb769d-da3d-4cdb-9a1c-71764f6995cb"
name = "Totally Accurate Battlegrounds"
version = "1.0"
author = "Padwight"
description = "Totally Accurate Battlegrounds on an Xbox-style pad, for the game's default keys. A loots and uses and, held, sprints, B jumps, X reloads, Y switches weapons, RT fires and LT aims. LB throws a grenade, L3 toggles crouch and the D-pad picks your weapon. Select opens the inventory; hold it for the map. The game has no controller support. Gyro and flick stick profiles are included to try."
made_with = "Xbox controller"

[[rules]]
kind = "steam_app_id"
value = "823130"
profile = "Totally Accurate Battlegrounds"

[[rules]]
kind = "executable"
value = "totallyaccuratebattlegrounds.exe"
profile = "Totally Accurate Battlegrounds"
[[profiles]]
name = "Totally Accurate Battlegrounds"
combos = []
combo_window_ms = 120
tap_window_ms = 250
long_press_ms = 250

[profiles.buttons]
Guide = { mode = "Guide" }
South = { keys = ["KEY_E"] }
East = { keys = ["KEY_SPACE"] }
West = { keys = ["KEY_R"] }
North = { wheel = "Down" }
LeftBumper = { keys = ["KEY_G"] }
LeftStick = { toggle = { action = { keys = ["KEY_LEFTCTRL"] } } }
Select = { keys = ["KEY_TAB"] }
Start = { keys = ["KEY_ESC"] }
DpadLeft = { keys = ["KEY_1"] }
DpadRight = { keys = ["KEY_2"] }

[profiles.gestures.South]
long_press = { keys = ["KEY_LEFTSHIFT"] }

[profiles.gestures.Select]
long_press = { keys = ["KEY_M"] }

[profiles.left_stick]
deadzone = 0.12
curve = 1.0
key_threshold = 0.25

[profiles.left_stick.action.ring]
sectors = 8
start_angle = 0.0
inner_radius = 0.25
hysteresis = 0.1

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_W"]

[[profiles.left_stick.action.ring.actions]]
multi = [{ keys = ["KEY_W"] }, { keys = ["KEY_D"] }]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_D"]

[[profiles.left_stick.action.ring.actions]]
multi = [{ keys = ["KEY_S"] }, { keys = ["KEY_D"] }]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_S"]

[[profiles.left_stick.action.ring.actions]]
multi = [{ keys = ["KEY_S"] }, { keys = ["KEY_A"] }]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_A"]

[[profiles.left_stick.action.ring.actions]]
multi = [{ keys = ["KEY_W"] }, { keys = ["KEY_A"] }]

[profiles.right_stick]
deadzone = 0.08
curve = 2.0
key_threshold = 0.5

[profiles.right_stick.action.mouse]
speed = 3500.0
accel = 0.2

[profiles.left_trigger.action.button]
threshold = 0.4
action = { multi = [{ layer = "Aim" }, { mouse = "Right" }] }

[profiles.right_trigger.action.button]
threshold = 0.3
action = { mouse = "Left" }

[profiles.guide]
notes = '''{start} (Escape) opens the game's menu and closes the other screens.
{south} picks up loot, opens doors and gets in; hold {south} to sprint. {east} jumps and {l3} toggles crouch. {west} reloads and {north} switches weapons; {left} and {right} pick the first and second weapon.
{rt} fires and {lt} aims down the sights; the right stick turns more finely while it's held. {lb} throws a grenade.
{select} opens the inventory, and a long press of {select} the map.
These keys are written from memory and not checked in the game (crouch, the grenade and the weapon keys especially); compare them with Settings → Controls and change the buttons here to match. The executable rule's name comes from Discord's game list and isn't checked. The game reads Steam Input, but has no controller scheme of its own, so turn Steam Input off for it. The gyro's full turn is a guess, not measured: turn in place and adjust it until a full turn of the controller turns you around once.'''

[profiles.guide.edits]
"stick:Left" = { text = "Move" }
"stick:Right" = { text = "Look" }
"trigger:Right" = { text = "Fire" }
"trigger:Left" = { text = "{icon:scope} Aim" }
"button:South" = { text = "{icon:hand} Loot · use" }
"gesture:button:South:long_press" = { text = "Sprint (hold)" }
"button:East" = { text = "Jump" }
"button:West" = { text = "Reload" }
"button:North" = { text = "{icon:rifle} Switch weapon" }
"button:LeftBumper" = { text = "{icon:grenade} Grenade" }
"button:LeftStick" = { text = "Crouch (toggle)" }
"button:Select" = { text = "{icon:bag} Inventory" }
"gesture:button:Select:long_press" = { text = "{icon:map} Map" }
"button:Start" = { text = "Menu" }

[[profiles.guide.merged]]
inputs = ["button:DpadLeft", "button:DpadRight"]
text = "Weapon 1 / 2"

