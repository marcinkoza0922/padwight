format = 20
macros = []
overlay_font = "Cinzel"

[pack]
id = "08d4687a-eaaf-5fe4-88bf-3b60b9aea738"
name = "Prince of Persia: The Sands of Time"
version = "1.0"
author = "Padwight"
description = "Prince of Persia: The Sands of Time (GOG, 2003) on an Xbox-style pad, laid out like the original Xbox release for the game's default keys. A jumps, X strikes with the sword and Y uses the dagger. RT runs on walls and blocks, LT rewinds (tap: slow time). A light push on the left stick walks. LB is the landscape view and R3 looks around in first person."
made_with = "Xbox controller"

[[rules]]
kind = "executable"
value = "PrinceOfPersia_gog.EXE"
profile = "Prince of Persia: The Sands of Time"

[[rules]]
kind = "executable"
value = "Prince of Persia - The Sands of Time/gpp.exe"
profile = "Prince of Persia: The Sands of Time"

[[rules]]
kind = "steam_app_id"
value = "13600"
profile = "Prince of Persia: The Sands of Time"

[[profiles]]
name = "Prince of Persia: The Sands of Time"
combos = []
combo_window_ms = 120
tap_window_ms = 250
long_press_ms = 500

[profiles.buttons]
Guide = {mode = "Guide"}
South = {keys = ["KEY_SPACE"]}
West = {mouse = "Left"}
North = {keys = ["KEY_E"]}
East = {keys = ["KEY_C"]}
LeftBumper = {keys = ["KEY_Q"]}
RightStick = {keys = ["KEY_F"]}
Start = {keys = ["KEY_ESC"]}
RightBumper = {keys = ["KEY_LEFTSHIFT"]}

[profiles.left_stick]
deadzone = 0.12
curve = 1.0
key_threshold = 0.25

[profiles.left_stick.action.ring]
sectors = 8
start_angle = 0.0
inner_radius = 0.25
hysteresis = 0.1

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_W"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_W"] },
    { keys = ["KEY_D"] },
]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_D"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_S"] },
    { keys = ["KEY_D"] },
]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_S"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_S"] },
    { keys = ["KEY_A"] },
]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_A"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_W"] },
    { keys = ["KEY_A"] },
]

[[profiles.left_stick.zones]]
min = 0.0
max = 0.6
action = {keys = ["KEY_LEFTSHIFT"]}

[profiles.right_stick]
deadzone = 0.1
curve = 1.8
key_threshold = 0.5

[profiles.right_stick.action.mouse]
speed = 1300.0
accel = 0.2

[profiles.left_trigger.action.button]
threshold = 0.3
action = {keys = ["KEY_R"]}

[profiles.right_trigger.action.button]
threshold = 0.3
action = {mouse = "Right"}

[profiles.gyro]
mode = "off"
horizontal = "yaw"
invert_x = false
invert_y = false
noise_threshold = 1.0

[profiles.guide]
notes = '''This is the original Xbox layout: {south} jumps, {west} strikes with the sword and {north} uses the dagger. Hold {rt} to run along walls, swing, push and pull, and to block in a fight.
Hold {lt} to rewind time and let go when the Prince is safe. Tap {lt} to slow time; hold {lt} and {rt} together for the Mega-Freeze.
A light push on the left stick {ls} walks, and so does holding {rb}.
Click {r3} to look around in first person, and press {lb} for the wide landscape view. {start} is the menu; the game saves at the sand fountains.'''

[profiles.guide.edits]
"stick:Left" = {text = "Move (light push: walk)"}
"stick:Right" = {text = "Camera"}
"trigger:Right" = {text = "Wall run, swing / block (hold)"}
"trigger:Left" = {text = "{icon:hourglass} {b}Rewind{/b} (hold) / slow time"}
"button:South" = {text = "Jump / roll"}
"button:West" = {text = "{icon:sword} {b}Attack{/b}"}
"button:North" = {text = "{icon:dagger} Dagger: take sand, freeze"}
"button:East" = {text = "Cancel / let go"}
"button:LeftBumper" = {text = "{icon:mountain} Landscape view"}
"button:RightStick" = {text = "{icon:eye} Look (first person)"}
"button:Start" = {text = "Menu"}
"button:RightBumper" = {text = "Walk (hold)"}

