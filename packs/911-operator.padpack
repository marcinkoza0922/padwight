format = 20
macros = []
overlay_font = "Rajdhani"

[pack]
id = "875cd2da-c5de-5b42-ab82-6fc584dcbee9"
name = "911 Operator"
version = "1.0"
author = "Padwight"
description = "911 Operator on an Xbox-style pad. The right stick points; A and RT click, LT right-clicks. Overlays in dispatch-desk blue."
made_with = "Xbox controller"

[[rules]]
kind = "steam_app_id"
value = "503560"
profile = "911 Operator"

[[rules]]
kind = "executable"
value = "911.exe"
profile = "911 Operator"

[[profiles]]
name = "911 Operator"
combos = []
combo_window_ms = 120
tap_window_ms = 250
long_press_ms = 500

[profiles.buttons]
Guide = {mode = "Guide"}
South = {mouse = "Left"}
East = {mouse = "Right"}
DpadUp = {wheel = "Up"}
DpadDown = {wheel = "Down"}
Start = {keys = ["KEY_ESC"]}
North = {keys = ["KEY_SPACE"]}

[profiles.left_stick]
deadzone = 0.15
curve = 1.7
key_threshold = 0.35

[profiles.left_stick.action.mouse]
speed = 450.0
accel = 0.0

[profiles.right_stick]
deadzone = 0.12
curve = 1.7
key_threshold = 0.5

[profiles.right_stick.action.mouse]
speed = 1400.0
accel = 0.3

[profiles.left_trigger.action.button]
threshold = 0.4
action = {mouse = "Right"}

[profiles.right_trigger.action.button]
threshold = 0.3
action = {mouse = "Left"}

[profiles.gyro]
enabled = false
horizontal = "yaw"
invert_x = false
invert_y = false
noise_threshold = 1.0

[profiles.guide]
notes = '''The right stick {rs} moves the pointer and the left stick {ls} nudges it slowly for fine work. {rt} or {south} clicks, {lt} right-clicks. {up} and {down} scroll the wheel.
Buttons: {south} Click; {east} Right-click / back; {start} Menu; {north} Pause.
Space pausing is a guess. Keys are the game's defaults as remembered, not read from an install; if one doesn't answer, check the game's controls options and change the buttons here to match. The Windows executable is from Discord's list. The game has no controller support, so the pad plays it with the pointer.
Typing a name or text: {guide} + {west} opens the on-screen keyboard.'''

[profiles.guide.edits]
"stick:Left" = {text = "Fine pointer"}
"stick:Right" = {text = "Pointer"}
"trigger:Right" = {text = "Left click"}
"trigger:Left" = {text = "Right click"}
"button:South" = {text = "Click"}
"button:East" = {text = "Right-click / back"}
"button:Start" = {text = "Menu"}
"button:North" = {text = "{icon:pause} Pause"}

[[profiles.guide.merged]]
inputs = ["button:DpadUp", "button:DpadDown"]
text = "Zoom in / out"



