format = 20
macros = []
overlay_font = "Kreon"

[pack]
id = "0dac69bc-4b77-45ba-ba97-5bde081b28db"
name = "Banished"
version = "1.0"
author = "Padwight"
description = "Banished (Steam, Windows) on an Xbox-style pad, for the default keys. The right stick moves the cursor, RT or A left-clicks, LT right-clicks, the left stick moves the camera, the d-pad zooms and rotates the view. Y pauses (hold to resume), L3 and R3 slow down and speed up, LB and RB turn a building, X switches the house design. Select lists the toolbar's menus: housing, roads, storage, services, food, resources, removal and the reports. The \"+ Gyro\" profile also moves the cursor by tilting the controller."
made_with = "Xbox controller"

[[rules]]
kind = "executable"
value = "application-steam-x64.exe"
profile = "Banished"

[[rules]]
kind = "executable"
value = "application-steam-x32.exe"
profile = "Banished"

[[rules]]
kind = "steam_app_id"
value = "242920"
profile = "Banished"


[[profiles]]
name = "Banished"
combos = []
combo_window_ms = 120
tap_window_ms = 250
long_press_ms = 500

[profiles.buttons]
Guide = {mode = "Guide"}
South = {mouse = "Left"}
East = {keys = ["KEY_ESC"]}
West = {keys = ["KEY_F"]}
North = {keys = ["KEY_2"]}
LeftBumper = {keys = ["KEY_T"]}
RightBumper = {keys = ["KEY_R"]}
Select = {open_menu = "Toolbar"}
Start = {keys = ["KEY_ESC"]}
LeftStick = {keys = ["KEY_1"]}
RightStick = {keys = ["KEY_4"]}
DpadUp = {wheel = "Up"}
DpadDown = {wheel = "Down"}
DpadLeft = {keys = ["KEY_Q"]}
DpadRight = {keys = ["KEY_E"]}

[profiles.gestures.North.long_press]
keys = ["KEY_3"]

[profiles.left_stick]
deadzone = 0.2
curve = 1.0
key_threshold = 0.45

[profiles.left_stick.action.ring]
sectors = 8
start_angle = 0.0
inner_radius = 0.45
hysteresis = 0.1

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_W"]

[[profiles.left_stick.action.ring.actions]]
multi = [{ keys = ["KEY_W"] }, { keys = ["KEY_D"] }]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_D"]

[[profiles.left_stick.action.ring.actions]]
multi = [{ keys = ["KEY_S"] }, { keys = ["KEY_D"] }]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_S"]

[[profiles.left_stick.action.ring.actions]]
multi = [{ keys = ["KEY_S"] }, { keys = ["KEY_A"] }]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_A"]

[[profiles.left_stick.action.ring.actions]]
multi = [{ keys = ["KEY_W"] }, { keys = ["KEY_A"] }]

[profiles.right_stick]
deadzone = 0.1
curve = 1.6
key_threshold = 0.25

[profiles.right_stick.action.mouse]
speed = 1500.0
accel = 0.25

[profiles.left_trigger.action.button]
threshold = 0.4
action = { mouse = "Right" }

[profiles.right_trigger.action.button]
threshold = 0.3
action = { mouse = "Left" }

[profiles.guide]
notes = '''The right stick {rs} moves the cursor: {rt} or {south} picks and places (left click, hold and drag for fields, roads and stockpiles), and {lt} is a right click (cancels what you're placing). The left stick {ls} moves the camera (WASD), {up} {down} zoom and {left} {right} rotate the view.
{north} pauses; hold {north} to resume. Click {l3} to slow the town down and {r3} to speed it up.
While placing a building, {lb} and {rb} turn it, and {west} switches between the house designs.
{select} lists the toolbar's menus: speed, tools and reports, housing, roads, storage and trade, town services, food, resources and removal (tap it, pick with {south}). Each opens the game's own menu, where you pick with the cursor. {east} closes a window; {start} is the options menu.
Banished has no controller support, so the controller works through these keys. It has no quick save: save from the options menu. The camera's tilt (Page Up and Page Down) isn't on the pad; hold {guide} and press {west} for the on-screen keyboard to use it, or to name a save.
The keys come from the Banished wiki's controls list, not checked on an install: 1 to 4 for the speeds most of all (some players say Space pauses and + and - change the speed in newer versions). If a key does nothing, look in the input settings and set it to the key in this setup. The Linux and GOG executable names are not covered: only the Steam one, Application-steam-x64.exe, is from Discord's list (the 32-bit Application-steam-x32.exe is a guess).'''

[profiles.guide.edits]
"stick:Left" = { text = "Move the camera" }
"stick:Right" = { text = "Cursor" }
"trigger:Right" = { text = "Left click (place, drag)" }
"trigger:Left" = { text = "Right click (cancel)" }
"button:South" = { text = "Left click" }
"button:East" = { text = "Close window" }
"button:West" = { text = "{icon:home} House design" }
"button:North" = { text = "{icon:pause} Pause" }
"gesture:button:North:long_press" = { text = "{icon:speed1} Resume" }
"button:LeftBumper" = { text = "{icon:rotate-left} Turn building" }
"button:RightBumper" = { text = "Turn building {icon:rotate}" }
"button:Select" = { text = "Toolbar menus" }
"button:Start" = { text = "Options menu" }
"button:LeftStick" = { text = "{icon:speed1} Slower" }
"button:RightStick" = { text = "{icon:speed3} Faster" }

[[profiles.guide.merged]]
inputs = ["button:DpadUp", "button:DpadDown"]
text = "Zoom in / out"

[[profiles.guide.merged]]
inputs = ["button:DpadLeft", "button:DpadRight"]
text = "Rotate the view"

[[profiles]]
name = "Banished + Gyro"
combos = [{buttons = ["Select", "Start"], action = "gyro_clutch"}]
combo_window_ms = 120
tap_window_ms = 250
long_press_ms = 500
requires = ["gyro"]

