format = 20
macros = []
overlay_font = "Special Elite"

[pack]
id = "ab064e35-22aa-409c-a1e0-5f7f648797ee"
name = "Return to Castle Wolfenstein"
version = "1.0"
author = "Padwight"
description = "Return to Castle Wolfenstein (2001) on an Xbox-style pad, for the game's default keys. A uses, B jumps, RT fires, X reloads, Y draws the knife, L3 toggles crouch and LT is the alternate fire (the sniper scope). Hold LB for the weapon ring, aiming with the right stick, and RB cycles to the next weapon. D-pad left and right lean. Start is the menu; double tap it to quick save, hold it to quick load. Gyro and flick stick profiles are included to try."
made_with = "Xbox controller"

[[rules]]
kind = "steam_app_id"
value = "9010"
profile = "Return to Castle Wolfenstein"

[[rules]]
kind = "executable"
value = "WolfSP.exe"
profile = "Return to Castle Wolfenstein"

[[profiles]]
name = "Return to Castle Wolfenstein"
combos = []
combo_window_ms = 120
tap_window_ms = 250
long_press_ms = 500

[profiles.buttons]
South = { keys = ["KEY_F"] }
East = { keys = ["KEY_SPACE"] }
West = { keys = ["KEY_R"] }
North = { keys = ["KEY_1"] }
LeftBumper = { open_menu = "Weapons" }
RightBumper = { wheel = "Up" }
Select = { keys = ["KEY_TAB"] }
Start = { keys = ["KEY_ESC"] }
Guide = { mode = "Guide" }
LeftStick = { toggle = { action = { keys = ["KEY_C"] } } }
DpadLeft = { keys = ["KEY_Q"] }
DpadRight = { keys = ["KEY_E"] }

[profiles.gestures.Start.double_tap]
keys = ["KEY_F5"]

[profiles.gestures.Start.long_press]
keys = ["KEY_F9"]

[profiles.left_stick]
deadzone = 0.12
curve = 1.0
key_threshold = 0.25

[profiles.left_stick.action.ring]
sectors = 8
start_angle = 0.0
inner_radius = 0.25
hysteresis = 0.1

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_W"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_W"] },
    { keys = ["KEY_D"] },
]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_D"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_S"] },
    { keys = ["KEY_D"] },
]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_S"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_S"] },
    { keys = ["KEY_A"] },
]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_A"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_W"] },
    { keys = ["KEY_A"] },
]

[profiles.right_stick]
deadzone = 0.1
curve = 1.8
key_threshold = 0.5

[profiles.right_stick.action.mouse]
speed = 1100.0
accel = 0.2

[profiles.left_trigger.action.button]
threshold = 0.4
action = { multi = [{ layer = "Zoom" }, { mouse = "Right" }] }

[profiles.right_trigger.action.button]
threshold = 0.3
action = { mouse = "Left" }

[profiles.guide]
notes = '''Hold {select} and {start} together to pause the gyro while you reposition the controller.
{start} (Escape) opens the game's menu and backs out of every screen in it.
Hold {lb} for the weapon ring, aiming with the right stick {rs}. {rb} cycles to the next weapon; {north} draws the knife.
{l3} toggles crouch, and it stays on until you click it again.
{lt} is the alternate fire, which is the scope on a sniper rifle. The right stick turns more slowly while it is held.
Quick save is a double tap of {start}, and quick load is a long press of {start}.
{select} (Tab) shows the status screen.
These are the game's default keys, written from memory and not checked in the game. If a button does nothing, compare the game's Controls screen with the keys here.'''

[profiles.guide.edits]
"stick:Left" = { text = "Move" }
"stick:Right" = { text = "Look" }
"trigger:Right" = { text = "Fire" }
"trigger:Left" = { text = "Alt fire / scope" }
"button:South" = { text = "Use / pick up" }
"button:East" = { text = "Jump" }
"button:West" = { text = "Reload" }
"button:North" = { text = "{icon:dagger} Knife" }
"button:LeftBumper" = { text = "Hold: weapons" }
"button:RightBumper" = { text = "Next weapon" }
"button:LeftStick" = { text = "Crouch (toggle)" }
"button:Select" = { text = "Status" }
"button:Start" = { text = "Menu / back out" }
"gesture:button:Start:double_tap" = { text = "{icon:save} Quick save" }
"gesture:button:Start:long_press" = { text = "{icon:load} Quick load" }

[[profiles.guide.merged]]
inputs = ["button:DpadLeft", "button:DpadRight"]
text = "Lean"

