[motion]
keyboard = "grim"
numpad = "grim"
menu = "grim"
media = "grim"
offer = "grim"
info = "grim"
log = "grim"

[sounds.menu]
step = {kind = "typewriter", volume = 0.05, pitch = 1.2}
pick = {kind = "typewriter", volume = 0.09, pitch = 0.9}
open = {kind = "page", volume = 0.06}
close = {kind = "page", volume = 0.05, pitch = 0.8}

[sounds.numpad]
