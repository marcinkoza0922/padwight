format = 20
macros = []
overlay_font = "Source Code Pro"

[pack]
id = "2b1852da-5a91-48e0-90bb-aa38c92ca073"
name = "SCP: Secret Laboratory"
version = "1.0"
author = "Padwight"
description = "SCP: Secret Laboratory on an Xbox-style pad, for the game's default keys. A interacts with doors and items and, held, sprints; B jumps, X reloads, Y switches the light, RT fires and LT aims. A light push of the left stick sneaks. Hold RB to talk and LB to talk on the radio. Hold Select for the inventory wheel and pick with the right stick. The same buttons work the SCPs' attacks and abilities. The game has no controller support. Gyro and flick stick profiles are included to try."
made_with = "Xbox controller"

[[rules]]
kind = "steam_app_id"
value = "700330"
profile = "SCP: Secret Laboratory"

[[rules]]
kind = "executable"
value = "SCPSL.exe"
profile = "SCP: Secret Laboratory"

[[profiles]]
name = "SCP: Secret Laboratory"
combos = []
combo_window_ms = 120
tap_window_ms = 250
long_press_ms = 300

[profiles.buttons]
Guide = { mode = "Guide" }
South = { keys = ["KEY_E"] }
East = { keys = ["KEY_SPACE"] }
West = { keys = ["KEY_R"] }
North = { keys = ["KEY_F"] }
LeftBumper = { keys = ["KEY_V"] }
RightBumper = { keys = ["KEY_Q"] }
Select = { keys = ["KEY_TAB"] }
Start = { keys = ["KEY_ESC"] }

[profiles.gestures.South]
long_press = { keys = ["KEY_LEFTSHIFT"] }

[profiles.left_stick]
deadzone = 0.12
curve = 1.0
key_threshold = 0.25

[profiles.left_stick.action.ring]
sectors = 8
start_angle = 0.0
inner_radius = 0.25
hysteresis = 0.1

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_W"]

[[profiles.left_stick.action.ring.actions]]
multi = [{ keys = ["KEY_W"] }, { keys = ["KEY_D"] }]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_D"]

[[profiles.left_stick.action.ring.actions]]
multi = [{ keys = ["KEY_S"] }, { keys = ["KEY_D"] }]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_S"]

[[profiles.left_stick.action.ring.actions]]
multi = [{ keys = ["KEY_S"] }, { keys = ["KEY_A"] }]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_A"]

[[profiles.left_stick.action.ring.actions]]
multi = [{ keys = ["KEY_W"] }, { keys = ["KEY_A"] }]

[[profiles.left_stick.zones]]
min = 0.0
max = 0.6
action = { keys = ["KEY_LEFTCTRL"] }

[profiles.right_stick]
deadzone = 0.08
curve = 2.0
key_threshold = 0.5

[profiles.right_stick.action.mouse]
speed = 3500.0
accel = 0.2

[profiles.left_trigger.action.button]
threshold = 0.4
action = { multi = [{ layer = "Aim" }, { mouse = "Right" }] }

[profiles.right_trigger.action.button]
threshold = 0.3
action = { mouse = "Left" }

[profiles.guide]
notes = '''{start} (Escape) opens the game's menu.
Hold {lt} to aim down the sights. The right stick turns more finely while it's held.
{south} opens doors, calls lifts and picks things up; hold {south} to sprint while you move. A light push of the left stick {ls} sneaks quietly. {east} jumps, {west} reloads and {north} switches your weapon's light.
Hold {select} (Tab) for the inventory wheel, and aim the right stick {rs} at an item to pick it.
Hold {rb} to talk to players near you, and {lb} to talk on the radio when you carry one.
As an SCP, {rt}, {lt}, {south}, {west} and {north} are the left and right mouse buttons, E, R and F, which the game shows on screen for each SCP. Typing in the console or chat: {guide} + {west} opens the on-screen keyboard.
Servers: the pad reaches the game as an ordinary keyboard and mouse. Some servers forbid macros in their rules, and this setup has none.
These keys are written from memory and not checked in the game (sneak, voice, radio and the light especially). Compare them with Settings → Controls and change the buttons here to match. The gyro's real-world turn is a guess; adjust it in Quick settings until a full turn of the controller turns you all the way round.'''

[profiles.guide.edits]
"stick:Left" = { text = "Move · light push: sneak" }
"stick:Right" = { text = "Look" }
"trigger:Right" = { text = "Fire / attack" }
"trigger:Left" = { text = "{icon:scope} Aim / ability" }
"button:South" = { text = "Interact" }
"gesture:button:South:long_press" = { text = "Sprint (hold)" }
"button:East" = { text = "Jump" }
"button:West" = { text = "Reload" }
"button:North" = { text = "{icon:flashlight} Light" }
"button:LeftBumper" = { text = "{icon:radio} Radio (hold)" }
"button:RightBumper" = { text = "{icon:microphone} Talk (hold)" }
"button:Select" = { text = "{icon:bag} Inventory (hold)" }
"button:Start" = { text = "Menu" }

