[motion]
keyboard = "stagger"
numpad = "stagger"
menu = "stagger"
media = "stagger"
offer = "stagger"
info = "stagger"
log = "stagger"

[sounds.menu]
step = {kind = "card", volume = 0.08, pitch = 1.2}
pick = {kind = "card", volume = 0.16, pitch = 0.85}

[sounds.keyboard]
step = {kind = "card", volume = 0.08, pitch = 1.2}
pick = {kind = "card", volume = 0.12}

[sounds.numpad]
step = {kind = "card", volume = 0.08, pitch = 1.2}
pick = {kind = "card", volume = 0.12}

[sounds.media]
pick = {kind = "card", volume = 0.16, pitch = 0.85}

[rumble.menu]
