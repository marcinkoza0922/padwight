format = 20
macros = []
overlay_font = "Kreon"

[pack]
id = "5081b502-b8b1-503c-ad10-5b1596ee6f00"
name = "Slay the Spire 2"
version = "1.1"
author = "Padwight"
description = "Slay the Spire 2 on an Xbox-style pad. When Steam starts the game, Steam Input looks after the controller and Padwight stays out of the way; this setup is for copies Steam doesn't start, or for using Padwight anyway. The controller passes through untouched and the game's own settings set the buttons. Padwight adds the Guide overlay on top, with the media controls and the on-screen keyboard, in the same look as Slay the Spire."
made_with = "Xbox controller"
native_controller = true

[controllers]
dualshock = true
dualsense = true
switch_pro = true

[[rules]]
kind = "steam_app_id"
value = "2868840"
profile = "Slay the Spire 2"

[[rules]]
kind = "executable"
value = "SlayTheSpire2"
profile = "Slay the Spire 2"

[[profiles]]
name = "Slay the Spire 2"
combos = []
combo_window_ms = 120
tap_window_ms = 250
long_press_ms = 500

[profiles.buttons]
Guide = {mode = "Guide"}
South = {gamepad = "South"}
East = {gamepad = "East"}
North = {gamepad = "North"}
West = {gamepad = "West"}
LeftBumper = {gamepad = "LeftBumper"}
RightBumper = {gamepad = "RightBumper"}
LeftStick = {gamepad = "LeftStick"}
RightStick = {gamepad = "RightStick"}
Select = {gamepad = "Select"}
Start = {gamepad = "Start"}
DpadUp = {gamepad = "DpadUp"}
DpadDown = {gamepad = "DpadDown"}
DpadLeft = {gamepad = "DpadLeft"}
DpadRight = {gamepad = "DpadRight"}

[profiles.left_stick]
deadzone = 0.05
curve = 1.0
key_threshold = 0.3

[profiles.left_stick.action]
gamepad = {stick = "Left", invert_y = false}

[profiles.right_stick]
deadzone = 0.05
curve = 1.0
key_threshold = 0.3

[profiles.right_stick.action]
gamepad = {stick = "Right", invert_y = false}

[profiles.left_trigger]
action = {gamepad = "Left"}

[profiles.right_trigger]
action = {gamepad = "Right"}

[profiles.gyro]
mode = "off"
horizontal = "yaw"
invert_x = false
invert_y = false
activation = "always"
noise_threshold = 1.0

[profiles.guide]
notes = '''The controller goes to the game as it is, so set the buttons in the game's own settings. If Steam starts the game with this setup in use, turn Steam Input off for it, and if the stick then does nothing, turn on Hide Padwight's controller from Steam in App settings and restart Steam.
{guide} still works over the game: {guide} + {west} opens the on-screen keyboard for a custom seed, and {guide} + {lb} the media controls.
If the game stops answering the pad, check that no other remapper is running for it.'''

[keyboard_style]
