[motion]
keyboard = "swift"
numpad = "swift"
menu = "swift"
media = "swift"
offer = "swift"
info = "swift"
log = "swift"

[sounds.keyboard]
step = {kind = "tick", volume = 0.06}
pick = {kind = "keys", volume = 0.2}

[sounds.numpad]
step = {kind = "tick", volume = 0.06}
pick = {kind = "glass", volume = 0.1}

[sounds.media]
pick = {kind = "glass", volume = 0.1, pitch = 1.2}

[rumble.keyboard]
step = {strength = 0.06, length_ms = 14}
pick = {strength = 0.25, length_ms = 22}

[rumble.numpad]
step = {strength = 0.06, length_ms = 14}
pick = {strength = 0.25, length_ms = 22}

[rumble.media]
