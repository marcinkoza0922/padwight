format = 20
macros = []
overlay_font = "Rajdhani"

[pack]
id = "fb084747-ecf4-41e6-b48a-b094612a0695"
name = "Teardown"
version = "1.0"
author = "Padwight"
description = "Teardown on an Xbox-style pad. The game has its own (partial) controller support, so the controller passes through untouched and the game's own scheme sets the buttons. Padwight adds the Guide overlay on top, with the on-screen keyboard and the media controls, in demolition yellow."
made_with = "Xbox controller"

[[rules]]
kind = "steam_app_id"
value = "1167630"
profile = "Teardown"

[[rules]]
kind = "executable"
value = "teardown.exe"
profile = "Teardown"

[[profiles]]
name = "Teardown"
combos = []
combo_window_ms = 120
tap_window_ms = 250
long_press_ms = 500

[profiles.buttons]
South = {gamepad = "South"}
East = {gamepad = "East"}
North = {gamepad = "North"}
West = {gamepad = "West"}
LeftBumper = {gamepad = "LeftBumper"}
RightBumper = {gamepad = "RightBumper"}
LeftStick = {gamepad = "LeftStick"}
RightStick = {gamepad = "RightStick"}
Select = {gamepad = "Select"}
Start = {gamepad = "Start"}
DpadUp = {gamepad = "DpadUp"}
DpadDown = {gamepad = "DpadDown"}
DpadLeft = {gamepad = "DpadLeft"}
DpadRight = {gamepad = "DpadRight"}
Guide = {mode = "Guide"}

[profiles.left_stick]
deadzone = 0.05
curve = 1.0
key_threshold = 0.3

[profiles.left_stick.action]
gamepad = {stick = "Left", invert_y = false}

[profiles.right_stick]
deadzone = 0.05
curve = 1.0
key_threshold = 0.3

[profiles.right_stick.action]
gamepad = {stick = "Right", invert_y = false}

[profiles.left_trigger]
action = {gamepad = "Left"}

[profiles.right_trigger]
action = {gamepad = "Right"}

[profiles.gyro]
enabled = false
horizontal = "yaw"
invert_x = false
invert_y = false
noise_threshold = 1.0

[profiles.guide]
notes = '''Teardown has its own controller support, listed as partial, so the controller goes to the game as it is. The game offers no button settings of its own for a pad (the community route is Steam Input, which Padwight doesn't use here). The editor and some menus may want a mouse: hold {guide} and move {rs} for a pointer.
{guide} still works over the game: {guide} + {west} opens the on-screen keyboard, and {guide} + {lb} the media controls.
Only an Xbox pad is listed for the game; a PlayStation or Nintendo pad is shown to it as an Xbox 360 pad.
If the game stops answering the pad, check that Steam Input or another remapper isn't also running for it.'''

