format = 20
macros = []
overlay_font = "Kreon"

[pack]
id = "70858544-21ee-4cde-b17b-04df84817c51"
name = "Gothic II"
version = "1.0"
author = "Padwight"
description = "Gothic II (2002) on an Xbox-style pad, for the game's keys with mouse control on. The left stick walks and steps aside, the right stick turns. A is the action key, B jumps, X draws the weapon and Y opens the inventory. Hold RT and push the left stick to strike, as Ctrl and the arrows do, and LT parries. Hold LB for the weapon and spell slots. The D-pad and RB (Enter) work the keyboard-only menus and dialogues. Select lists the character, log and map; Start is the menu, double tap it to quick save and hold it to quick load. Overlays in dark leather and old brass."
made_with = "Xbox controller"

[[rules]]
kind = "steam_app_id"
value = "39510"
profile = "Gothic II"

[[rules]]
kind = "executable"
value = "Gothic2.exe"
profile = "Gothic II"

[[profiles]]
name = "Gothic II"
combos = []
combo_window_ms = 120
tap_window_ms = 250
long_press_ms = 500

[profiles.buttons]
Guide = { mode = "Guide" }
South = { keys = ["KEY_LEFTCTRL"] }
East = { keys = ["KEY_LEFTALT"] }
West = { keys = ["KEY_SPACE"] }
North = { keys = ["KEY_TAB"] }
LeftBumper = { open_menu = "Weapons and spells" }
RightBumper = { keys = ["KEY_ENTER"] }
Select = { open_menu = "Screens" }
Start = { keys = ["KEY_ESC"] }
LeftStick = { keys = ["KEY_A"] }
DpadUp = { keys = ["KEY_UP"] }
DpadDown = { keys = ["KEY_DOWN"] }
DpadLeft = { keys = ["KEY_LEFT"] }
DpadRight = { keys = ["KEY_RIGHT"] }

[profiles.gestures.Start]
double_tap = { keys = ["KEY_F5"] }
long_press = { keys = ["KEY_F9"] }

[profiles.left_stick]
deadzone = 0.15
curve = 1.0
key_threshold = 0.35

[profiles.left_stick.action.ring]
sectors = 8
start_angle = 0.0
inner_radius = 0.35
hysteresis = 0.1

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_UP"]

[[profiles.left_stick.action.ring.actions]]
multi = [{ keys = ["KEY_UP"] }, { keys = ["KEY_E"] }]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_E"]

[[profiles.left_stick.action.ring.actions]]
multi = [{ keys = ["KEY_DOWN"] }, { keys = ["KEY_E"] }]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_DOWN"]

[[profiles.left_stick.action.ring.actions]]
multi = [{ keys = ["KEY_DOWN"] }, { keys = ["KEY_Q"] }]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_Q"]

[[profiles.left_stick.action.ring.actions]]
multi = [{ keys = ["KEY_UP"] }, { keys = ["KEY_Q"] }]

[profiles.right_stick]
deadzone = 0.1
curve = 1.8
key_threshold = 0.5

[profiles.right_stick.action.mouse]
speed = 1300.0
accel = 0.2

[profiles.left_trigger.action.button]
threshold = 0.4
action = { keys = ["KEY_LEFTCTRL", "KEY_DOWN"] }

[profiles.right_trigger.action.button]
threshold = 0.3
action = { multi = [{ keys = ["KEY_LEFTCTRL"] }, { layer = "Strike" }] }

[profiles.guide]
notes = '''The game has no controller support worth using (its joystick option can't turn the camera), so this plays it with the keys and mouse. Turn on mouse control in the game's Options, Controls first: the right stick {rs} then turns the hero and the camera.
The left stick {ls} walks forward and back and steps sideways. {south} is the action key (Ctrl): talk, open, pick up, use. {east} jumps and climbs, {west} draws and puts away the weapon.
{b}Fighting{/b}: hold {rt} (the action key) and push the left stick: forward strikes, left and right swing to the sides, back parries and steps away, as Ctrl with the arrow keys does. {lt} parries on its own. With a bow or a spell drawn, hold {rt} to aim at the target in front and let go to shoot or cast.
Hold {lb} and point the right stick to draw the melee weapon, the bow or a spell from slots 3 to 0. {north} opens the inventory, {select} lists the inventory, character, log and map.
The game's menus, dialogues and the inventory don't use the mouse: the {dpad} moves through them (the arrow keys), {south} or {rb} (Enter) picks, {start} (Escape) backs out. In dialogue {south} picks the highlighted line.
{l3} sneaks (a toggle in the game). {start} is the menu; double tap it to {color:green}quick save{/color}, hold it to quick load.
The keys are the game's defaults as remembered, not checked on an install: forward and back on the arrow keys, Q and E to step sideways, Ctrl for action, Alt to jump, Space for the weapon, A to sneak, Tab, B, L and M for the screens, 1 to 0 for the weapon and spell slots, F5 and F9 to save and load. If one doesn't answer, check Options, Controls and change the buttons here to match. The executable name (Gothic2.exe, in the System folder) is a guess, the Steam app id is the wiki's.'''

[profiles.guide.edits]
"stick:Left" = { text = "Walk · step aside" }
"stick:Right" = { text = "Turn · look" }
"trigger:Right" = { text = "{icon:sword} Hold + {ls}: strike" }
"trigger:Left" = { text = "{icon:shield} Parry" }
"button:South" = { text = "{icon:hand} Action · talk · pick up" }
"button:East" = { text = "Jump · climb" }
"button:West" = { text = "{icon:holster} Draw / put away" }
"button:North" = { text = "{icon:bag} Inventory" }
"button:LeftBumper" = { text = "Hold: {icon:sword} weapons · {icon:crystal} spells" }
"button:RightBumper" = { text = "Enter (menus)" }
"button:Select" = { text = "{icon:scroll} Character, log, map" }
"button:Start" = { text = "Menu · back" }
"gesture:button:Start:double_tap" = { text = "{icon:save} Quick save" }
"gesture:button:Start:long_press" = { text = "{icon:load} Quick load" }
"button:LeftStick" = { text = "{icon:footprints} Sneak" }

[[profiles.guide.merged]]
inputs = ["button:DpadUp", "button:DpadDown", "button:DpadLeft", "button:DpadRight"]
text = "Menus · dialogue · inventory"

