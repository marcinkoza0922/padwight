[motion]
keyboard = "grim"
numpad = "grim"
menu = "grim"
media = "grim"
offer = "grim"
info = "grim"
log = "grim"

[sounds.menu]
step = {kind = "thud", volume = 0.06, pitch = 0.9}
pick = {kind = "knock", volume = 0.09}
open = {kind = "heartbeat", volume = 0.06}
close = {kind = "thud", volume = 0.05, pitch = 0.7}

[sounds.numpad]
step = {kind = "thud", volume = 0.06, pitch = 0.9}
pick = {kind = "knock", volume = 0.09}

[sounds.keyboard]
step = {kind = "thud", volume = 0.06, pitch = 0.9}
pick = {kind = "keys", volume = 0.12, pitch = 0.9}

[sounds.media]
