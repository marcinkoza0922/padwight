[profiles.guide]
notes = '''Hold {select} and {start} together to pause the gyro while you reposition the controller. Tilting the controller moves the cursor, as a fine pointer next to the right stick {rs}.
The right stick moves the mouse pointer; {rt} or {south} is a left click and {lt} a right click. Hold {guide} and press {west} for the on-screen keyboard when the game asks for a name.
Hold {lb} for the zones and {rb} for roads, utilities and services, picking with the right stick {rs}, then drag with {rt} to place.
{east} closes the open window, or picks the centering tool when none is open.
Hold {north} and click to query a tile. Hold the {dpad} left or right to slow down or speed up time, and click {l3} to pause.
Double tap {start} to save the city.'''

