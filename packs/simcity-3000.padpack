format = 18
macros = []
overlay_font = "Cantarell"

[pack]
id = "a02787b8-2177-48cc-9111-86617957ac2b"
name = "SimCity 3000 Unlimited"
version = "1.0"
author = "Padwight"
description = "SimCity 3000 Unlimited (GOG) on an Xbox-style pad. The right stick moves the pointer, the left stick scrolls the view, RT or A left-clicks, LT right-clicks. Hold LB for the zones and RB for roads, utilities and services. X bulldozes, B closes windows, hold Y and click to query. The d-pad zooms and rotates (hold left or right for the speed), L3 pauses, R3 centers. Select lists the budget, advisors and data windows. Start is the preferences; double tap it to save."
made_with = "Xbox controller"

[[rules]]
kind = "executable"
value = "SC3U.exe"
profile = "SimCity 3000"

[[profiles]]
name = "SimCity 3000"
combos = []
combo_window_ms = 120
tap_window_ms = 250
long_press_ms = 500

[profiles.buttons]
Guide = { mode = "Guide" }
South = { mouse = "Left" }
East = { keys = ["KEY_ESC"] }
West = { keys = ["KEY_B"] }
North = { keys = ["KEY_LEFTCTRL"] }
LeftBumper = { open_menu = "Zones" }
RightBumper = { open_menu = "Build" }
Select = { open_menu = "Windows" }
Start = { keys = ["KEY_LEFTCTRL", "KEY_P"] }
LeftStick = { keys = ["KEY_SLASH"] }
RightStick = { keys = ["KEY_SPACE"] }
DpadUp = { keys = ["KEY_KPPLUS"] }
DpadDown = { keys = ["KEY_KPMINUS"] }
DpadLeft = { keys = ["KEY_PAGEUP"] }
DpadRight = { keys = ["KEY_PAGEDOWN"] }

[profiles.gestures.DpadLeft.long_press]
keys = ["KEY_COMMA"]

[profiles.gestures.DpadRight.long_press]
keys = ["KEY_DOT"]

[profiles.gestures.Start.double_tap]
keys = ["KEY_LEFTCTRL", "KEY_S"]

[profiles.left_stick]
deadzone = 0.15
curve = 1.0
key_threshold = 0.35

[profiles.left_stick.action.keys]
up = "KEY_UP"
down = "KEY_DOWN"
left = "KEY_LEFT"
right = "KEY_RIGHT"

[profiles.right_stick]
deadzone = 0.12
curve = 1.8
key_threshold = 0.5

[profiles.right_stick.action.mouse]
speed = 1500.0
accel = 0.3

[profiles.left_trigger.action.button]
threshold = 0.4
action = { mouse = "Right" }

[profiles.right_trigger.action.button]
threshold = 0.3
action = { mouse = "Left" }

[profiles.guide]
notes = '''
The right stick moves the mouse pointer; RT or A is a left click and LT a right click. Hold Guide and press X for the on-screen keyboard when the game asks for a name.
Hold LB for the zones and RB for roads, utilities and services, picking with the right stick, then drag with RT to place.
B closes the open window, or picks the centering tool when none is open.
Hold Y and click to query a tile. Hold the d-pad left or right to slow down or speed up time, and click L3 to pause.
Double tap Start to save the city.'''

[profiles.guide.edits]
"stick:Left" = { text = "Scroll the view" }
"stick:Right" = { text = "Pointer" }
"trigger:Right" = { text = "Left click (use the tool)" }
"trigger:Left" = { text = "Right click" }
"button:South" = { text = "Left click" }
"button:East" = { text = "Close window / centering tool" }
"button:West" = { text = "Bulldoze" }
"button:North" = { text = "Hold and click: query" }
"button:LeftBumper" = { text = "Hold: zones" }
"button:RightBumper" = { text = "Hold: roads, utilities, services" }
"button:LeftStick" = { text = "Pause" }
"button:RightStick" = { text = "Center on the pointer" }
"button:Select" = { text = "Budget, advisors, data" }
"button:Start" = { text = "Preferences" }
"gesture:button:Start:double_tap" = { text = "Save city" }
"gesture:button:DpadLeft:long_press" = { text = "Slower" }
"gesture:button:DpadRight:long_press" = { text = "Faster" }

[[profiles.guide.merged]]
inputs = ["button:DpadUp", "button:DpadDown"]
text = "Zoom in / out"

[[profiles.guide.merged]]
inputs = ["button:DpadLeft", "button:DpadRight"]
text = "Rotate"

