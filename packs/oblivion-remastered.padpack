format = 20
macros = []
overlay_font = "Cinzel"

[pack]
id = "c5612254-f3c1-5223-b1f4-1127bbe4e87c"
name = "The Elder Scrolls IV: Oblivion Remastered"
version = "1.0"
author = "Padwight"
description = "The Elder Scrolls IV: Oblivion Remastered (2025) on an Xbox-style pad. The game has its own controller support, so the controller passes through untouched and the game's own options set the buttons. Padwight adds the Guide overlay on top, with the on-screen keyboard and the media controls, in the colors of Cyrodiil."
made_with = "Xbox controller"

[controllers]
dualshock = true
dualsense = true

[[rules]]
kind = "executable"
value = "OblivionRemastered-Win64-Shipping.exe"
profile = "The Elder Scrolls IV: Oblivion Remastered"

[[rules]]
kind = "steam_app_id"
value = "2623190"
profile = "The Elder Scrolls IV: Oblivion Remastered"

[[rules]]
kind = "executable"
value = "OblivionRemastered-WinGDK-Shipping.exe"
profile = "The Elder Scrolls IV: Oblivion Remastered"

[[profiles]]
name = "The Elder Scrolls IV: Oblivion Remastered"
combos = []
combo_window_ms = 120
tap_window_ms = 250
long_press_ms = 500

[profiles.buttons]
South = {gamepad = "South"}
East = {gamepad = "East"}
North = {gamepad = "North"}
West = {gamepad = "West"}
LeftBumper = {gamepad = "LeftBumper"}
RightBumper = {gamepad = "RightBumper"}
LeftStick = {gamepad = "LeftStick"}
RightStick = {gamepad = "RightStick"}
Select = {gamepad = "Select"}
Start = {gamepad = "Start"}
DpadUp = {gamepad = "DpadUp"}
DpadDown = {gamepad = "DpadDown"}
DpadLeft = {gamepad = "DpadLeft"}
DpadRight = {gamepad = "DpadRight"}
Guide = {mode = "Guide"}

[profiles.left_stick]
deadzone = 0.05
curve = 1.0
key_threshold = 0.3

[profiles.left_stick.action]
gamepad = {stick = "Left", invert_y = false}

[profiles.right_stick]
deadzone = 0.05
curve = 1.0
key_threshold = 0.3

[profiles.right_stick.action]
gamepad = {stick = "Right", invert_y = false}

[profiles.left_trigger]
action = {gamepad = "Left"}

[profiles.right_trigger]
action = {gamepad = "Right"}

[profiles.gyro]
mode = "off"
horizontal = "yaw"
invert_x = false
invert_y = false
noise_threshold = 1.0

[profiles.guide]
notes = '''Oblivion Remastered has its own controller support, so the controller goes to the game as it is. Set the buttons in the game's own Settings → Controller.
{guide} still works over the game: {guide} + {west} opens the on-screen keyboard, and {guide} + {lb} the media controls.
If the game stops answering the pad, check that Steam Input or another remapper isn't also running for it.'''

[keyboard_style]
corners = 0.15
position = "bottom_center"
scale = 1.0

[keyboard_style.background]
color = "#17110f"
opacity = 0.92

[keyboard_style.items]
color = "#38201c"
opacity = 0.95

[keyboard_style.selected]
color = "#c8452d"
opacity = 1.0

[keyboard_style.border]
width = 1
color = "#a8872f"
opacity = 0.8

[keyboard_style.gradient]
color = "#271814"
opacity = 1.0
angle = 180

[keyboard_style.item_border]
width = 1
color = "#5a3a2c"

[keyboard_style.type]
letter_spacing = 2
case = "upper"

[numpad_style]
corners = 0.15
position = "center"
scale = 1.0

[numpad_style.background]
color = "#17110f"
opacity = 0.92

[numpad_style.items]
color = "#38201c"
opacity = 0.95

[numpad_style.selected]
color = "#c8452d"
opacity = 1.0

[numpad_style.border]
width = 1
color = "#a8872f"
opacity = 0.8

[numpad_style.gradient]
color = "#271814"
opacity = 1.0
angle = 180

[numpad_style.item_border]
width = 1
color = "#5a3a2c"

[numpad_style.type]
letter_spacing = 2
case = "upper"

[media_style]
corners = 0.15
position = "top_right"
scale = 0.9

[media_style.background]
color = "#17110f"
opacity = 0.92

[media_style.items]
color = "#38201c"
opacity = 0.95

[media_style.selected]
color = "#c8452d"
opacity = 1.0

[media_style.border]
width = 1
color = "#a8872f"
opacity = 0.8

[media_style.gradient]
color = "#271814"
opacity = 1.0
angle = 180

[media_style.item_border]
width = 1
color = "#5a3a2c"

[media_style.type]
letter_spacing = 2
case = "upper"

[menu_style]
corners = 0.15
position = "center"
scale = 1.0

[menu_style.background]
color = "#17110f"
opacity = 0.92

[menu_style.items]
color = "#38201c"
opacity = 0.95

[menu_style.selected]
color = "#c8452d"
opacity = 1.0

[menu_style.border]
width = 1
color = "#a8872f"
opacity = 0.8

[menu_style.gradient]
color = "#271814"
opacity = 1.0
angle = 180

[menu_style.item_border]
width = 1
color = "#5a3a2c"

[menu_style.glow]
color = "#f08a60"
opacity = 0.6
blur = 18
pulse = true

[menu_style.type]
letter_spacing = 2
case = "upper"

[menu_style.ornament]
frame = {kind = "chamfer", size = 12, width = 1, color = "#c8452d"}
vignette = {color = "#000000", opacity = 0.45, reach = 25}

[motion]
keyboard = "dreamy"
numpad = "dreamy"
menu = "dreamy"
media = "dreamy"
offer = "dreamy"
info = "dreamy"
log = "dreamy"

[sounds.menu]
step = {kind = "tick", volume = 0.07, pitch = 0.9}
pick = {kind = "shing", volume = 0.12}
open = {kind = "chime", volume = 0.1}
close = {kind = "chime", volume = 0.06, pitch = 0.8}

[sounds.keyboard]
step = {kind = "tick", volume = 0.07, pitch = 0.9}
pick = {kind = "wood", volume = 0.16}

[sounds.numpad]
step = {kind = "tick", volume = 0.07, pitch = 0.9}
pick = {kind = "wood", volume = 0.16}

[sounds.media]
pick = {kind = "wood", volume = 0.16}

[rumble.menu]
step = {strength = 0.1, length_ms = 18}
pick = {strength = 0.35, length_ms = 35}

[rumble.keyboard]
step = {strength = 0.07, length_ms = 14}
pick = {strength = 0.24, length_ms = 22}

[rumble.numpad]
step = {strength = 0.07, length_ms = 14}
pick = {strength = 0.24, length_ms = 22}

[rumble.media]
pick = {strength = 0.24, length_ms = 25}

[rumble.guide]
mode = {strength = 0.24, length_ms = 60}
