format = 20
macros = []
overlay_font = "Kreon"

[pack]
id = "b278d240-cc26-4d2d-b22a-2c96fa048ead"
name = "Baldur's Gate"
version = "1.0"
author = "Padwight"
description = "Baldur's Gate on an Xbox-style pad, for the Infinity Engine's mouse and keyboard controls. The right stick moves the pointer, the left stick scrolls the map, RT or A left-clicks and LT right-clicks. B pauses, X selects the whole party, Y is the inventory and hold RB to highlight what you can use. Hold LB to pick a party member. Select lists the character record, spells, map, journal and rest. Start is the options and backs out of every screen; double tap it to quick save, hold it to quick load."
made_with = "Xbox controller"

[[rules]]
kind = "executable"
value = "BGMain.exe"
profile = "Baldur's Gate"

[[rules]]
kind = "executable"
value = "BGMain2.exe"
profile = "Baldur's Gate"

[[rules]]
kind = "executable"
value = "Baldur's Gate Enhanced Edition/Baldur.exe"
profile = "Baldur's Gate"

[[rules]]
kind = "executable"
value = "Baldur's Gate - Enhanced Edition/Baldur.exe"
profile = "Baldur's Gate"

[[rules]]
kind = "steam_app_id"
value = "228280"
profile = "Baldur's Gate"

[[profiles]]
name = "Baldur's Gate"
combos = []
combo_window_ms = 120
tap_window_ms = 250
long_press_ms = 500

[profiles.buttons]
Guide = { mode = "Guide" }
South = { mouse = "Left" }
East = { keys = ["KEY_SPACE"] }
West = { keys = ["KEY_0"] }
North = { keys = ["KEY_I"] }
LeftBumper = { open_menu = "Party" }
RightBumper = { keys = ["KEY_TAB"] }
Select = { open_menu = "Screens" }
Start = { keys = ["KEY_ESC"] }
DpadUp = { wheel = "Up" }
DpadDown = { wheel = "Down" }
DpadLeft = { keys = ["KEY_J"] }
DpadRight = { keys = ["KEY_M"] }

[profiles.gestures.Start.double_tap]
keys = ["KEY_LEFTCTRL", "KEY_Q"]

[profiles.gestures.Start.long_press]
keys = ["KEY_LEFTCTRL", "KEY_L"]

[profiles.left_stick]
deadzone = 0.15
curve = 1.0
key_threshold = 0.35

[profiles.left_stick.action.ring]
sectors = 8
start_angle = 0.0
inner_radius = 0.35
hysteresis = 0.1

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_UP"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_UP"] },
    { keys = ["KEY_RIGHT"] },
]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_RIGHT"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_DOWN"] },
    { keys = ["KEY_RIGHT"] },
]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_DOWN"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_DOWN"] },
    { keys = ["KEY_LEFT"] },
]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_LEFT"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_UP"] },
    { keys = ["KEY_LEFT"] },
]

[profiles.right_stick]
deadzone = 0.12
curve = 1.8
key_threshold = 0.5

[profiles.right_stick.action.mouse]
speed = 1500.0
accel = 0.3

[profiles.left_trigger.action.button]
threshold = 0.4
action = { mouse = "Right" }

[profiles.right_trigger.action.button]
threshold = 0.3
action = { mouse = "Left" }

[profiles.guide]
notes = '''The right stick moves the mouse pointer; {rt} or {south} is a left click and {lt} a right click. Hold {guide} and press {west} for the on-screen keyboard when the game asks for a name.
{east} pauses and unpauses, which is how most fights are played: pause, give orders, unpause. Hold {rb} to highlight doors, containers and people you can use.
Hold {lb} and point with the right stick {rs} to pick one party member (or all six), then click. {west} selects the whole party.
{start} (Escape) closes the inventory, character record, spell books and map, and opens the options in play.
{select} lists the screens. The keys behind them are the game's defaults; if one does nothing, check Options, Gameplay, Assign Keys.'''

[profiles.guide.edits]
"stick:Left" = { text = "Scroll the map" }
"stick:Right" = { text = "Pointer" }
"trigger:Right" = { text = "Left click (move, use, attack)" }
"trigger:Left" = { text = "Right click (cancel)" }
"button:South" = { text = "Left click" }
"button:East" = { text = "{icon:pause} Pause" }
"button:West" = { text = "Select the whole party" }
"button:North" = { text = "{icon:bag} Inventory" }
"button:LeftBumper" = { text = "Hold: pick a party member" }
"button:RightBumper" = { text = "Hold: highlight objects" }
"button:Select" = { text = "{icon:book} Character, spells, rest" }
"button:Start" = { text = "Options / back out" }
"gesture:button:Start:double_tap" = { text = "{icon:save} Quick save" }
"gesture:button:Start:long_press" = { text = "{icon:load} Quick load" }
"button:DpadLeft" = { text = "{icon:scroll} Journal" }
"button:DpadRight" = { text = "{icon:map} Map" }

[[profiles.guide.merged]]
inputs = ["button:DpadUp", "button:DpadDown"]
text = "Scroll lists"

