format = 20
macros = []
overlay_font = "VT323"

[pack]
id = "ba2da02a-a6c1-5a1b-8d72-bb0e7fe160fa"
name = "Dwarf Fortress"
version = "1.0"
author = "Padwight"
description = "Dwarf Fortress (Steam, 2022 premium release) on an Xbox-style pad. The right stick moves the pointer, the left stick pans the map with the arrow keys, A or RT left-clicks, LT right-clicks. B backs out, Y pauses, the d-pad changes the z-level and zooms. LB opens the main modes, Select the screens. The \"+ Gyro\" profile also moves the pointer by tilting the controller."
made_with = "Xbox controller"

[[rules]]
kind = "executable"
value = "dwarf fortress.exe"
profile = "Dwarf Fortress"

[[rules]]
kind = "steam_app_id"
value = "975370"
profile = "Dwarf Fortress"

[[profiles]]
name = "Dwarf Fortress"
combos = []
combo_window_ms = 120
tap_window_ms = 250
long_press_ms = 500

[profiles.buttons]
Guide = { mode = "Guide" }
South = { mouse = "Left" }
East = { keys = ["KEY_ESC"] }
West = { keys = ["KEY_LEFTSHIFT"] }
North = { keys = ["KEY_SPACE"] }
LeftBumper = { open_menu = "Modes" }
RightBumper = { keys = ["KEY_ENTER"] }
Select = { open_menu = "Screens" }
Start = { keys = ["KEY_ESC"] }
LeftStick = { keys = ["KEY_LEFTCTRL"] }
RightStick = { mouse = "Middle" }
DpadUp = { keys = ["KEY_LEFTSHIFT", "KEY_DOT"] }
DpadDown = { keys = ["KEY_LEFTSHIFT", "KEY_COMMA"] }
DpadLeft = { wheel = "Down" }
DpadRight = { wheel = "Up" }

[profiles.left_stick]
deadzone = 0.15
curve = 1.0
key_threshold = 0.35

[profiles.left_stick.action.ring]
sectors = 8
start_angle = 0.0
inner_radius = 0.35
hysteresis = 0.1

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_UP"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_UP"] },
    { keys = ["KEY_RIGHT"] },
]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_RIGHT"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_DOWN"] },
    { keys = ["KEY_RIGHT"] },
]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_DOWN"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_DOWN"] },
    { keys = ["KEY_LEFT"] },
]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_LEFT"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_UP"] },
    { keys = ["KEY_LEFT"] },
]

[profiles.right_stick]
deadzone = 0.12
curve = 1.8
key_threshold = 0.5

[profiles.right_stick.action.mouse]
speed = 1500.0
accel = 0.3

[profiles.left_trigger.action.button]
threshold = 0.4
action = { mouse = "Right" }

[profiles.right_trigger.action.button]
threshold = 0.3
action = { mouse = "Left" }

[profiles.guide]
notes = '''The right stick {rs} moves the pointer: {rt} or {south} is a left click, {lt} a right click. The left stick {ls} pans the map with the arrow keys; hold {west} (Shift) to pan faster.
{north} pauses and unpauses. {updown} on the d-pad changes the z-level (Shift with period or comma, the less-than and greater-than keys); {leftright} zooms the map like the mouse wheel.
{rb} is Enter. {east} or {start} is Escape: it backs out of a menu, and on the map opens the game menu.
Hold {lb} for the main modes (aimed with {rs}, picked with {south}). {select} lists the screens (tap it, pick with {south}).
Hold {l3} for Ctrl, click {r3} for the middle mouse button.
Hold {guide} and press {west} for the on-screen keyboard (naming fortresses, dwarves, searches).
Dwarf Fortress has no controller support. Its keys can be remapped in data/init/interface.txt; these are the premium defaults as remembered. INFERRED, not checked on an install: every letter in the Modes and Screens menus and the z-level keys. If the game's own button tooltips show other keys, edit the menus.'''

[profiles.guide.edits]
"stick:Right" = { text = "Pointer" }
"stick:Left" = { text = "Pan the map" }
"trigger:Right" = { text = "Left click" }
"trigger:Left" = { text = "Right click" }
"button:South" = { text = "Left click" }
"button:East" = { text = "Back" }
"button:West" = { text = "Hold: Shift (pan fast)" }
"button:North" = { text = "{icon:pause} Pause" }
"button:LeftBumper" = { text = "Hold: main modes" }
"button:RightBumper" = { text = "Enter" }
"button:Select" = { text = "Screens" }
"button:Start" = { text = "Game menu" }
"button:LeftStick" = { text = "Hold: Ctrl" }
"button:RightStick" = { text = "Middle click" }
"button:DpadUp" = { text = "{icon:height} Level up" }
"button:DpadDown" = { text = "{icon:height} Level down" }
"button:DpadLeft" = { text = "Zoom out" }
"button:DpadRight" = { text = "Zoom in" }

[[profiles]]
name = "Dwarf Fortress + Gyro"
combos = [{buttons = ["Select", "Start"], action = "gyro_clutch"}]
combo_window_ms = 120
tap_window_ms = 250
long_press_ms = 500
requires = ["gyro"]

[profiles.buttons]
Guide = { mode = "Guide" }
South = { mouse = "Left" }
East = { keys = ["KEY_ESC"] }
West = { keys = ["KEY_LEFTSHIFT"] }
North = { keys = ["KEY_SPACE"] }
LeftBumper = { open_menu = "Modes" }
RightBumper = { keys = ["KEY_ENTER"] }
Select = { open_menu = "Screens" }
Start = { keys = ["KEY_ESC"] }
LeftStick = { keys = ["KEY_LEFTCTRL"] }
RightStick = { mouse = "Middle" }
DpadUp = { keys = ["KEY_LEFTSHIFT", "KEY_DOT"] }
DpadDown = { keys = ["KEY_LEFTSHIFT", "KEY_COMMA"] }
DpadLeft = { wheel = "Down" }
DpadRight = { wheel = "Up" }

[profiles.left_stick]
deadzone = 0.15
curve = 1.0
key_threshold = 0.35

[profiles.left_stick.action.ring]
sectors = 8
start_angle = 0.0
inner_radius = 0.35
