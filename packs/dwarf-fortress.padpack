"button:LeftBumper" = { text = "Hold: main modes" }
"button:RightBumper" = { text = "Enter" }
"button:Select" = { text = "Screens" }
"button:Start" = { text = "Game menu" }
"button:LeftStick" = { text = "Hold: Ctrl" }
"button:RightStick" = { text = "Middle click" }
"button:DpadUp" = { text = "{icon:height} Level up" }
"button:DpadDown" = { text = "{icon:height} Level down" }
"button:DpadLeft" = { text = "Zoom out" }
"button:DpadRight" = { text = "Zoom in" }

[profiles.gyro]
horizontal = "yaw"
invert_x = false
invert_y = false
noise_threshold = 1.0

[profiles.gyro.mode.mouse]
sensitivity = 20.0

