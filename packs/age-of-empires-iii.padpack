format = 20
macros = []
overlay_font = "Cinzel"

[pack]
id = "9c755d87-3787-4364-94ec-c778a683e63c"
name = "Age of Empires III"
version = "1.0"
author = "Padwight"
description = "Age of Empires III (2005) and its Complete Collection with The WarChiefs and The Asian Dynasties on an Xbox-style pad, for the default hotkeys. The game has no controller support, so the layout is the same as the Definitive Edition pack and the other Age of Empires packs (idle villagers and the Town Center on the face buttons, commands in quick menus) on the game's keys. The right stick moves the cursor, RT left-clicks, LT right-clicks, the left stick scrolls the map. A, X and Y find an idle villager, idle military and the Town Center; the d-pad zooms, opens the Home City and finds the Explorer. Hold LB for control groups 1-10 (LB + RB sets one), R3 for unit commands. Select lists pause, chat and the Home City; hold it for the Menus mode. Start is the game menu. The \"+ Gyro\" profile also moves the cursor by tilting the controller."
made_with = "Xbox controller"

[[rules]]
kind = "executable"
value = "age3.exe"
profile = "Age of Empires III"

[[rules]]
kind = "executable"
value = "age3x.exe"
profile = "Age of Empires III"

[[rules]]
kind = "executable"
value = "age3y.exe"
profile = "Age of Empires III"

[[rules]]
kind = "steam_app_id"
value = "105450"
profile = "Age of Empires III"

[[profiles]]
name = "Age of Empires III"
combos = [{buttons = ["LeftBumper", "RightBumper"], action = {open_menu = "Set group"}}]
combo_window_ms = 120
tap_window_ms = 250
long_press_ms = 500

[profiles.buttons]
Guide = {mode = "Guide"}
South = {keys = ["KEY_DOT"]}
West = {keys = ["KEY_COMMA"]}
North = {keys = ["KEY_H"]}
East = {keys = ["KEY_ESC"]}
LeftBumper = {open_menu = "Groups"}
RightBumper = {keys = ["KEY_LEFTSHIFT"]}
Select = {open_menu = "Game"}
Start = {keys = ["KEY_ESC"]}
RightStick = {open_menu = "Commands"}
DpadUp = {wheel = "Up"}
DpadDown = {wheel = "Down"}
DpadLeft = {keys = ["KEY_C"]}
DpadRight = {keys = ["KEY_SLASH"]}

[profiles.gestures.Select]
long_press = {mode = "Menus"}

[profiles.left_stick]
deadzone = 0.2
curve = 1.0
key_threshold = 0.45

[profiles.left_stick.action.ring]
sectors = 8
start_angle = 0.0
inner_radius = 0.45
hysteresis = 0.1

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_UP"]

[[profiles.left_stick.action.ring.actions]]
multi = [{ keys = ["KEY_UP"] }, { keys = ["KEY_RIGHT"] }]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_RIGHT"]

[[profiles.left_stick.action.ring.actions]]
multi = [{ keys = ["KEY_DOWN"] }, { keys = ["KEY_RIGHT"] }]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_DOWN"]

[[profiles.left_stick.action.ring.actions]]
multi = [{ keys = ["KEY_DOWN"] }, { keys = ["KEY_LEFT"] }]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_LEFT"]

[[profiles.left_stick.action.ring.actions]]
multi = [{ keys = ["KEY_UP"] }, { keys = ["KEY_LEFT"] }]

[profiles.right_stick]
deadzone = 0.1
curve = 1.6
key_threshold = 0.25

[profiles.right_stick.action.mouse]
speed = 1500.0
accel = 0.25

[profiles.left_trigger.action.button]
threshold = 0.4
action = { mouse = "Right" }

[profiles.right_trigger.action.button]
threshold = 0.3
action = { mouse = "Left" }

[profiles.gyro]
mode = "off"
horizontal = "yaw"
invert_x = false
invert_y = false
noise_threshold = 1.0

[profiles.guide]
notes = '''The right stick {rs} moves the cursor: {rt} selects (left click, hold to drag a box), and {lt} moves, gathers, builds or attacks (right click). The left stick {ls} scrolls the map, and {up} {down} zoom.
{south} jumps to the next idle villager, {west} to idle military and {north} to the Town Center. {left} opens the Home City to send a shipment, and {right} finds your Explorer.
Hold {lb} for the control groups and aim the right stick {rs} at one: release to select it. Hold {lb} and {rb} together to put the selection in a group instead (Ctrl + number).
{rb} is Shift: hold it to queue orders, add to the selection, or train five at once. Double-click with {rt} to select every unit of that type on screen.
Click {r3} for the unit commands (stop, ungarrison, delete), aimed with the right stick {rs}.
{select} lists pause, chat and the Home City. Hold {select} for the Menus mode (lobbies, the Home City screens, the main menu) and hold it again to come back. {start} (Esc) is the game menu; {east} cancels and closes.
The keys are the Definitive Edition's defaults, assumed to match the 2005 game's and not checked on an install: the Home City (C), Explorer (/), pause and the unit commands are the likeliest to differ. If a key does nothing, look in Options, Hotkeys. The base game, The WarChiefs and The Asian Dynasties run as age3.exe, age3x.exe and age3y.exe; age3x.exe isn't in the detection list and is from memory. Guide + {west} opens the on-screen keyboard for chat.'''

[profiles.guide.edits]
"stick:Left" = { text = "Scroll the map" }
"stick:Right" = { text = "Cursor" }
"trigger:Right" = { text = "Left click (select, drag a box)" }
"trigger:Left" = { text = "Right click (move, gather, attack)" }
"button:South" = { text = "{icon:sleep} Idle villager" }
"button:West" = { text = "{icon:sword} Idle military" }
"button:North" = { text = "{icon:home} Town Center" }
"button:East" = { text = "Cancel / close" }
"button:RightBumper" = { text = "Shift (queue, add, train 5)" }
"button:LeftBumper" = { text = "Hold: control groups" }
"button:RightStick" = { text = "Unit commands" }
"button:DpadLeft" = { text = "{icon:anchor} Home City" }
"button:DpadRight" = { text = "{icon:compass} Explorer" }
"button:Start" = { text = "Game menu" }
"gesture:button:Select:long_press" = { text = "Menus mode on / off" }
"button:Select" = { text = "Pause, chat, Home City" }

[[profiles.guide.merged]]
inputs = ["button:DpadUp", "button:DpadDown"]
text = "Zoom in / out"

[[profiles.guide.custom]]
inputs = ["button:LeftBumper", "button:RightBumper"]
text = "Set a control group"

[[profiles]]
name = "Age of Empires III + Gyro"
