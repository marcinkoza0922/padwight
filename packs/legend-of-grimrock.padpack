format = 20
macros = []
overlay_font = "Cinzel"

[pack]
id = "b4e756fb-05fb-539c-82d6-e5deae7a9174"
name = "Legend of Grimrock"
version = "1.0"
author = "Padwight"
description = "Legend of Grimrock on an Xbox-style pad. The left stick moves; the right stick points at doors and items. A clicks, B steps back; LB and RB turn. Overlays in dungeon stone."
made_with = "Xbox controller"

[[rules]]
kind = "steam_app_id"
value = "207170"
profile = "Legend of Grimrock"

[[rules]]
kind = "executable"
value = "grimrock.exe"
profile = "Legend of Grimrock"

[[profiles]]
name = "Legend of Grimrock"
combos = []
combo_window_ms = 120
tap_window_ms = 250
long_press_ms = 500

[profiles.buttons]
Guide = {mode = "Guide"}
South = {mouse = "Left"}
East = {keys = ["KEY_S"]}
DpadUp = {wheel = "Up"}
DpadDown = {wheel = "Down"}
Start = {keys = ["KEY_ESC"]}
LeftBumper = {keys = ["KEY_Q"]}
RightBumper = {keys = ["KEY_E"]}
West = {keys = ["KEY_I"]}
North = {keys = ["KEY_R"]}

[profiles.left_stick]
deadzone = 0.15
curve = 1.0
key_threshold = 0.35

[profiles.left_stick.action.ring]
sectors = 8
start_angle = 0.0
inner_radius = 0.35
hysteresis = 0.1

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_W"]

[[profiles.left_stick.action.ring.actions]]
multi = [{ keys = ["KEY_W"] }, { keys = ["KEY_D"] }]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_D"]

[[profiles.left_stick.action.ring.actions]]
multi = [{ keys = ["KEY_S"] }, { keys = ["KEY_D"] }]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_S"]

[[profiles.left_stick.action.ring.actions]]
multi = [{ keys = ["KEY_S"] }, { keys = ["KEY_A"] }]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_A"]

[[profiles.left_stick.action.ring.actions]]
multi = [{ keys = ["KEY_W"] }, { keys = ["KEY_A"] }]

[profiles.right_stick]
deadzone = 0.12
curve = 1.7
key_threshold = 0.5

[profiles.right_stick.action.mouse]
speed = 1400.0
accel = 0.3

[profiles.left_trigger.action.button]
threshold = 0.4
action = {mouse = "Right"}

[profiles.right_trigger.action.button]
threshold = 0.3
action = {mouse = "Left"}

[profiles.gyro]
enabled = false
horizontal = "yaw"
invert_x = false
invert_y = false
noise_threshold = 1.0

[profiles.guide]
notes = '''The right stick {rs} moves the pointer. {rt} or {south} clicks, {lt} right-clicks. {up} and {down} scroll the wheel. The left stick {ls} moves.
Buttons: {south} Click; {east} Step back; {start} Menu; {lb} Turn left; {rb} Turn right; {west} Inventory; {north} Rest.
Movement is grid by grid on WASD, Q and E turn; the pointer drags items. The sticks move one square at a time. Keys are the game's defaults as remembered, not read from an install; if one doesn't answer, check the game's controls options and change the buttons here to match. The Windows executable is from Discord's list. The game has no controller support, so the pad plays it with the pointer.
Typing a name or text: {guide} + {west} opens the on-screen keyboard.'''

[profiles.guide.edits]
"stick:Left" = {text = "Move"}
"stick:Right" = {text = "Pointer"}
"trigger:Right" = {text = "Left click"}
"trigger:Left" = {text = "Right click"}
"button:South" = {text = "Click"}
"button:East" = {text = "{icon:footprints} Step back"}
"button:Start" = {text = "Menu"}
"button:LeftBumper" = {text = "{icon:rotate-left} Turn left"}
"button:RightBumper" = {text = "{icon:rotate} Turn right"}
"button:West" = {text = "{icon:bag} Inventory"}
"button:North" = {text = "{icon:sleep} Rest"}

[[profiles.guide.merged]]
inputs = ["button:DpadUp", "button:DpadDown"]
text = "Zoom in / out"



