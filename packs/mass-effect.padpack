format = 20
macros = []
overlay_font = "Titillium Web"

[pack]
id = "59a16611-4221-4a8d-a96f-bfe85dee8723"
name = "Mass Effect"
version = "1.0"
author = "Padwight"
description = "Mass Effect (2008) on an Xbox-style pad, laid out like the Xbox 360 version on the PC game's keys. RT fires and LT zooms, A uses (hold it to sprint), B holsters, X draws the last weapon and Y is first aid. Hold RB for the tactics screen with its power and weapon wheel, hold LB for a weapon ring and press both for the quick slots. The D-pad gives squad orders, L3 crouches and R3 throws a grenade. Select lists the screens and the Mako controls; Start is the menu, double tap it to quick save and hold it to quick load. The game has no controller support. Gyro and flick stick profiles are included to try."
made_with = "Xbox controller"

[[rules]]
kind = "steam_app_id"
value = "17460"
profile = "Mass Effect"

[[rules]]
kind = "executable"
value = "MassEffect.exe"
profile = "Mass Effect"

[[profiles]]
name = "Mass Effect"
combos = [
    {buttons = ["LeftBumper", "RightBumper"], action = { open_menu = "Quick slots" }},
]
combo_window_ms = 120
tap_window_ms = 250
long_press_ms = 400

[profiles.buttons]
Guide = { mode = "Guide" }
South = { keys = ["KEY_SPACE"] }
East = { keys = ["KEY_H"] }
West = { keys = ["KEY_X"] }
North = { keys = ["KEY_V"] }
LeftBumper = { open_menu = "Weapons" }
RightBumper = { keys = ["KEY_LEFTSHIFT"] }
Select = { open_menu = "Screens" }
Start = { keys = ["KEY_ESC"] }
LeftStick = { keys = ["KEY_LEFTCTRL"] }
RightStick = { keys = ["KEY_G"] }
DpadUp = { keys = ["KEY_Z"] }
DpadDown = { keys = ["KEY_C"] }
DpadLeft = { keys = ["KEY_Q"] }
DpadRight = { keys = ["KEY_E"] }

[profiles.gestures.RightStick]
long_press = { mouse = "Middle" }

[profiles.gestures.Start]
double_tap = { keys = ["KEY_F5"] }
long_press = { keys = ["KEY_F9"] }

[profiles.left_stick]
deadzone = 0.12
curve = 1.0
key_threshold = 0.25

[profiles.left_stick.action.ring]
sectors = 8
start_angle = 0.0
inner_radius = 0.25
hysteresis = 0.1

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_W"]

[[profiles.left_stick.action.ring.actions]]
multi = [{ keys = ["KEY_W"] }, { keys = ["KEY_D"] }]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_D"]

[[profiles.left_stick.action.ring.actions]]
