[media_style.background]
color = "#050b14"
opacity = 0.93

[media_style.items]
color = "#0e1b2c"
opacity = 0.95

[media_style.selected]
color = "#1f6fa6"
opacity = 1.0

[media_style.border]
width = 1
color = "#4fb0e0"
opacity = 0.8

[media_style.gradient]
color = "#0a1424"
opacity = 1.0
angle = 180

[media_style.item_border]
width = 1
color = "#1d3550"

[media_style.type]
letter_spacing = 1
