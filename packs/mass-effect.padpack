[profiles.right_stick]
deadzone = 0.08
curve = 2.0
key_threshold = 0.5

[profiles.right_stick.action.mouse]
speed = 1200.0
accel = 0.2

[profiles.left_trigger.action.button]
threshold = 0.4
action = { multi = [{ layer = "Aim" }, { mouse = "Right" }] }

[profiles.right_trigger.action.button]
threshold = 0.3
action = { mouse = "Left" }

[profiles.guide]
notes = '''Laid out like the Xbox 360 version on the PC game's keys. {south} uses, talks and opens; hold {south} to sprint (storm). {east} holsters the weapon, {west} draws the last one, {north} uses medi-gel (first aid). {rt} fires and {lt} zooms in (the right stick turns more finely while it's held); the game aims only while the right mouse button is held.
Hold {rb} for the game's own tactics screen: it pauses, and the right stick {rs} picks powers and weapons in it, as on the console. Hold {lb} for a ring of the four weapons, aiming with the right stick. Press {lb} and {rb} together for the eight quick slots (fill them in the tactics screen).
{up} orders the squad to attack your target or move where you aim, {down} regroups them, and {left} and {right} give the same order to the first or second squadmate alone. Click {l3} to crouch, {r3} throws a grenade and a long press of {r3} changes the zoom level.
Hold {select} for the screens: map, equipment, squad, journal and codex, and the {b}Mako{/b} controls. In the Mako {south} fires the jump jets, {rb} the cannon, {lt} switches to the turret view, {north} repairs, {east} gets out and {west} returns to the Normandy; pick the Mako again from {select} to walk.
{start} opens the menu; double tap it to {color:green}quick save{/color}, hold it to quick load. Naming Shepard: {guide} + {west} opens the on-screen keyboard.
The game has no controller support on PC (a fan mod adds one; this setup is for the game as it ships). The keys are the first game's defaults as the Legendary Edition lists them, written from memory and not checked on an install: the 2008 release may differ (players remember E as its use key), so check Options, Controls and change the buttons here to match. The Mako keys, first aid (V), quick save and the squad orders are the least sure. The Xbox layout is from a walkthrough's controls table.'''

