[[menus]]
name = "Screens"

kind = "list"

[[menus.items]]
label = "{icon:map} Map"
action = { keys = ["KEY_M"] }

[[menus.items]]
label = "{icon:bag} Equipment"
action = { keys = ["KEY_I"] }

[[menus.items]]
label = "{icon:people} Squad"
action = { keys = ["KEY_U"] }

[[menus.items]]
label = "{icon:scroll} Journal"
action = { keys = ["KEY_J"] }

[[menus.items]]
label = "{icon:book} Codex"
action = { keys = ["KEY_O"] }

[[menus.items]]
label = "{icon:car} {b}Mako{/b} controls {color:#7fa9c8}on / off{/color}"
action = { mode = "Mako" }

[menus.style]
corners = 0.1
position = "center"
scale = 1.0

[menus.style.background]
color = "#050b14"
opacity = 0.93

[menus.style.items]
color = "#0e1b2c"
opacity = 0.95

[menus.style.selected]
color = "#1f6fa6"
opacity = 1.0

[menus.style.border]
width = 1
color = "#4fb0e0"
opacity = 0.8

[menus.style.gradient]
color = "#0a1424"
opacity = 1.0
angle = 180

[menus.style.item_border]
width = 1
color = "#1d3550"

[menus.style.glow]
color = "#3aa8f0"
opacity = 0.55
blur = 16

[menus.style.type]
letter_spacing = 1
case = "upper"

[menus.style.ornament]
frame = {kind = "brackets", size = 12, width = 1, color = "#4fb0e0"}
vignette = {color = "#000000", opacity = 0.45, reach = 25}

[keyboard_style]
corners = 0.1
position = "bottom_center"
scale = 1.0

[keyboard_style.background]
color = "#050b14"
opacity = 0.93

[keyboard_style.items]
color = "#0e1b2c"
opacity = 0.95

[keyboard_style.selected]
color = "#1f6fa6"
opacity = 1.0

[keyboard_style.border]
width = 1
color = "#4fb0e0"
opacity = 0.8

[keyboard_style.gradient]
color = "#0a1424"
opacity = 1.0
angle = 180

[keyboard_style.item_border]
width = 1
color = "#1d3550"

[keyboard_style.type]
letter_spacing = 1
case = "upper"

[numpad_style]
