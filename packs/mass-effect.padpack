[motion]
keyboard = "swift"
numpad = "swift"
menu = "swift"
media = "swift"
offer = "swift"
info = "swift"
log = "swift"

[sounds.menu]
step = {kind = "rollover", volume = 0.08}
pick = {kind = "nano", volume = 0.1}
open = {kind = "rise", volume = 0.05}
close = {kind = "fall", volume = 0.04}

[sounds.numpad]
step = {kind = "rollover", volume = 0.07}
pick = {kind = "select", volume = 0.12}

[sounds.keyboard]
step = {kind = "rollover", volume = 0.07}
pick = {kind = "select", volume = 0.12}

[rumble.menu]
step = {strength = 0.08, length_ms = 18}
pick = {strength = 0.3, length_ms = 35}
open = {strength = 0.07, length_ms = 25}

[rumble.keyboard]
step = {strength = 0.06, length_ms = 14}
pick = {strength = 0.21, length_ms = 22}

[rumble.numpad]
step = {strength = 0.06, length_ms = 14}
pick = {strength = 0.21, length_ms = 22}

[rumble.media]
pick = {strength = 0.21, length_ms = 25}

[rumble.guide]
mode = {strength = 0.21, length_ms = 60}

