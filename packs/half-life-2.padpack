format = 20
macros = []
overlay_font = "Inter"

[pack]
id = "31ad1dfa-4e20-42ca-a8e2-19f20f17f9c5"
name = "Half-Life 2"
version = "1.0"
author = "Padwight"
description = "Half-Life 2 and its episodes on an Xbox-style pad. The game has its own controller support, with the Xbox 360 layout of The Orange Box, so the controller passes through untouched and the game's Controller options set the buttons. Padwight adds the Guide overlay on top, with the on-screen keyboard and the media controls, in the amber of the HEV suit's HUD."
made_with = "Xbox controller"

[[rules]]
kind = "steam_app_id"
value = "220"
profile = "Half-Life 2"

[[rules]]
kind = "executable"
value = "Half-Life 2/hl2_linux"
profile = "Half-Life 2"

[[rules]]
kind = "executable"
value = "Half-Life 2/hl2.exe"
profile = "Half-Life 2"

[[profiles]]
name = "Half-Life 2"
combos = []
combo_window_ms = 120
tap_window_ms = 250
long_press_ms = 500

[profiles.buttons]
Guide = {mode = "Guide"}
South = {gamepad = "South"}
East = {gamepad = "East"}
North = {gamepad = "North"}
West = {gamepad = "West"}
LeftBumper = {gamepad = "LeftBumper"}
RightBumper = {gamepad = "RightBumper"}
LeftStick = {gamepad = "LeftStick"}
RightStick = {gamepad = "RightStick"}
Select = {gamepad = "Select"}
Start = {gamepad = "Start"}
DpadUp = {gamepad = "DpadUp"}
DpadDown = {gamepad = "DpadDown"}
DpadLeft = {gamepad = "DpadLeft"}
DpadRight = {gamepad = "DpadRight"}

[profiles.left_stick]
deadzone = 0.05
curve = 1.0
key_threshold = 0.3

[profiles.left_stick.action]
gamepad = {stick = "Left", invert_y = false}

[profiles.right_stick]
deadzone = 0.05
curve = 1.0
key_threshold = 0.3

[profiles.right_stick.action]
gamepad = {stick = "Right", invert_y = false}

[profiles.left_trigger]
action = {gamepad = "Left"}

[profiles.right_trigger]
action = {gamepad = "Right"}

[profiles.gyro]
enabled = false
horizontal = "yaw"
invert_x = false
invert_y = false
noise_threshold = 1.0

[profiles.guide]
notes = '''The controller goes to the game as it is. Half-Life 2 has its own controller support, so set the buttons, sensitivity and look inversion in the game's {b}Options → Controller{/b}. The episodes and Lost Coast use the same scheme.
{guide} still works over the game: {guide} + {west} opens the on-screen keyboard for the developer console or a save name, and {guide} + {lb} the media controls.
If the game stops answering the pad, check that Steam Input or another remapper isn't also running for it.'''

[keyboard_style]
