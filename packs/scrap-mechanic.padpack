format = 20
macros = []
overlay_font = "Titillium Web"

[pack]
id = "d65e0acd-38c2-466c-a846-c99c08e4c246"
name = "Scrap Mechanic"
version = "1.0"
author = "Padwight"
description = "Scrap Mechanic on an Xbox-style pad, for the game's default keys. RT uses the tool in hand, LT is its right-click and aims, X uses and sits, A jumps, B crouches (toggle), Y opens the inventory, RB rotates a part, L3 sprints (toggle), R3 reloads. Hold LB for the hotbar, which is also a seat's controls. Hold Select for the Driving mode: RT forward, LT back, the left stick steers. Gyro and flick stick profiles are included to try."
made_with = "Xbox controller"

[[rules]]
kind = "executable"
value = "ScrapMechanic.exe"
profile = "Scrap Mechanic"

[[rules]]
kind = "steam_app_id"
value = "387990"
profile = "Scrap Mechanic"

[[profiles]]
name = "Scrap Mechanic"
combos = []
combo_window_ms = 120
tap_window_ms = 250
long_press_ms = 500

[profiles.buttons]
South = { keys = ["KEY_SPACE"] }
East = { toggle = { action = { keys = ["KEY_LEFTCTRL"] } } }
West = { keys = ["KEY_E"] }
North = { keys = ["KEY_TAB"] }
LeftBumper = { open_menu = "Hotbar" }
RightBumper = { keys = ["KEY_Q"] }
Select = { open_menu = "Screens" }
Start = { keys = ["KEY_ESC"] }
Guide = { mode = "Guide" }
LeftStick = { toggle = { action = { keys = ["KEY_LEFTSHIFT"] } } }
RightStick = { keys = ["KEY_R"] }
DpadUp = { keys = ["KEY_M"] }
DpadDown = { keys = ["KEY_ENTER"] }
DpadLeft = { wheel = "Up" }
DpadRight = { wheel = "Down" }

[profiles.gestures.Select]
long_press = { mode = "Driving" }

[profiles.left_stick]
deadzone = 0.12
curve = 1.0
key_threshold = 0.25

[profiles.left_stick.action.ring]
sectors = 8
start_angle = 0.0
inner_radius = 0.25
hysteresis = 0.1

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_W"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_W"] },
    { keys = ["KEY_D"] },
]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_D"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_S"] },
    { keys = ["KEY_D"] },
]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_S"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_S"] },
    { keys = ["KEY_A"] },
]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_A"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_W"] },
    { keys = ["KEY_A"] },
]

[profiles.right_stick]
deadzone = 0.1
curve = 2.0
key_threshold = 0.5

[profiles.right_stick.action.mouse]
speed = 2400.0
accel = 0.4
y_scale = 0.75

[profiles.left_trigger.action.button]
threshold = 0.3
action = { multi = [{ layer = "Aim" }, { mouse = "Right" }] }

[profiles.right_trigger.action.button]
threshold = 0.3
action = { mouse = "Left" }

[profiles.guide]
notes = '''{rt} uses the tool in hand: place a part, swing the hammer, paint, connect, fire the spud gun. {lt} is its right-click (aim, erase, the lift's options); holding it also slows the right stick for aiming.
{west} uses and sits down, {south} jumps, {east} crouches (a toggle), {l3} sprints (a toggle). {rb} rotates the part you're placing, {r3} reloads.
Hold {lb} for the hotbar and pick a slot with the right stick {rs}; {left} and {right} step through it. In a seat, the hotbar slots are the seat's controls.
{north} opens the inventory and crafting, where the right stick {rs} moves the cursor and {rt} clicks. {up} is the map, {down} chat.
Hold {select} for the Driving mode once you sit in a seat: {rt} drives forward, {lt} back, {ls} steers. Hold {select} again to get back on your feet. {select} also lists the screens.
Naming a creation or chatting: {guide} + {west} opens the on-screen keyboard. The rotate, reload and map keys are inferred; check Options → Controls if one doesn't answer.'''

[profiles.guide.edits]
"stick:Left" = { text = "Move" }
"stick:Right" = { text = "Look / cursor" }
"trigger:Right" = { text = "{icon:wrench} Use tool / place" }
"trigger:Left" = { text = "{icon:crosshair} Aim / right-click" }
"button:South" = { text = "Jump" }
"button:East" = { text = "Crouch (toggle)" }
"button:West" = { text = "{icon:hand} Use / sit" }
"button:North" = { text = "{icon:bag} Inventory, crafting" }
"button:LeftBumper" = { text = "Hold: hotbar" }
"button:RightBumper" = { text = "{icon:rotate} Rotate part" }
"button:LeftStick" = { text = "Sprint (toggle)" }
"button:RightStick" = { text = "Reload" }
"button:DpadUp" = { text = "{icon:map} Map" }
"button:DpadDown" = { text = "{icon:messages} Chat" }
"button:Select" = { text = "Screens" }
"gesture:button:Select:long_press" = { text = "{icon:car} Driving mode" }
"button:Start" = { text = "Menu" }

[[profiles.guide.merged]]
inputs = ["button:DpadLeft", "button:DpadRight"]
text = "Previous / next hotbar slot"

