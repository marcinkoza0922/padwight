format = 20
macros = []
overlay_font = "Kreon"

[pack]
id = "e3b17c58-4f2a-4d96-8c0b-7a5e21d9f364"
name = "Stronghold Crusader"
version = "1.0"
author = "Padwight"
description = "Stronghold Crusader (HD and Extreme) on an Xbox-style pad, for the default keys. The game has no controller support, so the pad drives the mouse and the game's hotkeys. The right stick moves the cursor, RT left-clicks to select and give orders, LT right-clicks to deselect and cancel, the left stick scrolls the map. A, X and Y jump to the Keep, the Barracks and the Granary, R3 to the Market; the d-pad zooms, flattens the land and rotates the view. Hold LB for unit groups 1-9 (LB + RB sets one). Select lists pause and game speed; hold it for the Menus mode. Start is the menu. The \"+ Gyro\" profile also moves the cursor by tilting the controller."
made_with = "Xbox controller"

[[rules]]
kind = "executable"
value = "Stronghold Crusader.exe"
profile = "Stronghold Crusader"

[[rules]]
kind = "executable"
value = "Stronghold_Crusader_Extreme.exe"
profile = "Stronghold Crusader"

[[rules]]
kind = "steam_app_id"
value = "40970"
profile = "Stronghold Crusader"

[[profiles]]
name = "Stronghold Crusader"
combos = [{buttons = ["LeftBumper", "RightBumper"], action = {open_menu = "Set group"}}]
combo_window_ms = 120
tap_window_ms = 250
long_press_ms = 500

[profiles.buttons]
Guide = {mode = "Guide"}
South = {keys = ["KEY_H"]}
West = {keys = ["KEY_B"]}
North = {keys = ["KEY_G"]}
East = {keys = ["KEY_ESC"]}
LeftBumper = {open_menu = "Groups"}
RightBumper = {keys = ["KEY_LEFTSHIFT"]}
Select = {open_menu = "Game"}
Start = {keys = ["KEY_ESC"]}
RightStick = {keys = ["KEY_M"]}
DpadUp = {keys = ["KEY_Z"]}
DpadDown = {keys = ["KEY_SPACE"]}
DpadLeft = {keys = ["KEY_COMMA"]}
DpadRight = {keys = ["KEY_DOT"]}

[profiles.gestures.Select]
long_press = {mode = "Menus"}

[profiles.left_stick]
deadzone = 0.2
curve = 1.0
key_threshold = 0.45

[profiles.left_stick.action.ring]
sectors = 8
start_angle = 0.0
inner_radius = 0.45
hysteresis = 0.1

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_UP"]

[[profiles.left_stick.action.ring.actions]]
multi = [{ keys = ["KEY_UP"] }, { keys = ["KEY_RIGHT"] }]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_RIGHT"]

[[profiles.left_stick.action.ring.actions]]
multi = [{ keys = ["KEY_DOWN"] }, { keys = ["KEY_RIGHT"] }]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_DOWN"]

[[profiles.left_stick.action.ring.actions]]
multi = [{ keys = ["KEY_DOWN"] }, { keys = ["KEY_LEFT"] }]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_LEFT"]

[[profiles.left_stick.action.ring.actions]]
multi = [{ keys = ["KEY_UP"] }, { keys = ["KEY_LEFT"] }]

[profiles.right_stick]
deadzone = 0.1
curve = 1.6
key_threshold = 0.25

[profiles.right_stick.action.mouse]
speed = 1500.0
accel = 0.25

[profiles.left_trigger.action.button]
threshold = 0.4
action = { mouse = "Right" }

[profiles.right_trigger.action.button]
threshold = 0.3
action = { mouse = "Left" }

[profiles.gyro]
enabled = false
horizontal = "yaw"
invert_x = false
invert_y = false
noise_threshold = 1.0

[profiles.guide]
notes = '''The right stick {rs} moves the cursor. {rt} is the left click: it selects, places buildings and gives orders, and a drag boxes troops. {lt} is the right click: it deselects and cancels. The left stick {ls} scrolls the map.
{south} jumps to the Keep, {west} to the Barracks, {north} to the Granary and {r3} to the Market.
{up} zooms in and out, {down} flattens the land to see behind walls, and {left} {right} rotate the view.
Hold {lb} for the unit groups and aim the right stick {rs} at one: release to select it. Hold {lb} and {rb} together to put the selection in a group instead (Ctrl + number). {rb} is Shift, to add to the selection.
{select} lists pause and game speed. Hold {select} for the Menus mode (the main menu, mission briefings, the map editor) and hold it again to come back. {start} (Esc) is the menu; {east} closes a panel.
The keys are the game's defaults as best remembered, not checked on an install: rotate (, .), zoom (Z), flatten (Space), the building jumps and the group keys are the likeliest to differ, and Crusader can't remap them. The executable names for Steam's HD and Extreme HD are from Discord's list. Guide + {west} opens the on-screen keyboard to name a castle or chat.'''

[profiles.guide.edits]
"stick:Left" = { text = "Scroll the map" }
"stick:Right" = { text = "Cursor" }
"trigger:Right" = { text = "Left click (select, build, order)" }
"trigger:Left" = { text = "Right click (deselect, cancel)" }
"button:South" = { text = "{icon:castle} Keep" }
"button:West" = { text = "{icon:sword-cross} Barracks" }
"button:North" = { text = "{icon:wheat} Granary" }
"button:East" = { text = "Close" }
"button:RightBumper" = { text = "Shift (add to selection)" }
"button:LeftBumper" = { text = "Hold: unit groups" }
"button:RightStick" = { text = "{icon:shop} Market" }
"button:DpadUp" = { text = "{icon:search} Zoom" }
"button:DpadDown" = { text = "{icon:terrain} Flatten the land" }
"button:Start" = { text = "Menu" }
"gesture:button:Select:long_press" = { text = "Menus mode on / off" }
"button:Select" = { text = "Pause, speed" }

[[profiles.guide.merged]]
inputs = ["button:DpadLeft", "button:DpadRight"]
text = "Rotate the view"

[[profiles.guide.custom]]
inputs = ["button:LeftBumper", "button:RightBumper"]
text = "Set a control group"

