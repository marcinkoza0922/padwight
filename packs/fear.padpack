format = 18
macros = []
overlay_font = "Rajdhani"

[pack]
id = "440bc3de-a490-4318-b4d5-b11e53597dfe"
name = "F.E.A.R."
version = "2.0"
author = "Padwight"
description = "F.E.A.R. (2005) and its expansions on an Xbox-style pad, for the game's default keys. A uses, B jumps, RT fires, X reloads, Y throws a grenade, L3 toggles crouch, R3 is melee, and LT zooms. Hold LB for the weapon and grenade ring, aiming with the right stick, and double tap LB to holster. RB is slow-mo, D-pad left and right lean, and up and down are the flashlight and med kit. Start is the menu and backs out of every screen; double tap it to quick save, hold it to quick load. Gyro and flick stick profiles are included to try."
made_with = "Xbox controller"

[[rules]]
kind = "executable"
value = "FEAR.exe"
profile = "F.E.A.R."

[[rules]]
kind = "executable"
value = "FEARXP.exe"
profile = "F.E.A.R."

[[rules]]
kind = "executable"
value = "FEARXP2.exe"
profile = "F.E.A.R."

[[rules]]
kind = "steam_app_id"
value = "21090"
profile = "F.E.A.R."

[[profiles]]
name = "F.E.A.R."
combos = []
combo_window_ms = 120
tap_window_ms = 250
long_press_ms = 500

[profiles.buttons]
South = { keys = ["KEY_F"] }
East = { keys = ["KEY_SPACE"] }
West = { keys = ["KEY_R"] }
North = { keys = ["KEY_G"] }
LeftBumper = { open_menu = "Weapons" }
RightBumper = { keys = ["KEY_LEFTCTRL"] }
Select = { keys = ["KEY_TAB"] }
Start = { keys = ["KEY_ESC"] }
Guide = { mode = "Guide" }
LeftStick = { toggle = { action = { keys = ["KEY_C"] } } }
RightStick = { mouse = "Right" }
DpadUp = { keys = ["KEY_X"] }
DpadDown = { keys = ["KEY_Z"] }
DpadLeft = { keys = ["KEY_Q"] }
DpadRight = { keys = ["KEY_E"] }

[profiles.gestures.LeftBumper.double_tap]
keys = ["KEY_H"]

[profiles.gestures.Select.long_press]
keys = ["KEY_M"]

[profiles.gestures.Start.double_tap]
keys = ["KEY_F5"]

[profiles.gestures.Start.long_press]
keys = ["KEY_F9"]

[profiles.left_stick]
deadzone = 0.12
curve = 1.0
key_threshold = 0.25

[profiles.left_stick.action.keys]
up = "KEY_W"
down = "KEY_S"
left = "KEY_A"
right = "KEY_D"

[profiles.right_stick]
deadzone = 0.1
curve = 1.8
key_threshold = 0.5

[profiles.right_stick.action.mouse]
speed = 1100.0
accel = 0.2

[profiles.left_trigger.action.button]
threshold = 0.4
action = { multi = [{ layer = "Zoom" }, { keys = ["KEY_LEFTSHIFT"] }] }

[profiles.right_trigger.action.button]
threshold = 0.3
action = { mouse = "Left" }

[profiles.guide]
notes = '''
Start (Escape) opens the game's menu and backs out of every screen in it.
Hold LB for the weapon and grenade ring, aiming with the right stick. Double tap LB, or pick Holster on the ring, to put the weapon away.
RB is slow-mo.
L3 toggles crouch, and it stays on until you click it again.
Hold LT to zoom. The right stick turns more slowly while it is held.
Quick save is a double tap of Start, and quick load is a long press of Start.
Select (Tab) shows the status screen. Hold Select for the mission screen, which is also on M.'''

[profiles.guide.edits]
"stick:Left" = { text = "Move" }
"stick:Right" = { text = "Look" }
"trigger:Right" = { text = "Fire" }
"trigger:Left" = { text = "Zoom" }
"button:South" = { text = "Use / pick up" }
"button:East" = { text = "Jump" }
"button:West" = { text = "Reload" }
"button:North" = { text = "Throw grenade" }
"button:LeftBumper" = { text = "Hold: weapons, grenades" }
"gesture:button:LeftBumper:double_tap" = { text = "Holster" }
"button:RightBumper" = { text = "Slow-mo" }
"button:LeftStick" = { text = "Crouch (toggle)" }
"button:RightStick" = { text = "Melee" }
"button:DpadUp" = { text = "Flashlight" }
"button:DpadDown" = { text = "Med kit" }
"button:Select" = { text = "Status · hold: mission" }
"button:Start" = { text = "Menu / back out" }
"gesture:button:Start:double_tap" = { text = "Quick save" }
"gesture:button:Start:long_press" = { text = "Quick load" }

[[profiles.guide.merged]]
inputs = ["button:DpadLeft", "button:DpadRight"]
text = "Lean"

