format = 20
macros = []
overlay_font = "Rajdhani"

[pack]
id = "a0c985e5-8d49-4888-b0a3-db4276f0e9f5"
name = "Insurgency"
version = "1.0"
author = "Padwight"
description = "Insurgency (2014) on an Xbox-style pad, for the game's default keys. A uses and, held, sprints; B jumps, X reloads, Y takes out explosives, RT fires and LT aims down the sights. A light push of the left stick walks, L3 toggles crouch and a long press goes prone. Hold LB for the weapon ring, RB changes fire mode (hold it to talk), the D-pad leans and switches weapons, and Select holds the scoreboard. The game's own controller config is a console hack, so the pad plays it as keyboard and mouse. Gyro and flick stick profiles are included to try."
made_with = "Xbox controller"

[[rules]]
kind = "steam_app_id"
value = "222880"
profile = "Insurgency"

[[rules]]
kind = "executable"
value = "insurgency.exe"
profile = "Insurgency"

[[rules]]
kind = "executable"
value = "insurgency_BE.exe"
profile = "Insurgency"

[[rules]]
kind = "executable"
value = "insurgency_linux"
profile = "Insurgency"

[[profiles]]
name = "Insurgency"
combos = []
combo_window_ms = 120
tap_window_ms = 250
long_press_ms = 300

[profiles.buttons]
Guide = { mode = "Guide" }
South = { keys = ["KEY_F"] }
East = { keys = ["KEY_SPACE"] }
West = { keys = ["KEY_R"] }
North = { keys = ["KEY_3"] }
LeftBumper = { open_menu = "Weapons" }
RightBumper = { keys = ["KEY_X"] }
LeftStick = { toggle = { action = { keys = ["KEY_C"] } } }
Select = { keys = ["KEY_TAB"] }
Start = { keys = ["KEY_ESC"] }
DpadUp = { wheel = "Up" }
DpadDown = { wheel = "Down" }
DpadLeft = { keys = ["KEY_Q"] }
DpadRight = { keys = ["KEY_E"] }

[profiles.gestures.South]
long_press = { keys = ["KEY_LEFTSHIFT"] }

[profiles.gestures.LeftStick]
long_press = { keys = ["KEY_Z"] }

[profiles.gestures.RightBumper]
long_press = { keys = ["KEY_V"] }

[profiles.left_stick]
deadzone = 0.12
curve = 1.0
key_threshold = 0.25

[profiles.left_stick.action.ring]
sectors = 8
start_angle = 0.0
inner_radius = 0.25
hysteresis = 0.1

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_W"]

[[profiles.left_stick.action.ring.actions]]
multi = [{ keys = ["KEY_W"] }, { keys = ["KEY_D"] }]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_D"]

[[profiles.left_stick.action.ring.actions]]
multi = [{ keys = ["KEY_S"] }, { keys = ["KEY_D"] }]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_S"]

[[profiles.left_stick.action.ring.actions]]
multi = [{ keys = ["KEY_S"] }, { keys = ["KEY_A"] }]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_A"]

[[profiles.left_stick.action.ring.actions]]
multi = [{ keys = ["KEY_W"] }, { keys = ["KEY_A"] }]

[[profiles.left_stick.zones]]
min = 0.0
max = 0.6
action = { keys = ["KEY_LEFTALT"] }

[profiles.right_stick]
deadzone = 0.08
curve = 2.0
key_threshold = 0.5

[profiles.right_stick.action.mouse]
speed = 2400.0
accel = 0.2

[profiles.left_trigger.action.button]
threshold = 0.4
action = { multi = [{ layer = "Aim" }, { mouse = "Right" }] }

[profiles.right_trigger.action.button]
threshold = 0.3
action = { mouse = "Left" }

[profiles.guide]
notes = '''{start} (Escape) opens the game's menu and closes the other screens.
Hold {lt} to aim down the sights; the game must have aiming set to hold, not toggle. The right stick turns more finely while it's held, and holding {south} while aiming steadies your aim.
{south} uses and picks up; hold {south} to sprint. {east} jumps, {west} reloads, {north} takes out your explosives. A light push of the left stick {ls} walks.
{l3} toggles crouch, and a long press of {l3} goes prone. {left} and {right} lean.
Hold {lb} for the weapon ring, aiming with the right stick {rs}. {up} and {down} step through your weapons. {rb} changes fire mode; hold {rb} to talk on voice chat (V).
Hold {select} for the scoreboard. To chat, open the on-screen keyboard with {guide} + {west} and press Y (all) or U (team).
Servers: BattlEye was removed from the game in December 2025, and VAC sees the pad as an ordinary keyboard and mouse. Don't use the game's {i}exec controller{/i} config at the same time: the two would fight.
These keys are written from memory and not checked in the game (walk, fire mode, prone and voice especially). Compare them with Options → Controls and change the buttons here to match. The gyro's real-world turn assumes a mouse sensitivity of 3; set the full turn to 16364 divided by your sensitivity.'''

[profiles.guide.edits]
"stick:Left" = { text = "Move · light push: walk" }
"stick:Right" = { text = "Look" }
"trigger:Right" = { text = "Fire" }
"trigger:Left" = { text = "{icon:scope} Aim" }
"button:South" = { text = "Use" }
"gesture:button:South:long_press" = { text = "Sprint (hold)" }
"button:East" = { text = "Jump" }
"button:West" = { text = "Reload" }
"button:North" = { text = "{icon:grenade} Explosives" }
"button:LeftBumper" = { text = "Hold: weapons" }
"button:RightBumper" = { text = "Fire mode" }
"gesture:button:RightBumper:long_press" = { text = "{icon:microphone} Voice" }
"button:LeftStick" = { text = "Crouch (toggle)" }
"gesture:button:LeftStick:long_press" = { text = "Prone" }
"button:Select" = { text = "Scoreboard" }
"button:Start" = { text = "Menu" }

[[profiles.guide.merged]]
inputs = ["button:DpadLeft", "button:DpadRight"]
text = "Lean"

[[profiles.guide.merged]]
inputs = ["button:DpadUp", "button:DpadDown"]
text = "Previous / next weapon"

