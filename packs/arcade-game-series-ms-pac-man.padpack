format = 20
macros = []
overlay_font = "Silkscreen"

[pack]
id = "27b573b3-5d19-5651-89c9-10dc1682f12d"
name = "Arcade Game Series: Ms. Pac-Man"
version = "1.0"
author = "Padwight"
description = "Arcade Game Series: Ms. Pac-Man on an Xbox-style pad. The left stick and D-pad walk on the arrow keys; A starts and confirms."
made_with = "Xbox controller"

[[rules]]
kind = "steam_app_id"
value = "403410"
profile = "Arcade Game Series: Ms. Pac-Man"

[[rules]]
kind = "executable"
value = "ms. pac-man.exe"
profile = "Arcade Game Series: Ms. Pac-Man"

[[profiles]]
name = "Arcade Game Series: Ms. Pac-Man"
combos = []
combo_window_ms = 120
tap_window_ms = 250
long_press_ms = 500

[profiles.buttons]
Guide = {mode = "Guide"}
South = {keys = ["KEY_ENTER"]}
East = {keys = ["KEY_ESC"]}
DpadUp = {keys = ["KEY_UP"]}
DpadDown = {keys = ["KEY_DOWN"]}
Start = {keys = ["KEY_ESC"]}
DpadLeft = {keys = ["KEY_LEFT"]}
DpadRight = {keys = ["KEY_RIGHT"]}

[profiles.left_stick]
deadzone = 0.15
curve = 1.0
key_threshold = 0.35

[profiles.left_stick.action.ring]
sectors = 8
start_angle = 0.0
inner_radius = 0.35
hysteresis = 0.1

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_UP"]

[[profiles.left_stick.action.ring.actions]]
multi = [{ keys = ["KEY_UP"] }, { keys = ["KEY_RIGHT"] }]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_RIGHT"]

[[profiles.left_stick.action.ring.actions]]
multi = [{ keys = ["KEY_DOWN"] }, { keys = ["KEY_RIGHT"] }]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_DOWN"]

[[profiles.left_stick.action.ring.actions]]
multi = [{ keys = ["KEY_DOWN"] }, { keys = ["KEY_LEFT"] }]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_LEFT"]

[[profiles.left_stick.action.ring.actions]]
multi = [{ keys = ["KEY_UP"] }, { keys = ["KEY_LEFT"] }]

[profiles.right_stick]
deadzone = 0.12
curve = 1.7
key_threshold = 0.5

[profiles.right_stick.action.mouse]
speed = 1400.0
accel = 0.3

[profiles.left_trigger.action.button]
threshold = 0.4
action = {mouse = "Right"}

[profiles.right_trigger.action.button]
threshold = 0.3
action = {mouse = "Left"}

[profiles.gyro]
enabled = false
horizontal = "yaw"
invert_x = false
invert_y = false
noise_threshold = 1.0

[profiles.guide]
notes = '''The left stick {ls} and the D-pad move on the arrow keys. {south} starts and confirms, {east} backs out, and {start} opens the menu.
Buttons: {south} Start / confirm; {east} Back; {up} Up; {down} Down; {start} Menu; {left} Left; {right} Right.
Steam and the wiki list no controller support, though the other Arcade Game Series games have it; the pad sends the arrow keys and Enter, the usual arcade keys, not checked on an install. Keys are the game's defaults as remembered, not read from an install; if one doesn't answer, check the game's controls options and change the buttons here to match. The Windows executable is from Discord's list. The game has no controller support, so the pad sends keyboard keys.
Typing a name or text: {guide} + {west} opens the on-screen keyboard.'''

[profiles.guide.edits]
"stick:Left" = {text = "Move"}
"stick:Right" = {text = "Pointer"}
"trigger:Right" = {text = "Left click"}
"trigger:Left" = {text = "Right click"}
"button:South" = {text = "Start / confirm"}
"button:East" = {text = "Back"}
"button:DpadUp" = {text = "Up"}
"button:DpadDown" = {text = "Down"}
"button:Start" = {text = "Menu"}
"button:DpadLeft" = {text = "Left"}
"button:DpadRight" = {text = "Right"}



