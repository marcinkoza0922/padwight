format = 20
macros = []
overlay_font = "Comfortaa"

[pack]
id = "c1c5f55b-844a-4d5f-8773-b95e5b9cbb8c"
name = "Unturned"
version = "1.0"
author = "Padwight"
description = "Unturned on an Xbox-style pad, for the game's default keys. A interacts and, held, sprints; B jumps, X reloads, RT uses or fires what you hold and LT aims. L3 toggles crouch and a long press goes prone. Hold LB for the hotbar ring, RB changes fire mode and Y opens gestures. The D-pad leans and switches the tactical light and night vision. Select opens the dashboard with your inventory, crafting, skills and map. The game has no controller support. Gyro and flick stick profiles are included to try."
made_with = "Xbox controller"

[[rules]]
kind = "steam_app_id"
value = "304930"
profile = "Unturned"

[[rules]]
kind = "executable"
value = "Unturned.exe"
profile = "Unturned"

[[rules]]
kind = "executable"
value = "Unturned_BE.exe"
profile = "Unturned"

[[rules]]
kind = "executable"
value = "Unturned.x86_64"
profile = "Unturned"

[[profiles]]
name = "Unturned"
combos = []
combo_window_ms = 120
tap_window_ms = 250
long_press_ms = 300

[profiles.buttons]
Guide = { mode = "Guide" }
South = { keys = ["KEY_F"] }
East = { keys = ["KEY_SPACE"] }
West = { keys = ["KEY_R"] }
North = { keys = ["KEY_C"] }
LeftBumper = { open_menu = "Hotbar" }
RightBumper = { keys = ["KEY_V"] }
LeftStick = { toggle = { action = { keys = ["KEY_X"] } } }
Select = { keys = ["KEY_TAB"] }
Start = { keys = ["KEY_ESC"] }
DpadUp = { keys = ["KEY_T"] }
DpadDown = { keys = ["KEY_N"] }
DpadLeft = { keys = ["KEY_Q"] }
DpadRight = { keys = ["KEY_E"] }

[profiles.gestures.South]
long_press = { keys = ["KEY_LEFTSHIFT"] }

[profiles.gestures.LeftStick]
long_press = { keys = ["KEY_Z"] }

[profiles.left_stick]
deadzone = 0.12
curve = 1.0
key_threshold = 0.25

[profiles.left_stick.action.ring]
sectors = 8
start_angle = 0.0
inner_radius = 0.25
hysteresis = 0.1

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_W"]

[[profiles.left_stick.action.ring.actions]]
multi = [{ keys = ["KEY_W"] }, { keys = ["KEY_D"] }]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_D"]

[[profiles.left_stick.action.ring.actions]]
multi = [{ keys = ["KEY_S"] }, { keys = ["KEY_D"] }]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_S"]

[[profiles.left_stick.action.ring.actions]]
multi = [{ keys = ["KEY_S"] }, { keys = ["KEY_A"] }]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_A"]

[[profiles.left_stick.action.ring.actions]]
multi = [{ keys = ["KEY_W"] }, { keys = ["KEY_A"] }]

[profiles.right_stick]
deadzone = 0.08
curve = 2.0
key_threshold = 0.5

[profiles.right_stick.action.mouse]
speed = 3500.0
accel = 0.2

[profiles.left_trigger.action.button]
threshold = 0.4
action = { multi = [{ layer = "Aim" }, { mouse = "Right" }] }

[profiles.right_trigger.action.button]
threshold = 0.3
action = { mouse = "Left" }

[profiles.guide]
notes = '''{start} (Escape) opens the game's menu and closes the dashboard and other screens.
Hold {lt} to aim. The right stick turns more finely while it's held.
{south} picks up, opens and drives; hold {south} to sprint while you move. {east} jumps, {west} reloads, {rt} uses or fires what's in your hands.
{l3} toggles crouch, and a long press of {l3} goes prone. Unturned has no walk key, so the left stick moves at one speed.
Hold {lb} for the hotbar ring, aiming with the right stick {rs}. {rb} changes fire mode, {north} opens gestures, {left} and {right} lean, {up} switches a gun's light or laser and {down} night vision.
{select} (Tab) opens the dashboard: inventory, crafting, skills, map, quests and players. Typing a sign or chat: {guide} + {west} opens the on-screen keyboard.
Servers: many servers run BattlEye. The pad reaches the game as an ordinary keyboard and mouse, so it isn't flagged, but don't add rapid-fire macros on a server. The world saves itself, so there's no quick save.
These keys are written from memory and not checked in the game (crouch, prone, fire mode, gestures and the tactical and night vision keys especially). Compare them with the game's Options → Controls and change the buttons here to match. The gyro's real-world turn is a guess; adjust it in Quick settings until a full turn of the controller turns you all the way round.'''

[profiles.guide.edits]
"stick:Left" = { text = "Move" }
"stick:Right" = { text = "Look" }
"trigger:Right" = { text = "Use / fire" }
"trigger:Left" = { text = "{icon:scope} Aim" }
"button:South" = { text = "Interact" }
"gesture:button:South:long_press" = { text = "Sprint (hold)" }
"button:East" = { text = "Jump" }
"button:West" = { text = "Reload" }
"button:North" = { text = "Gestures" }
"button:LeftBumper" = { text = "Hold: hotbar" }
"button:RightBumper" = { text = "Fire mode" }
"button:LeftStick" = { text = "Crouch (toggle)" }
"gesture:button:LeftStick:long_press" = { text = "Prone" }
"button:DpadUp" = { text = "{icon:flashlight} Light / laser" }
"button:DpadDown" = { text = "{icon:eye} Night vision" }
"button:Select" = { text = "{icon:bag} Dashboard" }
"button:Start" = { text = "Menu" }

[[profiles.guide.merged]]
inputs = ["button:DpadLeft", "button:DpadRight"]
text = "Lean"

