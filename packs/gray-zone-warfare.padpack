format = 20
macros = []
overlay_font = "Titillium Web"

[pack]
id = "3b9c0cf2-d9e7-4d3a-bc1f-3f97a5536a38"
name = "Gray Zone Warfare"
version = "1.0"
author = "Padwight"
description = "Gray Zone Warfare on an Xbox-style pad, for the game's default keys. A interacts and, held, sprints, B jumps, X reloads (hold it for the fire mode), Y switches the weapon light (hold it for night vision), RT fires and LT aims down the sights. L3 crouches (hold it to go prone), LB holds a weapon ring and RB throws a grenade, the D-pad leans, and Select opens the inventory (hold it for the map). The game has no controller support. Gyro and flick stick profiles are included to try."
made_with = "Xbox controller"

[[rules]]
kind = "steam_app_id"
value = "2479810"
profile = "Gray Zone Warfare"

[[rules]]
kind = "executable"
value = "GZWClientSteam-Win64-Shipping.exe"
profile = "Gray Zone Warfare"

[[profiles]]
name = "Gray Zone Warfare"
combos = []
combo_window_ms = 120
tap_window_ms = 250
long_press_ms = 300

[profiles.buttons]
Guide = { mode = "Guide" }
South = { keys = ["KEY_F"] }
East = { keys = ["KEY_SPACE"] }
West = { keys = ["KEY_R"] }
North = { keys = ["KEY_L"] }
LeftBumper = { open_menu = "Weapons" }
RightBumper = { keys = ["KEY_G"] }
LeftStick = { keys = ["KEY_C"] }
RightStick = { keys = ["KEY_V"] }
Select = { keys = ["KEY_TAB"] }
Start = { keys = ["KEY_ESC"] }
DpadUp = { wheel = "Up" }
DpadDown = { wheel = "Down" }
DpadLeft = { keys = ["KEY_Q"] }
DpadRight = { keys = ["KEY_E"] }

[profiles.gestures.South]
long_press = { keys = ["KEY_LEFTSHIFT"] }

[profiles.gestures.West]
long_press = { keys = ["KEY_B"] }

[profiles.gestures.North]
long_press = { keys = ["KEY_N"] }

[profiles.gestures.LeftStick]
long_press = { keys = ["KEY_Z"] }

[profiles.gestures.Select]
long_press = { keys = ["KEY_M"] }

[profiles.left_stick]
deadzone = 0.12
curve = 1.0
key_threshold = 0.25

[profiles.left_stick.action.ring]
sectors = 8
start_angle = 0.0
inner_radius = 0.25
hysteresis = 0.1

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_W"]

[[profiles.left_stick.action.ring.actions]]
multi = [{ keys = ["KEY_W"] }, { keys = ["KEY_D"] }]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_D"]

[[profiles.left_stick.action.ring.actions]]
multi = [{ keys = ["KEY_S"] }, { keys = ["KEY_D"] }]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_S"]

[[profiles.left_stick.action.ring.actions]]
multi = [{ keys = ["KEY_S"] }, { keys = ["KEY_A"] }]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_A"]

[[profiles.left_stick.action.ring.actions]]
multi = [{ keys = ["KEY_W"] }, { keys = ["KEY_A"] }]

[profiles.right_stick]
deadzone = 0.08
curve = 2.0
key_threshold = 0.5

[profiles.right_stick.action.mouse]
speed = 1150.0
accel = 0.2

[profiles.left_trigger.action.button]
threshold = 0.4
action = { multi = [{ layer = "Aim" }, { mouse = "Right" }] }

[profiles.right_trigger.action.button]
threshold = 0.3
action = { mouse = "Left" }

[profiles.guide]
notes = '''{start} (Escape) opens the game's menu and closes the inventory and the map. The game saves on the server, so there's no quick save.
{south} interacts: loot, open doors, talk to vendors, board the helicopter. Hold {south} to sprint. {east} jumps and vaults. {west} reloads and a long press of {west} switches the fire mode. {north} switches the weapon light or laser, and a long press of {north} lowers or raises night vision.
Hold {lt} to aim down the sights. The right stick turns more finely while it's held.
{l3} crouches and a long press of {l3} goes prone. {r3} is melee. {left} and {right} lean while held, and {up} and {down} turn the mouse wheel to step through weapons and pick options in the interaction list.
Hold {lb} for the weapon ring, aiming with the right stick {rs}: primary, second primary, sidearm, melee and grenade. {rb} throws a grenade.
{select} opens the inventory, and a long press of {select} the map. In the inventory and map the right stick moves the pointer, {rt} clicks and {lt} right-clicks; drag items by holding {rt}.
Chat needs typing: open the on-screen keyboard with {guide} + {west}.
The game uses Easy Anti-Cheat; the pad reaches it as an ordinary keyboard and mouse.
These keys are written from memory and not checked in the game (fire mode, weapon light, night vision, grenade, melee, prone and the weapon slots especially). Compare them with Settings → Controls and change the buttons here to match. The executable name comes from Discord's detection list, which keeps it under a Win64 folder. The gyro's real-world turn of 8000 pixels at the default mouse sensitivity is guessed, not measured.'''

[profiles.guide.edits]
"stick:Left" = { text = "Move" }
"stick:Right" = { text = "Look" }
"trigger:Right" = { text = "Fire" }
"trigger:Left" = { text = "{icon:scope} Aim" }
"button:South" = { text = "{icon:hand} Interact" }
"gesture:button:South:long_press" = { text = "Sprint (hold)" }
"button:East" = { text = "Jump · vault" }
"button:West" = { text = "Reload" }
"gesture:button:West:long_press" = { text = "Fire mode" }
"button:North" = { text = "{icon:flashlight} Weapon light" }
"gesture:button:North:long_press" = { text = "{icon:eye} Night vision" }
"button:LeftBumper" = { text = "Hold: weapons" }
"button:RightBumper" = { text = "{icon:grenade} Grenade" }
"button:LeftStick" = { text = "Crouch" }
"gesture:button:LeftStick:long_press" = { text = "Prone" }
"button:RightStick" = { text = "{icon:dagger} Melee" }
"button:Select" = { text = "{icon:bag} Inventory" }
"gesture:button:Select:long_press" = { text = "{icon:map} Map" }
"button:Start" = { text = "Menu" }

[[profiles.guide.merged]]
inputs = ["button:DpadLeft", "button:DpadRight"]
text = "Lean"

[[profiles.guide.merged]]
inputs = ["button:DpadUp", "button:DpadDown"]
text = "Scroll"

