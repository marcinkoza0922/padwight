format = 20
macros = []
overlay_font = "Rajdhani"

[pack]
id = "315b4c26-d210-4fcd-bb5b-028787ce1d68"
name = "Rising Storm 2: Vietnam"
version = "1.0"
author = "Padwight"
description = "Rising Storm 2: Vietnam on an Xbox-style pad, for the game's default keys. A uses and, held, sprints, B jumps and vaults, X reloads (hold it for the fire mode), Y switches weapons (hold it to fix the bayonet), RT fires and LT aims down the sights. L3 crouches (hold it to go prone), R3 is melee, the D-pad leans and opens the map, and LB holds a weapon ring. Select holds the scoreboard. The game has no controller support. Gyro and flick stick profiles are included to try."
made_with = "Xbox controller"

[[rules]]
kind = "steam_app_id"
value = "418460"
profile = "Rising Storm 2: Vietnam"

[[rules]]
kind = "executable"
value = "VNGame.exe"
profile = "Rising Storm 2: Vietnam"

[[profiles]]
name = "Rising Storm 2: Vietnam"
combos = []
combo_window_ms = 120
tap_window_ms = 250
long_press_ms = 300

[profiles.buttons]
Guide = { mode = "Guide" }
South = { keys = ["KEY_F"] }
East = { keys = ["KEY_SPACE"] }
West = { keys = ["KEY_R"] }
North = { wheel = "Down" }
LeftBumper = { open_menu = "Weapons" }
RightBumper = { keys = ["KEY_3"] }
LeftStick = { keys = ["KEY_C"] }
RightStick = { keys = ["KEY_V"] }
Select = { keys = ["KEY_TAB"] }
Start = { keys = ["KEY_ESC"] }
DpadUp = { keys = ["KEY_M"] }
DpadLeft = { keys = ["KEY_Q"] }
DpadRight = { keys = ["KEY_E"] }

[profiles.gestures.South]
long_press = { keys = ["KEY_LEFTSHIFT"] }

[profiles.gestures.West]
long_press = { keys = ["KEY_X"] }

[profiles.gestures.North]
long_press = { keys = ["KEY_B"] }

[profiles.gestures.LeftStick]
long_press = { keys = ["KEY_Z"] }

[profiles.left_stick]
deadzone = 0.12
curve = 1.0
key_threshold = 0.25

[profiles.left_stick.action.ring]
sectors = 8
start_angle = 0.0
inner_radius = 0.25
hysteresis = 0.1

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_W"]

[[profiles.left_stick.action.ring.actions]]
multi = [{ keys = ["KEY_W"] }, { keys = ["KEY_D"] }]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_D"]

[[profiles.left_stick.action.ring.actions]]
multi = [{ keys = ["KEY_S"] }, { keys = ["KEY_D"] }]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_S"]

[[profiles.left_stick.action.ring.actions]]
multi = [{ keys = ["KEY_S"] }, { keys = ["KEY_A"] }]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_A"]

[[profiles.left_stick.action.ring.actions]]
multi = [{ keys = ["KEY_W"] }, { keys = ["KEY_A"] }]

[profiles.right_stick]
deadzone = 0.08
curve = 2.0
key_threshold = 0.5

[profiles.right_stick.action.mouse]
speed = 1150.0
accel = 0.2

[profiles.left_trigger.action.button]
threshold = 0.4
action = { multi = [{ layer = "Aim" }, { mouse = "Right" }] }

[profiles.right_trigger.action.button]
threshold = 0.3
action = { mouse = "Left" }

[profiles.guide]
notes = '''{start} (Escape) opens the game's menu and backs out of its screens. Matches are online only, so there's no saving.
{south} uses: resupply ammo, pick up weapons, man a gun or a radio. Hold {south} to sprint, and while aiming hold it to hold your breath. {east} jumps and vaults over cover. {west} reloads and a long press of {west} switches the fire mode. {north} switches to the next weapon and a long press of {north} fixes or removes the bayonet.
Hold {lt} to aim down the sights; set iron sights to hold in the game's options. The right stick turns more finely while it's held.
{l3} crouches and a long press of {l3} goes prone; both stay until you press again. {r3} is a melee strike with the rifle butt or bayonet.
Hold {lb} for the weapon ring, aiming with the right stick {rs}: primary, sidearm, grenades, explosives and equipment. {rb} takes out grenades straight away; throw with {rt}.
{left} and {right} lean while held. {up} opens the overhead map, and holding {select} shows the scoreboard.
Chat and squad orders need typing or the game's own keys: open the on-screen keyboard with {guide} + {west}. Voice chat is a held key; bind it to a spare button if you need it.
The game uses Easy Anti-Cheat; the pad reaches it as an ordinary keyboard and mouse.
These are the game's default keys, written from memory and not checked in the game (fire mode, bayonet, prone, melee, the map and the weapon slots especially). Compare them with Options → Controls and change the buttons here to match. The executable name comes from Discord's detection list. The gyro's real-world turn of 8000 pixels at the default mouse sensitivity is guessed, not measured.'''

[profiles.guide.edits]
"stick:Left" = { text = "Move" }
"stick:Right" = { text = "Look" }
"trigger:Right" = { text = "Fire" }
"trigger:Left" = { text = "{icon:scope} Aim" }
"button:South" = { text = "{icon:hand} Use" }
"gesture:button:South:long_press" = { text = "Sprint · hold breath" }
"button:East" = { text = "Jump · vault" }
"button:West" = { text = "Reload" }
"gesture:button:West:long_press" = { text = "Fire mode" }
"button:North" = { text = "{icon:rifle} Next weapon" }
"gesture:button:North:long_press" = { text = "{icon:dagger} Bayonet" }
"button:LeftBumper" = { text = "Hold: weapons" }
"button:RightBumper" = { text = "{icon:grenade} Grenades" }
"button:LeftStick" = { text = "Crouch" }
"gesture:button:LeftStick:long_press" = { text = "Prone" }
"button:RightStick" = { text = "{icon:fist} Melee" }
"button:DpadUp" = { text = "{icon:map} Map" }
"button:Select" = { text = "Scoreboard" }
"button:Start" = { text = "Menu" }

[[profiles.guide.merged]]
inputs = ["button:DpadLeft", "button:DpadRight"]
text = "Lean"

