format = 20
macros = []
overlay_font = "VT323"

[pack]
id = "232bdf71-642e-4b8d-bf0d-12e37b193621"
name = "Ultrakill"
version = "1.0"
author = "Padwight"
description = "Ultrakill on an Xbox-style pad. The game has its own controller support, including DualShock 4 and DualSense pads, so the controller passes through untouched. Padwight adds the Guide overlay on top, with the on-screen keyboard and the media controls. Gyro and flick stick profiles are there to try."
made_with = "Xbox controller"

[controllers]
dualshock = true
dualsense = true

[[rules]]
kind = "steam_app_id"
value = "1229490"
profile = "Ultrakill"

[[rules]]
kind = "executable"
value = "ULTRAKILL.exe"
profile = "Ultrakill"

[[profiles]]
name = "Ultrakill"
combos = []
combo_window_ms = 120
tap_window_ms = 250
long_press_ms = 500

[profiles.buttons]
Guide = {mode = "Guide"}
South = {gamepad = "South"}
East = {gamepad = "East"}
North = {gamepad = "North"}
West = {gamepad = "West"}
LeftBumper = {gamepad = "LeftBumper"}
RightBumper = {gamepad = "RightBumper"}
LeftStick = {gamepad = "LeftStick"}
RightStick = {gamepad = "RightStick"}
Select = {gamepad = "Select"}
Start = {gamepad = "Start"}
DpadUp = {gamepad = "DpadUp"}
DpadDown = {gamepad = "DpadDown"}
DpadLeft = {gamepad = "DpadLeft"}
DpadRight = {gamepad = "DpadRight"}

[profiles.left_stick]
deadzone = 0.05
curve = 1.0
key_threshold = 0.3

[profiles.left_stick.action]
gamepad = {stick = "Left", invert_y = false}

[profiles.right_stick]
deadzone = 0.05
curve = 1.0
key_threshold = 0.3

[profiles.right_stick.action]
gamepad = {stick = "Right", invert_y = false}

[profiles.left_trigger]
action = {gamepad = "Left"}

[profiles.right_trigger]
action = {gamepad = "Right"}

[profiles.gyro]
enabled = false
horizontal = "yaw"
invert_x = false
invert_y = false
noise_threshold = 1.0

[profiles.guide]
notes = '''Ultrakill has its own controller support (Xbox, DualShock 4 and DualSense), so the controller goes to the game as it is. The game has no controller remapping, so the buttons are fixed.
The game's own support is partial: a few actions are missing on some levels, its Options menu doesn't navigate well with a pad, and the Sandbox needs the keyboard and mouse. Press {guide} + {rs} for mouse mode to click through those menus, and {guide} to leave it.
{guide} still works over the game: {guide} + {west} opens the on-screen keyboard and {guide} + {lb} the media controls.
If the game stops answering the pad, check that Steam Input or another remapper isn't also running for it.'''

[[profiles]]
name = "Ultrakill + Gyro"
combos = [
    {buttons = ["Select", "Start"], action = "gyro_clutch"},
]
combo_window_ms = 120
tap_window_ms = 250
long_press_ms = 500

[profiles.buttons]
Guide = {mode = "Guide"}
South = {gamepad = "South"}
East = {gamepad = "East"}
North = {gamepad = "North"}
West = {gamepad = "West"}
LeftBumper = {gamepad = "LeftBumper"}
RightBumper = {gamepad = "RightBumper"}
LeftStick = {gamepad = "LeftStick"}
RightStick = {gamepad = "RightStick"}
Select = {gamepad = "Select"}
Start = {gamepad = "Start"}
DpadUp = {gamepad = "DpadUp"}
DpadDown = {gamepad = "DpadDown"}
DpadLeft = {gamepad = "DpadLeft"}
DpadRight = {gamepad = "DpadRight"}

[profiles.gestures.Start]
long_press = "gyro_toggle"

[profiles.gestures.RightStick]
long_press = "gyro_recenter"

[profiles.left_stick]
deadzone = 0.05
curve = 1.0
key_threshold = 0.3

[profiles.left_stick.action]
gamepad = {stick = "Left", invert_y = false}

[profiles.right_stick]
deadzone = 0.05
curve = 1.0
key_threshold = 0.3

[profiles.right_stick.action]
gamepad = {stick = "Right", invert_y = false}

[profiles.left_trigger]
action = {gamepad = "Left"}

[profiles.right_trigger]
action = {gamepad = "Right"}

[profiles.gyro]
horizontal = "player_space"
invert_x = false
invert_y = false
full_turn_px = 6000.0
noise_threshold = 1.0

[profiles.gyro.mode.mouse]
sensitivity = 1.0

[profiles.guide]
notes = '''Hold {select} and {start} together to pause the gyro while you reposition the controller. Hold {start} to switch the gyro off or on, and hold {r3} to recenter it.
Ultrakill has its own controller support (Xbox, DualShock 4 and DualSense), so the controller goes to the game as it is. The game has no controller remapping, so the buttons are fixed.
The game's own support is partial: a few actions are missing on some levels, its Options menu doesn't navigate well with a pad, and the Sandbox needs the keyboard and mouse. Press {guide} + {rs} for mouse mode to click through those menus, and {guide} to leave it.
{guide} still works over the game: {guide} + {west} opens the on-screen keyboard and {guide} + {lb} the media controls.
If the game stops answering the pad, check that Steam Input or another remapper isn't also running for it.'''

[profiles.guide.edits]
"gesture:button:Start:long_press" = { text = "Gyro active / inactive" }
"gesture:button:RightStick:long_press" = { text = "Recenter gyro" }

[[profiles]]
name = "Ultrakill + Flick stick"
combos = [
    {buttons = ["Select", "Start"], action = "gyro_clutch"},
]
combo_window_ms = 120
tap_window_ms = 250
long_press_ms = 500
requires = ["gyro"]

[profiles.buttons]
Guide = {mode = "Guide"}
South = {gamepad = "South"}
East = {gamepad = "East"}
North = {gamepad = "North"}
West = {gamepad = "West"}
LeftBumper = {gamepad = "LeftBumper"}
RightBumper = {gamepad = "RightBumper"}
LeftStick = {gamepad = "LeftStick"}
RightStick = {gamepad = "RightStick"}
Select = {gamepad = "Select"}
Start = {gamepad = "Start"}
DpadUp = {gamepad = "DpadUp"}
DpadDown = {gamepad = "DpadDown"}
DpadLeft = {gamepad = "DpadLeft"}
DpadRight = {gamepad = "DpadRight"}

[profiles.gestures.Start]
long_press = "gyro_toggle"

[profiles.gestures.RightStick]
long_press = "gyro_recenter"

[profiles.left_stick]
deadzone = 0.05
curve = 1.0
key_threshold = 0.3

[profiles.left_stick.action]
gamepad = {stick = "Left", invert_y = false}

[profiles.right_stick]
deadzone = 0.1
curve = 2.0
key_threshold = 0.5

[profiles.right_stick.action.flick]
full_turn_px = 6000.0
flick_threshold = 0.9
flick_time_ms = 100
rotate_smoothing_ms = 0
forward_deadzone = 0.0
vertical = "off"
vertical_speed = 1200.0

[profiles.left_trigger]
action = {gamepad = "Left"}

[profiles.right_trigger]
action = {gamepad = "Right"}

[profiles.gyro]
horizontal = "player_space"
invert_x = false
invert_y = false
full_turn_px = 6000.0
noise_threshold = 1.0

[profiles.gyro.mode.mouse]
sensitivity = 1.0

[profiles.guide]
notes = '''Hold {select} and {start} together to pause the gyro while you reposition the controller. Hold {start} to switch the gyro off or on, and hold {r3} to recenter it.
Flick stick: push the right stick {rs} toward where you want to face and the view turns to it; turn it around the rim to keep turning. The gyro aims up, down and finely.
Ultrakill has its own controller support (Xbox, DualShock 4 and DualSense), so the controller goes to the game as it is. The game has no controller remapping, so the buttons are fixed.
The game's own support is partial: a few actions are missing on some levels, its Options menu doesn't navigate well with a pad, and the Sandbox needs the keyboard and mouse. Press {guide} + {rs} for mouse mode to click through those menus, and {guide} to leave it.
{guide} still works over the game: {guide} + {west} opens the on-screen keyboard and {guide} + {lb} the media controls.
If the game stops answering the pad, check that Steam Input or another remapper isn't also running for it.'''

[profiles.guide.edits]
"gesture:button:Start:long_press" = { text = "Gyro active / inactive" }
"gesture:button:RightStick:long_press" = { text = "Recenter gyro" }

