format = 20
macros = []
overlay_font = "Cinzel"

[pack]
id = "65e416f3-2eed-5171-be6f-dd983f0a22b5"
name = "Final Fantasy XI"
version = "1.0"
author = "Padwight"
description = "Final Fantasy XI on an Xbox-style pad. The pad sends the keyboard keys the game uses: arrows walk, the face buttons confirm and cancel."
made_with = "Xbox controller"

[[rules]]
kind = "steam_app_id"
value = "230330"
profile = "Final Fantasy XI"

[[rules]]
kind = "executable"
value = "pol.exe"
profile = "Final Fantasy XI"

[[profiles]]
name = "Final Fantasy XI"
combos = []
combo_window_ms = 120
tap_window_ms = 250
long_press_ms = 500

[profiles.buttons]
Guide = {mode = "Guide"}
South = {keys = ["KEY_ENTER"]}
East = {keys = ["KEY_ESC"]}
Start = {keys = ["KEY_ESC"]}
West = {keys = ["KEY_TAB"]}
North = {keys = ["KEY_SPACE"]}

[profiles.left_stick]
deadzone = 0.15
curve = 1.0
key_threshold = 0.35

[profiles.left_stick.action.ring]
sectors = 8
start_angle = 0.0
inner_radius = 0.35
hysteresis = 0.1

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_UP"]

[[profiles.left_stick.action.ring.actions]]
multi = [{ keys = ["KEY_UP"] }, { keys = ["KEY_RIGHT"] }]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_RIGHT"]

[[profiles.left_stick.action.ring.actions]]
multi = [{ keys = ["KEY_DOWN"] }, { keys = ["KEY_RIGHT"] }]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_DOWN"]

[[profiles.left_stick.action.ring.actions]]
multi = [{ keys = ["KEY_DOWN"] }, { keys = ["KEY_LEFT"] }]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_LEFT"]

[[profiles.left_stick.action.ring.actions]]
multi = [{ keys = ["KEY_UP"] }, { keys = ["KEY_LEFT"] }]

[profiles.right_stick]
deadzone = 0.12
curve = 1.7
key_threshold = 0.5

[profiles.right_stick.action.mouse]
speed = 1400.0
accel = 0.3

[profiles.left_trigger.action.button]
threshold = 0.4
action = {mouse = "Right"}

[profiles.right_trigger.action.button]
threshold = 0.3
action = {mouse = "Left"}

[profiles.gyro]
enabled = false
horizontal = "yaw"
invert_x = false
invert_y = false
noise_threshold = 1.0

[profiles.guide]
notes = '''The arrow keys move. {south} confirms and targets, {east} cancels, {west} cycles targets, {start} opens the main menu.
Buttons: {south} Confirm / target; {east} Cancel; {start} Menu; {west} Next target; {north} Auto-run.
Released in 2002, before XInput, and its pad support is the old DirectInput kind, so the pad sends keys. The keys are the usual defaults, not checked on an install. Keys are the game's defaults as remembered, not read from an install; if one doesn't answer, check the game's controls options and change the buttons here to match. The Windows executable is from Discord's list. The game predates XInput, so the pad sends the keys its controls use.
Typing a name or text: {guide} + {west} opens the on-screen keyboard.'''

[profiles.guide.edits]
"stick:Left" = {text = "Move"}
"stick:Right" = {text = "Pointer"}
"trigger:Right" = {text = "Left click"}
"trigger:Left" = {text = "Right click"}
"button:South" = {text = "Confirm / target"}
"button:East" = {text = "Cancel"}
"button:Start" = {text = "Menu"}
"button:West" = {text = "Next target"}
"button:North" = {text = "Auto-run"}



