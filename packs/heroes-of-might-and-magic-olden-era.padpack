[motion]
keyboard = "dreamy"
numpad = "dreamy"
menu = "dreamy"
media = "dreamy"
offer = "dreamy"
info = "dreamy"
log = "dreamy"

[sounds.menu]
step = {kind = "glass", volume = 0.06, pitch = 1.1}
pick = {kind = "bell", volume = 0.08}
open = {kind = "chime", volume = 0.06}
close = {kind = "chime", volume = 0.05, pitch = 0.8}

[sounds.numpad]
step = {kind = "glass", volume = 0.06, pitch = 1.1}
pick = {kind = "bell", volume = 0.08}

[sounds.keyboard]
step = {kind = "glass", volume = 0.06, pitch = 1.1}
