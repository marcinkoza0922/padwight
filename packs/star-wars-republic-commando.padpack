"button:RightBumper" = { text = "{icon:eye} Visor mode" }
"button:LeftStick" = { text = "Crouch (toggle)" }
"button:RightStick" = { text = "{icon:scope} Zoom" }
"button:DpadUp" = { text = "{icon:rifle} Blaster" }
