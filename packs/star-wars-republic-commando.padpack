format = 20
macros = []
overlay_font = "Orbitron"

[pack]
id = "59307ba7-5686-472a-bc30-330d219e8816"
name = "Star Wars: Republic Commando"
version = "1.0"
author = "Padwight"
description = "Star Wars: Republic Commando (2005) on an Xbox-style pad, laid out like the Xbox release, for the PC game's default keys. A uses and sends squadmates to markers, B is melee, X reloads, Y jumps, RT fires and LT throws a grenade. LB and RB step through grenade types and visor modes, L3 crouches and R3 zooms. The D-pad picks the blaster, its sniper and anti-armor attachments and the pistol, and holding Select puts the squad orders on the D-pad. Start pauses; double tap it to quick save, hold it to quick load. The game came out before XInput and has no usable controller support. Gyro and flick stick profiles are included to try."
made_with = "Xbox controller"

[[rules]]
kind = "steam_app_id"
value = "6000"
profile = "Star Wars: Republic Commando"

[[rules]]
kind = "executable"
value = "swrepubliccommando.exe"
profile = "Star Wars: Republic Commando"
[[profiles]]
name = "Star Wars: Republic Commando"
combos = [
    {buttons = ["Select", "DpadUp"], action = {keys = ["KEY_F1"]}},
    {buttons = ["Select", "DpadRight"], action = {keys = ["KEY_F2"]}},
    {buttons = ["Select", "DpadDown"], action = {keys = ["KEY_F3"]}},
    {buttons = ["Select", "DpadLeft"], action = {keys = ["KEY_F4"]}},
]
combo_window_ms = 120
tap_window_ms = 250
long_press_ms = 300

[profiles.buttons]
Guide = { mode = "Guide" }
South = { keys = ["KEY_E"] }
East = { keys = ["KEY_F"] }
West = { keys = ["KEY_R"] }
North = { keys = ["KEY_SPACE"] }
LeftBumper = { keys = ["KEY_G"] }
RightBumper = { keys = ["KEY_V"] }
LeftStick = { toggle = { action = { keys = ["KEY_C"] } } }
RightStick = { keys = ["KEY_Z"] }
Select = { open_menu = "Squad" }
Start = { keys = ["KEY_ESC"] }
DpadUp = { keys = ["KEY_2"] }
DpadDown = { keys = ["KEY_1"] }
DpadLeft = { keys = ["KEY_3"] }
DpadRight = { keys = ["KEY_4"] }

[profiles.gestures.DpadUp]
long_press = { keys = ["KEY_5"] }

[profiles.gestures.Start]
double_tap = { keys = ["KEY_F5"] }
long_press = { keys = ["KEY_F9"] }

[profiles.left_stick]
deadzone = 0.12
curve = 1.0
key_threshold = 0.25

[profiles.left_stick.action.ring]
sectors = 8
start_angle = 0.0
inner_radius = 0.25
hysteresis = 0.1

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_W"]

[[profiles.left_stick.action.ring.actions]]
multi = [{ keys = ["KEY_W"] }, { keys = ["KEY_D"] }]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_D"]

[[profiles.left_stick.action.ring.actions]]
multi = [{ keys = ["KEY_S"] }, { keys = ["KEY_D"] }]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_S"]

[[profiles.left_stick.action.ring.actions]]
multi = [{ keys = ["KEY_S"] }, { keys = ["KEY_A"] }]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_A"]

[[profiles.left_stick.action.ring.actions]]
multi = [{ keys = ["KEY_W"] }, { keys = ["KEY_A"] }]

[profiles.right_stick]
deadzone = 0.08
curve = 2.0
key_threshold = 0.5

[profiles.right_stick.action.mouse]
speed = 9600.0
accel = 0.2

[profiles.left_trigger.action.button]
threshold = 0.4
action = { mouse = "Right" }

[profiles.right_trigger.action.button]
threshold = 0.3
action = { mouse = "Left" }

[profiles.guide]
notes = '''{start} (Escape) pauses and backs out of the game's menus. Double tap {start} to quick save (F5) and hold it to quick load (F9).
The buttons follow the Xbox release's layout. {south} uses: open doors, pick up, heal at bacta dispensers, and point at a squad marker to send a squadmate to it. Hold it to do the maneuver yourself or to revive a downed squadmate. {east} is melee (the wrist blade), {west} reloads and {north} jumps. {l3} toggles crouch and {r3} zooms in.
{rt} fires and {lt} throws your grenade; {lb} steps through the grenade types and {rb} through the visor modes.
The D-pad picks your weapon: {up} the DC-17m blaster, {left} its sniper attachment, {right} its anti-armor attachment and {down} the pistol. Hold {up} for the weapon you've picked up.
Hold {select} and press the D-pad for squad orders: {up} search and destroy, {right} form up, {down} secure position and {left} cancel maneuvers. Pressing {select} together with a D-pad direction sends the order at once. On the Xbox you held A for these; here A stays Use, so holding it still revives.
The game has a mouse-only menu and a gamepad mode you can only switch on by editing User.ini; don't turn that on with this setup, or the two would fight. In the menus, {guide} + {rs} moves the mouse.
These are the game's default PC keys, written from memory and not checked in the game (melee, zoom, the grenade and visor keys, the squad order keys and the quick save and load keys especially). Compare them with Options → Controls and change the buttons here to match. The executable rule's name comes from Discord's game list and isn't checked. The gyro's real-world turn assumes Unreal Engine 2's 65536 units a turn at a mouse sensitivity of 3; it is worked out, not measured: set the full turn to 65536 divided by MouseSensitivity in User.ini.'''

[profiles.guide.edits]
"stick:Left" = { text = "Move" }
"stick:Right" = { text = "Look" }
"trigger:Right" = { text = "Fire" }
"trigger:Left" = { text = "{icon:grenade} Throw grenade" }
"button:South" = { text = "{icon:hand} Use · squad marker" }
"button:East" = { text = "{icon:dagger} Melee" }
"button:West" = { text = "Reload" }
"button:North" = { text = "Jump" }
