format = 20
macros = []
overlay_font = "Titillium Web"

[pack]
id = "561c75ff-b98e-57c5-b4eb-e1a778862995"
name = "Factorio"
version = "1.0"
author = "Padwight"
description = "Factorio on an Xbox-style pad. The game has its own controller support, with Xbox, PlayStation and Switch button pictures, so the controller passes through untouched and the game's Controls settings set the buttons. Padwight adds the Guide overlay on top, with the on-screen keyboard for naming stations and the media controls, in the game's colors."
made_with = "Xbox controller"
native_controller = true

[controllers]
dualshock = true
dualsense = true
switch_pro = true

[[rules]]
kind = "executable"
value = "factorio"
profile = "Factorio"

[[rules]]
kind = "executable"
value = "factorio.exe"
profile = "Factorio"

[[rules]]
kind = "steam_app_id"
value = "427520"
profile = "Factorio"

[[profiles]]
name = "Factorio"
combos = []
combo_window_ms = 120
tap_window_ms = 250
long_press_ms = 500

[profiles.buttons]
Guide = {mode = "Guide"}
South = {gamepad = "South"}
East = {gamepad = "East"}
North = {gamepad = "North"}
West = {gamepad = "West"}
LeftBumper = {gamepad = "LeftBumper"}
RightBumper = {gamepad = "RightBumper"}
LeftStick = {gamepad = "LeftStick"}
RightStick = {gamepad = "RightStick"}
Select = {gamepad = "Select"}
Start = {gamepad = "Start"}
DpadUp = {gamepad = "DpadUp"}
DpadDown = {gamepad = "DpadDown"}
DpadLeft = {gamepad = "DpadLeft"}
DpadRight = {gamepad = "DpadRight"}

[profiles.left_stick]
deadzone = 0.05
curve = 1.0
key_threshold = 0.3

[profiles.left_stick.action]
gamepad = {stick = "Left", invert_y = false}

[profiles.right_stick]
deadzone = 0.05
curve = 1.0
key_threshold = 0.3

[profiles.right_stick.action]
gamepad = {stick = "Right", invert_y = false}

[profiles.left_trigger]
action = {gamepad = "Left"}

[profiles.right_trigger]
action = {gamepad = "Right"}

[profiles.gyro]
mode = "off"
horizontal = "yaw"
invert_x = false
invert_y = false
activation = "always"
noise_threshold = 1.0

[profiles.guide]
notes = '''Factorio has its own controller support, so the controller goes to the game as it is. Set the buttons in the game's own Controls settings (Settings → Controls, with the controller in use).
{guide} still works over the game: {guide} + {west} opens the on-screen keyboard for naming train stations and blueprints, and {guide} + {lb} the media controls.
If the game stops answering the pad, check that Steam Input or another remapper isn't also running for it.'''

[keyboard_style]
