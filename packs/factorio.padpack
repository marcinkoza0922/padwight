[motion]
keyboard = "stagger"
numpad = "stagger"
menu = "stagger"
media = "stagger"
offer = "stagger"
info = "stagger"
log = "stagger"

[sounds.menu]
step = {kind = "tick", volume = 0.07}
pick = {kind = "clank", volume = 0.12}

[sounds.keyboard]
step = {kind = "tick", volume = 0.07}
pick = {kind = "keys", volume = 0.2}

[sounds.numpad]
step = {kind = "tick", volume = 0.07}
pick = {kind = "keys", volume = 0.2}

[sounds.media]
pick = {kind = "clank", volume = 0.12}

[rumble.menu]
step = {strength = 0.09, length_ms = 18}
pick = {strength = 0.3, length_ms = 35}

[rumble.keyboard]
