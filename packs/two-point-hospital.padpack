format = 20
macros = []
overlay_font = "Comfortaa"

[pack]
id = "d1e7a3c5-29b8-4f6e-8a04-5b3c9e2f71d6"
name = "Two Point Hospital"
version = "1.0"
author = "Padwight"
description = "Two Point Hospital on an Xbox-style pad. The left stick pans the hospital and the right stick moves the pointer; RT and A click and drag, LT right-clicks to cancel. X rotates what you're placing, Y pauses, RB steps through the speeds (hold it with the D-pad for one), the D-pad turns the camera and zooms. A gyro variant tilts the pointer. Overlays in hospital teal and mint."
made_with = "Xbox controller"

[[rules]]
kind = "steam_app_id"
value = "535930"
profile = "Two Point Hospital"

[[rules]]
kind = "executable"
value = "TPH.exe"
profile = "Two Point Hospital"

[[rules]]
kind = "executable"
value = "TPH.x86_64"
profile = "Two Point Hospital"

[[profiles]]
name = "Two Point Hospital"
combos = []
combo_window_ms = 120
tap_window_ms = 250
long_press_ms = 500

[profiles.buttons]
Guide = {mode = "Guide"}
South = {mouse = "Left"}
East = {keys = ["KEY_ESC"]}
West = {keys = ["KEY_R"]}
North = {keys = ["KEY_SPACE"]}
RightBumper = {cycle = {name = "Game speed"}}
Start = {keys = ["KEY_ESC"]}
DpadUp = {wheel = "Up"}
DpadDown = {wheel = "Down"}
DpadLeft = {keys = ["KEY_Q"]}
DpadRight = {keys = ["KEY_E"]}

[profiles.gestures.RightBumper.long_press]
open_menu = "Speed"

[profiles.left_stick]
deadzone = 0.15
curve = 1.0
key_threshold = 0.35

[profiles.left_stick.action.ring]
sectors = 8
start_angle = 0.0
inner_radius = 0.35
hysteresis = 0.1

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_W"]

[[profiles.left_stick.action.ring.actions]]
multi = [{ keys = ["KEY_W"] }, { keys = ["KEY_D"] }]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_D"]

[[profiles.left_stick.action.ring.actions]]
multi = [{ keys = ["KEY_S"] }, { keys = ["KEY_D"] }]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_S"]

[[profiles.left_stick.action.ring.actions]]
multi = [{ keys = ["KEY_S"] }, { keys = ["KEY_A"] }]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_A"]

[[profiles.left_stick.action.ring.actions]]
multi = [{ keys = ["KEY_W"] }, { keys = ["KEY_A"] }]

[profiles.right_stick]
deadzone = 0.12
curve = 1.7
key_threshold = 0.5

[profiles.right_stick.action.mouse]
speed = 1400.0
accel = 0.3

[profiles.left_trigger.action.button]
threshold = 0.4
action = {mouse = "Right"}

[profiles.right_trigger.action.button]
threshold = 0.3
action = {mouse = "Left"}

[profiles.gyro]
mode = "off"
horizontal = "yaw"
invert_x = false
invert_y = false
noise_threshold = 1.0

[profiles.guide]
notes = '''The right stick {rs} moves the pointer and the left stick {ls} pans the hospital. {rt} or {south} clicks; hold it and drag to mark out a room. {lt} right-clicks to cancel what's in hand or back out of a window.
{west} rotates the object you're placing. {north} pauses. Tap {rb} for the next speed: fast, fastest, then normal again. Press {rb} with the {dpad} for one speed (left normal, up fast, right fastest, down pause); hold {rb} to see them. {left} and {right} turn the camera, {up} and {down} zoom.
{east} and {start} close windows and open the menu. Rooms, staff, the hospital overview and the objectives are on the toolbar along the bottom: point at them.
The PC game has no controller support, so this plays it with the pointer. The console Jumbo Edition built its own pad interface, which can't be copied; the PC keys stay. Panning on WASD, the camera on Q and E and zoom on the wheel are the game's defaults as remembered; rotate on R, pause on Space and the speeds on 1 to 3 are a guess, not read from an install. If one doesn't answer, check Options, Controls (the game can rebind them) and change the buttons here to match. The Windows executable is from Discord's list; the Linux one (TPH.x86_64) is a guess. Naming a hospital or staff: {guide} + {west} opens the on-screen keyboard.'''

[profiles.guide.edits]
"stick:Left" = {text = "Pan"}
"stick:Right" = {text = "Pointer"}
"trigger:Right" = {text = "Click / drag"}
"trigger:Left" = {text = "Right-click (cancel)"}
"button:South" = {text = "Click / drag"}
"button:East" = {text = "Close"}
"button:West" = {text = "{icon:rotate} Rotate object"}
"button:North" = {text = "{icon:pause} Pause"}
"button:RightBumper" = {text = "{icon:speed2} Next speed"}
"gesture:button:RightBumper:long_press" = {text = "Hold: speed menu"}
"button:Start" = {text = "Menu"}
"button:DpadLeft" = {text = "{icon:rotate-left} Turn camera"}
"button:DpadRight" = {text = "{icon:rotate} Turn camera"}

[[profiles.guide.merged]]
inputs = ["button:DpadUp", "button:DpadDown"]
text = "Zoom in / out"


