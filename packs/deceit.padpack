format = 20
macros = []
overlay_font = "Special Elite"

[pack]
id = "1849b2b5-41b1-4ce8-a3a7-c94f28ba707d"
name = "Deceit"
version = "1.0"
author = "Padwight"
description = "Deceit (2017) on an Xbox-style pad, for the game's default keys. A picks up and uses and, held, sprints, B jumps, X reloads, Y is the flashlight, RT fires and LT aims. LB transforms when you're infected, L3 toggles crouch, the D-pad steps through your items and holds voice chat, and Select holds the player list. The game has no controller support. Gyro and flick stick profiles are included to try."
made_with = "Xbox controller"

[[rules]]
kind = "steam_app_id"
value = "466240"
profile = "Deceit"

[[rules]]
kind = "executable"
value = "deceit.exe"
profile = "Deceit"
[[profiles]]
name = "Deceit"
combos = []
combo_window_ms = 120
tap_window_ms = 250
long_press_ms = 250

[profiles.buttons]
Guide = { mode = "Guide" }
South = { keys = ["KEY_E"] }
East = { keys = ["KEY_SPACE"] }
West = { keys = ["KEY_R"] }
North = { keys = ["KEY_F"] }
LeftBumper = { keys = ["KEY_Q"] }
LeftStick = { toggle = { action = { keys = ["KEY_LEFTCTRL"] } } }
Select = { keys = ["KEY_TAB"] }
Start = { keys = ["KEY_ESC"] }
DpadUp = { keys = ["KEY_V"] }
DpadLeft = { wheel = "Up" }
DpadRight = { wheel = "Down" }

[profiles.gestures.South]
long_press = { keys = ["KEY_LEFTSHIFT"] }

[profiles.left_stick]
deadzone = 0.12
curve = 1.0
key_threshold = 0.25

[profiles.left_stick.action.ring]
sectors = 8
start_angle = 0.0
inner_radius = 0.25
hysteresis = 0.1

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_W"]

[[profiles.left_stick.action.ring.actions]]
multi = [{ keys = ["KEY_W"] }, { keys = ["KEY_D"] }]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_D"]

[[profiles.left_stick.action.ring.actions]]
multi = [{ keys = ["KEY_S"] }, { keys = ["KEY_D"] }]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_S"]

[[profiles.left_stick.action.ring.actions]]
multi = [{ keys = ["KEY_S"] }, { keys = ["KEY_A"] }]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_A"]

[[profiles.left_stick.action.ring.actions]]
multi = [{ keys = ["KEY_W"] }, { keys = ["KEY_A"] }]

[profiles.right_stick]
deadzone = 0.08
curve = 2.0
key_threshold = 0.5

[profiles.right_stick.action.mouse]
speed = 3500.0
accel = 0.2

[profiles.left_trigger.action.button]
threshold = 0.4
action = { multi = [{ layer = "Aim" }, { mouse = "Right" }] }

[profiles.right_trigger.action.button]
threshold = 0.3
action = { mouse = "Left" }

[profiles.guide]
notes = '''{start} (Escape) opens the game's menu and closes the other screens.
{south} picks up, uses and drinks blood bags or pours them; hold {south} to sprint. {east} jumps and {l3} toggles crouch. {west} reloads and {north} switches the flashlight on and off.
{rt} fires or attacks, and {lt} aims; the right stick turns more finely while it's held. {left} and {right} step through what you carry.
Infected: {lb} transforms when the lights go out. Hold {select} for the player list, and hold {up} to talk on voice chat if you use push-to-talk. Text chat needs typing: open the on-screen keyboard with {guide} + {west}.
These keys are written from memory and not checked in the game (transform, flashlight, voice and the item keys especially); compare them with Options → Controls and change the buttons here to match. The executable rule's name comes from Discord's game list and isn't checked. Deceit uses Easy Anti-Cheat, which sees the pad as an ordinary keyboard and mouse. The gyro's full turn is a guess, not measured: turn in place and adjust it until a full turn of the controller turns you around once.'''

[profiles.guide.edits]
"stick:Left" = { text = "Move" }
"stick:Right" = { text = "Look" }
"trigger:Right" = { text = "Fire · attack" }
"trigger:Left" = { text = "{icon:scope} Aim" }
"button:South" = { text = "{icon:hand} Use · pick up" }
"gesture:button:South:long_press" = { text = "Sprint (hold)" }
"button:East" = { text = "Jump" }
"button:West" = { text = "Reload" }
"button:North" = { text = "{icon:flashlight} Flashlight" }
"button:LeftBumper" = { text = "{icon:skull} {color:red}Transform{/color}" }
"button:LeftStick" = { text = "Crouch (toggle)" }
"button:DpadUp" = { text = "{icon:microphone} Voice (hold)" }
"button:Select" = { text = "{icon:people} Players" }
"button:Start" = { text = "Menu" }

[[profiles.guide.merged]]
inputs = ["button:DpadLeft", "button:DpadRight"]
text = "Previous / next item"

