format = 20
macros = []
overlay_font = "Bangers"

[pack]
id = "8e6803ca-ed7d-4e8e-b372-9618cc250832"
name = "Bloons TD 6"
version = "1.0"
author = "Padwight"
description = "Bloons TD 6 on an Xbox-style pad, for the game's default hotkeys. The right stick moves the pointer and the left stick nudges it finely; RT and A click, LT right-clicks. Hold LB for a grid of every tower and the hero, hold RB for the abilities. The D-pad buys the three upgrade paths (hold down to sell), Y changes targeting and X starts the round and fast-forwards."
made_with = "Xbox controller"

[[rules]]
kind = "steam_app_id"
value = "960090"
profile = "Bloons TD 6"

[[rules]]
kind = "executable"
value = "BloonsTD6.exe"
profile = "Bloons TD 6"

[[profiles]]
name = "Bloons TD 6"
combos = []
combo_window_ms = 120
tap_window_ms = 250
long_press_ms = 500

[profiles.buttons]
Guide = {mode = "Guide"}
South = {mouse = "Left"}
East = {keys = ["KEY_ESC"]}
West = {keys = ["KEY_SPACE"]}
North = {keys = ["KEY_TAB"]}
LeftBumper = {open_menu = "Towers"}
RightBumper = {open_menu = "Abilities"}
Start = {keys = ["KEY_ESC"]}
DpadLeft = {keys = ["KEY_COMMA"]}
DpadUp = {keys = ["KEY_DOT"]}
DpadRight = {keys = ["KEY_SLASH"]}
DpadDown = "disabled"

[profiles.gestures.DpadDown.long_press]
keys = ["KEY_BACKSPACE"]

[profiles.left_stick]
deadzone = 0.12
curve = 1.6
key_threshold = 0.5

[profiles.left_stick.action.mouse]
speed = 450.0
accel = 0.0

[profiles.right_stick]
deadzone = 0.12
curve = 1.7
key_threshold = 0.5

[profiles.right_stick.action.mouse]
speed = 1500.0
accel = 0.3

[profiles.left_trigger.action.button]
threshold = 0.4
action = {mouse = "Right"}

[profiles.right_trigger.action.button]
threshold = 0.3
action = {mouse = "Left"}

[profiles.gyro]
enabled = false
horizontal = "yaw"
invert_x = false
invert_y = false
noise_threshold = 1.0

[profiles.guide]
notes = '''The right stick {rs} moves the pointer fast and the left stick {ls} slowly, for placing a monkey exactly. {rt} or {south} clicks; {lt} right-clicks to drop the tower in hand.
Hold {lb} for the towers: move with the {dpad} or the left stick {ls} and press {south}, then click where it goes. The rows are primary, military, magic and support, with the hero along the bottom.
Select a placed monkey, then {left} {up} {right} buy the top, middle and bottom upgrade paths. Hold {down} to {color:red}sell{/color} it. {north} changes its targeting.
{west} starts the round and toggles fast forward. Hold {rb} and aim the right stick {rs} for the activated abilities 1 to 0.
{east} deselects, {start} pauses. The tower keys are the game's defaults; if you changed them under Settings → Hotkeys, change the menu too. Media controls: {guide} + {lb}.'''

[profiles.guide.edits]
"stick:Left" = {text = "Fine pointer"}
"stick:Right" = {text = "Pointer"}
"trigger:Right" = {text = "Click (place, select)"}
"trigger:Left" = {text = "Right-click (drop tower)"}
"button:South" = {text = "Click"}
"button:East" = {text = "Deselect"}
"button:West" = {text = "{icon:fast} Go / fast forward"}
"button:North" = {text = "{icon:crosshair} Targeting"}
"button:LeftBumper" = {text = "Hold: {icon:balloon} towers"}
"button:RightBumper" = {text = "Hold: {icon:bolt} abilities"}
"button:Start" = {text = "{icon:pause} Pause"}
"button:DpadLeft" = {text = "{icon:upgrade} Top path"}
"button:DpadUp" = {text = "{icon:upgrade} Middle path"}
"button:DpadRight" = {text = "{icon:upgrade} Bottom path"}
"gesture:button:DpadDown:long_press" = {text = "{icon:coin} {color:red}Sell{/color}"}


[[profiles]]
name = "Bloons TD 6 + Gyro"
combos = [
    {buttons = ["Select", "Start"], action = "gyro_clutch"},
]
combo_window_ms = 120
tap_window_ms = 250
long_press_ms = 500
requires = ["gyro"]

[profiles.buttons]
Guide = {mode = "Guide"}
South = {mouse = "Left"}
East = {keys = ["KEY_ESC"]}
West = {keys = ["KEY_SPACE"]}
North = {keys = ["KEY_TAB"]}
LeftBumper = {open_menu = "Towers"}
RightBumper = {open_menu = "Abilities"}
Start = {keys = ["KEY_ESC"]}
DpadLeft = {keys = ["KEY_COMMA"]}
DpadUp = {keys = ["KEY_DOT"]}
DpadRight = {keys = ["KEY_SLASH"]}
DpadDown = "disabled"

[profiles.gestures.DpadDown.long_press]
keys = ["KEY_BACKSPACE"]

[profiles.left_stick]
deadzone = 0.12
curve = 1.6
key_threshold = 0.5

[profiles.left_stick.action.mouse]
speed = 450.0
accel = 0.0

[profiles.right_stick]
deadzone = 0.12
curve = 1.7
key_threshold = 0.5

[profiles.right_stick.action.mouse]
speed = 1500.0
accel = 0.3

[profiles.left_trigger.action.button]
threshold = 0.4
action = {mouse = "Right"}

[profiles.right_trigger.action.button]
threshold = 0.3
action = {mouse = "Left"}

[profiles.gyro]
horizontal = "yaw"
invert_x = false
invert_y = false
noise_threshold = 1.0

[profiles.gyro.mode.mouse]
sensitivity = 20.0

[profiles.guide]
notes = '''Hold {select} and {start} together to pause the gyro while you reposition the controller. Tilting the controller moves the pointer, as a fine pointer next to the right stick {rs}.
The right stick {rs} moves the pointer fast and the left stick {ls} slowly, for placing a monkey exactly. {rt} or {south} clicks; {lt} right-clicks to drop the tower in hand.
Hold {lb} for the towers: move with the {dpad} or the left stick {ls} and press {south}, then click where it goes. The rows are primary, military, magic and support, with the hero along the bottom.
Select a placed monkey, then {left} {up} {right} buy the top, middle and bottom upgrade paths. Hold {down} to {color:red}sell{/color} it. {north} changes its targeting.
{west} starts the round and toggles fast forward. Hold {rb} and aim the right stick {rs} for the activated abilities 1 to 0.
{east} deselects, {start} pauses. The tower keys are the game's defaults; if you changed them under Settings → Hotkeys, change the menu too. Media controls: {guide} + {lb}.'''

[profiles.guide.edits]
"stick:Left" = {text = "Fine pointer"}
"stick:Right" = {text = "Pointer"}
"trigger:Right" = {text = "Click (place, select)"}
"trigger:Left" = {text = "Right-click (drop tower)"}
"button:South" = {text = "Click"}
"button:East" = {text = "Deselect"}
"button:West" = {text = "{icon:fast} Go / fast forward"}
"button:North" = {text = "{icon:crosshair} Targeting"}
"button:LeftBumper" = {text = "Hold: {icon:balloon} towers"}
"button:RightBumper" = {text = "Hold: {icon:bolt} abilities"}
"button:Start" = {text = "{icon:pause} Pause"}
"button:DpadLeft" = {text = "{icon:upgrade} Top path"}
"button:DpadUp" = {text = "{icon:upgrade} Middle path"}
"button:DpadRight" = {text = "{icon:upgrade} Bottom path"}
"gesture:button:DpadDown:long_press" = {text = "{icon:coin} {color:red}Sell{/color}"}


