format = 20
macros = []
overlay_font = "Inter"

[pack]
id = "5e9a2b17-0c84-4d3f-b6e1-2a7f8c4d9e05"
name = "Prison Architect"
version = "1.0"
author = "Padwight"
description = "Prison Architect on an Xbox-style pad. The left stick pans the prison and the right stick moves the pointer; RT and A click and drag, LT right-clicks to cancel. X rotates, Y pauses, RB steps through the speeds (hold it with the D-pad for one), and the D-pad zooms. Overlays in grey concrete with jumpsuit orange."
made_with = "Xbox controller"

[[rules]]
kind = "steam_app_id"
value = "233450"
profile = "Prison Architect"

[[rules]]
kind = "executable"
value = "Prison Architect.exe"
profile = "Prison Architect"

[[rules]]
kind = "executable"
value = "Prison Architect64.exe"
profile = "Prison Architect"

[[rules]]
kind = "executable"
value = "PrisonArchitect"
profile = "Prison Architect"

[[rules]]
kind = "executable"
value = "PrisonArchitect.x86_64"
profile = "Prison Architect"

[[profiles]]
name = "Prison Architect"
combos = []
combo_window_ms = 120
tap_window_ms = 250
long_press_ms = 500

[profiles.buttons]
Guide = {mode = "Guide"}
South = {mouse = "Left"}
East = {keys = ["KEY_ESC"]}
West = {keys = ["KEY_R"]}
North = {keys = ["KEY_SPACE"]}
RightBumper = {cycle = {name = "Game speed"}}
Start = {keys = ["KEY_ESC"]}
DpadUp = {wheel = "Up"}
DpadDown = {wheel = "Down"}

[profiles.gestures.RightBumper.long_press]
open_menu = "Speed"

[profiles.left_stick]
deadzone = 0.15
curve = 1.0
key_threshold = 0.35

[profiles.left_stick.action.ring]
sectors = 8
start_angle = 0.0
inner_radius = 0.35
hysteresis = 0.1

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_W"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_W"] },
    { keys = ["KEY_D"] },
]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_D"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_S"] },
    { keys = ["KEY_D"] },
]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_S"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_S"] },
    { keys = ["KEY_A"] },
]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_A"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_W"] },
    { keys = ["KEY_A"] },
]

[profiles.right_stick]
deadzone = 0.12
curve = 1.7
key_threshold = 0.5

[profiles.right_stick.action.mouse]
speed = 1400.0
accel = 0.3

[profiles.left_trigger.action.button]
threshold = 0.4
action = {mouse = "Right"}

[profiles.right_trigger.action.button]
threshold = 0.3
action = {mouse = "Left"}

[profiles.gyro]
mode = "off"
horizontal = "yaw"
invert_x = false
invert_y = false
noise_threshold = 1.0

[profiles.guide]
notes = '''The right stick {rs} moves the pointer and the left stick {ls} pans the prison. {rt} or {south} clicks; hold it and drag to lay out walls, rooms and zones. {lt} right-clicks to cancel what's in hand.
{west} rotates the object you're placing. {north} pauses. Tap {rb} for the next speed: fast, fastest, then normal again. Press {rb} with the {dpad} for one speed (left normal, up fast, right fastest, down pause); hold {rb} to see them. {up} and {down} zoom.
{east} and {start} close windows and open the menu. Every other tool (foundations, rooms, deployment, staff, reports, intelligence) is on the toolbar: point at it.
Panning, zoom and R to rotate are the game's defaults; pause on Space and the speeds on 1 to 3 are a guess, not read from an install. The game can't rebind them, so if they don't answer, use the clock's buttons. The console editions had their own interface, which this doesn't copy. Naming a prison or a prisoner: {guide} + {west} opens the on-screen keyboard.'''

[profiles.guide.edits]
"stick:Left" = {text = "Pan"}
"stick:Right" = {text = "Pointer"}
"trigger:Right" = {text = "Click / drag"}
"trigger:Left" = {text = "Right-click (cancel)"}
"button:South" = {text = "Click / drag"}
"button:East" = {text = "Close"}
"button:West" = {text = "{icon:rotate} Rotate"}
"button:North" = {text = "{icon:pause} Pause"}
"button:RightBumper" = {text = "{icon:speed2} Next speed"}
"gesture:button:RightBumper:long_press" = {text = "Hold: speed menu"}
"button:Start" = {text = "Menu"}

[[profiles.guide.merged]]
inputs = ["button:DpadUp", "button:DpadDown"]
text = "Zoom in / out"


