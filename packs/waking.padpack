format = 20
macros = []
overlay_font = "Rajdhani"

[pack]
id = "e80a8b39-d4fb-56ae-bb19-7a58b07ddc2f"
name = "Waking"
version = "1.0"
author = "Padwight"
description = "Waking with its own controller support. The controller passes through to the game untouched; the game's options set the buttons. Padwight adds the Guide overlay in the game's colors."
made_with = "Xbox controller"

[[rules]]
kind = "steam_app_id"
value = "1068600"
profile = "Waking"

[[rules]]
kind = "executable"
value = "waking.exe"
profile = "Waking"

[[profiles]]
name = "Waking"
combos = []
combo_window_ms = 120
tap_window_ms = 250
long_press_ms = 500

[profiles.buttons]
South = {gamepad = "South"}
East = {gamepad = "East"}
North = {gamepad = "North"}
West = {gamepad = "West"}
LeftBumper = {gamepad = "LeftBumper"}
RightBumper = {gamepad = "RightBumper"}
LeftStick = {gamepad = "LeftStick"}
RightStick = {gamepad = "RightStick"}
Select = {gamepad = "Select"}
Start = {gamepad = "Start"}
DpadUp = {gamepad = "DpadUp"}
DpadDown = {gamepad = "DpadDown"}
DpadLeft = {gamepad = "DpadLeft"}
DpadRight = {gamepad = "DpadRight"}
Guide = {mode = "Guide"}

[profiles.left_stick]
deadzone = 0.05
curve = 1.0
key_threshold = 0.3

[profiles.left_stick.action]
gamepad = {stick = "Left", invert_y = false}

[profiles.right_stick]
deadzone = 0.05
curve = 1.0
key_threshold = 0.3

[profiles.right_stick.action]
gamepad = {stick = "Right", invert_y = false}

[profiles.left_trigger]
action = {gamepad = "Left"}

[profiles.right_trigger]
action = {gamepad = "Right"}

[profiles.gyro]
enabled = false
horizontal = "yaw"
invert_x = false
invert_y = false
noise_threshold = 1.0

[profiles.guide]
notes = '''The wiki or Steam gives only partial or limited controller support: some menus may still want the keyboard. The game has its own controller support, so the controller passes through untouched and the game's own options set the buttons. {guide} still works over the game: {guide} + {west} opens the on-screen keyboard for names and text, and {guide} + {lb} the media controls.'''


[keyboard_style]
corners = 0.03
position = "bottom_center"
scale = 1.0

[keyboard_style.background]
color = "#1b1e24"
opacity = 0.93

[keyboard_style.items]
color = "#32363f"
opacity = 0.95

[keyboard_style.selected]
color = "#cf3a35"
opacity = 1.0

[keyboard_style.border]
width = 1
color = "#8d93a1"
opacity = 0.8

[keyboard_style.gradient]
color = "#121418"
opacity = 1.0
angle = 180

[keyboard_style.item_border]
width = 1
color = "#4d525e"

[keyboard_style.type]
letter_spacing = 1
case = "upper"

[numpad_style]
corners = 0.03
position = "center"
scale = 1.0

[numpad_style.background]
color = "#1b1e24"
opacity = 0.93

[numpad_style.items]
color = "#32363f"
opacity = 0.95

[numpad_style.selected]
color = "#cf3a35"
opacity = 1.0

[numpad_style.border]
width = 1
color = "#8d93a1"
opacity = 0.8

[numpad_style.gradient]
color = "#121418"
opacity = 1.0
angle = 180

[numpad_style.item_border]
width = 1
color = "#4d525e"

[numpad_style.type]
letter_spacing = 1
case = "upper"

[media_style]
corners = 0.03
position = "top_right"
scale = 0.9

[media_style.background]
color = "#1b1e24"
opacity = 0.93

[media_style.items]
color = "#32363f"
opacity = 0.95

[media_style.selected]
color = "#cf3a35"
opacity = 1.0

[media_style.border]
width = 1
color = "#8d93a1"
opacity = 0.8

[media_style.gradient]
color = "#121418"
opacity = 1.0
angle = 180

[media_style.item_border]
width = 1
color = "#4d525e"

[media_style.type]
letter_spacing = 1
case = "upper"

[menu_style]
corners = 0.03
position = "center"
scale = 1.0

[menu_style.background]
color = "#1b1e24"
opacity = 0.93

[menu_style.items]
color = "#32363f"
opacity = 0.95

[menu_style.selected]
color = "#cf3a35"
opacity = 1.0

[menu_style.border]
width = 1
color = "#8d93a1"
opacity = 0.8

[menu_style.gradient]
color = "#121418"
opacity = 1.0
angle = 180

[menu_style.item_border]
width = 1
color = "#4d525e"

[menu_style.type]
letter_spacing = 1
case = "upper"

[menu_style.ornament]
frame = {kind = "brackets", size = 12, width = 2, color = "#cf3a35"}
dividers = {width = 1, color = "#4d525e", opacity = 0.8}

[motion]
keyboard = "swift"
numpad = "swift"
menu = "swift"
media = "swift"
offer = "swift"
info = "swift"
log = "swift"

[sounds.menu]
step = {kind = "click", volume = 0.06, pitch = 0.9}
pick = {kind = "radio", volume = 0.09}
open = {kind = "radio", volume = 0.07}
close = {kind = "click", volume = 0.06, pitch = 0.8}

[sounds.numpad]
step = {kind = "click", volume = 0.06, pitch = 0.9}
pick = {kind = "radio", volume = 0.09}

[sounds.keyboard]
step = {kind = "click", volume = 0.06, pitch = 0.9}
pick = {kind = "keys", volume = 0.13}

[sounds.media]
pick = {kind = "radio", volume = 0.09}
