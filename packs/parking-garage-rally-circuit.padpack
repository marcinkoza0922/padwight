format = 20
macros = []
overlay_font = "Titillium Web"

[pack]
id = "8946d2b2-4f10-5a75-afda-ffd447ab2698"
name = "Parking Garage Rally Circuit"
version = "1.0"
author = "Padwight"
description = "Parking Garage Rally Circuit on an Xbox-style pad. The game has its own controller support, so the controller passes through untouched and the game's own options set the buttons. Padwight adds the Guide overlay on top, with the on-screen keyboard and the media controls, in painted-concrete grey and safety yellow."
made_with = "Xbox controller"
native_controller = true

[[rules]]
kind = "executable"
value = "garagerally.x86_64"
profile = "Parking Garage Rally Circuit"

[[rules]]
kind = "executable"
value = "garagerally.exe"
profile = "Parking Garage Rally Circuit"

[[profiles]]
name = "Parking Garage Rally Circuit"
combos = []
combo_window_ms = 120
tap_window_ms = 250
long_press_ms = 500

[profiles.buttons]
Guide = {mode = "Guide"}
South = {gamepad = "South"}
East = {gamepad = "East"}
North = {gamepad = "North"}
West = {gamepad = "West"}
LeftBumper = {gamepad = "LeftBumper"}
RightBumper = {gamepad = "RightBumper"}
LeftStick = {gamepad = "LeftStick"}
RightStick = {gamepad = "RightStick"}
Select = {gamepad = "Select"}
Start = {gamepad = "Start"}
DpadUp = {gamepad = "DpadUp"}
DpadDown = {gamepad = "DpadDown"}
DpadLeft = {gamepad = "DpadLeft"}
DpadRight = {gamepad = "DpadRight"}

[profiles.left_stick]
deadzone = 0.05
curve = 1.0
key_threshold = 0.3

[profiles.left_stick.action]
gamepad = {stick = "Left", invert_y = false}

[profiles.right_stick]
deadzone = 0.05
curve = 1.0
key_threshold = 0.3

[profiles.right_stick.action]
gamepad = {stick = "Right", invert_y = false}

[profiles.left_trigger]
action = {gamepad = "Left"}

[profiles.right_trigger]
action = {gamepad = "Right"}

[profiles.gyro]
mode = "off"
horizontal = "yaw"
invert_x = false
invert_y = false
activation = "always"
noise_threshold = 1.0

[profiles.guide]
notes = '''Parking Garage Rally Circuit has its own controller support, so the controller goes to the game as it is. Set the buttons in the game's own control options.
{guide} still works over the game: {guide} + {west} opens the on-screen keyboard, and {guide} + {lb} the media controls.
If the game stops answering the pad, check that Steam Input or another remapper isn't also running for it.'''

[keyboard_style]
corners = 0.0
position = "bottom_center"
scale = 1.0

[keyboard_style.background]
color = "#1a1c1e"
opacity = 0.92

[keyboard_style.items]
color = "#2b2e31"
opacity = 0.95

[keyboard_style.selected]
color = "#ffc400"
opacity = 1.0

[keyboard_style.border]
width = 1
color = "#7a7d80"
opacity = 0.8

[keyboard_style.gradient]
color = "#232527"
opacity = 1.0
angle = 180

[keyboard_style.item_border]
width = 1
color = "#45494c"

[keyboard_style.type]
letter_spacing = 3
case = "upper"

