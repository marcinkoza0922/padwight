[motion]
keyboard = "swift"
numpad = "swift"
menu = "swift"
media = "swift"
offer = "swift"
info = "swift"
log = "swift"

[sounds.menu]
step = {kind = "click", volume = 0.08}
pick = {kind = "zap", volume = 0.1, pitch = 0.8}

[sounds.keyboard]
step = {kind = "click", volume = 0.08}
pick = {kind = "keys", volume = 0.2}

[sounds.numpad]
step = {kind = "click", volume = 0.08}
pick = {kind = "keys", volume = 0.2}

[sounds.media]
pick = {kind = "zap", volume = 0.1, pitch = 0.8}

[rumble.menu]
step = {strength = 0.1, length_ms = 18}
pick = {strength = 0.35, length_ms = 35}

[rumble.keyboard]
step = {strength = 0.07, length_ms = 14}
pick = {strength = 0.24, length_ms = 22}

[rumble.numpad]
step = {strength = 0.07, length_ms = 14}
pick = {strength = 0.24, length_ms = 22}

[rumble.media]
pick = {strength = 0.24, length_ms = 25}

[rumble.guide]
mode = {strength = 0.24, length_ms = 60}
