format = 20
macros = []
overlay_font = "Comfortaa"

[pack]
id = "8f046051-a4be-59ee-9858-535666c2e545"
name = "Beyond Good & Evil"
version = "1.0"
author = "Padwight"
description = "Beyond Good & Evil (GOG, 2003) on an Xbox-style pad, modelled on the console release, for the game's default keys. A acts and attacks, X rolls and throws the gyrodisk, B uses the item the D-pad picks, Y calls your companion. Hold RT to run and LT to sneak. RB raises the camera for photos, with the D-pad zooming, and R3 puts it behind Jade. Select shows the objectives and map."
made_with = "Xbox controller"

[[rules]]
kind = "executable"
value = "BGE.exe"
profile = "Beyond Good & Evil"

[[rules]]
kind = "steam_app_id"
value = "15130"
profile = "Beyond Good & Evil"

[[profiles]]
name = "Beyond Good & Evil"
combos = []
combo_window_ms = 120
tap_window_ms = 250
long_press_ms = 500

[profiles.buttons]
Guide = {mode = "Guide"}
South = {mouse = "Left"}
West = {mouse = "Right"}
East = {keys = ["KEY_Q"]}
North = {keys = ["KEY_E"]}
RightBumper = {keys = ["KEY_LEFTSHIFT"]}
RightStick = {keys = ["KEY_C"]}
DpadLeft = {keys = ["KEY_2"]}
DpadRight = {keys = ["KEY_3"]}
DpadUp = {wheel = "Up"}
DpadDown = {wheel = "Down"}
Select = {keys = ["KEY_TAB"]}
Start = {keys = ["KEY_ESC"]}

[profiles.left_stick]
deadzone = 0.12
curve = 1.0
key_threshold = 0.25

[profiles.left_stick.action.ring]
sectors = 8
start_angle = 0.0
inner_radius = 0.25
hysteresis = 0.1

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_W"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_W"] },
    { keys = ["KEY_D"] },
]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_D"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_S"] },
    { keys = ["KEY_D"] },
]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_S"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_S"] },
    { keys = ["KEY_A"] },
]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_A"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_W"] },
    { keys = ["KEY_A"] },
]

[profiles.right_stick]
deadzone = 0.1
curve = 1.8
key_threshold = 0.5

[profiles.right_stick.action.mouse]
speed = 1300.0
accel = 0.2

[profiles.left_trigger.action.button]
threshold = 0.3
action = {keys = ["KEY_LEFTCTRL"]}

[profiles.right_trigger.action.button]
threshold = 0.3
action = {keys = ["KEY_SPACE"]}

[profiles.gyro]
mode = "off"
horizontal = "yaw"
invert_x = false
invert_y = false
noise_threshold = 1.0

[profiles.guide]
notes = '''Laid out like the console release: {south} acts and attacks (kick doors, talk, shoot, take a photo, lock on by holding it), {west} rolls and dives, throws the gyrodisk and makes the hovercraft jump.
Hold {rt} to run or speed up a vehicle, and hold {lt} to sneak crouched.
{east} uses the selected item; the {dpad} left and right pick it. {north} asks your companion for help, or switches to the inside view in the hovercraft.
{rb} raises the camera for looking and photos; {up} and {down} zoom it. Click {r3} to put the camera behind Jade.
{select} shows the objectives, mail, map and detectors. {start} is the menu. Save at the MDisk readers.'''

[profiles.guide.edits]
"stick:Left" = {text = "Move / steer"}
"stick:Right" = {text = "Camera"}
"trigger:Right" = {text = "Run / accelerate (hold)"}
"trigger:Left" = {text = "Sneak (hold)"}
"button:South" = {text = "{b}Action{/b} / attack / shoot"}
"button:West" = {text = "Roll / gyrodisk / jump"}
"button:East" = {text = "Use item"}
"button:North" = {text = "{icon:people} Companion / inside view"}
"button:RightBumper" = {text = "{icon:camera} Look / photo"}
"button:RightStick" = {text = "Camera behind Jade"}
"button:Select" = {text = "{icon:map} Objectives, mail, map"}
"button:Start" = {text = "Menu"}

[[profiles.guide.merged]]
inputs = ["button:DpadLeft", "button:DpadRight"]
text = "Previous / next item"

[[profiles.guide.merged]]
inputs = ["button:DpadUp", "button:DpadDown"]
text = "Zoom in / out"

