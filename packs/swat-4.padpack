format = 20
macros = []
overlay_font = "Rajdhani"

[pack]
id = "b053eed6-298d-493a-93e6-04771d0dcc87"
name = "SWAT 4"
version = "1.0"
author = "Padwight"
description = "SWAT 4 and The Stetchkov Syndicate (2005) on an Xbox-style pad, for the game's default keys. RT fires, LT zooms, A uses, X reloads, Y is the flashlight, B is the quick command. RB holds the right mouse button for the graphical command menu, and the right stick picks from it. Hold LB for the gear ring. L3 toggles crouch, D-pad left and right lean, up cycles the command group. Select lists the viewports and the mission screens. Gyro and flick stick profiles are included to try."
made_with = "Xbox controller"

[[rules]]
kind = "executable"
value = "Swat4.exe"
profile = "SWAT 4"

[[rules]]
kind = "executable"
value = "Swat4X.exe"
profile = "SWAT 4"

[[profiles]]
name = "SWAT 4"
combos = []
combo_window_ms = 120
tap_window_ms = 250
long_press_ms = 500

[profiles.buttons]
South = { keys = ["KEY_F"] }
East = { keys = ["KEY_SPACE"] }
West = { keys = ["KEY_R"] }
North = { keys = ["KEY_V"] }
LeftBumper = { open_menu = "Gear" }
RightBumper = { mouse = "Right" }
Select = { open_menu = "Screens" }
Start = { keys = ["KEY_ESC"] }
Guide = { mode = "Guide" }
LeftStick = { toggle = { action = { keys = ["KEY_C"] } } }
RightStick = { keys = ["KEY_X"] }
DpadUp = { keys = ["KEY_TAB"] }
DpadDown = { keys = ["KEY_LEFTSHIFT"] }
DpadLeft = { keys = ["KEY_Q"] }
DpadRight = { keys = ["KEY_E"] }

[profiles.gestures.LeftBumper.double_tap]
open_menu = "Tools"

[profiles.left_stick]
deadzone = 0.12
curve = 1.0
key_threshold = 0.25

[profiles.left_stick.action.ring]
sectors = 8
start_angle = 0.0
inner_radius = 0.25
hysteresis = 0.1

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_W"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_W"] },
    { keys = ["KEY_D"] },
]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_D"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_S"] },
    { keys = ["KEY_D"] },
]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_S"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_S"] },
    { keys = ["KEY_A"] },
]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_A"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_W"] },
    { keys = ["KEY_A"] },
]

[profiles.right_stick]
deadzone = 0.1
curve = 1.8
key_threshold = 0.5

[profiles.right_stick.action.mouse]
speed = 1100.0
accel = 0.2

[profiles.left_trigger.action.button]
threshold = 0.4
action = { multi = [{ layer = "Zoom" }, { keys = ["KEY_Z"] }] }

[profiles.right_trigger.action.button]
threshold = 0.3
action = { mouse = "Left" }

[profiles.guide]
notes = '''{rb} holds the right mouse button, which opens the graphical command menu; steer it with the right stick {rs}, and click with {rt} to give the order. If you switched to Classic commands in the options, the number keys pick the order instead.
{east} is the quick command: it gives the order for whatever you are looking at (open, clear, restrain).
Hold {lb} for the gear ring, aiming with the right stick; double tap {lb} for the tools (toolkit, optiwand, door wedge). Slot 1 is the primary weapon, slot 2 the sidearm, then the grenades, the pepper spray and the tools. The handcuffs are on the ring too.
{l3} toggles crouch, and it stays on until you click it again. {dpad_down} holds Shift, the game's walk and run key.
{dpad_up} cycles the command group between Red, Blue and both.
{select} lists the viewports (Red, Blue and sniper), the objectives and the score. {start} (Escape) opens the menu and backs out of every screen.
SWAT 4 has no quick save.'''

[profiles.guide.edits]
"stick:Left" = { text = "Move" }
"stick:Right" = { text = "Look" }
"trigger:Right" = { text = "Fire" }
"trigger:Left" = { text = "Zoom" }
"button:South" = { text = "Use / interact" }
"button:East" = { text = "Quick command" }
"button:West" = { text = "Reload" }
"button:North" = { text = "{icon:eye} Flashlight" }
"button:LeftBumper" = { text = "Hold: gear · double tap: tools" }
"button:RightBumper" = { text = "Command menu" }
"button:LeftStick" = { text = "Crouch (toggle)" }
"button:RightStick" = { text = "Fire mode" }
"button:DpadUp" = { text = "Cycle command group" }
"button:DpadDown" = { text = "Walk / run (Shift)" }
"button:Select" = { text = "{icon:map} Viewports, objectives" }
"button:Start" = { text = "Menu / back out" }

[[profiles.guide.merged]]
inputs = ["button:DpadLeft", "button:DpadRight"]
text = "Lean"

