format = 20
macros = []
overlay_font = "Cinzel"

[pack]
id = "50b13422-5d3e-42d9-be8e-03ec6faef309"
name = "Crusader Kings III"
version = "1.0"
author = "Padwight"
description = "Crusader Kings III (Steam, Linux or Windows build) on an Xbox-style pad. The right stick moves the pointer, the left stick pans the map, RT or A left-clicks, LT right-clicks to move armies. Y pauses, the d-pad zooms and changes the speed (hold it for the slowest or fastest). Hold LB for the map modes, hold RB for the finders and speeds. Select lists the character, realm, military, council, court, intrigue, factions and decisions screens. Click L3 for your character, R3 to find a character. The \"+ Gyro\" profile also moves the pointer by tilting the controller."
made_with = "Xbox controller"

[[rules]]
kind = "executable"
value = "ck3"
profile = "Crusader Kings III"

[[rules]]
kind = "executable"
value = "ck3.exe"
profile = "Crusader Kings III"

[[rules]]
kind = "steam_app_id"
value = "1158310"
profile = "Crusader Kings III"

[[profiles]]
name = "Crusader Kings III"
combos = []
combo_window_ms = 120
tap_window_ms = 250
long_press_ms = 500

[profiles.buttons]
Guide = { mode = "Guide" }
South = { mouse = "Left" }
East = { keys = ["KEY_ESC"] }
West = { keys = ["KEY_LEFTSHIFT"] }
North = { keys = ["KEY_SPACE"] }
LeftBumper = { open_menu = "Map modes" }
RightBumper = { open_menu = "Finders" }
Select = { open_menu = "Screens" }
Start = { keys = ["KEY_ESC"] }
LeftStick = { keys = ["KEY_F1"] }
RightStick = { keys = ["KEY_C"] }
DpadUp = { wheel = "Up" }
DpadDown = { wheel = "Down" }
DpadLeft = { keys = ["KEY_KPMINUS"] }
DpadRight = { keys = ["KEY_KPPLUS"] }

[profiles.gestures.DpadLeft.long_press]
keys = ["KEY_1"]

[profiles.gestures.DpadRight.long_press]
keys = ["KEY_5"]

[profiles.left_stick]
deadzone = 0.15
curve = 1.0
key_threshold = 0.35

[profiles.left_stick.action.ring]
sectors = 8
start_angle = 0.0
inner_radius = 0.35
hysteresis = 0.1

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_UP"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_UP"] },
    { keys = ["KEY_RIGHT"] },
]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_RIGHT"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_DOWN"] },
    { keys = ["KEY_RIGHT"] },
]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_DOWN"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_DOWN"] },
    { keys = ["KEY_LEFT"] },
]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_LEFT"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_UP"] },
    { keys = ["KEY_LEFT"] },
]

[profiles.right_stick]
deadzone = 0.12
curve = 1.8
key_threshold = 0.5

[profiles.right_stick.action.mouse]
speed = 1500.0
accel = 0.3

[profiles.left_trigger.action.button]
threshold = 0.4
action = { mouse = "Right" }

[profiles.right_trigger.action.button]
threshold = 0.3
action = { mouse = "Left" }

[profiles.guide]
notes = '''The right stick {rs} moves the pointer: {rt} or {south} is a left click, {lt} a right click. The left stick {ls} pans the map.
{north} pauses and unpauses; the {leftright} d-pad slows the game down and speeds it up, and {updown} zooms.
Hold {west} for Shift while you click, to add to a selection or queue orders.
Hold {lb} for the map modes and {rb} for the finders and speeds, aimed or moved through and picked with {south}.
{select} lists the screens (tap it, pick with {south}, {east} closes the list). {east} or {start} is Escape: it closes the open window, and on the map opens the game menu.
Hold {guide} and press {west} for the on-screen keyboard (save names, searches).
Hold the {leftright} d-pad for the slowest or the fastest speed. {rb} also sets any of the five speeds directly, and opens the character and title finders and the issues list.
Click {l3} for your character and {r3} to find a character. Crusader Kings III on PC has no controller support of its own (the console edition's gamepad interface isn't in the PC game), so the controller works through these keys. It has no quick save: save from the game menu.'''

[profiles.guide.edits]
"stick:Right" = { text = "Pointer" }
"stick:Left" = { text = "Pan the map" }
"trigger:Right" = { text = "Left click (select)" }
"trigger:Left" = { text = "Right click (move armies)" }
"button:South" = { text = "Left click" }
"button:East" = { text = "Close window" }
"button:West" = { text = "Hold: Shift (add, queue)" }
"button:North" = { text = "{icon:pause} Pause" }
"button:LeftBumper" = { text = "Hold: {icon:map} map modes" }
"button:RightBumper" = { text = "Hold: the finders and speeds" }
"button:Select" = { text = "Screens" }
"button:Start" = { text = "Game menu" }
"button:LeftStick" = { text = "{icon:person} Your character" }
"button:RightStick" = { text = "{icon:search} Find a character" }
"gesture:button:DpadLeft:long_press" = { text = "Slowest speed" }
"gesture:button:DpadRight:long_press" = { text = "Fastest speed" }

[[profiles.guide.merged]]
inputs = ["button:DpadUp", "button:DpadDown"]
text = "Zoom in / out"

[[profiles.guide.merged]]
inputs = ["button:DpadLeft", "button:DpadRight"]
text = "{icon:speed1} Slower / faster {icon:speed3}"

