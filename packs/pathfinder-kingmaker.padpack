"button:West" = { text = "{icon:eye} Hold: highlight" }
"button:North" = { text = "{icon:bag} Inventory" }
"button:LeftBumper" = { text = "{icon:rotate-left} Turn camera" }
"button:RightBumper" = { text = "{icon:rotate} Turn camera" }
"button:RightStick" = { text = "{icon:hourglass} Turn-based mode" }
"button:Select" = { text = "{icon:book} Character, spells, formation" }
"button:Start" = { text = "Menu / back out" }
"gesture:button:Start:double_tap" = { text = "{icon:save} Quick save" }
"gesture:button:Start:long_press" = { text = "{icon:load} Quick load" }
"button:DpadLeft" = { text = "{icon:scroll} Journal" }
"button:DpadRight" = { text = "{icon:map} Map" }

[[profiles.guide.merged]]
inputs = ["button:DpadUp", "button:DpadDown"]
text = "Zoom · scroll lists"

