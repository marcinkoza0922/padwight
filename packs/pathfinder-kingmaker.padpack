format = 20
macros = []
overlay_font = "Cinzel"

[pack]
id = "6a2f9d4e-18c7-4b03-a5e2-c94d7f1b8e20"
name = "Pathfinder: Kingmaker"
version = "1.0"
author = "Padwight"
description = "Pathfinder: Kingmaker on an Xbox-style pad, for the game's mouse and keyboard controls. The right stick moves the pointer, the left stick pans the camera, RT or A left-clicks and LT right-clicks. B pauses, R3 switches turn-based mode as on the console edition, hold X to highlight what you can use and Y is the inventory. LB and RB turn the camera and the D-pad zooms. Select lists the character sheet, spellbook, journal, map and formation. Start is the menu and backs out of every screen; double tap it to quick save, hold it to quick load. Overlays in forest green and old gold."
made_with = "Xbox controller"

[[rules]]
kind = "steam_app_id"
value = "640820"
profile = "Pathfinder: Kingmaker"

[[rules]]
kind = "executable"
value = "Kingmaker.exe"
profile = "Pathfinder: Kingmaker"

[[rules]]
kind = "executable"
value = "Kingmaker.x86_64"
profile = "Pathfinder: Kingmaker"

[[profiles]]
name = "Pathfinder: Kingmaker"
combos = []
combo_window_ms = 120
tap_window_ms = 250
long_press_ms = 500

[profiles.buttons]
Guide = { mode = "Guide" }
South = { mouse = "Left" }
East = { keys = ["KEY_SPACE"] }
West = { keys = ["KEY_TAB"] }
North = { keys = ["KEY_I"] }
LeftBumper = { keys = ["KEY_Q"] }
RightBumper = { keys = ["KEY_E"] }
Select = { open_menu = "Screens" }
Start = { keys = ["KEY_ESC"] }
RightStick = { keys = ["KEY_R"] }
DpadUp = { wheel = "Up" }
DpadDown = { wheel = "Down" }
DpadLeft = { keys = ["KEY_J"] }
DpadRight = { keys = ["KEY_M"] }

[profiles.gestures.Start]
double_tap = { keys = ["KEY_F5"] }
long_press = { keys = ["KEY_F9"] }

[profiles.left_stick]
deadzone = 0.15
curve = 1.0
key_threshold = 0.35

[profiles.left_stick.action.ring]
sectors = 8
start_angle = 0.0
inner_radius = 0.35
hysteresis = 0.1

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_W"]

[[profiles.left_stick.action.ring.actions]]
multi = [{ keys = ["KEY_W"] }, { keys = ["KEY_D"] }]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_D"]

[[profiles.left_stick.action.ring.actions]]
multi = [{ keys = ["KEY_S"] }, { keys = ["KEY_D"] }]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_S"]

[[profiles.left_stick.action.ring.actions]]
multi = [{ keys = ["KEY_S"] }, { keys = ["KEY_A"] }]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_A"]

[[profiles.left_stick.action.ring.actions]]
multi = [{ keys = ["KEY_W"] }, { keys = ["KEY_A"] }]

[profiles.right_stick]
deadzone = 0.12
curve = 1.8
key_threshold = 0.5

[profiles.right_stick.action.mouse]
speed = 1500.0
accel = 0.3

[profiles.left_trigger.action.button]
threshold = 0.4
action = { mouse = "Right" }

[profiles.right_trigger.action.button]
threshold = 0.3
action = { mouse = "Left" }

[profiles.guide]
notes = '''The PC game has no controller support (the 2020 Definitive Edition's pad interface came to the PS4 and Xbox One only), so this plays the PC game with the pointer. The right stick {rs} moves it; {rt} or {south} is a left click (move, attack, use, talk) and {lt} a right click (cancel, inspect). Drag with {rt} held to box-select the party.
{east} pauses and unpauses, which is how real-time fights are played: pause, give orders, unpause. {r3} switches to turn-based mode and back, as clicking the right stick does on the console edition. Hold {west} to highlight doors, loot and people you can use.
The left stick {ls} pans the camera, {lb} and {rb} turn it and {up} and {down} zoom (and scroll lists). {north} opens the inventory, {left} the journal and {right} the map; {select} lists the screens, including the character sheet, spellbook and formation. Pick party members by clicking their portraits.
{start} (Escape) closes every screen and opens the menu in play; double tap it to {color:green}quick save{/color} and hold it to quick load. Naming a hero or a kingdom: {guide} + {west} opens the on-screen keyboard.
The keys are the game's defaults as remembered, not checked on an install: WASD to pan, Q and E to turn the camera, Space to pause, Tab to highlight, I, C, B, J, M and F for the screens, R for turn-based mode (added with the Enhanced Plus Edition), F5 and F9 to save and load. If one doesn't answer, check Options, Controls and change the buttons here to match. The Windows executable is from Discord's list; the Linux one (Kingmaker.x86_64) is a guess. The Steam app id is the wiki's.'''

[profiles.guide.edits]
"stick:Left" = { text = "Pan the camera" }
"stick:Right" = { text = "Pointer" }
"trigger:Right" = { text = "Click: move, attack, use" }
