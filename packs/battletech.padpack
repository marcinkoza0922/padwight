format = 20
macros = []
overlay_font = "Rajdhani"

[pack]
id = "a30cb398-236a-555e-bcd5-7bb25541db81"
name = "BattleTech"
version = "1.0"
author = "Padwight"
description = "BattleTech (Steam, 2018) on an Xbox-style pad. The right stick moves the pointer, the left stick pans the camera, A or RT left-clicks, LT right-clicks. Y confirms (Space), B backs out, LB and RB step through your units, the d-pad zooms and rotates the camera. Select opens the weapon list. The \"+ Gyro\" profile also moves the pointer by tilting the controller."
made_with = "Xbox controller"

[[rules]]
kind = "executable"
value = "battletech.exe"
profile = "BattleTech"

[[rules]]
kind = "steam_app_id"
value = "637090"
profile = "BattleTech"

[[rules]]
kind = "executable"
value = "BattleTech"
profile = "BattleTech"

[[profiles]]
name = "BattleTech"
combos = []
combo_window_ms = 120
tap_window_ms = 250
long_press_ms = 500

[profiles.buttons]
Guide = { mode = "Guide" }
South = { mouse = "Left" }
East = { keys = ["KEY_ESC"] }
West = { keys = ["KEY_LEFTSHIFT"] }
North = { keys = ["KEY_SPACE"] }
LeftBumper = { keys = ["KEY_LEFTSHIFT", "KEY_TAB"] }
RightBumper = { keys = ["KEY_TAB"] }
Select = { open_menu = "Weapons" }
Start = { keys = ["KEY_ESC"] }
LeftStick = { keys = ["KEY_LEFTALT"] }
RightStick = { mouse = "Middle" }
DpadUp = { wheel = "Up" }
DpadDown = { wheel = "Down" }
DpadLeft = { keys = ["KEY_Q"] }
DpadRight = { keys = ["KEY_E"] }

[profiles.left_stick]
deadzone = 0.15
curve = 1.0
key_threshold = 0.35

[profiles.left_stick.action.ring]
sectors = 8
start_angle = 0.0
inner_radius = 0.35
hysteresis = 0.1

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_W"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_W"] },
    { keys = ["KEY_D"] },
]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_D"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_S"] },
    { keys = ["KEY_D"] },
]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_S"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_S"] },
    { keys = ["KEY_A"] },
]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_A"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_W"] },
    { keys = ["KEY_A"] },
]

[profiles.right_stick]
deadzone = 0.12
curve = 1.8
key_threshold = 0.5

[profiles.right_stick.action.mouse]
speed = 1500.0
accel = 0.3

[profiles.left_trigger.action.button]
threshold = 0.4
action = { mouse = "Right" }

[profiles.right_trigger.action.button]
threshold = 0.3
action = { mouse = "Left" }

[profiles.guide]
notes = '''The right stick {rs} moves the pointer: {rt} or {south} is a left click (select a unit, a hex or a target), {lt} a right click. The left stick {ls} pans the camera.
{north} is Space, which confirms a move or attack and ends actions. {east} or {start} is Escape: it cancels, and opens the game menu.
{lb} and {rb} step back and forward through your units (Shift Tab and Tab). The {updown} d-pad zooms and {leftright} rotates the camera (Q and E).
{select} lists the weapon keys 1 to 6 (tap it, pick with {south}). Hold {west} for Shift, hold {l3} for Alt, and click {r3} for the middle mouse button (drag to orbit).
Hold {guide} and press {west} for the on-screen keyboard (naming mechs and pilots).
BattleTech has no controller support. INFERRED, not checked on an install: Space as confirm, Tab and Shift Tab for unit cycling, Q and E rotation, Alt for details, and the number keys for weapons. The game has key remapping in its options; edit these to match.'''

[profiles.guide.edits]
"stick:Right" = { text = "Pointer" }
"stick:Left" = { text = "Pan the camera" }
"trigger:Right" = { text = "Left click (select)" }
"trigger:Left" = { text = "Right click" }
"button:South" = { text = "Left click" }
"button:East" = { text = "Cancel" }
"button:West" = { text = "Hold: Shift" }
"button:North" = { text = "Confirm (Space)" }
"button:LeftBumper" = { text = "Previous unit" }
"button:RightBumper" = { text = "Next unit" }
"button:Select" = { text = "{icon:crosshair} Weapons" }
"button:Start" = { text = "Game menu" }
"button:LeftStick" = { text = "Hold: Alt" }
"button:RightStick" = { text = "Middle click (orbit)" }

[[profiles.guide.merged]]
inputs = ["button:DpadUp", "button:DpadDown"]
text = "Zoom in / out"

[[profiles.guide.merged]]
inputs = ["button:DpadLeft", "button:DpadRight"]
text = "Rotate camera"

[[profiles]]
name = "BattleTech + Gyro"
combos = [{buttons = ["Select", "Start"], action = "gyro_clutch"}]
combo_window_ms = 120
tap_window_ms = 250
long_press_ms = 500
requires = ["gyro"]

