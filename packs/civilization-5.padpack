[profiles.guide]
notes = '''Hold {select} and {start} together to pause the gyro while you reposition the controller. Tilting the controller moves the cursor, as a fine pointer next to the right stick {rs}.
The right stick moves the mouse pointer; {rt} or {south} is a left click and {lt} a right click. Hold {guide} and press {west} for the on-screen keyboard when the game asks for a name.
{lt} gives a right click, which moves the selected unit to the tile under the pointer.
{east} closes the open screen. {start} opens the game menu.
Hold {lb} for the unit orders, picking with the right stick {rs}.
{rb} goes to the next unit that needs orders, and ends the turn when none do.
Double tap {start} to quick save and hold it to quick load. {r3} switches to the strategic view.'''

