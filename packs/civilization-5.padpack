format = 18
macros = []
overlay_font = "Cinzel"

[pack]
id = "aa46287e-2997-4ffd-9ff8-2f78e8b91dd4"
name = "Civilization V"
version = "1.0"
author = "Padwight"
description = "Civilization V (Steam, Linux or Windows build) on an Xbox-style pad. The right stick moves the pointer, the left stick pans the map, RT or A left-clicks, LT right-clicks to move units. X skips a unit, Y fortifies, RB goes to the next unit or ends the turn. Hold LB for unit orders. The d-pad zooms and cycles units (hold: cities). Select lists the advisors and screens. Start is the game menu; double tap it to quick save, hold it to quick load."
made_with = "Xbox controller"

[[rules]]
kind = "executable"
value = "Civ5XP"
profile = "Civilization V"

[[rules]]
kind = "executable"
value = "CivilizationV.exe"
profile = "Civilization V"

[[rules]]
kind = "executable"
value = "CivilizationV_DX11.exe"
profile = "Civilization V"

[[rules]]
kind = "steam_app_id"
value = "8930"
profile = "Civilization V"

[[profiles]]
name = "Civilization V"
combos = []
combo_window_ms = 120
tap_window_ms = 250
long_press_ms = 500

[profiles.buttons]
Guide = { mode = "Guide" }
South = { mouse = "Left" }
East = { keys = ["KEY_ESC"] }
West = { keys = ["KEY_SPACE"] }
North = { keys = ["KEY_F"] }
LeftBumper = { open_menu = "Orders" }
RightBumper = { keys = ["KEY_ENTER"] }
Select = { open_menu = "Screens" }
Start = { keys = ["KEY_ESC"] }
LeftStick = { keys = ["KEY_C"] }
RightStick = { keys = ["KEY_F10"] }
DpadUp = { wheel = "Up" }
DpadDown = { wheel = "Down" }
DpadLeft = { keys = ["KEY_COMMA"] }
DpadRight = { keys = ["KEY_DOT"] }

[profiles.gestures.RightBumper.long_press]
keys = ["KEY_LEFTSHIFT", "KEY_ENTER"]

[profiles.gestures.DpadLeft.long_press]
keys = ["KEY_END"]

[profiles.gestures.DpadRight.long_press]
keys = ["KEY_HOME"]

[profiles.gestures.Start.double_tap]
keys = ["KEY_F11"]

[profiles.gestures.Start.long_press]
keys = ["KEY_LEFTCTRL", "KEY_F11"]

[profiles.left_stick]
deadzone = 0.15
curve = 1.0
key_threshold = 0.35

[profiles.left_stick.action.keys]
up = "KEY_UP"
down = "KEY_DOWN"
left = "KEY_LEFT"
right = "KEY_RIGHT"

[profiles.right_stick]
deadzone = 0.12
curve = 1.8
key_threshold = 0.5

[profiles.right_stick.action.mouse]
speed = 1500.0
accel = 0.3

[profiles.left_trigger.action.button]
threshold = 0.4
action = { mouse = "Right" }

[profiles.right_trigger.action.button]
threshold = 0.3
action = { mouse = "Left" }

[profiles.guide]
notes = '''
The right stick moves the mouse pointer; RT or A is a left click and LT a right click. Hold Guide and press X for the on-screen keyboard when the game asks for a name.
LT gives a right click, which moves the selected unit to the tile under the pointer.
B closes the open screen. Start opens the game menu.
Hold LB for the unit orders, picking with the right stick.
RB goes to the next unit that needs orders, and ends the turn when none do.
Double tap Start to quick save and hold it to quick load. R3 switches to the strategic view.'''

[profiles.guide.edits]
"stick:Right" = { text = "Pointer" }
"trigger:Right" = { text = "Left click (select)" }
"trigger:Left" = { text = "Right click (move to)" }
"button:South" = { text = "Left click" }
"button:East" = { text = "Close screen" }
"button:LeftBumper" = { text = "Hold: unit orders" }
"button:Select" = { text = "Advisors, screens" }
"button:Start" = { text = "Game menu" }
"stick:Left" = { text = "Pan the map" }
"button:West" = { text = "Skip the unit's turn" }
"button:North" = { text = "Fortify / sleep" }
"button:RightBumper" = { text = "Next action / end turn" }
"button:LeftStick" = { text = "Center on the unit" }
"button:RightStick" = { text = "Strategic view" }
"gesture:button:DpadLeft:long_press" = { text = "Previous city" }
"gesture:button:DpadRight:long_press" = { text = "Next city" }
"gesture:button:Start:double_tap" = { text = "Quick save" }
"gesture:button:Start:long_press" = { text = "Quick load" }
"gesture:button:RightBumper:long_press" = { text = "End turn now" }

[[profiles.guide.merged]]
inputs = ["button:DpadUp", "button:DpadDown"]
text = "Zoom in / out"

[[profiles.guide.merged]]
inputs = ["button:DpadLeft", "button:DpadRight"]
text = "Previous / next unit"

