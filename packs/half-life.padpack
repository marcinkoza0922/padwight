format = 20
macros = []
overlay_font = "Rajdhani"

[pack]
id = "00208920-9c32-4f40-bd13-1ab18841b824"
name = "Half-Life"
version = "1.0"
author = "Padwight"
description = "Half-Life (1998) on an Xbox-style pad, for the game's default keys. The game has no real controller support, so the pad plays the keyboard and mouse. A uses, B jumps, X reloads, Y is the flashlight, RT fires and LT is the alternate fire. A light push of the left stick walks, L3 toggles crouch and R3 pulls out the crowbar. LB and RB step through weapons, and the D-pad up opens the weapon slot ring. Start is the menu, a double tap quick saves and a long press quick loads. Gyro and flick stick profiles are included to try."
made_with = "Xbox controller"

[[rules]]
kind = "steam_app_id"
value = "70"
profile = "Half-Life"

[[rules]]
kind = "executable"
value = "hl.exe"
profile = "Half-Life"

[[rules]]
kind = "executable"
value = "hl_linux"
profile = "Half-Life"

[[profiles]]
name = "Half-Life"
combos = []
combo_window_ms = 120
tap_window_ms = 250
long_press_ms = 500

[profiles.buttons]
South = { keys = ["KEY_E"] }
East = { keys = ["KEY_SPACE"] }
West = { keys = ["KEY_R"] }
North = { keys = ["KEY_F"] }
LeftBumper = { wheel = "Up" }
RightBumper = { wheel = "Down" }
Select = { keys = ["KEY_TAB"] }
Start = { keys = ["KEY_ESC"] }
Guide = { mode = "Guide" }
LeftStick = { toggle = { action = { keys = ["KEY_LEFTCTRL"] } } }
RightStick = { keys = ["KEY_1"] }
DpadUp = { open_menu = "Weapons" }
DpadDown = { keys = ["KEY_T"] }
DpadLeft = { keys = ["KEY_Q"] }
DpadRight = { keys = ["KEY_GRAVE"] }

[profiles.gestures.Start.double_tap]
keys = ["KEY_F6"]

[profiles.gestures.Start.long_press]
keys = ["KEY_F7"]

[profiles.left_stick]
deadzone = 0.12
curve = 1.0
key_threshold = 0.25

[profiles.left_stick.action.ring]
sectors = 8
start_angle = 0.0
inner_radius = 0.25
hysteresis = 0.1

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_W"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_W"] },
    { keys = ["KEY_D"] },
]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_D"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_S"] },
    { keys = ["KEY_D"] },
]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_S"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_S"] },
    { keys = ["KEY_A"] },
]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_A"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_W"] },
    { keys = ["KEY_A"] },
]

[[profiles.left_stick.zones]]
min = 0.0
max = 0.6
action = { keys = ["KEY_LEFTSHIFT"] }

[profiles.right_stick]
deadzone = 0.1
curve = 1.8
key_threshold = 0.5

[profiles.right_stick.action.mouse]
speed = 1100.0
accel = 0.2

[profiles.left_trigger.action.button]
threshold = 0.4
action = { mouse = "Right" }

[profiles.right_trigger.action.button]
threshold = 0.3
action = { mouse = "Left" }

[profiles.gyro]
enabled = false
horizontal = "yaw"
invert_x = false
invert_y = false
noise_threshold = 1.0

[profiles.guide]
notes = '''{start} (Escape) opens the game's menu and backs out of every screen in it.
{south} uses (buttons, ladders, pick-ups), {east} jumps, {west} reloads and {north} is the flashlight. {lt} is the right mouse button, the alternate fire of the weapons that have one (the .357's scope, the MP5 grenade launcher, the crossbow's zoom).
A light push of the left stick {ls} walks slowly (Shift); a full push runs. {l3} toggles crouch, and it stays on until you click it again.
{lb} and {rb} step to the previous and next weapon (mouse wheel). {r3} selects the crowbar (slot 1), {left} jumps back to the last weapon and {up} opens a ring of the weapon slots, aimed with the right stick {rs}; pressing a slot again steps through the weapons in it.
Quick save is a double tap of {start} (F6), and quick load a long press of {start} (F7). {down} sprays your logo (T) and {right} opens the developer console (~), if you turned it on in the game's options.
The keys are the game's defaults. If you changed them in Options → Controls, change them here too. Half-Life: Source and the expansions (Opposing Force, Blue Shift) use the same keys.
{guide} still works over the game: {guide} + {west} opens the on-screen keyboard and {guide} + {lb} the media controls.
If the game stops answering the pad, check that Steam Input or another remapper isn't also running for it.'''

[profiles.guide.edits]
"stick:Left" = { text = "Move · light push walks" }
"stick:Right" = { text = "Look" }
"trigger:Right" = { text = "Fire" }
"trigger:Left" = { text = "Alt fire" }
"button:South" = { text = "Use" }
"button:East" = { text = "Jump" }
"button:West" = { text = "Reload" }
"button:North" = { text = "Flashlight" }
"button:LeftBumper" = { text = "Previous weapon" }
"button:RightBumper" = { text = "Next weapon" }
"button:LeftStick" = { text = "Crouch (toggle)" }
"button:RightStick" = { text = "{icon:fist} Crowbar" }
"button:DpadUp" = { text = "Weapon slots" }
"button:DpadDown" = { text = "Spray logo" }
"button:DpadLeft" = { text = "Last weapon" }
"button:DpadRight" = { text = "Console" }
"button:Select" = { text = "Scores" }
"button:Start" = { text = "Menu / back out" }
"gesture:button:Start:double_tap" = { text = "{icon:save} Quick save" }
"gesture:button:Start:long_press" = { text = "{icon:load} Quick load" }

