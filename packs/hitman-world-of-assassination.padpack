format = 20
macros = []
overlay_font = "Rajdhani"

[pack]
id = "e02f7cc2-987f-40fa-a599-5468e5b7f922"
name = "Hitman World of Assassination"
version = "1.0"
author = "Padwight"
description = "Hitman World of Assassination (2016) on an Xbox-style pad. The game has its own controller support, so the controller passes through untouched and you set the buttons in the game's Controls options. One pack covers HITMAN, HITMAN 2 and HITMAN 3, which share the controls and the Steam launcher. Padwight adds the Guide overlay on top, in clean white on black. Gyro and flick stick profiles are included to try; they move the mouse beside the pad."
made_with = "Xbox controller"

