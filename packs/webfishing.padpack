format = 20
macros = []
overlay_font = "Comfortaa"

[pack]
id = "58f6ec49-0020-5782-99cb-8a301eec7b78"
name = "Webfishing"
version = "1.0"
author = "Padwight"
description = "WEBFISHING on an Xbox-style pad, laid out like the WebfishingPlus mod's controller binds. The left stick walks and L3 toggles sprint, the right stick turns the camera; RT casts and reels, A jumps, X interacts, Y barks or meows and B blows a kiss. Hold LB for the hotbar, RB for the emote wheel and LT to zoom with the right stick. Overlays in lake teal and the game's cream paper."
made_with = "Xbox controller"

[[rules]]
kind = "steam_app_id"
value = "3146520"
profile = "Webfishing"

[[rules]]
kind = "executable"
value = "webfishing.exe"
profile = "Webfishing"

[[profiles]]
name = "Webfishing"
combos = []
combo_window_ms = 120
tap_window_ms = 250
long_press_ms = 500

[profiles.buttons]
Guide = {mode = "Guide"}
South = {keys = ["KEY_SPACE"]}
West = {keys = ["KEY_E"]}
North = {keys = ["KEY_G"]}
East = {keys = ["KEY_K"]}
LeftBumper = {open_menu = "Hotbar"}
RightBumper = {keys = ["KEY_C"]}
LeftStick = {toggle = {action = {keys = ["KEY_LEFTSHIFT"]}}}
Select = {keys = ["KEY_TAB"]}
Start = {keys = ["KEY_ESC"]}
DpadUp = {keys = ["KEY_ENTER"]}

[profiles.gestures.North]
long_press = {keys = ["KEY_LEFTCTRL", "KEY_G"]}

[profiles.left_stick]
deadzone = 0.12
curve = 1.0
key_threshold = 0.25

[profiles.left_stick.action.ring]
sectors = 8
start_angle = 0.0
inner_radius = 0.25
hysteresis = 0.1

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_W"]

[[profiles.left_stick.action.ring.actions]]
multi = [{ keys = ["KEY_W"] }, { keys = ["KEY_D"] }]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_D"]

[[profiles.left_stick.action.ring.actions]]
multi = [{ keys = ["KEY_S"] }, { keys = ["KEY_D"] }]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_S"]

[[profiles.left_stick.action.ring.actions]]
multi = [{ keys = ["KEY_S"] }, { keys = ["KEY_A"] }]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_A"]

[[profiles.left_stick.action.ring.actions]]
multi = [{ keys = ["KEY_W"] }, { keys = ["KEY_A"] }]

[profiles.right_stick]
deadzone = 0.08
curve = 2.0
key_threshold = 0.5

[profiles.right_stick.action.mouse]
speed = 2400.0
accel = 0.2

[profiles.left_trigger.action.button]
threshold = 0.4
action = {layer = "Zoom"}

[profiles.right_trigger.action.button]
threshold = 0.3
action = {mouse = "Left"}

[profiles.gyro]
mode = "off"
horizontal = "yaw"
invert_x = false
invert_y = false
noise_threshold = 1.0

[profiles.guide]
notes = '''WEBFISHING has no controller support of its own (the WebfishingPlus mod adds one; this layout follows its buttons), so the pad plays the keyboard and mouse. The left stick {ls} walks and the right stick {rs} turns the camera; {l3} toggles sprint.
{rt} is the left mouse button: hold it to charge a cast, then click it to reel in. {south} jumps and {west} interacts (E).
{north} barks or meows (G), a long press of {north} hisses or growls (Ctrl+G), and {east} blows a kiss (K). Hold {rb} for the emote wheel (C) and point at an emote with {rs}.
Hold {lb} and aim {rs} at a hotbar slot to pick it (1 to 5). Hold {lt} and push {rs} up or down to zoom the camera (mouse wheel).
{select} opens the inventory and {up} opens the chat: type with the on-screen keyboard ({guide} + {west}), then press Enter. {start} is the menu (Escape).
The game lets you remap its keys. Most of these are from memory and unchecked on an install: the emote keys come from a guide, but sprint, interact, inventory (Tab), chat (Enter) and five hotbar slots are guesses, so compare them with Settings → Controls and set the game's keys to match. The fishing minigame's autoclick setting lets you hold {rt} instead of tapping it.'''

[profiles.guide.edits]
"stick:Left" = {text = "Walk"}
"stick:Right" = {text = "Camera"}
"trigger:Right" = {text = "{icon:fish} {b}Cast · reel{/b}"}
"trigger:Left" = {text = "{icon:search} Zoom (hold, {rs})"}
"button:South" = {text = "Jump"}
"button:West" = {text = "{icon:hand} Interact"}
"button:North" = {text = "{icon:paw} Bark / meow"}
"gesture:button:North:long_press" = {text = "Hiss / growl"}
"button:East" = {text = "{icon:heart} Kiss"}
"button:LeftBumper" = {text = "{icon:box} Hotbar (hold)"}
"button:RightBumper" = {text = "{icon:people} Emotes (hold)"}
"button:LeftStick" = {text = "{icon:footprints} Sprint (toggle)"}
"button:Select" = {text = "{icon:bag} Inventory"}
"button:DpadUp" = {text = "{icon:messages} Chat"}
"button:Start" = {text = "Menu"}

