format = 20
macros = []
overlay_font = "Cinzel"

[pack]
id = "28b5b728-b7bb-517c-a8d0-a735075f2005"
name = "Stronghold Crusader 2"
version = "1.0"
author = "Padwight"
description = "Stronghold Crusader 2 on an Xbox-style pad. The left stick scrolls the map, the right stick points; RT and A click, LT right-clicks to order troops. Y pauses and the shoulder buttons zoom. Overlays in sandstone and gold."
made_with = "Xbox controller"

[[rules]]
kind = "steam_app_id"
value = "232890"
profile = "Stronghold Crusader 2"

[[rules]]
kind = "executable"
value = "crusader2.exe"
profile = "Stronghold Crusader 2"

[[profiles]]
name = "Stronghold Crusader 2"
combos = []
combo_window_ms = 120
tap_window_ms = 250
long_press_ms = 500

[profiles.buttons]
Guide = {mode = "Guide"}
South = {mouse = "Left"}
East = {keys = ["KEY_ESC"]}
Start = {keys = ["KEY_ESC"]}
DpadUp = {wheel = "Up"}
DpadDown = {wheel = "Down"}
North = {keys = ["KEY_PAUSE"]}
West = {keys = ["KEY_SPACE"]}
LeftBumper = {keys = ["KEY_LEFTSHIFT"]}

[profiles.left_stick]
deadzone = 0.15
curve = 1.0
key_threshold = 0.35

[profiles.left_stick.action.ring]
sectors = 8
start_angle = 0.0
inner_radius = 0.35
hysteresis = 0.1

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_UP"]

[[profiles.left_stick.action.ring.actions]]
multi = [{ keys = ["KEY_UP"] }, { keys = ["KEY_RIGHT"] }]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_RIGHT"]

[[profiles.left_stick.action.ring.actions]]
multi = [{ keys = ["KEY_DOWN"] }, { keys = ["KEY_RIGHT"] }]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_DOWN"]

[[profiles.left_stick.action.ring.actions]]
multi = [{ keys = ["KEY_DOWN"] }, { keys = ["KEY_LEFT"] }]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_LEFT"]

[[profiles.left_stick.action.ring.actions]]
multi = [{ keys = ["KEY_UP"] }, { keys = ["KEY_LEFT"] }]

[profiles.right_stick]
deadzone = 0.12
curve = 1.7
key_threshold = 0.5

[profiles.right_stick.action.mouse]
speed = 1400.0
accel = 0.3

[profiles.left_trigger.action.button]
threshold = 0.4
action = {mouse = "Right"}

[profiles.right_trigger.action.button]
threshold = 0.3
action = {mouse = "Left"}

[profiles.gyro]
enabled = false
horizontal = "yaw"
invert_x = false
invert_y = false
noise_threshold = 1.0

[profiles.guide]
notes = '''The right stick {rs} moves the pointer and the left stick {ls} pans the view. {rt} or {south} clicks, {lt} right-clicks (orders, cancel). Scroll zooms on {up} and {down}.
Buttons: {south} Click; {east} Back / close; {start} Menu; {north} Pause; {west} Select all; {lb} Add to selection.
Select-all on Space is remembered from the older Stronghold games. Keys are the game's defaults as remembered, not read from an install; if one doesn't answer, check the game's controls options and change the buttons here to match. The Windows executable is from Discord's list. The game has no controller support, so the pad plays it with the pointer.
Typing a name or text: {guide} + {west} opens the on-screen keyboard.'''

[profiles.guide.edits]
"stick:Left" = {text = "Pan the view"}
"stick:Right" = {text = "Pointer"}
"trigger:Right" = {text = "Left click"}
"trigger:Left" = {text = "Right click"}
"button:South" = {text = "Click"}
"button:East" = {text = "Back / close"}
"button:Start" = {text = "Menu"}
"button:North" = {text = "{icon:pause} Pause"}
"button:West" = {text = "{icon:formation} Select all"}
"button:LeftBumper" = {text = "{icon:supports} Add to selection"}

[[profiles.guide.merged]]
inputs = ["button:DpadUp", "button:DpadDown"]
text = "Zoom in / out"



[[profiles]]
name = "Stronghold Crusader 2 + Gyro"
combos = [
    {buttons = ["Select", "Start"], action = "gyro_clutch"},
]
combo_window_ms = 120
tap_window_ms = 250
long_press_ms = 500
requires = ["gyro"]

[profiles.buttons]
Guide = {mode = "Guide"}
South = {mouse = "Left"}
East = {keys = ["KEY_ESC"]}
Start = {keys = ["KEY_ESC"]}
DpadUp = {wheel = "Up"}
DpadDown = {wheel = "Down"}
North = {keys = ["KEY_PAUSE"]}
West = {keys = ["KEY_SPACE"]}
LeftBumper = {keys = ["KEY_LEFTSHIFT"]}

[profiles.left_stick]
deadzone = 0.15
curve = 1.0
key_threshold = 0.35

[profiles.left_stick.action.ring]
sectors = 8
start_angle = 0.0
inner_radius = 0.35
hysteresis = 0.1

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_UP"]

[[profiles.left_stick.action.ring.actions]]
multi = [{ keys = ["KEY_UP"] }, { keys = ["KEY_RIGHT"] }]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_RIGHT"]

[[profiles.left_stick.action.ring.actions]]
multi = [{ keys = ["KEY_DOWN"] }, { keys = ["KEY_RIGHT"] }]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_DOWN"]

[[profiles.left_stick.action.ring.actions]]
multi = [{ keys = ["KEY_DOWN"] }, { keys = ["KEY_LEFT"] }]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_LEFT"]

[[profiles.left_stick.action.ring.actions]]
multi = [{ keys = ["KEY_UP"] }, { keys = ["KEY_LEFT"] }]

[profiles.right_stick]
deadzone = 0.12
curve = 1.7
key_threshold = 0.5

[profiles.right_stick.action.mouse]
speed = 1400.0
accel = 0.3

[profiles.left_trigger.action.button]
threshold = 0.4
action = {mouse = "Right"}

[profiles.right_trigger.action.button]
threshold = 0.3
action = {mouse = "Left"}

[profiles.gyro]
horizontal = "yaw"
invert_x = false
invert_y = false
noise_threshold = 1.0

[profiles.gyro.mode.mouse]
sensitivity = 20.0

[profiles.guide]
notes = '''Hold {select} and {start} together to pause the gyro while you reposition the controller. Tilting the controller moves the pointer, as a fine pointer next to the right stick {rs}.
The right stick {rs} moves the pointer and the left stick {ls} pans the view. {rt} or {south} clicks, {lt} right-clicks (orders, cancel). Scroll zooms on {up} and {down}.
Buttons: {south} Click; {east} Back / close; {start} Menu; {north} Pause; {west} Select all; {lb} Add to selection.
Select-all on Space is remembered from the older Stronghold games. Keys are the game's defaults as remembered, not read from an install; if one doesn't answer, check the game's controls options and change the buttons here to match. The Windows executable is from Discord's list. The game has no controller support, so the pad plays it with the pointer.
Typing a name or text: {guide} + {west} opens the on-screen keyboard.'''

[profiles.guide.edits]
"stick:Left" = {text = "Pan the view"}
"stick:Right" = {text = "Pointer"}
"trigger:Right" = {text = "Left click"}
"trigger:Left" = {text = "Right click"}
"button:South" = {text = "Click"}
"button:East" = {text = "Back / close"}
"button:Start" = {text = "Menu"}
"button:North" = {text = "{icon:pause} Pause"}
"button:West" = {text = "{icon:formation} Select all"}
"button:LeftBumper" = {text = "{icon:supports} Add to selection"}

[[profiles.guide.merged]]
inputs = ["button:DpadUp", "button:DpadDown"]
text = "Zoom in / out"



