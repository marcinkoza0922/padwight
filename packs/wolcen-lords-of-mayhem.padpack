format = 20
macros = []
overlay_font = "Cinzel"

[pack]
id = "bc371170-5e82-4a40-a256-6f8c90652b75"
name = "Wolcen: Lords of Mayhem"
version = "1.0"
author = "Padwight"
description = "Wolcen: Lords of Mayhem on an Xbox-style pad, for the game's mouse and keys. The left stick sweeps the pointer and, pushed all the way, walks there; the right stick aims finely. A left-clicks, LT uses the right-click skill, X, Y, RB and RT are skills 1 to 4, B rolls and LB drinks a potion. The D-pad shows the map and zooms. Select lists the character, inventory, skills, the Gate of Fates and quests; Start is the menu. The game has no controller support. Overlays in black and Wolcen gold."
made_with = "Xbox controller"

[[rules]]
kind = "steam_app_id"
value = "424370"
profile = "Wolcen: Lords of Mayhem"

[[rules]]
kind = "executable"
value = "Wolcen.exe"
profile = "Wolcen: Lords of Mayhem"

[[profiles]]
name = "Wolcen: Lords of Mayhem"
combos = []
combo_window_ms = 120
tap_window_ms = 250
long_press_ms = 500

[profiles.buttons]
Guide = { mode = "Guide" }
South = { mouse = "Left" }
East = { keys = ["KEY_SPACE"] }
West = { keys = ["KEY_1"] }
North = { keys = ["KEY_2"] }
LeftBumper = { keys = ["KEY_Q"] }
RightBumper = { keys = ["KEY_3"] }
Select = { open_menu = "Screens" }
Start = { keys = ["KEY_ESC"] }
LeftStick = { toggle = { action = { keys = ["KEY_LEFTSHIFT"] } } }
RightStick = { keys = ["KEY_LEFTALT"] }
DpadUp = { keys = ["KEY_TAB"] }
DpadDown = { keys = ["KEY_M"] }
DpadLeft = { wheel = "Up" }
DpadRight = { wheel = "Down" }


[profiles.left_stick]
deadzone = 0.15
curve = 1.5
key_threshold = 0.5

[profiles.left_stick.action.mouse]
speed = 1700.0
accel = 0.2

[[profiles.left_stick.zones]]
min = 0.85
max = 1.0
action = { mouse = "Left" }

[profiles.right_stick]
deadzone = 0.1
curve = 1.8
key_threshold = 0.5

[profiles.right_stick.action.mouse]
speed = 900.0
accel = 0.3

[profiles.left_trigger.action.button]
threshold = 0.4
action = { mouse = "Right" }

[profiles.right_trigger.action.button]
threshold = 0.3
action = { keys = ["KEY_4"] }

[profiles.guide]
notes = '''Neither stick can walk the hero directly, because the game moves only by clicking: the left stick {ls} sweeps the pointer quickly, and a full push also holds the left mouse button, so the hero walks toward the pointer and attacks what's under it. Push it toward where you want to go and keep it there. The right stick {rs} moves the pointer slowly, for aiming and the inventory.
{south} left-clicks: walk, attack, pick up, talk. {lt} uses the skill on the right mouse button. {west} {north} {rb} {rt} cast skills 1 to 4. {east} is the {b}dodge roll{/b}, toward the pointer. {lb} drinks a {color:green}health potion{/color}.
Click {l3} to stand still and attack in place (Shift, toggled; click again to walk). Hold {r3} to show the items on the ground. {up} shows the map over the game, {down} the full map, {left} and {right} zoom (if the game zooms).
{select} lists the character sheet, inventory, skills, the Gate of Fates (the passive tree) and quests. {start} is the menu and closes the open windows; the game saves on its own. Naming the hero: {guide} + {west} opens the on-screen keyboard.
The game has no controller support. The keys are its defaults as remembered, not checked on an install: 1 to 4 for skills, Space to roll, Q for the potion, Tab and M for the maps, Shift to stand still, Alt for the items, C I K P J for the screens; the potion, the Gate of Fates and the quests keys are the least sure. If one doesn't answer, check Options, Controls and change the buttons here to match. The executable name is the one Discord lists.'''

[profiles.guide.edits]
"stick:Left" = { text = "Pointer · full push: walk" }
"stick:Right" = { text = "Pointer (fine)" }
"trigger:Right" = { text = "Skill 4" }
"trigger:Left" = { text = "Right-click skill" }
"button:South" = { text = "Click: walk · attack · use" }
"button:East" = { text = "{icon:fast} Dodge roll" }
"button:West" = { text = "Skill 1" }
"button:North" = { text = "Skill 2" }
"button:RightBumper" = { text = "Skill 3" }
"button:LeftBumper" = { text = "{color:red}{icon:potion}{/color} Potion" }
"button:Select" = { text = "{icon:book} Character, skills, fates" }
"button:Start" = { text = "Menu" }
"button:LeftStick" = { text = "Stand still (toggle)" }
"button:RightStick" = { text = "Hold: {icon:eye} show items" }
"button:DpadUp" = { text = "{icon:map} Map overlay" }
"button:DpadDown" = { text = "{icon:globe} Full map" }

[[profiles.guide.merged]]
inputs = ["button:DpadLeft", "button:DpadRight"]
text = "Zoom"


