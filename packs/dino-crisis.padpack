format = 20
macros = []
overlay_font = "Rajdhani"

[pack]
id = "892a7e9b-c0f1-5e5d-94eb-c59cee03ee72"
name = "Dino Crisis"
version = "1.0"
author = "Padwight"
description = "Dino Crisis on an Xbox-style pad. The pad sends the keyboard keys the game uses: tank controls on the arrows."
made_with = "Xbox controller"

[[rules]]
kind = "steam_app_id"
value = "4249130"
profile = "Dino Crisis"

[[rules]]
kind = "executable"
value = "4249130_launcher.exe"
profile = "Dino Crisis"

[[profiles]]
name = "Dino Crisis"
combos = []
combo_window_ms = 120
tap_window_ms = 250
long_press_ms = 500

[profiles.buttons]
Guide = {mode = "Guide"}
South = {keys = ["KEY_C"]}
East = {keys = ["KEY_V"]}
DpadUp = {keys = ["KEY_UP"]}
DpadDown = {keys = ["KEY_DOWN"]}
Start = {keys = ["KEY_Q"]}
North = {keys = ["KEY_Z"]}
LeftBumper = {keys = ["KEY_B"]}
RightBumper = {keys = ["KEY_S"]}
DpadLeft = {keys = ["KEY_LEFT"]}
DpadRight = {keys = ["KEY_RIGHT"]}

[profiles.left_stick]
deadzone = 0.15
curve = 1.0
key_threshold = 0.35

[profiles.left_stick.action.ring]
sectors = 8
start_angle = 0.0
inner_radius = 0.35
hysteresis = 0.1

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_UP"]

[[profiles.left_stick.action.ring.actions]]
multi = [{ keys = ["KEY_UP"] }, { keys = ["KEY_RIGHT"] }]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_RIGHT"]

[[profiles.left_stick.action.ring.actions]]
multi = [{ keys = ["KEY_DOWN"] }, { keys = ["KEY_RIGHT"] }]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_DOWN"]

[[profiles.left_stick.action.ring.actions]]
multi = [{ keys = ["KEY_DOWN"] }, { keys = ["KEY_LEFT"] }]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_LEFT"]

[[profiles.left_stick.action.ring.actions]]
multi = [{ keys = ["KEY_UP"] }, { keys = ["KEY_LEFT"] }]

[profiles.right_stick]
deadzone = 0.12
curve = 1.7
key_threshold = 0.5

[profiles.right_stick.action.mouse]
speed = 1400.0
accel = 0.3

[profiles.left_trigger.action.button]
threshold = 0.4
action = {keys = ["KEY_Z"]}

[profiles.right_trigger.action.button]
threshold = 0.3
action = {keys = ["KEY_S"]}

[profiles.gyro]
enabled = false
horizontal = "yaw"
invert_x = false
invert_y = false
noise_threshold = 1.0

[profiles.guide]
notes = '''The stick and {dpad} are tank controls: left and right turn, up walks, down backs away. {south} acts and fires, hold {east} to run, {rb} readies the weapon.
Buttons: {south} Action / shoot; {east} Run (hold) / cancel; {start} Pause; {north} Status: items, files; {lb} Quick turn; {rb} Ready weapon.
Released in 2000, before XInput, so the pad sends keys. The keys follow the Resident Evil pack for the same engine family (C action, V run and cancel, Z status, B quick turn, S ready weapon, Q pause), not checked in Dino Crisis itself. Keys are the game's defaults as remembered, not read from an install; if one doesn't answer, check the game's controls options and change the buttons here to match. The Windows executable is from Discord's list. The game predates XInput, so the pad sends the keys its controls use.
Typing a name or text: {guide} + {west} opens the on-screen keyboard.'''

[profiles.guide.edits]
"stick:Left" = {text = "Move"}
"stick:Right" = {text = "Pointer"}
"trigger:Right" = {text = "Ready weapon"}
"trigger:Left" = {text = "Status"}
"button:South" = {text = "{icon:hand} Action / shoot"}
"button:East" = {text = "{icon:fast} Run (hold) / cancel"}
"button:Start" = {text = "Pause"}
"button:North" = {text = "{icon:bag} Status: items, files"}
"button:LeftBumper" = {text = "{icon:rotate} Quick turn"}
"button:RightBumper" = {text = "{icon:crosshair} Ready weapon"}



[keyboard_style]
