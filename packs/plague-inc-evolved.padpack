position = "center"
scale = 1.0

[menu_style.background]
color = "#0d1215"
opacity = 0.92

[menu_style.items]
color = "#1c2a2e"
opacity = 0.95

[menu_style.selected]
color = "#c0392b"
opacity = 1.0

[menu_style.border]
width = 1
color = "#8c2a20"
opacity = 0.8

[menu_style.gradient]
color = "#141d20"
opacity = 1.0
angle = 180
