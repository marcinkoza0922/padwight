action = { multi = [{ layer = "Aim" }, { mouse = "Right" }] }

[profiles.right_trigger.action.button]
threshold = 0.3
action = { mouse = "Left" }

[profiles.guide]
notes = '''{start} (Escape) opens the game's menu and closes the inventory, the PDA and dialogs. Double tap {start} to quick save (F6) and hold it to quick load (F7).
{south} uses, talks and picks up; hold {south} to sprint (X). {east} jumps, {west} reloads and a long press of {west} changes ammo type. {north} switches the flashlight, and a long press of {north} night vision (with a suit that has it). A light push of the left stick {ls} walks quietly, and {l3} toggles crouch.
Hold {lt} to aim down the sights; the game aims only while the right mouse button is held. The right stick turns more finely while it's held.
Hold {lb} for the weapon ring, aiming with the right stick {rs}: knife, pistol, rifle, grenades, binoculars, bolt and drop. {up} and {down} step through the weapon slots, and {left} and {right} lean. {r3} switches to the grenade launcher or other attachment.
{rb} takes out a grenade (press again to change type); throw it with {rt}. {select} opens the inventory, and a long press of {select} the PDA.
In the inventory, trading, the PDA and dialogs the right stick moves the pointer, {rt} clicks and {lt} right-clicks (use, drop and the like). Throw bolts at shimmering air to find anomalies.
The game reads the keyboard in exclusive mode, so other programs don't see its keys; that doesn't stop the pad, which reaches it as a keyboard and mouse. OpenXRay, the open-source engine that runs the game natively on Linux, has gamepad support of its own; this setup is for the original game. The Enhanced Edition has native controller support and isn't covered here.
These are the game's default keys, written from memory and not checked in the game (sprint, ammo type and attachment especially). Compare them with Options → Controls and change the buttons here to match. The gyro's real-world turn assumes the default mouse sensitivity of 0.12 and is worked out, not measured; set the full turn to 314 divided by your sensitivity.'''

[profiles.guide.edits]
"stick:Left" = { text = "Move · light push: walk" }
"stick:Right" = { text = "Look" }
"trigger:Right" = { text = "Fire" }
"trigger:Left" = { text = "{icon:scope} Aim" }
"button:South" = { text = "{icon:hand} Use · talk" }
"gesture:button:South:long_press" = { text = "Sprint (hold)" }
"button:East" = { text = "Jump" }
"button:West" = { text = "Reload" }
"gesture:button:West:long_press" = { text = "Ammo type" }
"button:North" = { text = "{icon:flashlight} Flashlight" }
"gesture:button:North:long_press" = { text = "{icon:eye} Night vision" }
"button:LeftBumper" = { text = "Hold: weapons" }
"button:RightBumper" = { text = "{icon:grenade} Grenade" }
"button:LeftStick" = { text = "Crouch (toggle)" }
"button:RightStick" = { text = "{icon:rocket} Attachment" }
"button:Select" = { text = "{icon:bag} Inventory" }
"gesture:button:Select:long_press" = { text = "{icon:pda} PDA" }
"button:Start" = { text = "Menu" }
"gesture:button:Start:double_tap" = { text = "{icon:save} Quick save" }
"gesture:button:Start:long_press" = { text = "{icon:load} Quick load" }

