opacity = 0.92

[media_style.items]
color = "#24231a"
opacity = 0.95

[media_style.selected]
color = "#a88a3e"
opacity = 1.0

[media_style.border]
width = 1
color = "#c9a95a"
opacity = 0.5

[media_style.gradient]
color = "#1b1a14"
opacity = 1.0
angle = 180

[media_style.item_border]
width = 1
color = "#4a4532"

[media_style.type]
case = "upper"
letter_spacing = 1

[menu_style]
corners = 0.05
position = "center"
scale = 1.0

[menu_style.background]
color = "#13130f"
opacity = 0.92

[menu_style.items]
color = "#24231a"
opacity = 0.95

[menu_style.selected]
color = "#a88a3e"
opacity = 1.0

[menu_style.border]
width = 1
color = "#c9a95a"
opacity = 0.5

[menu_style.gradient]
color = "#1b1a14"
opacity = 1.0
angle = 180

[menu_style.item_border]
width = 1
color = "#4a4532"

[menu_style.glow]
color = "#c9a95a"
opacity = 0.2
blur = 20

[menu_style.type]
case = "upper"
letter_spacing = 1

[menu_style.ornament]
frame = {kind = "chamfer", size = 12, width = 2, color = "#c9a95a"}
concrete = {opacity = 0.35}
vignette = {color = "#000000", opacity = 0.55, reach = 28}

[motion]
keyboard = "grim"
numpad = "grim"
menu = "grim"
media = "grim"
offer = "grim"
info = "grim"
log = "grim"

[sounds.menu]
step = {kind = "geiger", volume = 0.1}
pick = {kind = "latch", volume = 0.25}
open = {kind = "radio", volume = 0.08}
close = {kind = "swish", volume = 0.03, pitch = 0.7}

[sounds.guide]
open = {kind = "radio", volume = 0.08}

[sounds.keyboard]
step = {kind = "click", volume = 0.08, pitch = 0.8}
pick = {kind = "keys", volume = 0.2}

[sounds.numpad]
step = {kind = "click", volume = 0.08, pitch = 0.8}
pick = {kind = "beep", volume = 0.12, pitch = 0.8}

[rumble.menu]
step = {strength = 0.1, length_ms = 16}
pick = {strength = 0.4, length_ms = 35}

[rumble.keyboard]
step = {strength = 0.08, length_ms = 12}
pick = {strength = 0.3, length_ms = 22}

[rumble.numpad]
step = {strength = 0.08, length_ms = 12}
pick = {strength = 0.3, length_ms = 22}

[rumble.media]
pick = {strength = 0.3, length_ms = 25}

[rumble.guide]
mode = {strength = 0.3, length_ms = 60}
