format = 20
macros = []
overlay_font = "Special Elite"

[pack]
id = "839b265e-9293-4520-965a-3c100c7e047e"
name = "S.T.A.L.K.E.R.: Shadow of Chernobyl"
version = "1.0"
author = "Padwight"
description = "S.T.A.L.K.E.R.: Shadow of Chernobyl on an Xbox-style pad, for the game's default keys. A uses and, held, sprints, B jumps, X reloads (hold it for ammo type), Y is the flashlight (hold it for night vision), RT fires and LT aims. A light push of the left stick walks, L3 toggles crouch and R3 switches to the attachment. Hold LB for the weapon ring, RB takes out a grenade, the D-pad leans and steps through weapons, and Select opens the inventory (hold it for the PDA). Start is the menu; double tap it to quick save, hold it to quick load. The game has no controller support. Gyro and flick stick profiles are included to try."
made_with = "Xbox controller"

[[rules]]
kind = "steam_app_id"
value = "4500"
profile = "S.T.A.L.K.E.R.: Shadow of Chernobyl"

[[rules]]
kind = "steam_app_id"
value = "4830"
profile = "S.T.A.L.K.E.R.: Shadow of Chernobyl"

[[rules]]
