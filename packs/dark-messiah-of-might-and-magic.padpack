format = 20
macros = []
overlay_font = "Cinzel"

[pack]
id = "e79734c1-1f3d-4309-8cef-e74a5379d1ad"
name = "Dark Messiah of Might and Magic"
version = "1.0"
author = "Padwight"
description = "Dark Messiah of Might and Magic (2006) on an Xbox-style pad, for the game's default keys. RT attacks (hold it for a power attack) and LT parries, A uses and grabs and, held, sprints, B jumps, X kicks and Y is the special ability. A light push of the left stick walks, L3 toggles crouch and R3 zooms with a bow. Hold LB for the belt ring, the D-pad leans and steps through the belt, and Select is the inventory (hold it for the objectives). Start is the menu; double tap it to quick save, hold it to quick load. The game has no controller support. Gyro and flick stick profiles are included to try."
made_with = "Xbox controller"

[[rules]]
kind = "steam_app_id"
value = "2100"
profile = "Dark Messiah of Might and Magic"

[[rules]]
kind = "executable"
value = "Dark Messiah Might and Magic Single Player/mm.exe"
profile = "Dark Messiah of Might and Magic"

[[profiles]]
name = "Dark Messiah of Might and Magic"
combos = []
combo_window_ms = 120
tap_window_ms = 250
long_press_ms = 300

[profiles.buttons]
Guide = { mode = "Guide" }
South = { keys = ["KEY_E"] }
East = { keys = ["KEY_SPACE"] }
West = { keys = ["KEY_F"] }
North = { keys = ["KEY_V"] }
LeftBumper = { open_menu = "Belt" }
LeftStick = { toggle = { action = { keys = ["KEY_LEFTCTRL"] } } }
RightStick = { keys = ["KEY_R"] }
Select = { keys = ["KEY_TAB"] }
Start = { keys = ["KEY_ESC"] }
DpadUp = { wheel = "Up" }
DpadDown = { wheel = "Down" }
DpadLeft = { keys = ["KEY_Z"] }
DpadRight = { keys = ["KEY_X"] }

[profiles.gestures.South]
long_press = { keys = ["KEY_LEFTSHIFT"] }

[profiles.gestures.Select]
long_press = { keys = ["KEY_O"] }

[profiles.gestures.Start]
double_tap = { keys = ["KEY_F6"] }
long_press = { keys = ["KEY_F9"] }

[profiles.left_stick]
