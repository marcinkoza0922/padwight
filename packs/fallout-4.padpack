format = 20
macros = []
overlay_font = "VT323"

[pack]
id = "f8de536d-1cef-5175-b77c-63e8590c0155"
name = "Fallout 4"
version = "1.0"
author = "Padwight"
description = "Fallout 4 (2015) on an Xbox-style pad. The game has its own controller support, so the controller passes through untouched and the game's own options set the buttons. Padwight adds the Guide overlay on top, with the on-screen keyboard and the media controls, in the Vault-Tec blue of the Commonwealth."
made_with = "Xbox controller"

[[rules]]
kind = "executable"
value = "Fallout4.exe"
profile = "Fallout 4"

[[rules]]
kind = "steam_app_id"
value = "377160"
profile = "Fallout 4"

[[profiles]]
name = "Fallout 4"
combos = []
combo_window_ms = 120
tap_window_ms = 250
long_press_ms = 500

[profiles.buttons]
South = {gamepad = "South"}
East = {gamepad = "East"}
North = {gamepad = "North"}
West = {gamepad = "West"}
LeftBumper = {gamepad = "LeftBumper"}
RightBumper = {gamepad = "RightBumper"}
LeftStick = {gamepad = "LeftStick"}
RightStick = {gamepad = "RightStick"}
Select = {gamepad = "Select"}
Start = {gamepad = "Start"}
DpadUp = {gamepad = "DpadUp"}
DpadDown = {gamepad = "DpadDown"}
DpadLeft = {gamepad = "DpadLeft"}
DpadRight = {gamepad = "DpadRight"}
Guide = {mode = "Guide"}

[profiles.left_stick]
deadzone = 0.05
curve = 1.0
key_threshold = 0.3

[profiles.left_stick.action]
gamepad = {stick = "Left", invert_y = false}

[profiles.right_stick]
deadzone = 0.05
curve = 1.0
key_threshold = 0.3

[profiles.right_stick.action]
gamepad = {stick = "Right", invert_y = false}

[profiles.left_trigger]
action = {gamepad = "Left"}

[profiles.right_trigger]
action = {gamepad = "Right"}

[profiles.gyro]
mode = "off"
horizontal = "yaw"
invert_x = false
invert_y = false
activation = "always"
noise_threshold = 1.0

[profiles.guide]
notes = '''Fallout 4 has its own controller support, so the controller goes to the game as it is. Set the buttons in the game's own Settings → Controls.
{guide} still works over the game: {guide} + {west} opens the on-screen keyboard, and {guide} + {lb} the media controls.
If the game stops answering the pad, check that Steam Input or another remapper isn't also running for it.'''

[keyboard_style]
corners = 0.15
position = "bottom_center"
scale = 1.0

[keyboard_style.background]
color = "#06121a"
opacity = 0.92

[keyboard_style.items]
color = "#0c2636"
opacity = 0.95

[keyboard_style.selected]
color = "#3fb8e8"
opacity = 1.0

[keyboard_style.border]
width = 1
color = "#3fb8e8"
opacity = 0.8

[keyboard_style.gradient]
color = "#09192a"
opacity = 1.0
angle = 180

[keyboard_style.item_border]
width = 1
color = "#1b5878"

[keyboard_style.type]
letter_spacing = 1
case = "upper"

[numpad_style]
corners = 0.15
position = "center"
scale = 1.0

[numpad_style.background]
color = "#06121a"
opacity = 0.92

[numpad_style.items]
color = "#0c2636"
opacity = 0.95

[numpad_style.selected]
color = "#3fb8e8"
opacity = 1.0

[numpad_style.border]
width = 1
color = "#3fb8e8"
opacity = 0.8

[numpad_style.gradient]
color = "#09192a"
opacity = 1.0
angle = 180

[numpad_style.item_border]
width = 1
color = "#1b5878"

[numpad_style.type]
letter_spacing = 1
case = "upper"

[media_style]
corners = 0.15
position = "top_right"
scale = 0.9

[media_style.background]
color = "#06121a"
opacity = 0.92

[media_style.items]
color = "#0c2636"
opacity = 0.95

[media_style.selected]
color = "#3fb8e8"
opacity = 1.0

[media_style.border]
width = 1
color = "#3fb8e8"
opacity = 0.8

[media_style.gradient]
color = "#09192a"
opacity = 1.0
angle = 180

[media_style.item_border]
width = 1
color = "#1b5878"

[media_style.type]
letter_spacing = 1
case = "upper"

[menu_style]
corners = 0.15
position = "center"
scale = 1.0

[menu_style.background]
color = "#06121a"
opacity = 0.92

[menu_style.items]
color = "#0c2636"
opacity = 0.95

[menu_style.selected]
color = "#3fb8e8"
opacity = 1.0

[menu_style.border]
width = 1
color = "#3fb8e8"
opacity = 0.8

[menu_style.gradient]
color = "#09192a"
opacity = 1.0
angle = 180

[menu_style.item_border]
width = 1
color = "#1b5878"

[menu_style.glow]
color = "#7fdcff"
opacity = 0.6
blur = 18
pulse = true

[menu_style.type]
letter_spacing = 1
case = "upper"

[menu_style.ornament]
scanlines = {spacing = 3, opacity = 0.2, color = "#000000", drift = true}
vignette = {color = "#000000", opacity = 0.5, reach = 20}

[motion]
keyboard = "retro"
numpad = "retro"
menu = "retro"
media = "retro"
offer = "retro"
info = "retro"
log = "retro"

[sounds.menu]
step = {kind = "geiger", volume = 0.1}
pick = {kind = "beep", volume = 0.16, pitch = 0.9, length = 0.8}
open = {kind = "blip", volume = 0.06, pitch = 0.7}
close = {kind = "blip", volume = 0.05, pitch = 0.55}

[sounds.keyboard]
step = {kind = "geiger", volume = 0.1}
pick = {kind = "typewriter", volume = 0.2, length = 0.6}

[sounds.numpad]
step = {kind = "geiger", volume = 0.1}
pick = {kind = "typewriter", volume = 0.2, length = 0.6}

[sounds.media]
pick = {kind = "typewriter", volume = 0.2, length = 0.6}

[rumble.menu]
step = {strength = 0.1, length_ms = 18}
pick = {strength = 0.35, length_ms = 35}

[rumble.keyboard]
step = {strength = 0.07, length_ms = 14}
pick = {strength = 0.24, length_ms = 22}

[rumble.numpad]
step = {strength = 0.07, length_ms = 14}
pick = {strength = 0.24, length_ms = 22}

[rumble.media]
pick = {strength = 0.24, length_ms = 25}

[rumble.guide]
mode = {strength = 0.24, length_ms = 60}
