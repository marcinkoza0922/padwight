format = 20
macros = []
overlay_font = "Silkscreen"

[pack]
id = "23de066e-3978-4a64-9be9-a0459a63735a"
name = "GZDoom"
version = "1.0"
author = "Padwight"
description = "GZDoom, the Doom source port that runs Doom, Doom II, Heretic, Hexen and most mods, on an Xbox-style pad for its default keys. A uses, B jumps, RT fires, X reloads, LT is the alternate fire, L3 toggles crouch, and the d-pad sends the arrow keys. Hold LB for the weapon ring, aiming with the right stick, RB cycles to the next weapon and Y to the previous. Start is the menu; double tap it to quick save, hold it to quick load. Gyro and flick stick profiles are included to try."
made_with = "Xbox controller"

[[rules]]
kind = "executable"
value = "gzdoom.exe"
profile = "GZDoom"

[[rules]]
kind = "executable"
value = "gzdoom"
profile = "GZDoom"

[[profiles]]
name = "GZDoom"
combos = []
combo_window_ms = 120
tap_window_ms = 250
long_press_ms = 500

[profiles.buttons]
Guide = { mode = "Guide" }
South = { keys = ["KEY_E"] }
East = { keys = ["KEY_SPACE"] }
West = { keys = ["KEY_R"] }
North = { wheel = "Down" }
LeftBumper = { open_menu = "Weapons" }
RightBumper = { wheel = "Up" }
Select = { keys = ["KEY_TAB"] }
Start = { keys = ["KEY_ESC"] }
LeftStick = { toggle = { action = { keys = ["KEY_C"] } } }
RightStick = { keys = ["KEY_V"] }
DpadUp = { keys = ["KEY_UP"] }
DpadDown = { keys = ["KEY_DOWN"] }
DpadLeft = { keys = ["KEY_LEFT"] }
DpadRight = { keys = ["KEY_RIGHT"] }
[profiles.gestures.Start.double_tap]
keys = ["KEY_F6"]

[profiles.gestures.Start.long_press]
keys = ["KEY_F9"]

[profiles.left_stick]
deadzone = 0.12
curve = 1.0
key_threshold = 0.25

[profiles.left_stick.action.ring]
sectors = 8
start_angle = 0.0
inner_radius = 0.25
hysteresis = 0.1

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_W"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_W"] },
    { keys = ["KEY_D"] },
]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_D"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_S"] },
    { keys = ["KEY_D"] },
]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_S"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_S"] },
    { keys = ["KEY_A"] },
]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_A"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_W"] },
    { keys = ["KEY_A"] },
]

[profiles.right_stick]
deadzone = 0.1
curve = 1.8
key_threshold = 0.5

[profiles.right_stick.action.mouse]
speed = 1000.0
accel = 0.2

[profiles.left_trigger.action.button]
threshold = 0.4
action = { multi = [{ layer = "Zoom" }, { mouse = "Right" }] }

[profiles.right_trigger.action.button]
threshold = 0.3
action = { mouse = "Left" }

[profiles.guide]
notes = '''{start} (Escape) opens the game's menu and backs out of every screen in it.
Hold {lb} for the weapon ring, aiming with the right stick {rs}. {rb} switches to the next weapon and {north} to the previous one.
{south} uses doors and switches, {west} reloads in mods that have it, {east} jumps in mods and maps that allow it, and {l3} toggles crouch.
{lt} is the alternate fire, or aim down sights in mods that use it. The right stick turns more slowly while it is held. {r3} is the zoom key.
The d-pad {dpad} sends the arrow keys, for the menus, the automap and the console's history.
Quick save is a double tap of {start}, and quick load is a long press of {start}.
{select} (Tab) shows the automap.
These are GZDoom's default keys, written from memory and not checked in the game. Turn on Always Run in the options. If a button does nothing, compare the game's Customize Controls screen with the keys here.'''

[profiles.guide.edits]
"stick:Left" = { text = "Move" }
"stick:Right" = { text = "Look" }
"trigger:Right" = { text = "Fire" }
"button:Select" = { text = "Automap" }
"button:Start" = { text = "Menu / back out" }
"gesture:button:Start:double_tap" = { text = "{icon:save} Quick save" }
"gesture:button:Start:long_press" = { text = "{icon:load} Quick load" }
"trigger:Left" = { text = "Alt fire / aim" }
"button:South" = { text = "Use" }
"button:East" = { text = "Jump" }
"button:West" = { text = "Reload" }
"button:North" = { text = "Previous weapon" }
"button:LeftBumper" = { text = "Hold: weapons" }
"button:RightBumper" = { text = "Next weapon" }
"button:LeftStick" = { text = "Crouch (toggle)" }
"button:RightStick" = { text = "Zoom" }

