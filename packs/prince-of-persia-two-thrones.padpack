format = 20
macros = []
overlay_font = "Cinzel"

[pack]
id = "05a27d21-924d-5c56-9b4e-7d6400eb2476"
name = "Prince of Persia: The Two Thrones"
version = "1.0"
author = "Padwight"
description = "Prince of Persia: The Two Thrones (GOG, 2005) on an Xbox-style pad, laid out like the original Xbox release for the game's default keys. A jumps, X attacks, Y starts speed kills, uses the second weapon and grabs, B picks up and throws weapons. RT runs on walls and blocks, LT rewinds (tap: slow time). LB is the landscape view, R3 looks in first person and D-pad down puts the camera behind the Prince."
made_with = "Xbox controller"

[[rules]]
kind = "executable"
value = "pop3.exe"
profile = "Prince of Persia: The Two Thrones"

[[rules]]
kind = "steam_app_id"
value = "13530"
profile = "Prince of Persia: The Two Thrones"

[[rules]]
kind = "executable"
value = "Prince of Persia Two Thrones/PrinceOfPersia.exe"
profile = "Prince of Persia: The Two Thrones"

[[profiles]]
name = "Prince of Persia: The Two Thrones"
combos = []
combo_window_ms = 120
tap_window_ms = 250
long_press_ms = 500

[profiles.buttons]
Guide = {mode = "Guide"}
South = {keys = ["KEY_SPACE"]}
West = {mouse = "Left"}
North = {keys = ["KEY_E"]}
East = {keys = ["KEY_C"]}
LeftBumper = {keys = ["KEY_Q"]}
RightStick = {keys = ["KEY_F"]}
Start = {keys = ["KEY_ESC"]}
DpadDown = {keys = ["KEY_X"]}

[profiles.left_stick]
deadzone = 0.12
curve = 1.0
key_threshold = 0.25

[profiles.left_stick.action.ring]
sectors = 8
start_angle = 0.0
inner_radius = 0.25
hysteresis = 0.1

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_W"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_W"] },
    { keys = ["KEY_D"] },
]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_D"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_S"] },
    { keys = ["KEY_D"] },
]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_S"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_S"] },
    { keys = ["KEY_A"] },
]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_A"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_W"] },
    { keys = ["KEY_A"] },
]

[profiles.right_stick]
deadzone = 0.1
curve = 1.8
key_threshold = 0.5

[profiles.right_stick.action.mouse]
speed = 1300.0
accel = 0.2

[profiles.left_trigger.action.button]
threshold = 0.3
action = {keys = ["KEY_R"]}

[profiles.right_trigger.action.button]
threshold = 0.3
action = {mouse = "Right"}

[profiles.gyro]
enabled = false
horizontal = "yaw"
invert_x = false
invert_y = false
noise_threshold = 1.0

[profiles.guide]
notes = '''This is the original Xbox layout: {south} jumps, {west} strikes with the sword and {north} uses the dagger. Hold {rt} to run along walls, swing, push and pull, and to block in a fight.
Hold {lt} to rewind time and let go when the Prince is safe. Tap {lt} to slow time. While blocking with {rt}, press {lt} for the Breath of Fate and hold it for a few seconds for the Sand Storm.
When the Prince waits unseen behind an enemy, press {north} to start a speed kill, then press {west} each time the dagger flashes. In the chariot races the left stick {ls} steers and {west} strikes boarders.
Press {down} to put the camera behind the Prince.
Click {r3} to look around in first person, and press {lb} for the wide landscape view. {start} is the menu; the game saves at the save fountains.'''

[profiles.guide.edits]
"stick:Left" = {text = "Move"}
"stick:Right" = {text = "Camera"}
"trigger:Right" = {text = "Wall run, swing / block (hold)"}
"trigger:Left" = {text = "{icon:hourglass} {b}Rewind{/b} (hold) / slow time"}
"button:South" = {text = "Jump / roll"}
"button:West" = {text = "{icon:sword} {b}Attack{/b}"}
"button:North" = {text = "{icon:dagger} Speed kill / second weapon / grab"}
"button:East" = {text = "Pick up, throw / climb down"}
"button:LeftBumper" = {text = "{icon:mountain} Landscape view"}
"button:RightStick" = {text = "{icon:eye} Look (first person)"}
"button:Start" = {text = "Menu"}
"button:DpadDown" = {text = "Camera behind the Prince"}

