format = 20
macros = []
overlay_font = "Orbitron"

[pack]
id = "201ad110-bdfb-5ae8-a434-c872fae5a6e1"
name = "Star Trek: Starfleet Academy"
version = "1.0"
author = "Padwight"
description = "Star Trek: Starfleet Academy on an Xbox-style pad. The game's own pad support predates XInput, so the pad sends its keyboard keys: arrows walk and the face buttons act."
made_with = "Xbox controller"

[[rules]]
kind = "steam_app_id"
value = "364810"
profile = "Star Trek: Starfleet Academy"

[[rules]]
kind = "executable"
value = "sfad3d.exe"
profile = "Star Trek: Starfleet Academy"

[[profiles]]
name = "Star Trek: Starfleet Academy"
combos = []
combo_window_ms = 120
tap_window_ms = 250
long_press_ms = 500

[profiles.buttons]
Guide = {mode = "Guide"}
South = {keys = ["KEY_Z"]}
East = {keys = ["KEY_X"]}
Start = {keys = ["KEY_ESC"]}
West = {keys = ["KEY_C"]}

[profiles.left_stick]
deadzone = 0.15
curve = 1.0
key_threshold = 0.35

[profiles.left_stick.action.ring]
sectors = 8
start_angle = 0.0
inner_radius = 0.35
hysteresis = 0.1

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_UP"]

[[profiles.left_stick.action.ring.actions]]
multi = [{ keys = ["KEY_UP"] }, { keys = ["KEY_RIGHT"] }]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_RIGHT"]

[[profiles.left_stick.action.ring.actions]]
multi = [{ keys = ["KEY_DOWN"] }, { keys = ["KEY_RIGHT"] }]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_DOWN"]

[[profiles.left_stick.action.ring.actions]]
multi = [{ keys = ["KEY_DOWN"] }, { keys = ["KEY_LEFT"] }]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_LEFT"]

[[profiles.left_stick.action.ring.actions]]
multi = [{ keys = ["KEY_UP"] }, { keys = ["KEY_LEFT"] }]

[profiles.right_stick]
deadzone = 0.12
curve = 1.7
key_threshold = 0.5

[profiles.right_stick.action.mouse]
speed = 1400.0
accel = 0.3

[profiles.left_trigger.action.button]
threshold = 0.4
action = {mouse = "Right"}

[profiles.right_trigger.action.button]
threshold = 0.3
action = {mouse = "Left"}

[profiles.gyro]
enabled = false
horizontal = "yaw"
invert_x = false
invert_y = false
noise_threshold = 1.0

[profiles.guide]
notes = '''The arrow keys move. {south} confirms, {east} cancels, {west} acts, and {start} opens the menu.
Buttons: {south} Confirm; {east} Cancel; {start} Menu; {west} Action.
The game has some controller support, but it predates XInput or is limited, so this pack plays it with the keyboard keys. The keys are the usual defaults for the series, not checked on an install. Keys are the game's defaults as remembered, not read from an install; if one doesn't answer, check the game's controls options and change the buttons here to match. The Windows executable is from Steam's launch data. The game predates XInput, so the pad sends the keys its controls use.
Typing a name or text: {guide} + {west} opens the on-screen keyboard.'''

[profiles.guide.edits]
"stick:Left" = {text = "Move"}
"stick:Right" = {text = "Pointer"}
"trigger:Right" = {text = "Left click"}
"trigger:Left" = {text = "Right click"}
"button:South" = {text = "Confirm"}
"button:East" = {text = "Cancel"}
"button:Start" = {text = "Menu"}
"button:West" = {text = "Action"}



[keyboard_style]
corners = 0.05
position = "bottom_center"
scale = 1.0

[keyboard_style.background]
color = "#0b1624"
opacity = 0.93

[keyboard_style.items]
color = "#14304a"
opacity = 0.95

[keyboard_style.selected]
color = "#35c6e8"
opacity = 1.0

[keyboard_style.border]
width = 1
color = "#2a8fb0"
opacity = 0.8

[keyboard_style.gradient]
color = "#07101b"
opacity = 1.0
angle = 180

[keyboard_style.item_border]
width = 1
color = "#1f5a7a"

[keyboard_style.type]
letter_spacing = 1
case = "upper"

