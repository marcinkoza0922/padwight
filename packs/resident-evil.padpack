format = 20
macros = []
overlay_font = "Special Elite"

[pack]
id = "a78c9ec0-f4cc-4f3f-981e-3ac1c68c4f4c"
name = "Resident Evil"
version = "1.0"
author = "Padwight"
description = "Resident Evil (GOG, the 1996 Windows release) on an Xbox-style pad, laid out like the PlayStation original for the game's default keys. Tank controls on the stick and D-pad, A to open and examine, B to run and back out, RB to ready the weapon and Y for the status screen. The menus and keyboard are a typewriter, ink ribbon and all."
made_with = "Xbox controller"

[[rules]]
kind = "executable"
value = "ResidentEvil.exe"
profile = "Resident Evil"


[[profiles]]
name = "Resident Evil"
combos = []
combo_window_ms = 120
tap_window_ms = 250
long_press_ms = 500

[profiles.buttons]
Guide = {mode = "Guide"}
South = {keys = ["KEY_C"]}
East = {keys = ["KEY_V"]}
North = {keys = ["KEY_Z"]}
RightBumper = {keys = ["KEY_X"]}
Select = {open_menu = "Keys"}
Start = {keys = ["KEY_LEFTCTRL"]}
DpadUp = {keys = ["KEY_UP"]}
DpadDown = {keys = ["KEY_DOWN"]}
DpadLeft = {keys = ["KEY_LEFT"]}
DpadRight = {keys = ["KEY_RIGHT"]}

[profiles.left_stick]
deadzone = 0.2
curve = 1.0
key_threshold = 0.4

[profiles.left_stick.action.ring]
sectors = 8
start_angle = 0.0
inner_radius = 0.4
hysteresis = 0.1

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_UP"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_UP"] },
    { keys = ["KEY_RIGHT"] },
]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_RIGHT"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_DOWN"] },
    { keys = ["KEY_RIGHT"] },
]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_DOWN"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_DOWN"] },
    { keys = ["KEY_LEFT"] },
]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_LEFT"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_UP"] },
    { keys = ["KEY_LEFT"] },
]

[profiles.right_stick]
deadzone = 0.3
curve = 1.0
key_threshold = 0.5
action = "disabled"

[profiles.left_trigger.action.button]
threshold = 0.3
action = {keys = ["KEY_A"]}

[profiles.right_trigger.action.button]
threshold = 0.3
action = {keys = ["KEY_X"]}

[profiles.gyro]
mode = "off"
horizontal = "yaw"
invert_x = false
invert_y = false
activation = "always"
noise_threshold = 1.0

[profiles.guide]
notes = '''The layout follows the PlayStation original and the game's default keys. The stick and {dpad} turn and walk the way the game's tank controls expect: left and right turn, up walks, down backs away. Hold {east} to run and to back out of menus.
{south} checks, picks up and opens, and fires when the weapon is ready. Hold {rb} (or {rt}) to ready the weapon, then press {south} to shoot; push up or down to aim. {north} opens the status screen with the items, the files and the map. {lt} is the A key, the game's map.
{start} is Ctrl, the game's pause. {select} lists the other keys: Escape, Enter and Space.
The game saves only at typewriters, and each save costs an ink ribbon. There is no quick save.'''

[profiles.guide.edits]
"stick:Left" = {text = "{icon:footprints} Turn and walk"}
"trigger:Left" = {text = "{icon:map} Map"}
"trigger:Right" = {text = "{icon:holster} Ready weapon (hold)"}
"button:South" = {text = "{icon:hand} Action / fire"}
"button:East" = {text = "{icon:fast} Run (hold) / cancel"}
"button:North" = {text = "{icon:bag} Status: items, files, map"}
"button:RightBumper" = {text = "{icon:holster} Ready weapon (hold)"}
"button:Select" = {text = "{icon:key} Escape, Enter, Space"}
"button:Start" = {text = "{icon:pause} Pause"}

[[info_overlays]]
name = "Controls"
title = "Resident Evil"
rows = [
    ["{south}", "Action / fire", "{east}", "Run (hold) / cancel"],
    ["{rb} {rt}", "Ready weapon (hold)", "{north}", "Status screen"],
    ["{lt}", "Map", "{start}", "Pause"],
    ["{ls} {dpad}", "Turn and walk", "{select}", "Escape, Enter, Space"],
]

[info_overlays.style]
corners = 0.05
position = "top_right"
scale = 1.0

[info_overlays.style.background]
color = "#e8dfc6"
opacity = 0.96

[info_overlays.style.items]
