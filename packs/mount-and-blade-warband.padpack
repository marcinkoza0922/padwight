format = 20
macros = []
overlay_font = "Cinzel"

[pack]
id = "baecf4f9-7cd3-4161-bf15-830d9f9d1485"
name = "Mount & Blade: Warband"
version = "1.0"
author = "Padwight"
description = "Mount & Blade: Warband on an Xbox-style pad, for the game's default keys. The right stick looks and aims your swings, RT attacks, LT blocks, A uses, B jumps, X kicks, Y changes weapon mode. Hold LB for the orders ring and RB for the weapons ring; the D-pad cycles weapons and shields. Select lists the game's screens and the retreat key. Hold Select to switch to the Map mode, where the D-pad zooms the world map. Double tap Start to quick save. "
made_with = "Xbox controller"

[[rules]]
kind = "executable"
value = "mb_warband.exe"
profile = "Mount & Blade: Warband"

[[rules]]
kind = "steam_app_id"
value = "48700"
profile = "Mount & Blade: Warband"

[[profiles]]
name = "Mount & Blade: Warband"
combos = []
combo_window_ms = 120
tap_window_ms = 250
long_press_ms = 500

[profiles.buttons]
South = { keys = ["KEY_F"] }
East = { keys = ["KEY_SPACE"] }
West = { keys = ["KEY_E"] }
North = { keys = ["KEY_X"] }
LeftBumper = { open_menu = "Orders" }
RightBumper = { open_menu = "Weapons" }
Select = { open_menu = "Screens" }
Start = { keys = ["KEY_ESC"] }
Guide = { mode = "Guide" }
LeftStick = { toggle = { action = { keys = ["KEY_Z"] } } }
RightStick = { keys = ["KEY_R"] }
DpadUp = { open_menu = "Groups" }
DpadDown = { keys = ["KEY_BACKSPACE"] }
DpadLeft = { wheel = "Up" }
DpadRight = { wheel = "Down" }

[profiles.gestures.Select.long_press]
mode = "Map"

[profiles.gestures.Start.double_tap]
keys = ["KEY_F12"]

[profiles.left_stick]
deadzone = 0.12
curve = 1.0
key_threshold = 0.25

[profiles.left_stick.action.ring]
sectors = 8
start_angle = 0.0
inner_radius = 0.25
hysteresis = 0.1

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_W"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_W"] },
    { keys = ["KEY_D"] },
]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_D"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_S"] },
    { keys = ["KEY_D"] },
]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_S"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_S"] },
    { keys = ["KEY_A"] },
]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_A"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_W"] },
    { keys = ["KEY_A"] },
]

[profiles.right_stick]
deadzone = 0.1
curve = 1.6
key_threshold = 0.5

[profiles.right_stick.action.mouse]
speed = 1300.0
accel = 0.2

[profiles.left_trigger.action.button]
threshold = 0.4
action = { mouse = "Right" }

[profiles.right_trigger.action.button]
threshold = 0.3
action = { mouse = "Left" }

[profiles.guide]
notes = '''Aim your swings with the right stick {rs}: the way you move the mouse as you attack picks the direction, so push it up for an overhead, sideways for a slash or swing, and hold it still for a thrust. {rt} attacks and {lt} blocks, in the direction you are looking.
Hold {lb} for the orders ring and pick with the right stick. In a field battle the order menus are on F1 to F6 and the groups on the number keys: open Groups on {up} to choose who you are ordering, then the order. {down} shows the order view.
Hold {rb} for the weapons ring (the four item slots, drop weapon, change mode). {left} and {right} scroll to the next weapon and shield; {north} changes the weapon mode (one or two hands, arrows).
{l3} toggles crouch. {r3} is the first and third person view. {east} jumps, {west} kicks and {south} uses.
{select} lists the character, inventory, party, quest and log windows, plus Retreat (Tab, which leaves the battle). Hold {select} to switch to the Map mode, and again to switch back.
{start} is Escape: it opens the menu and backs out of every screen. A double tap of {start} quick saves.'''

[profiles.guide.edits]
"stick:Left" = { text = "Move" }
"stick:Right" = { text = "Look · aim the swing" }
"trigger:Right" = { text = "{icon:sword} Attack" }
"trigger:Left" = { text = "{icon:shield} Block" }
"button:South" = { text = "Use" }
"button:East" = { text = "Jump" }
"button:West" = { text = "Kick" }
"button:North" = { text = "Weapon mode" }
"button:LeftBumper" = { text = "Hold: orders" }
"button:RightBumper" = { text = "Hold: weapons" }
"button:LeftStick" = { text = "Crouch (toggle)" }
"button:RightStick" = { text = "First / third person" }
"button:DpadUp" = { text = "Order groups" }
"button:DpadDown" = { text = "Order view" }
"button:DpadLeft" = { text = "Next weapon" }
"button:DpadRight" = { text = "Next shield" }
"button:Select" = { text = "{icon:scroll} Screens · hold: map mode" }
"button:Start" = { text = "Menu / back out" }
"gesture:button:Start:double_tap" = { text = "{icon:save} Quick save" }

