[motion]
keyboard = "playful"
numpad = "playful"
menu = "playful"
media = "playful"
offer = "playful"
info = "playful"
log = "playful"

[sounds.menu]
step = {kind = "card", volume = 0.07}
pick = {kind = "coin", volume = 0.09}
open = {kind = "card", volume = 0.07, pitch = 1.1}
close = {kind = "card", volume = 0.06, pitch = 0.8}

[sounds.numpad]
step = {kind = "card", volume = 0.07}
pick = {kind = "coin", volume = 0.09}

[sounds.keyboard]
step = {kind = "card", volume = 0.07}
pick = {kind = "keys", volume = 0.12}

[sounds.media]
pick = {kind = "coin", volume = 0.09}
