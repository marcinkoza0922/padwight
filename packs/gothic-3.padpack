format = 20
macros = []
overlay_font = "Kreon"

[pack]
id = "b84c1e07-5a3d-4f29-8c6e-71e9d2f0a3b5"
name = "Gothic 3"
version = "1.0"
author = "Padwight"
description = "Gothic 3 (2006) on an Xbox-style pad, for the game's keys and mouse. The left stick walks (a light push walks slowly), the right stick turns and looks. RT attacks (hold it for a power blow) and A uses, talks and picks up, both the left mouse button; LT parries. B jumps, X draws and puts away the weapon, Y opens the inventory and L3 sneaks. Hold LB for the ten quick slots. Select lists the character, log and spellbook; Start is the menu, double tap it to quick save and hold it to quick load. Overlays in dark leather and old brass, the same as the Gothic II setup."
made_with = "Xbox controller"

[[rules]]
kind = "steam_app_id"
value = "39500"
profile = "Gothic 3"

[[rules]]
kind = "executable"
value = "Gothic3.exe"
profile = "Gothic 3"

[[profiles]]
name = "Gothic 3"
combos = []
combo_window_ms = 120
tap_window_ms = 250
long_press_ms = 500

[profiles.buttons]
Guide = { mode = "Guide" }
South = { mouse = "Left" }
East = { keys = ["KEY_LEFTALT"] }
West = { keys = ["KEY_SPACE"] }
North = { keys = ["KEY_I"] }
LeftBumper = { open_menu = "Quick slots" }
RightBumper = { keys = ["KEY_ENTER"] }
Select = { open_menu = "Screens" }
Start = { keys = ["KEY_ESC"] }
LeftStick = { toggle = { action = { keys = ["KEY_LEFTCTRL"] } } }
DpadUp = { wheel = "Up" }
DpadDown = { wheel = "Down" }
DpadLeft = { keys = ["KEY_Q"] }
DpadRight = { keys = ["KEY_E"] }

[profiles.gestures.Start]
double_tap = { keys = ["KEY_F5"] }
long_press = { keys = ["KEY_F9"] }

[profiles.left_stick]
deadzone = 0.12
curve = 1.0
key_threshold = 0.25

[profiles.left_stick.action.ring]
sectors = 8
start_angle = 0.0
inner_radius = 0.25
hysteresis = 0.1

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_W"]

[[profiles.left_stick.action.ring.actions]]
multi = [{ keys = ["KEY_W"] }, { keys = ["KEY_D"] }]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_D"]

[[profiles.left_stick.action.ring.actions]]
multi = [{ keys = ["KEY_S"] }, { keys = ["KEY_D"] }]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_S"]

[[profiles.left_stick.action.ring.actions]]
multi = [{ keys = ["KEY_S"] }, { keys = ["KEY_A"] }]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_A"]

[[profiles.left_stick.action.ring.actions]]
multi = [{ keys = ["KEY_W"] }, { keys = ["KEY_A"] }]

[[profiles.left_stick.zones]]
min = 0.0
max = 0.6
action = { keys = ["KEY_LEFTSHIFT"] }

[profiles.right_stick]
deadzone = 0.1
curve = 1.8
key_threshold = 0.5

[profiles.right_stick.action.mouse]
speed = 1300.0
accel = 0.2

[profiles.left_trigger.action.button]
threshold = 0.4
action = { mouse = "Right" }

[profiles.right_trigger.action.button]
threshold = 0.3
action = { mouse = "Left" }

[profiles.guide]
notes = '''The game has no controller support, so this plays it with the keys and mouse. The left stick {ls} walks and steps sideways (WASD), and a light push walks slowly (Shift held, the game's walk key as remembered; if a light push runs instead, the game has it the other way round). The right stick {rs} turns the hero and the camera.
{b}Fighting{/b}: {rt} strikes (the left mouse button); hold it for a heavy blow. {lt} parries and blocks (the right mouse button). With a bow or a spell drawn, {lt} aims and {rt} shoots or casts. {west} draws and puts away the weapon in hand.
{south} is the same left click out of a fight: talk, open, pick up, use. {east} jumps and climbs, {l3} sneaks (a toggle here, Ctrl). {left} and {right} turn on the spot (Q and E), {up} and {down} turn the mouse wheel to step through lists and zoom the camera.
Hold {lb} and point the right stick to use quick slot 1 to 0: fill the slots by dragging weapons, spells and potions onto the bar in the inventory. {north} opens the inventory; {select} lists the inventory, character, log and spellbook.
The inventory and trading take the pointer: the right stick moves it, {rt} clicks and {lt} right-clicks. Some items equip only with Enter while the pointer is on them: that's {rb}. {start} is the menu and backs out of every screen; double tap it to {color:green}quick save{/color}, hold it to quick load.
The keys are the game's defaults as listed by a community page and remembered, not checked on an install: WASD to move, Q and E to turn, Shift to walk or run, Ctrl to sneak, Alt to jump, Space for the weapon, I, C, L and B for the screens, 1 to 0 for the quick slots, F5 and F9 to save and load. The documents and map keys weren't found, so they aren't bound: use the map from the inventory. If one doesn't answer, check Options, Controls and change the buttons here to match. The executable (Gothic3.exe) is from Discord's list, the Steam app id is the wiki's. The Community Patch keeps these keys.'''

[profiles.guide.edits]
"stick:Left" = { text = "Walk · light push: slow" }
"stick:Right" = { text = "Turn · look" }
"trigger:Right" = { text = "{icon:sword} Strike · hold: heavy blow" }
"trigger:Left" = { text = "{icon:shield} Parry · aim" }
"button:South" = { text = "{icon:hand} Use · talk · pick up" }
"button:East" = { text = "Jump · climb" }
"button:West" = { text = "{icon:holster} Draw / put away" }
"button:North" = { text = "{icon:bag} Inventory" }
"button:LeftBumper" = { text = "Hold: quick slots 1 to 0" }
"button:RightBumper" = { text = "Enter (equip)" }
"button:Select" = { text = "{icon:scroll} Character, log, spells" }
"button:Start" = { text = "Menu · back" }
"gesture:button:Start:double_tap" = { text = "{icon:save} Quick save" }
"gesture:button:Start:long_press" = { text = "{icon:load} Quick load" }
"button:LeftStick" = { text = "{icon:footprints} Sneak" }
"button:DpadLeft" = { text = "{icon:rotate-left} Turn left" }
"button:DpadRight" = { text = "{icon:rotate} Turn right" }

[[profiles.guide.merged]]
