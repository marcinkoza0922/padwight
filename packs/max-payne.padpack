info = "grim"
log = "grim"

[sounds.menu]
step = {kind = "click", volume = 0.08, pitch = 0.9}
pick = {kind = "casing", volume = 0.16}
open = {kind = "heartbeat", volume = 0.3}
close = {kind = "swish", volume = 0.03, pitch = 0.6, length = 1.6}

[sounds.numpad]
step = {kind = "click", volume = 0.08, pitch = 0.9}
pick = {kind = "typewriter", volume = 0.18, length = 0.6}

[sounds.keyboard]
step = {kind = "click", volume = 0.08, pitch = 0.9}
pick = {kind = "typewriter", volume = 0.2, length = 0.6}

[rumble.menu]
step = {strength = 0.15, length_ms = 18}
pick = {strength = 0.5, length_ms = 40}
open = {strength = 0.35, length_ms = 90}

[rumble.keyboard]
