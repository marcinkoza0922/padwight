format = 19
macros = []
overlay_font = "Source Code Pro"

[pack]
id = "7b1d3c52-4f0a-4c1e-9a64-2e8f5d0b9a11"
name = "Max Payne"
version = "1.4"
author = "Padwight"
description = "Max Payne (2001) on an Xbox-style pad, for the game's default keys. RT shoots, LT is bullet time and RB shootdodges (with a direction). A uses (and zooms the sniper rifle), B jumps, X reloads and Y takes a painkiller. LB opens a radial menu of weapon groups (aim with the right stick), L3 toggles crouch. Start is the menu: double tap it to quick save, hold it to quick load. Gyro and flick stick profiles are included to try."
made_with = "Xbox controller"

[[rules]]
kind = "executable"
value = "maxpayne.exe"
profile = "Max Payne"

[[rules]]
kind = "steam_app_id"
value = "12140"
profile = "Max Payne"

[[profiles]]
name = "Max Payne"
combos = []
combo_window_ms = 120
tap_window_ms = 250
long_press_ms = 500

[profiles.buttons]

[profiles.buttons.Guide]
mode = "Guide"

[profiles.buttons.South]
keys = ["KEY_E"]

[profiles.buttons.East]
keys = ["KEY_SPACE"]

[profiles.buttons.West]
keys = ["KEY_R"]

[profiles.buttons.North]
keys = ["KEY_TAB"]

[profiles.buttons.LeftBumper]
open_menu = "Weapons"

[profiles.buttons.RightBumper]
keys = ["KEY_LEFTSHIFT"]

[profiles.buttons.Select]
keys = ["KEY_P"]

[profiles.buttons.Start]
keys = ["KEY_ESC"]

[profiles.buttons.LeftStick.toggle]
keys = ["KEY_C"]

[profiles.buttons.DpadLeft]
wheel = "Up"

[profiles.buttons.DpadRight]
wheel = "Down"

[profiles.buttons.DpadUp]
keys = ["KEY_G"]
[profiles.left_stick]
deadzone = 0.12
curve = 1.0
key_threshold = 0.25

[profiles.left_stick.action.keys]
up = "KEY_W"
down = "KEY_S"
left = "KEY_A"
right = "KEY_D"

[profiles.right_stick]
deadzone = 0.1
curve = 1.8
key_threshold = 0.5

[profiles.right_stick.action.mouse]
speed = 1300.0
accel = 0.2

[profiles.left_trigger.action.button]
threshold = 0.4
action = {mouse = "Right"}

[profiles.right_trigger.action.button]
threshold = 0.3

[profiles.right_trigger.action.button.action]
mouse = "Left"

[profiles.gestures.Start.double_tap]
keys = ["KEY_F5"]

[profiles.gestures.Start.long_press]
keys = ["KEY_F9"]

[profiles.gyro]
mode = "off"
horizontal = "yaw"
invert_x = false
invert_y = false
activation = "always"
noise_threshold = 1.0
[profiles.guide]
notes = '''Hold {lt} for bullet time. Hold {rb} with a direction on the left stick {ls} to shootdodge.
{north} takes a painkiller. {south} uses doors, switches and phones, zooms the sniper rifle, and {east} jumps.
Hold {lb} for the weapon groups, aiming with the right stick {rs}. The {dpad} left and right step through the weapons, and {up} picks the best one.
Crouch is a toggle: click {l3} to crouch and again to stand.
{start} is the menu. Double tap it to quick save and hold it to quick load. {select} pauses without the menu.'''

[profiles.guide.edits]
"stick:Left" = {text = "Move"}
"stick:Right" = {text = "Aim"}
"trigger:Right" = {text = "Shoot"}
"trigger:Left" = {text = "{icon:hourglass} Bullet time"}
"button:RightBumper" = {text = "Shootdodge (with a direction)"}
"button:South" = {text = "Use / sniper zoom"}
"button:East" = {text = "Jump"}
"button:West" = {text = "Reload"}
"button:North" = {text = "{icon:pill} {color:green}Painkillers{/color}"}
"button:LeftBumper" = {text = "Hold: weapon groups"}
"button:LeftStick" = {text = "Crouch (toggle)"}
"button:Select" = {text = "{icon:pause} Pause"}
"button:Start" = {text = "Menu"}
"gesture:button:Start:double_tap" = {text = "{icon:save} Quick save"}
"gesture:button:Start:long_press" = {text = "{icon:load} Quick load"}
"button:DpadUp" = {text = "Best weapon"}

[[profiles.guide.merged]]
inputs = ["button:DpadLeft", "button:DpadRight"]
text = "Previous / next weapon"




