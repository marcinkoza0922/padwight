position = "top_right"
scale = 0.9

[media_style.background]
color = "#0d131c"
opacity = 0.92

[media_style.items]
color = "#1b2636"
opacity = 0.95

[media_style.selected]
color = "#8a1f26"
opacity = 1.0

[media_style.border]
width = 1
color = "#c2a25a"
opacity = 0.85

[media_style.gradient]
color = "#121a26"
opacity = 1.0
angle = 180

[media_style.item_border]
width = 1
color = "#3a4a60"

[media_style.type]
letter_spacing = 1

[menu_style]
corners = 0.0
position = "center"
scale = 1.0

[menu_style.background]
color = "#0d131c"
opacity = 0.92

[menu_style.items]
color = "#1b2636"
opacity = 0.95

[menu_style.selected]
color = "#8a1f26"
opacity = 1.0

[menu_style.border]
width = 1
color = "#c2a25a"
opacity = 0.85

[menu_style.gradient]
color = "#121a26"
opacity = 1.0
angle = 180

[menu_style.item_border]
width = 1
color = "#3a4a60"

[menu_style.glow]
color = "#d8b060"
opacity = 0.55
blur = 16

[menu_style.type]
letter_spacing = 1

[menu_style.ornament]
frame = {kind = "baroque", size = 44, width = 2, color = "#c2a25a"}
dividers = {width = 1, color = "#c2a25a", opacity = 0.35}
vignette = {color = "#000000", opacity = 0.4, reach = 25}

[motion]
keyboard = "subtle"
numpad = "subtle"
menu = "subtle"
media = "subtle"
offer = "subtle"
info = "subtle"
log = "subtle"

[sounds.menu]
step = {kind = "click", volume = 0.08, pitch = 0.8}
pick = {kind = "latch", volume = 0.1, pitch = 0.9}
open = {kind = "page", volume = 0.06, pitch = 0.9}
close = {kind = "page", volume = 0.04, pitch = 0.7}

[sounds.keyboard]
step = {kind = "click", volume = 0.07, pitch = 0.9}
pick = {kind = "clank", volume = 0.14, pitch = 0.9}

[sounds.numpad]
step = {kind = "click", volume = 0.07, pitch = 0.9}
pick = {kind = "clank", volume = 0.14, pitch = 0.9}

[rumble.menu]
step = {strength = 0.11, length_ms = 18}
pick = {strength = 0.41, length_ms = 35}
open = {strength = 0.09, length_ms = 25}

[rumble.keyboard]
step = {strength = 0.07, length_ms = 14}
pick = {strength = 0.27, length_ms = 22}

[rumble.numpad]
step = {strength = 0.07, length_ms = 14}
pick = {strength = 0.27, length_ms = 22}

[rumble.media]
pick = {strength = 0.27, length_ms = 25}

[rumble.guide]
mode = {strength = 0.27, length_ms = 60}
