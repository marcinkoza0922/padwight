format = 20
macros = []
overlay_font = "Cinzel"

[pack]
id = "79a38d7f-ff10-4808-8c44-d45fdd5b2db1"
name = "Empire: Total War"
version = "1.0"
author = "Padwight"
description = "Empire: Total War (Steam, Windows or Linux build) on an Xbox-style pad, for the default keys. The campaign map and battles get their own schemes: hold Select to switch. Both: the right stick moves the cursor, RT left-clicks, LT right-clicks, the left stick moves the camera, the d-pad zooms and rotates. Campaign: A clicks, hold Y to end the turn, Select lists technology and saving. Battle: A halts, X runs, Y fires at will, L3 groups, R3 pauses, hold LB for control groups 1-10 (LB + RB sets one), RB adds to the selection. Start is the game menu; double tap it to quick save, hold to quick load. The \"+ Gyro\" profile also moves the cursor by tilting the controller."
made_with = "Xbox controller"

[[rules]]
kind = "executable"
value = "Empire.exe"
profile = "Empire: Total War"

[[rules]]
kind = "executable"
value = "Empire"
profile = "Empire: Total War"

[[rules]]
kind = "steam_app_id"
value = "10500"
profile = "Empire: Total War"

[[profiles]]
name = "Empire: Total War"
combos = []
combo_window_ms = 120
tap_window_ms = 250
long_press_ms = 500

[profiles.buttons]
Guide = {mode = "Guide"}
South = {mouse = "Left"}
East = {keys = ["KEY_ESC"]}
Select = {open_menu = "Campaign"}
Start = {keys = ["KEY_ESC"]}
DpadUp = {wheel = "Up"}
DpadDown = {wheel = "Down"}
DpadLeft = {keys = ["KEY_Q"]}
DpadRight = {keys = ["KEY_E"]}

[profiles.gestures.North]
long_press = {keys = ["KEY_ENTER"]}

[profiles.gestures.Select]
long_press = {open_menu = "Campaign or battle"}

[profiles.gestures.Start]
double_tap = {keys = ["KEY_LEFTCTRL", "KEY_S"]}
long_press = {keys = ["KEY_LEFTCTRL", "KEY_L"]}

[profiles.left_stick]
deadzone = 0.2
curve = 1.0
key_threshold = 0.45

[profiles.left_stick.action.ring]
sectors = 8
start_angle = 0.0
inner_radius = 0.45
hysteresis = 0.1

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_W"]

[[profiles.left_stick.action.ring.actions]]
multi = [{ keys = ["KEY_W"] }, { keys = ["KEY_D"] }]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_D"]

[[profiles.left_stick.action.ring.actions]]
multi = [{ keys = ["KEY_S"] }, { keys = ["KEY_D"] }]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_S"]

[[profiles.left_stick.action.ring.actions]]
multi = [{ keys = ["KEY_S"] }, { keys = ["KEY_A"] }]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_A"]

[[profiles.left_stick.action.ring.actions]]
multi = [{ keys = ["KEY_W"] }, { keys = ["KEY_A"] }]

[profiles.right_stick]
deadzone = 0.1
curve = 1.6
key_threshold = 0.25

[profiles.right_stick.action.mouse]
speed = 1500.0
accel = 0.25

[profiles.left_trigger.action.button]
threshold = 0.4
action = { mouse = "Right" }

[profiles.right_trigger.action.button]
threshold = 0.3
action = { mouse = "Left" }

[profiles.gyro]
enabled = false
horizontal = "yaw"
invert_x = false
invert_y = false
noise_threshold = 1.0

[profiles.guide]
notes = '''The campaign map and battles play very differently, so this setup has a scheme for each. Hold {select} to pick Campaign map or Battle with {lb} {rb} and {confirm}: switch when a battle starts and when it ends. The scheme in use shows at the top of the screen.
Both: the right stick {rs} moves the cursor, {rt} selects (left click, hold to drag a box) and {lt} moves and attacks (right click; drag it to set the line's width). The left stick {ls} moves the camera (WASD), {up} {down} zoom and {left} {right} rotate it. {east} closes a panel or deselects, {start} is the game menu; double tap {start} to quick save, hold it to quick load.
Campaign map: {south} is a left click as well. Hold {north} to end the turn. {select} lists the end turn, technology, saving and loading.
Battle: {south} halts, {west} toggles running, {north} toggles fire at will, {l3} groups the selected units and {r3} pauses. Hold {lb} for the control groups and aim the right stick {rs}; hold {lb} and {rb} together to set one instead. {rb} is Ctrl: hold it to add units to the selection. {select} lists pause, select all and the other orders.
Empire has no tactical map, so {r3} pauses instead. Formations, ammunition and ships' sail speeds are on the unit card: click them. Sea battles use the Battle scheme too.
The keys are the defaults as best known, not checked on an install. The Linux executable name (Empire, Feral's port) is a guess; Empire.exe comes from Discord's game list, and the other ids the wiki lists for the game are DLC, so only 10500 is kept. If a key does nothing, look in Options, Controls and set it to the key in this setup.'''

[profiles.guide.edits]
"stick:Left" = { text = "Move the camera" }
"stick:Right" = { text = "Cursor" }
"trigger:Right" = { text = "Left click (select, drag a box)" }
"trigger:Left" = { text = "Right click (move, attack; drag to form up)" }
"button:South" = { text = "Left click · battle: {icon:stop} Halt" }
"button:East" = { text = "Close / deselect" }
"button:Select" = { text = "Campaign list · battle orders" }
"button:Start" = { text = "Game menu" }
"gesture:button:North:long_press" = { text = "{icon:hourglass} End turn (campaign)" }
"gesture:button:Select:long_press" = { text = "{icon:map} Campaign map / {icon:sword-cross} Battle" }
"gesture:button:Start:double_tap" = { text = "{icon:save} Quick save" }
"gesture:button:Start:long_press" = { text = "{icon:load} Quick load" }

[[profiles.guide.merged]]
inputs = ["button:DpadUp", "button:DpadDown"]
text = "Zoom in / out"

[[profiles.guide.merged]]
inputs = ["button:DpadLeft", "button:DpadRight"]
text = "Rotate the camera"

[[profiles.guide.custom]]
inputs = ["button:West"]
text = "Battle: {icon:footprints} Run"

[[profiles.guide.custom]]
inputs = ["button:North"]
text = "Battle: {icon:ranged} Fire at will"

[[profiles.guide.custom]]
inputs = ["button:LeftBumper"]
text = "Battle, hold: control groups"

[[profiles.guide.custom]]
inputs = ["button:LeftBumper", "button:RightBumper"]
text = "Battle: set a control group"

[[profiles.guide.custom]]
inputs = ["button:RightBumper"]
text = "Battle: Ctrl (add to selection)"

[[profiles.guide.custom]]
inputs = ["button:LeftStick"]
text = "Battle: {icon:formation} Group units"

[[profiles.guide.custom]]
inputs = ["button:RightStick"]
text = "Battle: {icon:pause} Pause"

