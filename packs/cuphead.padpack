format = 20
macros = []
overlay_font = "Bangers"

[pack]
id = "e0057e7b-cd57-493a-98aa-abb9ba2ac2dd"
name = "Cuphead"
version = "1.0"
author = "Padwight"
description = "Cuphead on an Xbox-style pad. The game has its own controller support, so the controller passes through untouched and the game's Controls options set the buttons. Padwight adds the Guide overlay on top, with the on-screen keyboard for text and the media controls, in 1930s cartoon ink and cream."
made_with = "Xbox controller"

[controllers]
dualshock = true
switch_pro = true

[[rules]]
kind = "executable"
value = "Cuphead.exe"
profile = "Cuphead"

[[rules]]
kind = "steam_app_id"
value = "268910"
profile = "Cuphead"

[[profiles]]
name = "Cuphead"
combos = []
combo_window_ms = 120
tap_window_ms = 250
long_press_ms = 500

[profiles.buttons]
South = {gamepad = "South"}
East = {gamepad = "East"}
North = {gamepad = "North"}
West = {gamepad = "West"}
LeftBumper = {gamepad = "LeftBumper"}
RightBumper = {gamepad = "RightBumper"}
LeftStick = {gamepad = "LeftStick"}
RightStick = {gamepad = "RightStick"}
Select = {gamepad = "Select"}
Start = {gamepad = "Start"}
DpadUp = {gamepad = "DpadUp"}
DpadDown = {gamepad = "DpadDown"}
DpadLeft = {gamepad = "DpadLeft"}
DpadRight = {gamepad = "DpadRight"}
Guide = {mode = "Guide"}

[profiles.left_stick]
deadzone = 0.05
curve = 1.0
key_threshold = 0.3

[profiles.left_stick.action]
gamepad = {stick = "Left", invert_y = false}

[profiles.right_stick]
deadzone = 0.05
curve = 1.0
key_threshold = 0.3

[profiles.right_stick.action]
gamepad = {stick = "Right", invert_y = false}

[profiles.left_trigger]
action = {gamepad = "Left"}

[profiles.right_trigger]
action = {gamepad = "Right"}

[profiles.gyro]
enabled = false
horizontal = "yaw"
invert_x = false
invert_y = false
noise_threshold = 1.0

[profiles.guide]
notes = '''Cuphead has its own controller support, so the controller goes to the game as it is. Set the buttons in the game's Options, under Controls.
{guide} still works over the game: {guide} + {west} opens the on-screen keyboard, and {guide} + {lb} the media controls.
If the game stops answering the pad, check that Steam Input or another remapper isn't also running for it.'''

[keyboard_style]
corners = 0.2
position = "bottom_center"
scale = 1.0

[keyboard_style.background]
color = "#f1e4c3"
opacity = 0.92

[keyboard_style.items]
color = "#e2d0a4"
opacity = 0.95

[keyboard_style.selected]
color = "#d8281c"
opacity = 1.0

[keyboard_style.border]
width = 1
color = "#1a1410"
opacity = 0.8

[keyboard_style.gradient]
color = "#e9d9b0"
opacity = 1.0
angle = 180

[keyboard_style.item_border]
width = 1
color = "#8a7448"

[numpad_style]
corners = 0.2
position = "center"
scale = 1.0

[numpad_style.background]
color = "#f1e4c3"
opacity = 0.92

[numpad_style.items]
color = "#e2d0a4"
opacity = 0.95

[numpad_style.selected]
color = "#d8281c"
opacity = 1.0

[numpad_style.border]
width = 1
color = "#1a1410"
opacity = 0.8

[numpad_style.gradient]
color = "#e9d9b0"
opacity = 1.0
angle = 180

[numpad_style.item_border]
width = 1
color = "#8a7448"

[media_style]
corners = 0.2
position = "top_right"
scale = 0.9

[media_style.background]
color = "#f1e4c3"
opacity = 0.92

[media_style.items]
color = "#e2d0a4"
opacity = 0.95

[media_style.selected]
color = "#d8281c"
opacity = 1.0

[media_style.border]
width = 1
color = "#1a1410"
opacity = 0.8

[media_style.gradient]
color = "#e9d9b0"
opacity = 1.0
angle = 180

[media_style.item_border]
