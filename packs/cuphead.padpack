[menu_style.type]
letter_spacing = 1

[menu_style.ornament]
frame = {kind = "brackets", size = 12, width = 3, color = "#1a1410"}
vignette = {color = "#7a5c2e", opacity = 0.35, reach = 22}

[motion]
keyboard = "playful"
numpad = "playful"
menu = "playful"
media = "playful"
offer = "playful"
info = "playful"
log = "playful"

[sounds.keyboard]
step = {kind = "tin", volume = 0.06, pitch = 1.3}
pick = {kind = "tin", volume = 0.2}

[sounds.numpad]
step = {kind = "tin", volume = 0.06, pitch = 1.3}
pick = {kind = "boing", volume = 0.1}

[sounds.media]
pick = {kind = "boing", volume = 0.1, pitch = 1.2}

[rumble.keyboard]
step = {strength = 0.06, length_ms = 14}
pick = {strength = 0.25, length_ms = 22}

[rumble.numpad]
step = {strength = 0.06, length_ms = 14}
pick = {strength = 0.25, length_ms = 22}

[rumble.media]
pick = {strength = 0.25, length_ms = 25}

[rumble.guide]
mode = {strength = 0.25, length_ms = 60}
