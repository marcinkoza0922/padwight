[menu_style]
corners = 0.2
position = "center"
scale = 1.0

[menu_style.background]
color = "#f1e4c3"
opacity = 0.92

[menu_style.items]
color = "#e2d0a4"
opacity = 0.95

[menu_style.selected]
color = "#d8281c"
opacity = 1.0

[menu_style.border]
width = 1
color = "#1a1410"
opacity = 0.8

[menu_style.gradient]
color = "#e9d9b0"
opacity = 1.0
angle = 180
drift = true

[menu_style.item_border]
width = 1
color = "#8a7448"

[menu_style.glow]
color = "#f5c43a"
opacity = 0.6
