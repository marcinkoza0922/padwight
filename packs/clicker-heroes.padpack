[profiles.guide]
notes = '''Hold {select} and {start} together to pause the gyro while you reposition the controller. Tilting the controller moves the pointer, as a fine pointer next to the right stick {rs}.
The game is played with the mouse. The right stick {rs} moves the pointer and the left stick {ls} moves it slowly. {south} or {rt} clicks: the monster, a hero's level-up button, an upgrade. Hold {west} to click fifteen times a second on the monster.
Hold {lb} (Z) and click a hero to level them ten times, {rb} (Shift) for twenty-five, and both together (Ctrl) for a hundred. {north} buys every upgrade you can afford (Q). {up} and {down} scroll the hero list.
Hold {lt} and aim {rs} at a skill to use it (keys 1 to 9). {select} toggles progression mode (A). {east} and {start} close a window (Escape).
The game came out on PlayStation 4 and Xbox One too, with its own interface, but its button layout couldn't be looked up, so this is built on the PC keys. The keys are remembered and unchecked on an install; the game has no key settings.'''

[profiles.guide.edits]
"stick:Left" = {text = "Fine pointer"}
"stick:Right" = {text = "Pointer"}
"trigger:Right" = {text = "{icon:sword} {b}Click{/b}"}
"trigger:Left" = {text = "{icon:bolt} Skills (hold)"}
"button:South" = {text = "{icon:sword} {b}Click{/b}"}
"button:West" = {text = "{icon:fast} Rapid click (hold)"}
"button:North" = {text = "{icon:upgrade} Buy upgrades"}
"button:East" = {text = "{icon:cancel} Close"}
"button:LeftBumper" = {text = "{icon:coin} ×10 (hold)"}
"button:RightBumper" = {text = "{icon:money} ×25 (hold)"}
"combo:button:LeftBumper+button:RightBumper" = {text = "{icon:money-bag} ×100 (hold both)"}
"button:Select" = {text = "{icon:arrow} Progression mode"}
"button:Start" = {text = "Close"}

