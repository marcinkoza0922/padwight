format = 20
macros = []
overlay_font = "Kreon"

[pack]
id = "221f7053-1c84-5606-91c2-46217ccc4e47"
name = "Clicker Heroes"
version = "1.0"
author = "Padwight"
description = "Clicker Heroes on an Xbox-style pad. The game takes the mouse, so the right stick moves the pointer and the left stick nudges it; A or RT clicks the monster or a hero, and holding X clicks fifteen times a second. Hold LB, RB or both to level heroes by 10, 25 or 100, Y buys every upgrade, and holding LT opens the nine skills on a wheel. Overlays in the game's night-blue sky, wood and gold. The \"Clicker Heroes + Gyro\" profile also moves the pointer by tilting the controller."
made_with = "Xbox controller"

[[rules]]
kind = "steam_app_id"
value = "363970"
profile = "Clicker Heroes"

[[rules]]
kind = "executable"
value = "Clicker Heroes.exe"
profile = "Clicker Heroes"

[[profiles]]
name = "Clicker Heroes"
combos = [
    {buttons = ["LeftBumper", "RightBumper"], action = {keys = ["KEY_LEFTCTRL"]}},
]
combo_window_ms = 120
tap_window_ms = 250
long_press_ms = 500

[profiles.buttons]
Guide = {mode = "Guide"}
South = {mouse = "Left"}
East = {keys = ["KEY_ESC"]}
West = {turbo = {action = {mouse = "Left"}, rate = 15.0}}
North = {keys = ["KEY_Q"]}
LeftBumper = {keys = ["KEY_Z"]}
RightBumper = {keys = ["KEY_LEFTSHIFT"]}
Select = {keys = ["KEY_A"]}
Start = {keys = ["KEY_ESC"]}
DpadUp = {wheel = "Up"}
DpadDown = {wheel = "Down"}

[profiles.left_stick]
deadzone = 0.12
curve = 1.6
key_threshold = 0.5

[profiles.left_stick.action.mouse]
speed = 500.0
accel = 0.0

[profiles.right_stick]
deadzone = 0.12
curve = 1.7
key_threshold = 0.5

[profiles.right_stick.action.mouse]
speed = 1400.0
accel = 0.3

[profiles.left_trigger.action.button]
threshold = 0.4
action = {open_menu = "Skills"}

[profiles.right_trigger.action.button]
threshold = 0.3
action = {mouse = "Left"}

[profiles.gyro]
enabled = false
horizontal = "yaw"
invert_x = false
invert_y = false
noise_threshold = 1.0

[profiles.guide]
notes = '''The game is played with the mouse. The right stick {rs} moves the pointer and the left stick {ls} moves it slowly. {south} or {rt} clicks: the monster, a hero's level-up button, an upgrade. Hold {west} to click fifteen times a second on the monster.
Hold {lb} (Z) and click a hero to level them ten times, {rb} (Shift) for twenty-five, and both together (Ctrl) for a hundred. {north} buys every upgrade you can afford (Q). {up} and {down} scroll the hero list.
Hold {lt} and aim {rs} at a skill to use it (keys 1 to 9). {select} toggles progression mode (A). {east} and {start} close a window (Escape).
The game came out on PlayStation 4 and Xbox One too, with its own interface, but its button layout couldn't be looked up, so this is built on the PC keys. The keys are remembered and unchecked on an install; the game has no key settings.'''

[profiles.guide.edits]
"stick:Left" = {text = "Fine pointer"}
"stick:Right" = {text = "Pointer"}
"trigger:Right" = {text = "{icon:sword} {b}Click{/b}"}
"trigger:Left" = {text = "{icon:bolt} Skills (hold)"}
"button:South" = {text = "{icon:sword} {b}Click{/b}"}
"button:West" = {text = "{icon:fast} Rapid click (hold)"}
"button:North" = {text = "{icon:upgrade} Buy upgrades"}
"button:East" = {text = "{icon:cancel} Close"}
"button:LeftBumper" = {text = "{icon:coin} ×10 (hold)"}
"button:RightBumper" = {text = "{icon:money} ×25 (hold)"}
"combo:button:LeftBumper+button:RightBumper" = {text = "{icon:money-bag} ×100 (hold both)"}
"button:Select" = {text = "{icon:arrow} Progression mode"}
"button:Start" = {text = "Close"}

[[profiles.guide.merged]]
inputs = ["button:DpadUp", "button:DpadDown"]
text = "Scroll heroes"

[[profiles]]
name = "Clicker Heroes + Gyro"
combos = [
    {buttons = ["LeftBumper", "RightBumper"], action = {keys = ["KEY_LEFTCTRL"]}},
    {buttons = ["Select", "Start"], action = "gyro_clutch"},
]
combo_window_ms = 120
tap_window_ms = 250
long_press_ms = 500
requires = ["gyro"]

[profiles.buttons]
Guide = {mode = "Guide"}
South = {mouse = "Left"}
