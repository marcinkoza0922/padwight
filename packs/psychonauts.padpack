format = 20
macros = []
overlay_font = "Bangers"

[pack]
id = "ad3552b0-5842-5679-a859-21dec63acdc2"
name = "Psychonauts"
version = "1.1"
author = "Padwight"
description = "Psychonauts (2005) on an Xbox-style pad, modelled on the Xbox release, for the game's default keys. A jumps, X punches, Y uses, B cancels. RT, RB and LB are the three PSI power slots, and holding LT locks on and levitates. The D-pad opens the backpack and the PSI Powers menu, R3 looks in first person, Select shows the stats and Start the journal."
made_with = "Xbox controller"

[[rules]]
kind = "executable"
value = "Psychonauts.exe"
profile = "Psychonauts"

[[rules]]
kind = "steam_app_id"
value = "3830"
profile = "Psychonauts"

[[profiles]]
name = "Psychonauts"
combos = []
combo_window_ms = 120
tap_window_ms = 250
long_press_ms = 500

[profiles.buttons]
Guide = {mode = "Guide"}
South = {keys = ["KEY_SPACE"]}
West = {mouse = "Left"}
North = {keys = ["KEY_F"]}
East = {keys = ["KEY_X"]}
RightBumper = {keys = ["KEY_Q"]}
LeftBumper = {keys = ["KEY_E"]}
RightStick = {mouse = "Middle"}
DpadLeft = {keys = ["KEY_LEFTBRACE"]}
DpadRight = {keys = ["KEY_RIGHTBRACE"]}
Select = {keys = ["KEY_TAB"]}
Start = {keys = ["KEY_ESC"]}

[profiles.left_stick]
deadzone = 0.12
curve = 1.0
key_threshold = 0.25

[profiles.left_stick.action.keys]
up = "KEY_UP"
down = "KEY_DOWN"
left = "KEY_LEFT"
right = "KEY_RIGHT"

[profiles.right_stick]
deadzone = 0.1
curve = 1.8
key_threshold = 0.5

[profiles.right_stick.action.mouse]
speed = 1300.0
accel = 0.2

[profiles.left_trigger.action.button]
threshold = 0.3
action = {keys = ["KEY_LEFTSHIFT"]}

[profiles.right_trigger.action.button]
threshold = 0.3
action = {mouse = "Right"}

[profiles.gyro]
mode = "off"
horizontal = "yaw"
invert_x = false
invert_y = false
activation = "always"
noise_threshold = 1.0

[profiles.guide]
notes = '''Laid out like the Xbox release: {south} jumps, {west} punches (jump, then punch for a Palm Bomb), {north} talks and uses things, {east} cancels and puts an item back.
Hold {lt} to lock on to a target and centre the camera; once Raz has Levitation, it also floats him in his bubble.
{rt}, {rb} and {lb} are the three PSI power slots. Press {right} for the PSI Powers menu and pick a power, then press the slot to give it to.
{left} opens the backpack. Click {r3} to look in first person. {select} shows Raz's stats and {start} opens the journal, where you can save.'''

[profiles.guide.edits]
"stick:Left" = {text = "Move"}
"stick:Right" = {text = "Camera"}
"trigger:Right" = {text = "{icon:brain} PSI power 1"}
"button:RightBumper" = {text = "{icon:brain} PSI power 2"}
"button:LeftBumper" = {text = "{icon:brain} PSI power 3"}
"trigger:Left" = {text = "Lock on / Levitation (hold)"}
"button:South" = {text = "Jump"}
"button:West" = {text = "{icon:fist} {b}Punch{/b}"}
"button:North" = {text = "Talk / use"}
"button:East" = {text = "Cancel / put away"}
"button:DpadLeft" = {text = "{icon:bag} Backpack"}
"button:DpadRight" = {text = "{icon:brain} PSI Powers menu"}
"button:RightStick" = {text = "{icon:eye} Look (first person)"}
"button:Select" = {text = "{icon:chart} Stats"}
"button:Start" = {text = "{icon:book} Journal / save"}

