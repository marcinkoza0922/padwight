format = 20
macros = []
overlay_font = "Rajdhani"

[pack]
id = "a7c3e5d1-94b2-4f60-8d1a-6e2b0f7c3a98"
name = "Dyson Sphere Program"
version = "1.0"
author = "Padwight"
description = "Dyson Sphere Program on an Xbox-style pad, for the game's default keys. The left stick walks the mecha and the right stick moves the pointer; RT and A click, LT right-clicks to walk and mine, hold R3 to turn the camera. Hold LB and RB for the build bar, Select for the panels. X rotates, Y jumps and flies, B sinks. Overlays in the mecha's holographic blue."
made_with = "Xbox controller"

[[rules]]
kind = "steam_app_id"
value = "1366540"
profile = "Dyson Sphere Program"

[[rules]]
kind = "executable"
value = "DSPGAME.exe"
profile = "Dyson Sphere Program"

[[profiles]]
name = "Dyson Sphere Program"
combos = []
combo_window_ms = 120
tap_window_ms = 250
long_press_ms = 500

[profiles.buttons]
Guide = {mode = "Guide"}
South = {mouse = "Left"}
East = {keys = ["KEY_LEFTALT"]}
West = {keys = ["KEY_R"]}
North = {keys = ["KEY_SPACE"]}
LeftBumper = {open_menu = "Categories"}
RightBumper = {open_menu = "Slots"}
Select = {open_menu = "Panels"}
Start = {keys = ["KEY_ESC"]}
LeftStick = {keys = ["KEY_LEFTSHIFT"]}
RightStick = {mouse = "Middle"}
DpadUp = {wheel = "Up"}
DpadDown = {wheel = "Down"}
DpadLeft = {keys = ["KEY_B"]}
DpadRight = {keys = ["KEY_X"]}

[profiles.gestures.DpadRight]
long_press = {keys = ["KEY_U"]}

[profiles.left_stick]
deadzone = 0.15
curve = 1.0
key_threshold = 0.35

[profiles.left_stick.action.ring]
sectors = 8
start_angle = 0.0
inner_radius = 0.35
hysteresis = 0.1

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_W"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_W"] },
    { keys = ["KEY_D"] },
]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_D"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_S"] },
    { keys = ["KEY_D"] },
]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_S"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_S"] },
    { keys = ["KEY_A"] },
]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_A"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_W"] },
    { keys = ["KEY_A"] },
]

[profiles.right_stick]
deadzone = 0.12
curve = 1.7
key_threshold = 0.5

[profiles.right_stick.action.mouse]
speed = 1400.0
accel = 0.3

[profiles.left_trigger.action.button]
threshold = 0.4
action = {mouse = "Right"}

[profiles.right_trigger.action.button]
threshold = 0.3
action = {mouse = "Left"}

[profiles.gyro]
mode = "off"
horizontal = "yaw"
invert_x = false
invert_y = false
noise_threshold = 1.0

[profiles.guide]
notes = '''The left stick {ls} walks the mecha and the right stick {rs} moves the pointer. {rt} or {south} clicks to build and take; {lt} right-clicks to walk to a spot, mine a vein or drop what's in hand. Hold {r3} and move the right stick {rs} to turn the camera; {up} and {down} zoom.
{north} jumps; double tap it to take off and hold it to climb, {east} to sink. Hold {l3} for Shift: queue several orders, copy a building with {south}, speed up in flight.
Hold {lb} for the build categories (F1 to F10) and {rb} for the slots in the open one (1 to 0), aiming with the right stick {rs}. {west} rotates the building in hand. {left} enters construction mode, {right} demolition; hold {right} for upgrade mode.
{select} lists the panels: inventory, replicator, mecha, tech tree, statistics, starmap, planet view, Dyson sphere, and the warp and cursor lock for sailing. {start} closes panels and opens the menu.
Panel, movement and build keys come from a community list; the F-key categories, the number-key slots and upgrade on U are from memory. None were read from an install: check Settings → Control if one is off. Naming a station or a blueprint: {guide} + {west} opens the on-screen keyboard.'''

[profiles.guide.edits]
"stick:Left" = {text = "Walk"}
"stick:Right" = {text = "Pointer"}
"trigger:Right" = {text = "Click / build"}
"trigger:Left" = {text = "Walk to / mine / drop"}
"button:South" = {text = "Click / build"}
"button:East" = {text = "Fly down"}
"button:West" = {text = "{icon:rotate} Rotate building"}
"button:North" = {text = "Jump / fly up"}
"button:LeftBumper" = {text = "Hold: build categories"}
"button:RightBumper" = {text = "Hold: build slots"}
"button:Select" = {text = "Panels"}
"button:Start" = {text = "Close / menu"}
"button:LeftStick" = {text = "Hold: Shift"}
"button:RightStick" = {text = "Hold: turn the camera"}
"button:DpadLeft" = {text = "{icon:hammer} Construction mode"}
"button:DpadRight" = {text = "{icon:trash} {color:red}Demolish{/color}"}
"gesture:button:DpadRight:long_press" = {text = "{icon:upgrade} Upgrade mode"}

[[profiles.guide.merged]]
inputs = ["button:DpadUp", "button:DpadDown"]
text = "Zoom in / out"


