format = 20
macros = []
overlay_font = "Rajdhani"

[pack]
id = "9e0cfe78-c364-4390-b1a4-b13a425bd4af"
name = "Hitman 2: Silent Assassin"
version = "1.0"
author = "Padwight"
description = "Hitman 2: Silent Assassin (2002) on an Xbox-style pad, laid out like the Xbox release for the game's default keys. A carries out the action, X picks up, B drops (hold: throw) and Y reloads. RT fires, LT is the right mouse button (tap: holster, hold: inventory). L3 toggles crouch and sneak, and a full push on the left stick runs. The D-pad is the arrow keys, Select is the map and Start the menu. Gyro and flick stick profiles are included to try. Overlays in midnight black and crimson."
made_with = "Xbox controller"

[[rules]]
kind = "steam_app_id"
value = "6850"
profile = "Hitman 2: Silent Assassin"

[[rules]]
kind = "executable"
value = "Hitman 2 Silent Assassin/hitman2.exe"
profile = "Hitman 2: Silent Assassin"

[[profiles]]
name = "Hitman 2: Silent Assassin"
combos = []
combo_window_ms = 120
tap_window_ms = 250
long_press_ms = 500

[profiles.buttons]
South = { keys = ["KEY_E"] }
West = { keys = ["KEY_SPACE"] }
East = { keys = ["KEY_G"] }
North = { keys = ["KEY_R"] }
LeftBumper = { wheel = "Down" }
RightBumper = { wheel = "Up" }
LeftStick = { toggle = { action = { keys = ["KEY_LEFTCTRL"] } } }
RightStick = { keys = ["KEY_X"] }
Select = { keys = ["KEY_M"] }
Start = { keys = ["KEY_ESC"] }
Guide = { mode = "Guide" }
DpadUp = { keys = ["KEY_UP"] }
DpadDown = { keys = ["KEY_DOWN"] }
DpadLeft = { keys = ["KEY_LEFT"] }
DpadRight = { keys = ["KEY_RIGHT"] }

[profiles.left_stick]
deadzone = 0.12
curve = 1.0
key_threshold = 0.25

[profiles.left_stick.action.ring]
sectors = 8
start_angle = 0.0
inner_radius = 0.25
hysteresis = 0.1

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_W"]

[[profiles.left_stick.action.ring.actions]]
multi = [{ keys = ["KEY_W"] }, { keys = ["KEY_D"] }]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_D"]

[[profiles.left_stick.action.ring.actions]]
multi = [{ keys = ["KEY_S"] }, { keys = ["KEY_D"] }]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_S"]

[[profiles.left_stick.action.ring.actions]]
multi = [{ keys = ["KEY_S"] }, { keys = ["KEY_A"] }]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_A"]

[[profiles.left_stick.action.ring.actions]]
multi = [{ keys = ["KEY_W"] }, { keys = ["KEY_A"] }]

[[profiles.left_stick.zones]]
min = 0.7
max = 1.0
action = { keys = ["KEY_LEFTSHIFT"] }

[profiles.right_stick]
deadzone = 0.1
curve = 1.8
key_threshold = 0.5

[profiles.right_stick.action.mouse]
speed = 1100.0
accel = 0.2

[profiles.left_trigger.action.button]
threshold = 0.3
action = { mouse = "Right" }

[profiles.right_trigger.action.button]
threshold = 0.3
action = { mouse = "Left" }

[profiles.gyro]
enabled = false
horizontal = "yaw"
invert_x = false
invert_y = false
noise_threshold = 1.0

[profiles.guide]
notes = '''Hitman 2: Silent Assassin's keys here are the defaults from the Blood Money manual, not checked in the game. If a button does nothing, compare the game's Controls screen with the keys here.
{south} carries out the action (hold it for the action list); {west} picks up an item (hold it for the list); {east} drops an item (hold it to throw). {north} reloads.
{rt} fires. {lt} is the right mouse button: tap it to holster or draw the weapon, hold it for the inventory and let go on the item you want. {lb} and {rb} scroll through actions, items and the map.
{l3} toggles crouch and sneak. A light push on the left stick {ls} walks; push it all the way to run. Click {r3} for the sniper scope and binoculars.
The D-pad is the arrow keys, which the game's menus need. {select} is the map and {start} the menu.'''

[profiles.guide.edits]
"stick:Left" = { text = "Move (full push: run)" }
"stick:Right" = { text = "Look" }
"trigger:Right" = { text = "{icon:pistol} Fire" }
"trigger:Left" = { text = "{icon:holster} Holster (tap) / inventory (hold)" }
"button:South" = { text = "{b}Action{/b} (hold: list)" }
"button:West" = { text = "{icon:hand} Pick up (hold: list)" }
"button:East" = { text = "{icon:drop-item} Drop (hold: throw)" }
"button:North" = { text = "{icon:unload} Reload" }
"button:LeftBumper" = { text = "Scroll down" }
"button:RightBumper" = { text = "Scroll up" }
"button:LeftStick" = { text = "{icon:footprints} Crouch / sneak (toggle)" }
"button:RightStick" = { text = "{icon:scope} Scope / binoculars" }
"button:Select" = { text = "{icon:map} Map" }
"button:Start" = { text = "Menu" }

[[profiles.guide.merged]]
inputs = ["button:DpadUp", "button:DpadDown", "button:DpadLeft", "button:DpadRight"]
text = "Menus (arrow keys)"

