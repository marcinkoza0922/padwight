format = 20
macros = []
overlay_font = "Silkscreen"

[pack]
id = "e56a18f4-db2e-5a91-8f96-795fa933f66d"
name = "Dead Cells"
version = "1.0"
author = "Padwight"
description = "Dead Cells on an Xbox-style pad. The game has its own controller support, so the controller passes through untouched and the game's Controls options set the buttons. Padwight adds the Guide overlay on top, with the media controls and the on-screen keyboard, in the dark violet and flame orange of the Prisoners' Quarters."
made_with = "Xbox controller"

[[rules]]
kind = "executable"
value = "deadcells"
profile = "Dead Cells"

[[rules]]
kind = "executable"
value = "deadcells.exe"
profile = "Dead Cells"

[[rules]]
kind = "steam_app_id"
value = "588650"
profile = "Dead Cells"

[[profiles]]
name = "Dead Cells"
combos = []
combo_window_ms = 120
tap_window_ms = 250
long_press_ms = 500

[profiles.buttons]
Guide = {mode = "Guide"}
South = {gamepad = "South"}
East = {gamepad = "East"}
North = {gamepad = "North"}
West = {gamepad = "West"}
LeftBumper = {gamepad = "LeftBumper"}
RightBumper = {gamepad = "RightBumper"}
LeftStick = {gamepad = "LeftStick"}
RightStick = {gamepad = "RightStick"}
Select = {gamepad = "Select"}
Start = {gamepad = "Start"}
DpadUp = {gamepad = "DpadUp"}
DpadDown = {gamepad = "DpadDown"}
DpadLeft = {gamepad = "DpadLeft"}
DpadRight = {gamepad = "DpadRight"}

[profiles.left_stick]
deadzone = 0.05
curve = 1.0
key_threshold = 0.3

[profiles.left_stick.action]
gamepad = {stick = "Left", invert_y = false}

[profiles.right_stick]
deadzone = 0.05
curve = 1.0
key_threshold = 0.3

[profiles.right_stick.action]
gamepad = {stick = "Right", invert_y = false}

[profiles.left_trigger]
action = {gamepad = "Left"}

[profiles.right_trigger]
action = {gamepad = "Right"}

[profiles.gyro]
mode = "off"
horizontal = "yaw"
invert_x = false
invert_y = false
noise_threshold = 1.0

[profiles.guide]
notes = '''Dead Cells has its own controller support, so the controller goes to the game as it is. Set the buttons in the game's own Options → Controls.
{guide} still works over the game: {guide} + {west} opens the on-screen keyboard, and {guide} + {lb} the media controls.
If the game stops answering the pad, check that Steam Input or another remapper isn't also running for it.'''

[keyboard_style]
corners = 0.3
position = "bottom_center"
scale = 1.0

[keyboard_style.background]
color = "#12101a"
opacity = 0.92

[keyboard_style.items]
color = "#241b2e"
opacity = 0.95

[keyboard_style.selected]
color = "#ff7a2a"
opacity = 1.0

[keyboard_style.border]
width = 1
color = "#c8401e"
opacity = 0.8

[keyboard_style.gradient]
color = "#1c1226"
opacity = 1.0
angle = 180

[keyboard_style.item_border]
width = 1
color = "#3a2a46"

[keyboard_style.type]
letter_spacing = 2
case = "upper"

