[motion]
keyboard = "swift"
numpad = "swift"
menu = "swift"
media = "swift"
offer = "swift"
info = "swift"
log = "swift"

[sounds.menu]
step = {kind = "select", volume = 0.06, pitch = 1.2}
pick = {kind = "shing", volume = 0.1, pitch = 1.2}
open = {kind = "latch", volume = 0.12}

[sounds.keyboard]
step = {kind = "select", volume = 0.05, pitch = 1.2}
pick = {kind = "shing", volume = 0.1, pitch = 1.4}

[sounds.numpad]
step = {kind = "select", volume = 0.05, pitch = 1.2}
pick = {kind = "shing", volume = 0.1, pitch = 1.4}

[sounds.media]
pick = {kind = "latch", volume = 0.12}

[rumble.menu]
step = {strength = 0.07, length_ms = 18}
pick = {strength = 0.25, length_ms = 35}

[rumble.keyboard]
step = {strength = 0.05, length_ms = 14}
pick = {strength = 0.17, length_ms = 22}

[rumble.numpad]
step = {strength = 0.05, length_ms = 14}
pick = {strength = 0.17, length_ms = 22}

[rumble.media]
pick = {strength = 0.17, length_ms = 25}

[rumble.guide]
mode = {strength = 0.17, length_ms = 60}
