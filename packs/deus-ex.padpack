format = 18
macros = []
overlay_font = "Rajdhani"

[pack]
id = "744efa38-f5b0-4a49-bc95-126809ef6fc2"
name = "Deus Ex"
version = "2.0"
author = "Padwight"
description = "The original Deus Ex (2000) on an Xbox-style pad, for the game's default keys. A uses, B jumps, RT fires, X reloads (hold: change ammo), L3 toggles crouch, R3 toggles the scope (hold: laser sight). Hold LB for the belt and RB for augmentations, aiming with the right stick; double tap LB to holster. D-pad left and right lean, up and down cycle the belt. Select opens a list of the inventory and goals. Start is the menu and backs out of every screen; double tap it to quick save, hold it to quick load. Gyro and flick stick profiles are included to try."
made_with = "Xbox controller"

[[rules]]
kind = "executable"
value = "DeusEx.exe"
profile = "Deus Ex"

[[rules]]
kind = "steam_app_id"
value = "6910"
profile = "Deus Ex"

[[profiles]]
name = "Deus Ex"
combos = []
combo_window_ms = 120
tap_window_ms = 250
long_press_ms = 500

[profiles.buttons]
South = { mouse = "Right" }
East = { keys = ["KEY_SPACE"] }
West = { keys = ["KEY_SEMICOLON"] }
North = { keys = ["KEY_TAB"] }
LeftBumper = { open_menu = "Belt" }
RightBumper = { open_menu = "Augmentations" }
Select = { open_menu = "Screens" }
Start = { keys = ["KEY_ESC"] }
Guide = { mode = "Guide" }
LeftStick = { toggle = { action = { keys = ["KEY_X"] } } }
RightStick = { keys = ["KEY_LEFTBRACE"] }
DpadUp = { wheel = "Up" }
DpadDown = { wheel = "Down" }
DpadLeft = { keys = ["KEY_Q"] }
DpadRight = { keys = ["KEY_E"] }

[profiles.gestures.West.long_press]
keys = ["KEY_APOSTROPHE"]

[profiles.gestures.RightStick.long_press]
keys = ["KEY_RIGHTBRACE"]

[profiles.gestures.LeftBumper.double_tap]
keys = ["KEY_BACKSPACE"]

[profiles.gestures.Start.double_tap]
keys = ["KEY_KPPLUS"]

[profiles.gestures.Start.long_press]
keys = ["KEY_KPSLASH"]

[profiles.left_stick]
deadzone = 0.12
curve = 1.0
key_threshold = 0.25

[profiles.left_stick.action.keys]
up = "KEY_W"
down = "KEY_S"
left = "KEY_A"
right = "KEY_D"

[[profiles.left_stick.zones]]
min = 0.0
max = 0.6
action = { keys = ["KEY_LEFTSHIFT"] }

[profiles.right_stick]
deadzone = 0.12
curve = 2.2
key_threshold = 0.5

[profiles.right_stick.action.mouse]
speed = 2600.0
accel = 0.5
accel_ramp_ms = 350
y_scale = 0.75

[profiles.left_trigger]
action = "disabled"

[profiles.right_trigger.action.button]
threshold = 0.3
action = { mouse = "Left" }


[profiles.guide]
notes = '''
Start (Escape) backs out of every in-game screen: the inventory, goals, computers, keypads, robot recharging and repair bots.
On those screens the right stick moves the cursor, RT is a left click and A a right click.
Tap Select for a list of the inventory and goals screens, and pick one with A. Select or B closes the list without picking.
Keypads: hold Guide and press Y for the numpad. Computer logins: Guide + X opens the keyboard.
A light push of the left stick walks, a full push runs.
The scope is a toggle in the game: click R3 to look through it and again to lower it.
Belt slot 0 is always the nanokey ring. Double tap LB, or pick Holster on the belt, to put the item in hand away.
Augmentation hotkeys follow the order you installed them, so the slots on RB match the F-keys on the augmentation screen.'''

[profiles.guide.edits]
"stick:Left" = { text = "Move (light push: walk)" }
"stick:Right" = { text = "Look" }
"trigger:Right" = { text = "Fire" }
"button:South" = { text = "Use / pick up" }
"button:East" = { text = "Jump" }
"button:West" = { text = "Reload" }
"gesture:button:West:long_press" = { text = "Change ammo" }
"button:North" = { text = "Drop / throw" }
"button:LeftBumper" = { text = "Hold: belt" }
"gesture:button:LeftBumper:double_tap" = { text = "Holster" }
"button:RightBumper" = { text = "Hold: augmentations" }
"button:LeftStick" = { text = "Crouch (toggle)" }
"button:RightStick" = { text = "Scope (toggle)" }
"gesture:button:RightStick:long_press" = { text = "Laser sight" }
"button:Select" = { text = "Inventory, goals" }
"button:Start" = { text = "Menu / back out" }
"gesture:button:Start:double_tap" = { text = "Quick save" }
"gesture:button:Start:long_press" = { text = "Quick load" }

[[profiles.guide.merged]]
inputs = ["button:DpadLeft", "button:DpadRight"]
text = "Lean"

[[profiles.guide.merged]]
inputs = ["button:DpadUp", "button:DpadDown"]
text = "Previous / next belt item"

