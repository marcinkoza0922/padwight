numpad = "swift"
menu = "swift"
media = "swift"
offer = "swift"
info = "swift"
log = "swift"

[sounds.menu]
step = {kind = "tick", volume = 0.08, pitch = 1.4, length = 0.7}
pick = {file = "nano", kind = "blip", volume = 0.2}
open = {kind = "swish", volume = 0.04, pitch = 1.3}
close = {kind = "swish", volume = 0.03, pitch = 1.1}

[sounds.numpad]
step = {kind = "tick", volume = 0.08, pitch = 1.4, length = 0.7}
pick = {kind = "beep", volume = 0.18, pitch = 1.2, length = 0.8}

[sounds.keyboard]
step = {kind = "tick", volume = 0.08, pitch = 1.4, length = 0.7}
pick = {kind = "keys", volume = 0.25}

[rumble.menu]
