overlay_font = "Rajdhani"

[pack]
id = "cddd0daa-7b6c-4ba5-9858-8758a9cbc88a"
name = "F.E.A.R. 2: Project Origin"
version = "1.0"
author = "Padwight"
description = "F.E.A.R. 2: Project Origin (2009) and its Reborn expansion on an Xbox-style pad, for the game's default keys, laid out like the F.E.A.R. setup. A uses and, held, sprints, B jumps, X reloads (hold it for fire mode), Y throws a grenade (hold it for the next grenade type), L3 toggles crouch, R3 is melee, and LT zooms. Hold LB for the weapon and grenade ring, aiming with the right stick. RB is slow-mo, D-pad up and down are the flashlight and med kit, and left and right step through weapons. Start is the menu. The game has no controller support. Gyro and flick stick profiles are included to try."
made_with = "Xbox controller"

[[rules]]
kind = "steam_app_id"
value = "16450"
profile = "F.E.A.R. 2: Project Origin"

[[rules]]
kind = "executable"
value = "FEAR2.exe"
profile = "F.E.A.R. 2: Project Origin"

[[profiles]]
name = "F.E.A.R. 2: Project Origin"
combos = []
combo_window_ms = 120
tap_window_ms = 250
long_press_ms = 300

[profiles.buttons]
Guide = { mode = "Guide" }
South = { keys = ["KEY_E"] }
East = { keys = ["KEY_SPACE"] }
West = { keys = ["KEY_R"] }
North = { keys = ["KEY_G"] }
LeftBumper = { open_menu = "Weapons" }
RightBumper = { keys = ["KEY_LEFTCTRL"] }
LeftStick = { toggle = { action = { keys = ["KEY_C"] } } }
RightStick = { mouse = "Right" }
Select = { keys = ["KEY_TAB"] }
Start = { keys = ["KEY_ESC"] }
DpadUp = { keys = ["KEY_F"] }
DpadDown = { keys = ["KEY_Z"] }
DpadLeft = { wheel = "Down" }
DpadRight = { wheel = "Up" }

[profiles.gestures.South]
long_press = { keys = ["KEY_LEFTALT"] }

[profiles.gestures.West]
long_press = { keys = ["KEY_B"] }

[profiles.gestures.North]
long_press = { keys = ["KEY_X"] }

[profiles.left_stick]
deadzone = 0.12
curve = 1.0
key_threshold = 0.25

[profiles.left_stick.action.ring]
sectors = 8
start_angle = 0.0
inner_radius = 0.25
hysteresis = 0.1

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_W"]

[[profiles.left_stick.action.ring.actions]]
multi = [{ keys = ["KEY_W"] }, { keys = ["KEY_D"] }]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_D"]

[[profiles.left_stick.action.ring.actions]]
multi = [{ keys = ["KEY_S"] }, { keys = ["KEY_D"] }]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_S"]

[[profiles.left_stick.action.ring.actions]]
multi = [{ keys = ["KEY_S"] }, { keys = ["KEY_A"] }]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_A"]

[[profiles.left_stick.action.ring.actions]]
multi = [{ keys = ["KEY_W"] }, { keys = ["KEY_A"] }]

[profiles.right_stick]
deadzone = 0.08
curve = 2.0
key_threshold = 0.5

[profiles.right_stick.action.mouse]
speed = 1100.0
accel = 0.2

[profiles.left_trigger.action.button]
threshold = 0.4
action = { multi = [{ layer = "Aim" }, { keys = ["KEY_LEFTSHIFT"] }] }

[profiles.right_trigger.action.button]
threshold = 0.3
action = { mouse = "Left" }

[profiles.guide]
notes = '''{start} (Escape) opens the game's menu and backs out of it. The game saves at checkpoints; it has no quick save.
{south} uses: doors, switches, pick-ups and turrets. Hold {south} to sprint. {east} jumps, {west} reloads and a long press of {west} changes the fire mode. {north} throws a grenade, and a long press of {north} picks the next grenade type.
Hold {lt} to zoom. The right stick turns more slowly while it is held.
{rb} is slow-mo (reflex time). {l3} toggles crouch, and it stays on until you click it again. {r3} is melee; tap {east} and then {r3} for a jump kick.
Hold {lb} for the weapon and grenade ring, aiming with the right stick {rs}. {left} and {right} step through your weapons. {up} switches the flashlight and {down} uses a med kit.
In the powered armor sections the same buttons drive the suit and fire its weapons. {select} (Tab) shows the players in multiplayer; chat needs typing: open the on-screen keyboard with {guide} + {west} and press T (all) or Y (team).
The mouse can feel smoothed and too fast; PCGamingWiki points to the FEAR 2 Mouse Fix for raw input. These are the game's default keys from a fan-made controls list and not checked in the game (fire mode, grenade type and sprint especially). The game also came out on the Xbox 360 and PlayStation 3; that layout isn't checked here, so the scheme follows the F.E.A.R. setup instead. Compare the keys with Options → Controls and change the buttons here to match. The Steam app id is from PCGamingWiki and the executable from Discord's game list. The gyro's full turn of 6000 is a guess, not worked out; if a turn of the controller doesn't turn the view as far, change it in the gyro settings.'''

[profiles.guide.edits]
"stick:Left" = { text = "Move" }
"stick:Right" = { text = "Look" }
"trigger:Right" = { text = "Fire" }
"trigger:Left" = { text = "{icon:scope} Zoom" }
"button:South" = { text = "{icon:hand} Use" }
"gesture:button:South:long_press" = { text = "Sprint (hold)" }
"button:East" = { text = "Jump" }
"button:West" = { text = "Reload" }
"gesture:button:West:long_press" = { text = "Fire mode" }
"button:North" = { text = "{icon:grenade} Throw grenade" }
"gesture:button:North:long_press" = { text = "Grenade type" }
"button:LeftBumper" = { text = "Hold: weapons, grenades" }
"button:RightBumper" = { text = "{icon:hourglass} Slow-mo" }
"button:LeftStick" = { text = "Crouch (toggle)" }
"button:RightStick" = { text = "{icon:fist} Melee" }
"button:DpadUp" = { text = "{icon:flashlight} Flashlight" }
"button:DpadDown" = { text = "{icon:medkit} Med kit" }
"button:Select" = { text = "Players (multiplayer)" }
"button:Start" = { text = "Menu" }

[[profiles.guide.merged]]
