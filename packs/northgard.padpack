format = 20
macros = []
overlay_font = "Kreon"

[pack]
id = "85995b52-16d8-4e09-9c85-d05c4d0d5e34"
name = "Northgard"
version = "1.0"
author = "Padwight"
description = "Northgard (Steam, Linux or Windows build) on an Xbox-style pad, for the default keys. The PC version has no controller support, so the layout borrows the console edition's radial selection on the PC keys. The right stick moves the cursor, RT or A left-clicks, LT right-clicks to move and order, the left stick moves the camera. X opens build mode, Y jumps to the latest notification, the d-pad zooms, cycles the selection and rotates a building. Hold LB to select idle workers, residents or scouts; RB is Ctrl for orders. Select lists the Folklore, victory and world screens. The \"+ Gyro\" profile also moves the cursor by tilting the controller."
made_with = "Xbox controller"

[[rules]]
kind = "executable"
value = "Northgard"
profile = "Northgard"

[[rules]]
kind = "executable"
value = "Northgard.exe"
profile = "Northgard"

[[rules]]
kind = "steam_app_id"
value = "466560"
profile = "Northgard"

[[profiles]]
name = "Northgard"
combos = []
combo_window_ms = 120
tap_window_ms = 250
long_press_ms = 500

[profiles.buttons]
Guide = { mode = "Guide" }
South = { mouse = "Left" }
East = { keys = ["KEY_ESC"] }
West = { keys = ["KEY_B"] }
North = { keys = ["KEY_SPACE"] }
LeftBumper = { open_menu = "Select units" }
RightBumper = { keys = ["KEY_LEFTCTRL"] }
Select = { open_menu = "Screens" }
Start = { keys = ["KEY_ESC"] }
LeftStick = { keys = ["KEY_BACKSPACE"] }
RightStick = { keys = ["KEY_LEFTALT"] }
DpadUp = { wheel = "Up" }
DpadDown = { wheel = "Down" }
DpadLeft = { keys = ["KEY_TAB"] }
DpadRight = { keys = ["KEY_F"] }

[profiles.left_stick]
deadzone = 0.15
curve = 1.0
key_threshold = 0.35

[profiles.left_stick.action.ring]
sectors = 8
start_angle = 0.0
inner_radius = 0.35
hysteresis = 0.1

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_W"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_W"] },
    { keys = ["KEY_D"] },
]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_D"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_S"] },
    { keys = ["KEY_D"] },
]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_S"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_S"] },
    { keys = ["KEY_A"] },
]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_A"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_W"] },
    { keys = ["KEY_A"] },
]

[profiles.right_stick]
deadzone = 0.12
curve = 1.8
key_threshold = 0.5

[profiles.right_stick.action.mouse]
speed = 1500.0
accel = 0.3

[profiles.left_trigger.action.button]
threshold = 0.4
action = { mouse = "Right" }

[profiles.right_trigger.action.button]
threshold = 0.3
action = { mouse = "Left" }

[profiles.guide]
notes = '''The right stick {rs} moves the cursor: {rt} or {south} selects (left click), and {lt} moves, gathers, explores or attacks (right click). The left stick {ls} moves the camera, and {updown} zooms.
{west} opens build mode: pick a building with {south}, rotate it with {right}, place it with {south}, and cancel with {lt} or {east}.
{north} jumps to the latest notification, {left} cycles through the selection, and {l3} goes back to the Town Hall.
Hold {lb} and aim the right stick {rs} to select every idle worker, every resident or every scout, mark the squad or hold the units in place: release to pick.
Hold {rb} for Ctrl while you right-click, to give a unit its special order. Hold {r3} for Alt and click to ping the map for your team.
{select} lists the Folklore, the victory requirements, the world information, the minimap mode and chat. {start} (Esc) is the game menu; {east} cancels and closes.
Northgard came out on Switch, PlayStation 4 and Xbox One with its own radial interface, which the PC game doesn't have, so only the radial selection is borrowed. The keys are the defaults as listed by a third-party guide, not checked on an install: if one does nothing, look in Options, Controls, where they can be rebound. Hold {guide} and press {west} for the on-screen keyboard.'''

[profiles.guide.edits]
"stick:Right" = { text = "Cursor" }
"stick:Left" = { text = "Move the camera" }
"trigger:Right" = { text = "Left click (select)" }
"trigger:Left" = { text = "Right click (move, order)" }
"button:South" = { text = "Left click" }
"button:East" = { text = "Cancel / close" }
"button:West" = { text = "{icon:hammer} Build mode" }
"button:North" = { text = "{icon:bell} Latest notification" }
"button:LeftBumper" = { text = "Hold: select units" }
"button:RightBumper" = { text = "Hold: Ctrl (special order)" }
"button:Select" = { text = "Screens and chat" }
"button:Start" = { text = "Game menu" }
"button:LeftStick" = { text = "{icon:home} Town Hall" }
"button:RightStick" = { text = "Hold: Alt (ping)" }
"button:DpadLeft" = { text = "Cycle the selection" }
"button:DpadRight" = { text = "{icon:rotate} Rotate building" }

[[profiles.guide.merged]]
inputs = ["button:DpadUp", "button:DpadDown"]
text = "Zoom in / out"

