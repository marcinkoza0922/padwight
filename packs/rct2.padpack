format = 20
macros = []
overlay_font = "Silkscreen"

[pack]
id = "83de13c0-9832-4676-b3ef-438915c1feda"
name = "RollerCoaster Tycoon 2"
version = "1.2"
author = "Padwight"
description = "RollerCoaster Tycoon 2 on an Xbox-style pad, for the game's default keys. The left stick scrolls the view, the right stick moves the pointer, RT and A click, LT right-clicks (hold it to drag the view). Hold LB for the build tools and RB for the view options; Select lists the park screens. Y rotates what you're placing, B closes windows (hold: all), X cancels building, the d-pad zooms and rotates the view, Start pauses."
made_with = "Xbox controller"

[[rules]]
kind = "executable"
value = "RCT2.EXE"
profile = "RollerCoaster Tycoon 2"

[[profiles]]
name = "RollerCoaster Tycoon 2"
combos = []
combo_window_ms = 120
tap_window_ms = 250
long_press_ms = 500

[profiles.buttons]
Guide = {mode = "Guide"}
South = {mouse = "Left"}
East = {keys = ["KEY_BACKSPACE"]}
West = {keys = ["KEY_ESC"]}
North = {keys = ["KEY_Z"]}
LeftBumper = {open_menu = "Build"}
RightBumper = {open_menu = "View"}
Select = {open_menu = "Park"}
Start = {keys = ["KEY_PAUSE"]}
DpadUp = {keys = ["KEY_PAGEDOWN"]}
DpadDown = {keys = ["KEY_PAGEUP"]}
DpadLeft = {keys = ["KEY_ENTER"]}
DpadRight = {keys = ["KEY_ENTER"]}

[profiles.gestures.East]
long_press = {keys = ["KEY_LEFTSHIFT", "KEY_BACKSPACE"]}

[profiles.left_stick]
deadzone = 0.12
curve = 1.0
key_threshold = 0.3

[profiles.left_stick.action.ring]
sectors = 8
start_angle = 0.0
inner_radius = 0.3
hysteresis = 0.1

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_UP"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_UP"] },
    { keys = ["KEY_RIGHT"] },
]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_RIGHT"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_DOWN"] },
    { keys = ["KEY_RIGHT"] },
]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_DOWN"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_DOWN"] },
    { keys = ["KEY_LEFT"] },
]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_LEFT"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_UP"] },
    { keys = ["KEY_LEFT"] },
]

[profiles.right_stick]
deadzone = 0.15
curve = 1.6
key_threshold = 0.5

[profiles.right_stick.action.mouse]
speed = 1400.0
accel = 0.3

[profiles.left_trigger.action.button]
threshold = 0.4
action = {mouse = "Right"}

[profiles.right_trigger.action.button]
threshold = 0.3
action = {mouse = "Left"}

[profiles.gyro]
mode = "off"
horizontal = "yaw"
invert_x = false
invert_y = false
activation = "always"
noise_threshold = 1.0

[profiles.guide]
notes = '''The right stick {rs} moves the pointer. {rt} or {south} clicks, and {lt} right-clicks: it removes scenery and paths while building. Hold {lt} and move the pointer to drag the view.
The left stick {ls} scrolls the view. {up} and {down} zoom, {left} and {right} rotate it.
Hold {lb} for the build tools (land, water, scenery, paths, new rides) and {rb} for the view options, aiming with the right stick {rs}. The view menu stays open, so you can flip several.
{select} lists the park screens: finances, research, rides, guests, staff, messages and the map.
{north} rotates the object you're placing. {east} closes the top window, and holding {east} closes them all. {west} cancels building.
Naming a ride or a guest: {guide} + {west} opens the on-screen keyboard.'''

[profiles.guide.edits]
"stick:Left" = {text = "Scroll the view"}
"stick:Right" = {text = "Pointer"}
"trigger:Right" = {text = "Left click"}
"trigger:Left" = {text = "Right click (hold and move: drag the view)"}
"button:South" = {text = "Left click"}
"button:East" = {text = "Close window"}
"gesture:button:East:long_press" = {text = "Close all windows"}
"button:West" = {text = "Cancel construction"}
"button:North" = {text = "{icon:rotate} Rotate object"}
"button:LeftBumper" = {text = "Hold: build"}
"button:RightBumper" = {text = "Hold: view options"}
"button:Select" = {text = "Park screens"}
"button:Start" = {text = "{icon:pause} Pause"}
"button:DpadUp" = {text = "Zoom in"}
"button:DpadDown" = {text = "Zoom out"}

[[profiles.guide.merged]]
inputs = ["button:DpadLeft", "button:DpadRight"]
text = "Rotate the view"

