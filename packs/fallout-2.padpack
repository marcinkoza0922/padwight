format = 20
macros = []
overlay_font = "VT323"

[pack]
id = "50ba1a62-ee3d-4931-96e3-4e08d0b8258e"
name = "Fallout 2"
version = "1.0"
author = "Padwight"
description = "Fallout 2 (GOG, with the high resolution patch) on an Xbox-style pad. The right stick moves the pointer, the left stick scrolls the map, RT or A left-clicks and LT right-clicks to change the pointer. Y is the inventory, X swaps hands (hold: attack mode), B ends the turn (hold: end combat), RB starts combat, L3 toggles Sneak. Hold LB for the skills. Select lists the character screen, Pip-Boy, Skilldex and map. Start is the options and backs out of every screen; double tap it to quick save, hold it to quick load."
made_with = "Xbox controller"

[[rules]]
kind = "executable"
value = "fallout2.exe"
profile = "Fallout 2"

[[rules]]
kind = "executable"
value = "fallout2HR.exe"
profile = "Fallout 2"

[[rules]]
kind = "steam_app_id"
value = "38410"
profile = "Fallout 2"

[[profiles]]
name = "Fallout 2"
combos = []
combo_window_ms = 120
tap_window_ms = 250
long_press_ms = 500

[profiles.buttons]
Guide = { mode = "Guide" }
South = { mouse = "Left" }
East = { keys = ["KEY_SPACE"] }
West = { keys = ["KEY_B"] }
North = { keys = ["KEY_I"] }
LeftBumper = { open_menu = "Skills" }
RightBumper = { keys = ["KEY_A"] }
Select = { open_menu = "Screens" }
Start = { keys = ["KEY_ESC"] }
LeftStick = { keys = ["KEY_1"] }
DpadUp = { wheel = "Up" }
DpadDown = { wheel = "Down" }
DpadLeft = { keys = ["KEY_HOME"] }
DpadRight = { keys = ["KEY_TAB"] }

[profiles.gestures.East.long_press]
keys = ["KEY_ENTER"]

[profiles.gestures.West.long_press]
keys = ["KEY_N"]

[profiles.gestures.Start.double_tap]
keys = ["KEY_F6"]

[profiles.gestures.Start.long_press]
keys = ["KEY_F7"]

[profiles.left_stick]
deadzone = 0.15
curve = 1.0
key_threshold = 0.35

[profiles.left_stick.action.ring]
sectors = 8
start_angle = 0.0
inner_radius = 0.35
hysteresis = 0.1

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_UP"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_UP"] },
    { keys = ["KEY_RIGHT"] },
]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_RIGHT"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_DOWN"] },
    { keys = ["KEY_RIGHT"] },
]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_DOWN"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_DOWN"] },
    { keys = ["KEY_LEFT"] },
]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_LEFT"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_UP"] },
    { keys = ["KEY_LEFT"] },
]

[profiles.right_stick]
deadzone = 0.12
curve = 1.8
key_threshold = 0.5

[profiles.right_stick.action.mouse]
speed = 1500.0
accel = 0.3

[profiles.left_trigger.action.button]
threshold = 0.4
action = { mouse = "Right" }

[profiles.right_trigger.action.button]
threshold = 0.3
action = { mouse = "Left" }

[profiles.guide]
notes = '''The right stick moves the mouse pointer; {rt} or {south} is a left click and {lt} a right click. Hold {guide} and press {west} for the on-screen keyboard when the game asks for a name.
{lt} cycles the pointer between moving, using and looking, as the right mouse button does.
{start} (Escape) closes the inventory, character screen, Pip-Boy and dialogue trade windows, and opens the options on the map.
In combat, {east} ends your turn and holding {east} ends combat when no one is hostile. {rb} starts combat.
Hold {lb} for the skills and the Skilldex, picking with the right stick {rs}, then click what to use the skill on. {l3} toggles Sneak.
The {dpad} scrolls lists such as the inventory, when the high resolution patch is on.'''

[profiles.guide.edits]
"stick:Left" = { text = "Scroll the map" }
"stick:Right" = { text = "Pointer" }
"trigger:Right" = { text = "Left click (move, use, attack)" }
"trigger:Left" = { text = "Right click (change pointer)" }
"button:South" = { text = "Left click" }
"button:East" = { text = "End turn" }
"gesture:button:East:long_press" = { text = "End combat / done" }
"button:West" = { text = "Swap hands" }
"gesture:button:West:long_press" = { text = "Change attack mode" }
"button:North" = { text = "{icon:bag} Inventory" }
"button:LeftBumper" = { text = "Hold: skills" }
"button:RightBumper" = { text = "Start combat" }
"button:LeftStick" = { text = "Sneak" }
"button:Select" = { text = "{icon:map} Character, Pip-Boy, map" }
"button:Start" = { text = "Options / back out" }
"gesture:button:Start:double_tap" = { text = "{icon:save} Quick save" }
"gesture:button:Start:long_press" = { text = "{icon:load} Quick load" }
"button:DpadLeft" = { text = "Center on you" }
"button:DpadRight" = { text = "{icon:map} Automap" }

[[profiles.guide.merged]]
inputs = ["button:DpadUp", "button:DpadDown"]
text = "Scroll lists"

