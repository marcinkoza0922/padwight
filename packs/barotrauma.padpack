format = 20
macros = []
overlay_font = "Rajdhani"

[pack]
id = "5a9c1e47-83b2-4d6f-a015-e2c7b8f39d14"
name = "Barotrauma"
version = "1.0"
author = "Padwight"
description = "Barotrauma on an Xbox-style pad, for the game's default keys. The left stick walks and a full push runs, the right stick moves the cursor you aim and work with; RT uses and fires, LT aims. A interacts, B grabs, X opens health, Y the crew and missions list, LB the command interface. Hold RB for the hotbar. Select lists chat, radio and the rest. Overlays in the sub's dark steel with an amber highlight. The \"Barotrauma + Gyro\" profile also moves the cursor by tilting the controller."
made_with = "Xbox controller"

[[rules]]
kind = "steam_app_id"
value = "602960"
profile = "Barotrauma"

[[rules]]
kind = "executable"
value = "Barotrauma.exe"
profile = "Barotrauma"

[[rules]]
kind = "executable"
value = "Barotrauma"
profile = "Barotrauma"

[[profiles]]
name = "Barotrauma"
combos = []
combo_window_ms = 120
tap_window_ms = 250
long_press_ms = 500

[profiles.buttons]
Guide = {mode = "Guide"}
South = {keys = ["KEY_E"]}
East = {keys = ["KEY_G"]}
West = {keys = ["KEY_H"]}
North = {keys = ["KEY_TAB"]}
LeftBumper = {keys = ["KEY_Q"]}
RightBumper = {open_menu = "Hotbar"}
LeftStick = { toggle = { action = { keys = ["KEY_LEFTCTRL"] } } }
RightStick = {mouse = "Middle"}
Select = {open_menu = "Crew and chat"}
Start = {keys = ["KEY_ESC"]}
DpadUp = {wheel = "Up"}
DpadDown = {wheel = "Down"}
DpadLeft = {keys = ["KEY_Z"]}
DpadRight = {keys = ["KEY_X"]}

[profiles.left_stick]
deadzone = 0.15
curve = 1.0
key_threshold = 0.3

[profiles.left_stick.action.ring]
sectors = 8
start_angle = 0.0
inner_radius = 0.3
hysteresis = 0.1

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_W"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_W"] },
    { keys = ["KEY_D"] },
]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_D"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_S"] },
    { keys = ["KEY_D"] },
]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_S"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_S"] },
    { keys = ["KEY_A"] },
]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_A"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_W"] },
    { keys = ["KEY_A"] },
]

[[profiles.left_stick.zones]]
min = 0.85
max = 1.0
action = { keys = ["KEY_LEFTSHIFT"] }

[profiles.right_stick]
deadzone = 0.12
curve = 1.7
key_threshold = 0.5

[profiles.right_stick.action.mouse]
speed = 1700.0
accel = 0.3

[profiles.left_trigger.action.button]
threshold = 0.4
action = {mouse = "Right"}

[profiles.right_trigger.action.button]
threshold = 0.3
action = {mouse = "Left"}

[profiles.gyro]
enabled = false
horizontal = "yaw"
invert_x = false
invert_y = false
noise_threshold = 1.0

[profiles.guide]
notes = '''The right stick {rs} moves the cursor, which is where you aim, and what you point at is what you use. {rt} uses the item in your hands: fire, weld, repair, cut. {lt} aims a weapon or tool.
{ls} walks, climbs ladders and swims; a full push runs (Shift). Click {l3} to crouch, and again to stand.
{south} interacts with what you point at (E): doors, terminals, the helm, a crewmate. {east} grabs and drags a body (G). {west} opens the health screen (H), {north} the crew and missions list (Tab).
{lb} opens the command interface to give orders (Q), and clicking {r3} gives a quick order for what you point at (middle mouse). Hold {rb} for the hotbar and pick a slot with {rs}; {up} and {down} turn the wheel.
{left} and {right} switch to the previous and next crewmate in single player. {select} lists chat, radio chat and ragdoll. {start} opens the menu (Escape).
Chat needs typing: {guide} + {west} opens the on-screen keyboard.
The keys are remembered defaults, unchecked on an install; the command interface, grab and crew-switch keys are the least sure. If one doesn't answer, check Settings → Controls and change the pack to match.'''

[profiles.guide.edits]
"stick:Left" = {text = "Walk · {b}full push runs{/b}"}
"stick:Right" = {text = "Cursor · aim"}
"trigger:Right" = {text = "{icon:crosshair} {b}Use · fire{/b}"}
"trigger:Left" = {text = "Aim"}
"button:South" = {text = "{icon:hand} {b}Interact{/b}"}
"button:East" = {text = "Grab · drag"}
"button:West" = {text = "{icon:medkit} Health"}
"button:North" = {text = "{icon:people} Crew · missions"}
"button:LeftBumper" = {text = "{icon:messages} Command"}
"button:RightBumper" = {text = "Hotbar (hold)"}
"button:LeftStick" = {text = "Crouch (toggle)"}
"button:RightStick" = {text = "Quick order"}
"button:Select" = {text = "Chat, radio, more"}
"button:Start" = {text = "{icon:pause} Menu"}

[[profiles.guide.merged]]
inputs = ["button:DpadUp", "button:DpadDown"]
text = "Wheel"

[[profiles.guide.merged]]
inputs = ["button:DpadLeft", "button:DpadRight"]
text = "{icon:person} Switch crewmate"

