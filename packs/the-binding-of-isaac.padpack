format = 20
macros = []
overlay_font = "Special Elite"

[pack]
id = "ed821094-bb8b-45f7-a4fa-3a75fd404ce5"
name = "The Binding of Isaac"
version = "1.0"
author = "Padwight"
description = "The original Flash Binding of Isaac on an Xbox-style pad, laid out like Rebirth: the left stick walks, the right stick or the face buttons cry tears, RT uses the active item, LT drops a bomb and RB takes a pill or uses a card. Start pauses. A second profile passes the controller through for the IsaacRecomp port, which reads it. Overlays in torn basement paper and blood red."
made_with = "Xbox controller"

[[rules]]
kind = "steam_app_id"
value = "113200"
profile = "The Binding of Isaac"

[[rules]]
kind = "executable"
value = "Isaac.exe"
profile = "The Binding of Isaac"

[[rules]]
kind = "executable"
value = "binding_of_isaac.exe"
profile = "The Binding of Isaac"

[[rules]]
kind = "executable"
value = "isaac"
profile = "The Binding of Isaac"

[[rules]]
kind = "executable"
value = "IsaacRecomp.exe"
profile = "The Binding of Isaac (game's own pad support)"

[[profiles]]
name = "The Binding of Isaac"
combos = []
combo_window_ms = 120
tap_window_ms = 250
long_press_ms = 500

[profiles.buttons]
Guide = {mode = "Guide"}
North = {keys = ["KEY_UP"]}
South = {keys = ["KEY_DOWN"]}
West = {keys = ["KEY_LEFT"]}
East = {keys = ["KEY_RIGHT"]}
RightBumper = {keys = ["KEY_Q"]}
Select = {keys = ["KEY_ENTER"]}
Start = {keys = ["KEY_P"]}
DpadUp = {keys = ["KEY_UP"]}
DpadDown = {keys = ["KEY_DOWN"]}
DpadLeft = {keys = ["KEY_LEFT"]}
DpadRight = {keys = ["KEY_RIGHT"]}

[profiles.gestures.Start.long_press]
keys = ["KEY_ESC"]

[profiles.gestures.Select.long_press]
keys = ["KEY_F"]

[profiles.left_stick]
deadzone = 0.15
curve = 1.0
key_threshold = 0.3

[profiles.left_stick.action.ring]
sectors = 8
start_angle = 0.0
inner_radius = 0.3
hysteresis = 0.1

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_W"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_W"] },
    { keys = ["KEY_D"] },
]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_D"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_S"] },
    { keys = ["KEY_D"] },
]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_S"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_S"] },
    { keys = ["KEY_A"] },
]

[[profiles.left_stick.action.ring.actions]]
keys = ["KEY_A"]

[[profiles.left_stick.action.ring.actions]]
multi = [
    { keys = ["KEY_W"] },
    { keys = ["KEY_A"] },
]

[profiles.right_stick]
deadzone = 0.2
curve = 1.0
key_threshold = 0.3

[profiles.right_stick.action.ring]
sectors = 4
start_angle = 0.0
inner_radius = 0.35
hysteresis = 0.1

[[profiles.right_stick.action.ring.actions]]
keys = ["KEY_UP"]

[[profiles.right_stick.action.ring.actions]]
keys = ["KEY_RIGHT"]

[[profiles.right_stick.action.ring.actions]]
keys = ["KEY_DOWN"]

[[profiles.right_stick.action.ring.actions]]
keys = ["KEY_LEFT"]

[profiles.left_trigger.action.button]
threshold = 0.3
action = {keys = ["KEY_E"]}

[profiles.right_trigger.action.button]
threshold = 0.3
