[profiles.gyro]
mode = "off"
horizontal = "yaw"
invert_x = false
invert_y = false
noise_threshold = 1.0

[profiles.guide]
notes = '''The layout follows the pad scheme of the later Rebirth, so it feels the same.
The left stick {ls} walks (WASD). Cry tears with the right stick {rs}, the face buttons or the {dpad}: they press the arrow keys, so {north} fires up, {south} down, {west} left and {east} right. Tears go one way at a time.
{rt} uses your active item (Space), {lt} drops a bomb (E) and {rb} takes your pill or uses your card (Q).
{start} pauses (P); hold {start} for Escape. {select} presses Enter, and holding it toggles full screen (F), which the game only takes on the title and pause screens. The arrows move through the menus.
The keys are the game's remembered defaults, unchecked on an install, as is the Linux executable name. The Flash game has no key settings.
The IsaacRecomp port reads a controller itself; for it the pack picks the game's own pad support profile, which passes the controller through.'''

[profiles.guide.edits]
"stick:Left" = {text = "Walk (WASD)"}
"stick:Right" = {text = "{icon:drop} Cry tears"}
"trigger:Right" = {text = "{icon:star} {b}Active item{/b}"}
"trigger:Left" = {text = "{icon:bomb} Bomb"}
"button:RightBumper" = {text = "{icon:pill} Pill / card"}
"button:Select" = {text = "Enter"}
"gesture:button:Select:long_press" = {text = "Full screen"}
"button:Start" = {text = "{icon:pause} Pause"}
"gesture:button:Start:long_press" = {text = "Escape"}

[[profiles.guide.merged]]
inputs = ["button:North", "button:East", "button:South", "button:West"]
text = "{icon:drop} Tears up, right, down, left"

[[profiles.guide.merged]]
inputs = ["button:DpadUp", "button:DpadDown", "button:DpadLeft", "button:DpadRight"]
text = "Tears (arrow keys)"


[[profiles]]
name = "The Binding of Isaac (game's own pad support)"
combos = []
combo_window_ms = 120
tap_window_ms = 250
long_press_ms = 500

[profiles.buttons]
Guide = {mode = "Guide"}
South = {gamepad = "South"}
East = {gamepad = "East"}
North = {gamepad = "North"}
West = {gamepad = "West"}
LeftBumper = {gamepad = "LeftBumper"}
RightBumper = {gamepad = "RightBumper"}
LeftStick = {gamepad = "LeftStick"}
RightStick = {gamepad = "RightStick"}
Select = {gamepad = "Select"}
Start = {gamepad = "Start"}
DpadUp = {gamepad = "DpadUp"}
DpadDown = {gamepad = "DpadDown"}
DpadLeft = {gamepad = "DpadLeft"}
DpadRight = {gamepad = "DpadRight"}

[profiles.left_stick]
deadzone = 0.05
curve = 1.0
key_threshold = 0.3

[profiles.left_stick.action]
gamepad = {stick = "Left", invert_y = false}

[profiles.right_stick]
deadzone = 0.05
curve = 1.0
key_threshold = 0.3

[profiles.right_stick.action]
gamepad = {stick = "Right", invert_y = false}

[profiles.left_trigger]
action = {gamepad = "Left"}

[profiles.right_trigger]
action = {gamepad = "Right"}

[profiles.gyro]
mode = "off"
horizontal = "yaw"
invert_x = false
invert_y = false
noise_threshold = 1.0

[profiles.guide]
notes = '''The controller goes to the game as it is, for the IsaacRecomp port, which reads a gamepad through SDL. If the game ignores the pad, switch back to The Binding of Isaac profile, which plays it with the keys.
{guide} still works over the game: {guide} + {lb} opens the media controls.'''


